, [7.05, 0.064122], [7.1, 0.062459], [7.15, 0.060837], [7.2, 0.059254], [7.25, 0.05771], [7.3, 0.056203], [7.35, 0.054732], [7.4, 0.053298], [7.45, 0.051899], [7.5, 0.050535], [7.55, 0.049204], [7.6, 0.047906], [7.65, 0.04664], [7.7, 0.045406], [7.75, 0.044203], [7.8, 0.043029], [7.85, 0.041885], [7.9, 0.04077], [7.95, 0.039683], [8.0, 0.038624]], "c": 0, "label": "lower T"}, {"pts": [[0.0, 0.0], [0.05, 0.017644], [0.1, 0.034588], [0.15, 0.050855], [0.2, 0.066464], [0.25, 0.081435], [0.3, 0.095787], [0.35, 0.109539], [0.4, 0.122709], [0.45, 0.135314], [0.5, 0.147372], [0.55, 0.158899], [0.6, 0.169912], [0.65, 0.180426], [0.7, 0.190458], [0.75, 0.200021], [0.8, 0.209131], [0.85, 0.217802], [0.9, 0.226047], [0.95, 0.233881], [1.0, 0.241315], [1.05, 0.248364], [1.1, 0.255038], [1.15, 0.261351], [1.2, 0.267314], [1.25, 0.272939], [1.3, 0.278236], [1.35, 0.283216], [1.4, 0.287889], [1.45, 0.292267], [1.5, 0.296358], [1.55, 0.300173], [1.6, 0.30372], [1.65, 0.30701], [1.7, 0.31005], [1.75, 0.312849], [1.8, 0.315415], [1.85, 0.317758], [1.9, 0.319884], [1.95, 0.321801], [2.0, 0.323517], [2.05, 0.325039], [2.1, 0.326373], [2.15, 0.327527], [2.2, 0.328508], [2.25, 0.329321], [2.3, 0.329974], [2.35, 0.330471], [2.4, 0.330819], [2.45, 0.331024], [2.5, 0.331091], [2.55, 0.331026], [2.6, 0.330834], [2.65, 0.330519], [2.7, 0.330087], [2.75, 0.329542], [2.8, 0.32889], [2.85, 0.328134], [2.9, 0.32728], [2.95, 0.32633], [3.0, 0.32529], [3.05, 0.324163], [3.1, 0.322953], [3.15, 0.321664], [3.2, 0.320299], [3.25, 0.318862], [3.3, 0.317357], [3.35, 0.315786], [3.4, 0.314153], [3.45, 0.312461], [3.5, 0.310712], [3.55, 0.308911], [3.6, 0.307058], [3.65, 0.305158], [3.7, 0.303213], [3.75, 0.301226], [3.8, 0.299198], [3.85, 0.297132], [3.9, 0.295031], [3.95, 0.292897], [4.0, 0.290731], [4.05, 0.288536], [4.1, 0.286315], [4.15, 0.284068], [4.2, 0.281797], [4.25, 0.279506], [4.3, 0.277194], [4.35, 0.274865], [4.4, 0.272519], [4.45, 0.270158], [4.5, 0.267784], [4.55, 0.265398], [4.6, 0.263002], [4.65, 0.260596], [4.7, 0.258182], [4.75, 0.255762], [4.8, 0.253337], [4.85, 0.250907], [4.9, 0.248474], [4.95, 0.246039], [5.0, 0.243604], [5.05, 0.241168], [5.1, 0.238733], [5.15, 0.2363], [5.2, 0.233869], [5.25, 0.231443], [5.3, 0.22902], [5.35, 0.226603], [5.4, 0.224192], [5.45, 0.221787], [5.5, 0.21939], [5.55, 0.217001], [5.6, 0.21462], [5.65, 0.212249], [5.7, 0.209887], [5.75, 0.207536], [5.8, 0.205195], [5.85, 0.202866], [5.9, 0.200549], [5.95, 0.198243], [6.0, 0.195951], [6.05, 0.193671], [6.1, 0.191405], [6.15, 0.189153], [6.2, 0.186915], [6.25, 0.184691], [6.3, 0.182482], [6.35, 0.180289], [6.4, 0.17811], [6.45, 0.175947], [6.5, 0.1738], [6.55, 0.171669], [6.6, 0.169554], [6.65, 0.167456], [6.7, 0.165374], [6.75, 0.163309], [6.8, 0.161261], [6.85, 0.15923], [6.9, 0.157217], [6.95, 0.15522], [7.0, 0.153241], [7.05, 0.15128], [7.1, 0.149336], [7.15, 0.14741], [7.2, 0.145501], [7.25, 0.143611], [7.3, 0.141738], [7.35, 0.139883], [7.4, 0.138046], [7.45, 0.136226], [7.5, 0.134425], [7.55, 0.132642], [7.6, 0.130876], [7.65, 0.129129], [7.7, 0.127399], [7.75, 0.125687], [7.8, 0.123993], [7.85, 0.122317], [7.9, 0.120659], [7.95, 0.119018], [8.0, 0.117395]], "c": 1, "label": "higher T"}, {"pts": [[5, 0], [5, 0.45]], "label": "Ea", "dash": true, "c": 2}], "xnums": false, "ynums": false}}, "selfx": {"q": "In step 1, why does the answer say the area under the curve stays the same?", "o": ["Because Ea rises by the same amount as the average energy", "Because the area shows the rate, and the rate is unchanged", "Because the area is the total number of molecules, which heating does not change", "Because no molecules gain energy when the mixture is heated"], "a": 2, "f": ["Ea does not change with temperature. It is a property of the reaction and its route.", "The area is not the rate. It is the number of molecules. The rate does rise on heating.", "Right. The area represents the total number of molecules. Heating redistributes their energies but adds none.", "Many molecules do gain energy on heating. That is why the peak moves right."]}, "faded": {"task": "Explain, in terms of collisions, why increasing the concentration of hydrochloric acid increases the rate of its reaction with magnesium.", "given": ["More acid particles are present in the same volume, so they are closer together."], "q": "What is the next point in the explanation?", "o": ["A greater fraction of collisions then has energy ≥ Ea, so more collisions succeed.", "The activation energy falls because more particles are present to react.", "Each particle then has more kinetic energy, so every collision is harder.", "Collisions are more frequent, so more successful collisions occur per second."], "a": 3, "f": ["Concentration does not change the energy distribution, so the fraction with E ≥ Ea is the same. That explanation belongs to temperature.", "Only a catalyst lowers Ea. Concentration leaves it unchanged.", "Concentration does not change the energy of particles. Only temperature does that.", "Right. Closer particles collide more often, so successful collisions per second increase and the rate rises."]}, "trap": "Saying a temperature rise works mainly because collisions are more frequent. The main effect is the much larger fraction of particles with E ≥ Ea. Always state this fraction first.", "recap": "Rate depends on successful collisions per second: temperature and catalysts raise the fraction with E ≥ Ea, while concentration and pressure raise collision frequency."}
{"s": "chem", "t": "3.1.6", "kind": "method", "why": "Kc calculations are a common multi-mark question on the physical chemistry papers, and the units for Kc are usually worth a separate mark.", "hook": null, "chunks": [{"h": "Writing the Kc expression", "b": "For aA + bB ⇌ cC + dD at equilibrium: $K_c = \\frac{[C]^c[D]^d}{[A]^a[B]^b}$. Square brackets mean **equilibrium concentration** in mol dm⁻³. **Products** go on top, reactants below. Each coefficient becomes a **power**."}, {"h": "What changes Kc", "b": "Only **temperature** changes Kc. For an exothermic forward reaction, raising T lowers Kc and the position shifts left. Concentration and pressure changes shift the **position** but leave Kc unchanged. A **catalyst** only speeds up reaching equilibrium. Press Next step on the graph: adding PCl₅ shifts the position, not Kc.", "fig": {"type": "graph", "anim": "steps", "x": [0, 40], "xstep": 5, "y": [0, 0.35], "ystep": 0.05, "xlabel": "Time / s", "ylabel": "Concentration / mol dm⁻³", "lines": [{"c": 0, "step": 1, "pts": [[0, 0.15], [10, 0.15]]}, {"c": 1, "step": 1, "pts": [[0, 0.1], [10, 0.1]]}, {"c": 0, "dash": true, "step": 2, "pts": [[10, 0.15], [10, 0.3]]}, {"c": 0, "label": "[PCl₅]", "step": 3, "pts": [[10, 0.3], [11, 0.2927], [12, 0.2869], [13, 0.2824], [14, 0.2789], [16, 0.2741], [18, 0.2712], [20, 0.2694], [24, 0.2677], [28, 0.267], [32, 0.2668], [40, 0.2667]]}, {"c": 1, "label": "[PCl₃] = [Cl₂]", "step": 3, "pts": [[10, 0.1], [11, 0.1074], [12, 0.1131], [13, 0.1176], [14, 0.1211], [16, 0.1259], [18, 0.1288], [20, 0.1306], [24, 0.1323], [28, 0.133], [32, 0.1332], [40, 0.1333]]}], "points": [{"at": [10, 0.3], "label": "PCl₅ added", "step": 2}, {"at": [35, 0.2667], "label": "0.267", "step": 4}, {"at": [35, 0.1333], "label": "0.133", "step": 4}], "steps": ["Start at equilibrium: [PCl₅] = 0.15, [PCl₃] = [Cl₂] = 0.10 mol dm⁻³. Kc = 0.10 × 0.10 ÷ 0.15 = 0.067 mol dm⁻³.", "At 10 s more PCl₅ is added and [PCl₅] jumps from 0.15 to 0.30 mol dm⁻³. The product concentrations have not changed yet.", "The forward reaction speeds up: PCl₅ is used up and PCl₃ and Cl₂ are made. The position shifts right until the rates balance again.", "New equilibrium: [PCl₅] = 0.267, [PCl₃] = [Cl₂] = 0.133. Kc = 0.1333² ÷ 0.2667 = 0.067 mol dm⁻³, unchanged. Only the position moved."]}}, {"h": "The moles table", "b": "Draw three rows: initial moles, change, **equilibrium moles**. The change follows the **ratio in the equation**. Then divide each equilibrium amount by the **volume in dm³** to get concentrations. Kc needs concentrations, never moles, unless the volume cancels."}, {"h": "Working out the units", "b": "Put units into the expression and **cancel**. For $\\frac{[\\text{PCl}_3][\\text{Cl}_2]}{[\\text{PCl}_5]}$ the units are $\\frac{(\\text{mol dm}^{-3})^2}{\\text{mol dm}^{-3}}$ = mol dm⁻³. If the powers on top and bottom add up to the same total, Kc has **no units**."}], "example": {"task": "0.50 mol PCl₅ is heated in a 2.0 dm³ vessel: PCl₅ ⇌ PCl₃ + Cl₂. At equilibrium 0.30 mol PCl₅ remains. Calculate Kc, with units.", "steps": [{"do": "Write the expression: Kc = [PCl₃][Cl₂] ÷ [PCl₅].", "why": "Products over reactants. All coefficients are 1, so no powers are needed."}, {"do": "PCl₅ reacted = 0.50 − 0.30 = 0.20 mol. So at equilibrium PCl₃ = 0.20 mol and Cl₂ = 0.20 mol.", "why": "The equation is 1:1:1, so each mole of PCl₅ lost makes one mole of each product."}, {"do": "Divide by 2.0 dm³: [PCl₅] = 0.15, [PCl₃] = 0.10, [Cl₂] = 0.10 mol dm⁻³.", "why": "Kc uses concentrations. Volume does not cancel because there is 1 mol of gas on the left and 2 on the right."}, {"do": "Substitute: Kc = (0.10 × 0.10) ÷ 0.15 = 0.0667.", "why": "Use only equilibrium concentrations, never initial ones."}, {"do": "Units: (mol dm⁻³)² ÷ mol dm⁻³ = mol dm⁻³.", "why": "Units come from cancelling in the expression, and they earn a mark."}], "answer": "Kc = 0.067 mol dm⁻³ (2 significant figures)"}, "selfx": {"q": "Why are the equilibrium moles divided by 2.0 dm³ in step 3?", "o": ["Moles and concentration are the same thing once the volume is in dm³", "Dividing by the volume turns the 1:1:1 ratio into the concentration ratio", "Kc uses concentrations, and the volume does not cancel as the gas moles differ", "The volume only matters if the pressure or temperature has been changed"], "a": 2, "f": ["Wrong. Concentration is moles ÷ volume. Treating them as equal confuses amount with concentration, so Kc would come out wrong.", "Wrong. The ratio comes from the equation and is already used in step 2. Dividing by volume does not alter any ratio.", "Right. Kc is defined using concentrations. With 1 mol of gas on the left and 2 on the right, the volume does not cancel.", "Wrong. Volume always matters when converting moles to concentration. Pressure and temperature are not involved in this step."]}, "faded": {"task": "1.00 mol N₂O₄ is heated in a 4.0 dm³ vessel: N₂O₄ ⇌ 2NO₂. At equilibrium 0.40 mol NO₂ is present. Calculate Kc.", "given": ["Kc = [NO₂]² ÷ [N₂O₄]", "Equilibrium moles: NO₂ = 0.40. N₂O₄ reacted = 0.20, so N₂O₄ = 1.00 − 0.20 = 0.80."], "q": "What is the next step?", "o": ["[N₂O₄] = 0.20 mol dm⁻³ and [NO₂] = 0.10 mol dm⁻³", "[N₂O₄] = 0.80 mol dm⁻³ and [NO₂] = 0.40 mol dm⁻³", "[N₂O₄] = 0.20 mol dm⁻³ and [NO₂] = 0.050 mol dm⁻³", "[N₂O₄] = 0.25 mol dm⁻³ and [NO₂] = 0.10 mol dm⁻³"], "a": 0, "f": ["Right. 0.80 ÷ 4.0 = 0.20 and 0.40 ÷ 4.0 = 0.10. Then Kc = 0.10² ÷ 0.20 = 0.050 mol dm⁻³.", "Wrong. These are moles, not concentrations. Here the volume does not cancel (1 mol of gas becomes 2), so divide by 4.0 dm³.", "Wrong. You divided NO₂ by its coefficient 2 as well as by 4.0. The coefficient is applied later, as the power in the expression.", "Wrong. 0.25 is the initial 1.00 mol ÷ 4.0. You must use the equilibrium amount of N₂O₄, 0.80 mol, not the starting amount."]}, "trap": "Substituting moles or initial amounts into Kc. Always build the table (initial − reacted = equilibrium), divide by the volume, and use equilibrium concentrations only. Do not forget the units.", "recap": "Kc uses equilibrium concentrations (moles ÷ volume), products over reactants, each to the power of its coefficient; only temperature changes Kc."}
{"s": "chem", "t": "3.1.7", "kind": "method", "why": "Exam questions ask you to assign oxidation states, build half-equations and combine them into balanced ionic equations, often before a titration calculation.", "hook": null, "chunks": [{"h": "Assigning oxidation states", "b": "An **oxidation state** is the charge an atom would have if all its bonding were ionic. Uncombined elements are 0. The states in a species add up to its overall charge. Oxygen is −2, except in **peroxides** such as H₂O₂, where it is −1. Hydrogen is +1, except in metal hydrides such as NaH, where it is −1."}, {"h": "Oxidation, reduction and agents", "b": "**Oxidation** is loss of electrons, and the oxidation state increases. **Reduction** is gain of electrons, and the oxidation state decreases. The **reducing agent** is the species that is oxidised. The oxidising agent is the species that is reduced."}, {"h": "Building a half-equation", "b": "Work in this order. Balance the atoms other than O and H. Add **H₂O** to balance oxygen. Add **H⁺** to balance hydrogen (acidic solution). Add **electrons** to balance charge. Finally check that the charges on both sides match."}, {"h": "Combining half-equations", "b": "Multiply the half-equations so that **electrons gained equal electrons lost**. Add them together. Cancel the electrons, and cancel any H⁺ or H₂O that appears on both sides. Check atoms and **total charge** on each side."}], "example": {"task": "Hydrogen peroxide oxidises iodide ions to iodine in acidic solution. Write the overall ionic equation, building it from half-equations.", "steps": [{"do": "Find oxidation states. In H₂O₂, O is −1; in H₂O it is −2. Iodine is −1 in I⁻ and 0 in I₂.", "why": "Oxygen decreases, so H₂O₂ is reduced. Iodine increases, so I⁻ is oxidised."}, {"do": "Reduction half-equation: H₂O₂ → 2H₂O. Oxygen already balances, so add 2H⁺ to the left to balance hydrogen: H₂O₂ + 2H⁺ → 2H₂O.", "why": "The solution is acidic, so H⁺ balances hydrogen. No extra water is needed."}, {"do": "Balance charge. The left is 2+ and the right is 0, so add 2e⁻ to the left: H₂O₂ + 2H⁺ + 2e⁻ → 2H₂O.", "why": "Electrons are gained in reduction, so they go on the left."}, {"do": "Oxidation half-equation: 2I⁻ → I₂ + 2e⁻.", "why": "Iodine atoms balance, and the 2− charge on the left matches the 2e⁻ on the right."}, {"do": "Both half-equations involve 2e⁻. Add them and cancel the electrons: H₂O₂ + 2H⁺ + 2I⁻ → 2H₂O + I₂.", "why": "Electrons gained equal electrons lost, so none appear in the overall equation."}], "answer": "H₂O₂ + 2H⁺ + 2I⁻ → 2H₂O + I₂. Atoms balance, and the charge is 0 on both sides."}, "selfx": {"q": "Why are 2e⁻ added to the left in the reduction half-equation, H₂O₂ + 2H⁺ + 2e⁻ → 2H₂O?", "o": ["H₂O₂ loses two electrons when it reacts, so they must appear on the left", "They are needed to balance the four hydrogen atoms in 2H₂O", "The left has charge 2+ and the right 0, so two electrons make the charges equal", "Each oxygen atom rises from −1 to 0, so two electrons are removed from the left"], "a": 2, "f": ["H₂O₂ is reduced, so it gains electrons. Losing electrons would be oxidation, and the electrons would then be on the right.", "Electrons balance charge, not atoms. The hydrogen atoms were already balanced by adding 2H⁺.", "Correct: 2+ plus 2− gives 0 on the left, matching 0 on the right. Electrons are added last to balance charge.", "Oxygen goes from −1 to −2, which is a decrease. A decrease in oxidation state means electrons are gained."]}, "faded": {"task": "Acidified dichromate(VI) oxidises Fe²⁺ to Fe³⁺. Write the overall ionic equation, with Cr₂O₇²⁻ going to Cr³⁺.", "given": ["Reduction: Cr₂O₇²⁻ + 14H⁺ + 6e⁻ → 2Cr³⁺ + 7H₂O", "Oxidation: Fe²⁺ → Fe³⁺ + e⁻", "6e⁻ are gained and 1e⁻ is lost, so multiply the oxidation half-equation by 6."], "q": "Add the half-equations and cancel the electrons. Which overall equation is correct?", "o": ["Cr₂O₇²⁻ + 14H⁺ + Fe²⁺ → 2Cr³⁺ + Fe³⁺ + 7H₂O", "Cr₂O₇²⁻ + 14H⁺ + 6Fe²⁺ → 2Cr³⁺ + 6Fe³⁺ + 7H₂O", "Cr₂O₇²⁻ + 14H⁺ + 6Fe²⁺ → 2Cr³⁺ + 6Fe³⁺ + 7H₂O + 6e⁻", "Cr₂O₇²⁻ + 14H⁺ + 3Fe²⁺ → 2Cr³⁺ + 3Fe³⁺ + 7H₂O"], "a": 1, "f": ["The Fe half-equation was not multiplied by 6. The charge is 14+ on the left and 9+ on the right, so it does not balance.", "Correct: the charge is 24+ on each side, and the electrons cancel because 6e⁻ gained equal 6e⁻ lost.", "The electrons were not cancelled. Electrons gained and lost are equal, so they must not appear in the overall equation.", "Multiplying by 3 does not equalise electrons, because 6e⁻ are gained. The charge is 18+ on the left and 15+ on the right."]}, "trap": "Giving oxygen −2 in H₂O₂ when it is −1. Also avoid saying the reducing agent is the species reduced: it is the one oxidised. Check charge as well as atoms.", "recap": "Balance half-equations with H₂O, then H⁺, then e⁻; equalise electrons, add and cancel; the reducing agent is the species that is oxidised."}
{"s": "chem", "t": "3.1.8", "kind": "method", "why": "Born-Haber and ΔG calculations are standard multi-step marks in AQA thermodynamics questions, and a fixed method stops most sign and multiplier slips.", "hook": null, "chunks": [{"h": "Building the cycle", "b": "Hess's law: ΔHf equals the sum of the steps taken via gaseous ions. The steps are **atomisation** (per mole of gaseous atoms), ionisation energies, **electron affinity**, then **lattice enthalpy of formation** (gaseous ions to solid lattice, always exothermic). Rearrange for the unknown."}, {"h": "Count the ions", "b": "Use the formula to decide how many times each step happens. Mg²⁺ needs the **1st and 2nd ionisation energies**. Two Cl⁻ need 2 × ΔHat(Cl) and 2 × EA. For O²⁻ the **2nd electron affinity** is endothermic, because an electron is added to an ion that is already negative."}, {"h": "Feasibility and ΔG", "b": "**ΔG = ΔH − TΔS**. Drag the graph slider: a reaction is **feasible** when ΔG ≤ 0. Match units: ΔS is in J K⁻¹ mol⁻¹, ΔH in kJ mol⁻¹, so convert one (200 J = 0.2 kJ). If ΔH and ΔS are both positive, minimum temperature is T = ΔH/ΔS, in kelvin. Feasible does not mean fast.", "fig": {"type": "graph", "anim": "frames", "x": [0, 1000], "xstep": 200, "y": [-120, 120], "ystep": 40, "xlabel": "Temperature, T / K", "ylabel": "ΔG / kJ mol⁻¹", "lines": [{"c": 1, "pts": [[0.0, 120.0], [1000.0, -80.0]], "label": "ΔH +120, ΔS +200"}, {"c": 0, "pts": [[0.0, -80.0], [1000.0, 120.0]], "label": "ΔH −80, ΔS −200"}, {"dash": true, "c": 3, "pts": [[0, 0], [1000, 0]]}], "points": [{"at": [600, 0], "label": "600 K"}, {"at": [400, 0], "label": "400 K"}], "frames": [{"lines": [], "points": [{"at": [0.0, 120.0], "label": "1"}, {"at": [0.0, -80.0], "label": "2"}], "read": ["T = 0 K", "1: ΔG = 120 − 0.2T = 120 kJ mol⁻¹", "2: ΔG = −80 + 0.2T = −80 kJ mol⁻¹"]}, {"lines": [], "points": [{"at": [50.0, 110.0], "label": "1"}, {"at": [50.0, -70.0], "label": "2"}], "read": ["T = 50 K", "1: ΔG = 120 − 0.2T = 110 kJ mol⁻¹", "2: ΔG = −80 + 0.2T = −70 kJ mol⁻¹"]}, {"lines": [], "points": [{"at": [100.0, 100.0], "label": "1"}, {"at": [100.0, -60.0], "label": "2"}], "read": ["T = 100 K", "1: ΔG = 120 − 0.2T = 100 kJ mol⁻¹", "2: ΔG = −80 + 0.2T = −60 kJ mol⁻¹"]}, {"lines": [], "points": [{"at": [150.0, 90.0], "label": "1"}, {"at": [150.0, -50.0], "label": "2"}], "read": ["T = 150 K", "1: ΔG = 120 − 0.2T = 90 kJ mol⁻¹", "2: ΔG = −80 + 0.2T = −50 kJ mol⁻¹"]}, {"lines": [], "points": [{"at": [200.0, 80.0], "label": "1"}, {"at": [200.0, -40.0], "label": "2"}], "read": ["T = 200 K", "1: ΔG = 120 − 0.2T = 80 kJ mol⁻¹", "2: ΔG = −80 + 0.2T = −40 kJ mol⁻¹"]}, {"lines": [], "points": [{"at": [250.0, 70.0], "label": "1"}, {"at": [250.0, -30.0], "label": "2"}], "read": ["T = 250 K", "1: ΔG = 120 − 0.2T = 70 kJ mol⁻¹", "2: ΔG = −80 + 0.2T = −30 kJ mol⁻¹"]}, {"lines": [], "points": [{"at": [300.0, 60.0], "label": "1"}, {"at": [300.0, -20.0], "label": "2"}], "read": ["T = 300 K", "1: ΔG = 120 − 0.2T = 60 kJ mol⁻¹", "2: ΔG = −80 + 0.2T = −20 kJ mol⁻¹"]}, {"lines": [], "points": [{"at": [350.0, 50.0], "label": "1"}, {"at": [350.0, -10.0], "label": "2"}], "read": ["T = 350 K", "1: ΔG = 120 − 0.2T = 50 kJ mol⁻¹", "2: ΔG = −80 + 0.2T = −10 kJ mol⁻¹"]}, {"lines": [], "points": [{"at": [400.0, 40.0], "label": "1"}, {"at": [400.0, 0.0], "label": "2"}], "read": ["T = 400 K", "1: ΔG = 120 − 0.2T = 40 kJ mol⁻¹", "2: ΔG = −80 + 0.2T = 0 kJ mol⁻¹"]}, {"lines": [], "points": [{"at": [450.0, 30.0], "label": "1"}, {"at": [450.0, 10.0], "label": "2"}], "read": ["T = 450 K", "1: ΔG = 120 − 0.2T = 30 kJ mol⁻¹", "2: ΔG = −80 + 0.2T = 10 kJ mol⁻¹"]}, {"lines": [], "points": [{"at": [500.0, 20.0], "label": "1"}, {"at": [500.0, 20.0], "label": "2"}], "read": ["T = 500 K", "1: ΔG = 120 − 0.2T = 20 kJ mol⁻¹", "2: ΔG = −80 + 0.2T = 20 kJ mol⁻¹"]}, {"lines": [], "points": [{"at": [550.0, 10.0], "label": "1"}, {"at": [550.0, 30.0], "label": "2"}], "read": ["T = 550 K", "1: ΔG = 120 − 0.2T = 10 kJ mol⁻¹", "2: ΔG = −80 + 0.2T = 30 kJ mol⁻¹"]}, {"lines": [], "points": [{"at": [600.0, 0.0], "label": "1"}, {"at": [600.0, 40.0], "label": "2"}], "read": ["T = 600 K", "1: ΔG = 120 − 0.2T = 0 kJ mol⁻¹", "2: ΔG = −80 + 0.2T = 40 kJ mol⁻¹"]}, {"lines": [], "points": [{"at": [650.0, -10.0], "label": "1"}, {"at": [650.0, 50.0], "label": "2"}], "read": ["T = 650 K", "1: ΔG = 120 − 0.2T = −10 kJ mol⁻¹", "2: ΔG = −80 + 0.2T = 50 kJ mol⁻¹"]}, {"lines": [], "points": [{"at": [700.0, -20.0], "label": "1"}, {"at": [700.0, 60.0], "label": "2"}], "read": ["T = 700 K", "1: ΔG = 120 − 0.2T = −20 kJ mol⁻¹", "2: ΔG = −80 + 0.2T = 60 kJ mol⁻¹"]}, {"lines": [], "points": [{"at": [750.0, -30.0], "label": "1"}, {"at": [750.0, 70.0], "label": "2"}], "read": ["T = 750 K", "1: ΔG = 120 − 0.2T = −30 kJ mol⁻¹", "2: ΔG = −80 + 0.2T = 70 kJ mol⁻¹"]}, {"lines": [], "points": [{"at": [800.0, -40.0], "label": "1"}, {"at": [800.0, 80.0], "label": "2"}], "read": ["T = 800 K", "1: ΔG = 120 − 0.2T = −40 kJ mol⁻¹", "2: ΔG = −80 + 0.2T = 80 kJ mol⁻¹"]}, {"lines": [], "points": [{"at": [850.0, -50.0], "label": "1"}, {"at": [850.0, 90.0], "label": "2"}], "read": ["T = 850 K", "1: ΔG = 120 − 0.2T = −50 kJ mol⁻¹", "2: ΔG = −80 + 0.2T = 90 kJ mol⁻¹"]}, {"lines": [], "points": [{"at": [900.0, -60.0], "label": "1"}, {"at": [900.0, 100.0], "label": "2"}], "read": ["T = 900 K", "1: ΔG = 120 − 0.2T = −60 kJ mol⁻¹", "2: ΔG = −80 + 0.2T = 100 kJ mol⁻¹"]}, {"lines": [], "points": [{"at": [950.0, -70.0], "label": "1"}, {"at": [950.0, 110.0], "label": "2"}], "read": ["T = 950 K", "1: ΔG = 120 − 0.2T = −70 kJ mol⁻¹", "2: ΔG = −80 + 0.2T = 110 kJ mol⁻¹"]}, {"lines": [], "points": [{"at": [1000.0, -80.0], "label": "1"}, {"at": [1000.0, 120.0], "label": "2"}], "read": ["T = 1000 K", "1: ΔG = 120 − 0.2T = −80 kJ mol⁻¹", "2: ΔG = −80 + 0.2T = 120 kJ mol⁻¹"]}], "ctl": {"type": "slider", "label": "u", "vals": ["0", "50", "100", "150", "200", "250", "300", "350", "400", "450", "500", "550", "600", "650", "700", "750", "800", "850", "900", "950", "1000"], "start": 4}}}], "example": {"task": "Calculate the lattice enthalpy of formation of MgCl₂ (kJ mol⁻¹): ΔHf −641; ΔHat Mg +148; ΔHat Cl +122; IE1 Mg +738; IE2 Mg +1451; EA Cl −349.", "steps": [{"do": "Write Hess's law: ΔHf = ΔHat(Mg) + IE1 + IE2 + 2ΔHat(Cl) + 2EA(Cl) + ΔHlatt.", "why": "The direct route equals the route via gaseous ions."}, {"do": "Mg terms: +148 + 738 + 1451 = +2337.", "why": "Mg is atomised, then loses two electrons."}, {"do": "Cl terms: 2 × (+122) + 2 × (−349) = +244 − 698 = −454.", "why": "MgCl₂ contains two Cl, so each chlorine step happens twice."}, {"do": "Add the steps: +2337 − 454 = +1883.", "why": "This is everything except the lattice step."}, {"do": "Rearrange: ΔHlatt = −641 − 1883 = −2524.", "why": "ΔHlatt is the only unknown. The negative sign is right because the lattice forms exothermically."}], "answer": "ΔHlatt (lattice enthalpy of formation) of MgCl₂ = −2524 kJ mol⁻¹."}, "selfx": {"q": "Why is the chlorine atomisation term multiplied by 2 in the MgCl₂ cycle?", "o": ["ΔHat(Cl) is defined per mole of Cl₂, so it has to be doubled", "One formula unit of MgCl₂ contains two chlorine atoms, so the step happens twice", "ΔHf is also doubled, so every other term must be doubled to match", "Electron affinity is negative, so the chlorine terms are doubled to balance it"], "a": 1, "f": ["ΔHat is defined per mole of gaseous atoms, not per mole of Cl₂. Doubling comes from the formula, not the definition.", "Correct. Two chlorine atoms are needed per MgCl₂, so atomisation and electron gain each occur twice.", "ΔHf is for one mole of MgCl₂ and is not doubled. Only terms whose species appear twice in the formula are multiplied.", "Sign has no effect on how many times a step occurs. The multiplier comes from the number of Cl⁻ ions in the formula."]}, "faded": {"task": "Find ΔHlatt of Na₂O (kJ mol⁻¹): ΔHf −414; ΔHat Na +107; 1st IE Na +496; ΔHat O +249; 1st EA O −141; 2nd EA O +798.", "given": ["Hess: ΔHf = 2ΔHat(Na) + 2IE1(Na) + ΔHat(O) + EA1(O) + EA2(O) + ΔHlatt", "Na terms: 2 × 107 = +214 and 2 × 496 = +992"], "q": "Next, what is the sum of the three oxygen terms (ΔHat, 1st EA, 2nd EA)?", "o": ["+108", "−690", "+906", "+1812"], "a": 2, "f": ["This leaves out the 2nd electron affinity (+798). Both electron additions are needed to form O²⁻.", "This treats the 2nd EA as exothermic. It is +798, because the electron is added to an ion that is already negative.", "Correct. +249 − 141 + 798 = +906. Only one O is needed per Na₂O, so none is multiplied.", "This doubles the oxygen terms. Na₂O contains one O²⁻ per formula unit, so it is the sodium terms that are doubled."]}, "trap": "Forgetting to multiply by the number of ions in the formula, or leaving out the 2nd ionisation energy or 2nd electron affinity. For ΔG, mixing kJ and J is the other common slip.", "recap": "Sum the steps to gaseous ions, scaled by the formula; ΔHlatt = ΔHf − that sum; feasible when ΔG ≤ 0."}
{"s": "chem", "t": "3.1.9", "kind": "method", "why": "Exam questions here usually ask you to deduce orders from rate data, calculate k with units and use the Arrhenius equation, often set in required practical 7.", "hook": null, "chunks": [{"h": "Finding an order", "b": "The **order** for a reactant is the power of its concentration in the **rate equation**. Change one concentration and keep the others fixed. Then (concentration factor)^order = rate factor. On the graph, doubling [A] leaves the rate unchanged for order 0. It makes rate ×2 for order 1 and rate ×4 for order 2.", "fig": {"type": "graph", "x": [0, 2], "y": [0, 4], "xstep": 0.5, "ystep": 0.5, "xlabel": "[A] / mol dm⁻³", "ylabel": "rate / mol dm⁻³ s⁻¹", "lines": [{"pts": [[0.0, 1.0], [0.0125, 1.0], [0.025, 1.0], [0.0375, 1.0], [0.05, 1.0], [0.0625, 1.0], [0.075, 1.0], [0.0875, 1.0], [0.1, 1.0], [0.1125, 1.0], [0.125, 1.0], [0.1375, 1.0], [0.15, 1.0], [0.1625, 1.0], [0.175, 1.0], [0.1875, 1.0], [0.2, 1.0], [0.2125, 1.0], [0.225, 1.0], [0.2375, 1.0], [0.25, 1.0], [0.2625, 1.0], [0.275, 1.0], [0.2875, 1.0], [0.3, 1.0], [0.3125, 1.0], [0.325, 1.0], [0.3375, 1.0], [0.35, 1.0], [0.3625, 1.0], [0.375, 1.0], [0.3875, 1.0], [0.4, 1.0], [0.4125, 1.0], [0.425, 1.0], [0.4375, 1.0], [0.45, 1.0], [0.4625, 1.0], [0.475, 1.0], [0.4875, 1.0], [0.5, 1.0], [0.5125, 1.0], [0.525, 1.0], [0.5375, 1.0], [0.55, 1.0], [0.5625, 1.0], [0.575, 1.0], [0.5875, 1.0], [0.6, 1.0], [0.6125, 1.0], [0.625, 1.0], [0.6375, 1.0], [0.65, 1.0], [0.6625, 1.0], [0.675, 1.0], [0.6875, 1.0], [0.7, 1.0], [0.7125, 1.0], [0.725, 1.0], [0.7375, 1.0], [0.75, 1.0], [0.7625, 1.0], [0.775, 1.0], [0.7875, 1.0], [0.8, 1.0], [0.8125, 1.0], [0.825, 1.0], [0.8375, 1.0], [0.85, 1.0], [0.8625, 1.0], [0.875, 1.0], [0.8875, 1.0], [0.9, 1.0], [0.9125, 1.0], [0.925, 1.0], [0.9375, 1.0], [0.95, 1.0], [0.9625, 1.0], [0.975, 1.0], [0.9875, 1.0], [1.0, 1.0], [1.0125, 1.0], [1.025, 1.0], [1.0375, 1.0], [1.05, 1.0], [1.0625, 1.0], [1.075, 1.0], [1.0875, 1.0], [1.1, 1.0], [1.1125, 1.0], [1.125, 1.0], [1.1375, 1.0], [1.15, 1.0], [1.1625, 1.0], [1.175, 1.0], [1.1875, 1.0], [1.2, 1.0], [1.2125, 1.0], [1.225, 1.0], [1.2375, 1.0], [1.25, 1.0], [1.2625, 1.0], [1.275, 1.0], [1.2875, 1.0], [1.3, 1.0], [1.3125, 1.0], [1.325, 1.0], [1.3375, 1.0], [1.35, 1.0], [1.3625, 1.0], [1.375, 1.0], [1.3875, 1.0], [1.4, 1.0], [1.4125, 1.0], [1.425, 1.0], [1.4375, 1.0], [1.45, 1.0], [1.4625, 1.0], [1.475, 1.0], [1.4875, 1.0], [1.5, 1.0], [1.5125, 1.0], [1.525, 1.0], [1.5375, 1.0], [1.55, 1.0], [1.5625, 1.0], [1.575, 1.0], [1.5875, 1.0], [1.6, 1.0], [1.6125, 1.0], [1.625, 1.0], [1.6375, 1.0], [1.65, 1.0], [1.6625, 1.0], [1.675, 1.0], [1.6875, 1.0], [1.7, 1.0], [1.7125, 1.0], [1.725, 1.0], [1.7375, 1.0], [1.75, 1.0], [1.7625, 1.0], [1.775, 1.0], [1.7875, 1.0], [1.8, 1.0], [1.8125, 1.0], [1.825, 1.0], [1.8375, 1.0], [1.85, 1.0], [1.8625, 1.0], [1.875, 1.0], [1.8875, 1.0], [1.9, 1.0], [1.9125, 1.0], [1.925, 1.0], [1.9375, 1.0], [1.95, 1.0], [1.9625, 1.0], [1.975, 1.0], [1.9875, 1.0], [2.0, 1.0]], "c": 0, "label": "order 0"}, {"pts": [[0.0, 0.0], [0.0125, 0.0125], [0.025, 0.025], [0.0375, 0.0375], [0.05, 0.05], [0.0625, 0.0625], [0.075, 0.075], [0.0875, 0.0875], [0.1, 0.1], [0.1125, 0.1125], [0.125, 0.125], [0.1375, 0.1375], [0.15, 0.15], [0.1625, 0.1625], [0.175, 0.175], [0.1875, 0.1875], [0.2, 0.2], [0.2125, 0.2125], [0.225, 0.225], [0.2375, 0.2375], [0.25, 0.25], [0.2625, 0.2625], [0.275, 0.275], [0.2875, 0.2875], [0.3, 0.3], [0.3125, 0.3125], [0.325, 0.325], [0.3375, 0.3375], [0.35, 0.35], [0.3625, 0.3625], [0.375, 0.375], [0.3875, 0.3875], [0.4, 0.4], [0.4125, 0.4125], [0.425, 0.425], [0.4375, 0.4375], [0.45, 0.45], [0.4625, 0.4625], [0.475, 0.475], [0.4875, 0.4875], [0.5, 0.5], [0.5125, 0.5125], [0.525, 0.525], [0.5375, 0.5375], [0.55, 0.55], [0.5625, 0.5625], [0.575, 0.575], [0.5875, 0.5875], [0.6, 0.6], [0.6125, 0.6125], [0.625, 0.625], [0.6375, 0.6375], [0.65, 0.65], [0.6625, 0.6625], [0.675, 0.675], [0.6875, 0.6875], [0.7, 0.7], [0.7125, 0.7125], [0.725