 "label": "P"}], "read": ["t = 0.75 s", "v = 4.06 m/s", "a = −4.5 m/s²"]}, {"lines": [], "points": [{"at": [0.875, 3.5156], "label": "P"}], "read": ["t = 0.875 s", "v = 3.52 m/s", "a = −4.25 m/s²"]}, {"lines": [], "points": [{"at": [1.0, 3.0], "label": "P"}], "read": ["t = 1 s", "v = 3 m/s", "a = −4 m/s²"]}, {"lines": [], "points": [{"at": [1.125, 2.5156], "label": "P"}], "read": ["t = 1.125 s", "v = 2.52 m/s", "a = −3.75 m/s²"]}, {"lines": [], "points": [{"at": [1.25, 2.0625], "label": "P"}], "read": ["t = 1.25 s", "v = 2.06 m/s", "a = −3.5 m/s²"]}, {"lines": [], "points": [{"at": [1.375, 1.6406], "label": "P"}], "read": ["t = 1.375 s", "v = 1.64 m/s", "a = −3.25 m/s²"]}, {"lines": [], "points": [{"at": [1.5, 1.25], "label": "P"}], "read": ["t = 1.5 s", "v = 1.25 m/s", "a = −3 m/s²"]}, {"lines": [], "points": [{"at": [1.625, 0.8906], "label": "P"}], "read": ["t = 1.625 s", "v = 0.89 m/s", "a = −2.75 m/s²"]}, {"lines": [], "points": [{"at": [1.75, 0.5625], "label": "P"}], "read": ["t = 1.75 s", "v = 0.56 m/s", "a = −2.5 m/s²"]}, {"lines": [], "points": [{"at": [1.875, 0.2656], "label": "P"}], "read": ["t = 1.875 s", "v = 0.27 m/s", "a = −2.25 m/s²"]}, {"lines": [], "points": [{"at": [2.0, 0.0], "label": "P"}], "read": ["t = 2 s", "v = 0 m/s", "a = −2 m/s²"]}, {"lines": [], "points": [{"at": [2.125, -0.2344], "label": "P"}], "read": ["t = 2.125 s", "v = −0.23 m/s", "a = −1.75 m/s²"]}, {"lines": [], "points": [{"at": [2.25, -0.4375], "label": "P"}], "read": ["t = 2.25 s", "v = −0.44 m/s", "a = −1.5 m/s²"]}, {"lines": [], "points": [{"at": [2.375, -0.6094], "label": "P"}], "read": ["t = 2.375 s", "v = −0.61 m/s", "a = −1.25 m/s²"]}, {"lines": [], "points": [{"at": [2.5, -0.75], "label": "P"}], "read": ["t = 2.5 s", "v = −0.75 m/s", "a = −1 m/s²"]}, {"lines": [], "points": [{"at": [2.625, -0.8594], "label": "P"}], "read": ["t = 2.625 s", "v = −0.86 m/s", "a = −0.75 m/s²"]}, {"lines": [], "points": [{"at": [2.75, -0.9375], "label": "P"}], "read": ["t = 2.75 s", "v = −0.94 m/s", "a = −0.5 m/s²"]}, {"lines": [], "points": [{"at": [2.875, -0.9844], "label": "P"}], "read": ["t = 2.875 s", "v = −0.98 m/s", "a = −0.25 m/s²"]}, {"lines": [], "points": [{"at": [3.0, -1.0], "label": "P"}], "read": ["t = 3 s", "v = −1 m/s", "a = 0 m/s²"]}], "ctl": {"type": "play", "label": "p", "vals": ["0", "0.125", "0.25", "0.375", "0.5", "0.625", "0.75", "0.875", "1", "1.125", "1.25", "1.375", "1.5", "1.625", "1.75", "1.875", "2", "2.125", "2.25", "2.375", "2.5", "2.625", "2.75", "2.875", "3"], "start": 0}}}, "selfx": {"q": "Why does the solution split the motion at $t=2$ instead of working out $s(3)-s(0)$?", "o": ["Because $t=2$ is the halfway point of the first 3 seconds", "Because $v$ changes sign at $t=2$, so later motion cancels some earlier motion", "Because the constant of integration is only valid up to $t=2$", "Because $a=0$ at $t=2$, so the particle stops accelerating"], "a": 1, "f": ["Wrong. The split comes from where $v=0$, not from the middle of the interval. Time $t=1.5$ would be the midpoint.", "Right. At $t=2$ the velocity changes from positive to negative, so the particle turns round. Integrating across it gives displacement, $6$, not distance.", "Wrong. The constant $c$ applies for all $t$. It is found once from $s(0)=0$ and does not change at $t=2$.", "Wrong. Here $a=2t-6$, which is $0$ at $t=3$, not $t=2$. Turning points depend on $v=0$, not on $a=0$."]}, "faded": {"task": "The graph shows $v=t^2-5t+4$ m s⁻¹ for $0\\le t\\le2$ for a particle on a line. It starts at O. Find the total distance travelled in the 2 seconds.", "given": ["$v=(t-1)(t-4)=0$ gives $t=1$ or $4$. Only $t=1$ is in the interval.", "$s=\\frac{t^3}{3}-\\frac{5t^2}{2}+4t$, using $s(0)=0$.", "$s(1)=\\frac{1}{3}-\\frac{5}{2}+4=\\frac{11}{6}$ m."], "q": "What is the next step?", "o": ["$s(2)=\\frac{2}{3}$, so the distance is $\\frac{2}{3}$ m", "$s(2)=\\frac{2}{3}$, so the distance is $\\frac{11}{6}+\\frac{2}{3}=\\frac{5}{2}$ m", "$s(2)=\\frac{2}{3}$, so the distance is $\\frac{11}{6}+\\left(\\frac{11}{6}-\\frac{2}{3}\\right)=3$ m", "$s(2)=\\frac{2}{3}$, so the distance is $\\frac{11}{6}-\\frac{2}{3}=\\frac{7}{6}$ m"], "a": 2, "f": ["Wrong. $s(2)$ is the displacement. The particle turned round at $t=1$, so the distance is larger.", "Wrong. This adds the positions $s(1)$ and $s(2)$. You must add the sizes of the changes in $s$ for each section.", "Right. The first section is $\\frac{11}{6}$ m. The second is $\\left|\\frac{2}{3}-\\frac{11}{6}\\right|=\\frac{7}{6}$ m. The sum is $\\frac{18}{6}=3$ m.", "Wrong. This is only the size of the second section. The first section, $\\frac{11}{6}$ m, is missing from the total."], "fig": {"type": "graph", "x": [0, 2], "y": [-2, 4], "xstep": 0.5, "ystep": 1, "xlabel": "time / s", "ylabel": "velocity / m s⁻¹", "lines": [{"pts": [[0.0, 4.0], [0.0125, 3.937656], [0.025, 3.875625], [0.0375, 3.813906], [0.05, 3.7525], [0.0625, 3.691406], [0.075, 3.630625], [0.0875, 3.570156], [0.1, 3.51], [0.1125, 3.450156], [0.125, 3.390625], [0.1375, 3.331406], [0.15, 3.2725], [0.1625, 3.213906], [0.175, 3.155625], [0.1875, 3.097656], [0.2, 3.04], [0.2125, 2.982656], [0.225, 2.925625], [0.2375, 2.868906], [0.25, 2.8125], [0.2625, 2.756406], [0.275, 2.700625], [0.2875, 2.645156], [0.3, 2.59], [0.3125, 2.535156], [0.325, 2.480625], [0.3375, 2.426406], [0.35, 2.3725], [0.3625, 2.318906], [0.375, 2.265625], [0.3875, 2.212656], [0.4, 2.16], [0.4125, 2.107656], [0.425, 2.055625], [0.4375, 2.003906], [0.45, 1.9525], [0.4625, 1.901406], [0.475, 1.850625], [0.4875, 1.800156], [0.5, 1.75], [0.5125, 1.700156], [0.525, 1.650625], [0.5375, 1.601406], [0.55, 1.5525], [0.5625, 1.503906], [0.575, 1.455625], [0.5875, 1.407656], [0.6, 1.36], [0.6125, 1.312656], [0.625, 1.265625], [0.6375, 1.218906], [0.65, 1.1725], [0.6625, 1.126406], [0.675, 1.080625], [0.6875, 1.035156], [0.7, 0.99], [0.7125, 0.945156], [0.725, 0.900625], [0.7375, 0.856406], [0.75, 0.8125], [0.7625, 0.768906], [0.775, 0.725625], [0.7875, 0.682656], [0.8, 0.64], [0.8125, 0.597656], [0.825, 0.555625], [0.8375, 0.513906], [0.85, 0.4725], [0.8625, 0.431406], [0.875, 0.390625], [0.8875, 0.350156], [0.9, 0.31], [0.9125, 0.270156], [0.925, 0.230625], [0.9375, 0.191406], [0.95, 0.1525], [0.9625, 0.113906], [0.975, 0.075625], [0.9875, 0.037656], [1.0, 0.0], [1.0125, -0.037344], [1.025, -0.074375], [1.0375, -0.111094], [1.05, -0.1475], [1.0625, -0.183594], [1.075, -0.219375], [1.0875, -0.254844], [1.1, -0.29], [1.1125, -0.324844], [1.125, -0.359375], [1.1375, -0.393594], [1.15, -0.4275], [1.1625, -0.461094], [1.175, -0.494375], [1.1875, -0.527344], [1.2, -0.56], [1.2125, -0.592344], [1.225, -0.624375], [1.2375, -0.656094], [1.25, -0.6875], [1.2625, -0.718594], [1.275, -0.749375], [1.2875, -0.779844], [1.3, -0.81], [1.3125, -0.839844], [1.325, -0.869375], [1.3375, -0.898594], [1.35, -0.9275], [1.3625, -0.956094], [1.375, -0.984375], [1.3875, -1.012344], [1.4, -1.04], [1.4125, -1.067344], [1.425, -1.094375], [1.4375, -1.121094], [1.45, -1.1475], [1.4625, -1.173594], [1.475, -1.199375], [1.4875, -1.224844], [1.5, -1.25], [1.5125, -1.274844], [1.525, -1.299375], [1.5375, -1.323594], [1.55, -1.3475], [1.5625, -1.371094], [1.575, -1.394375], [1.5875, -1.417344], [1.6, -1.44], [1.6125, -1.462344], [1.625, -1.484375], [1.6375, -1.506094], [1.65, -1.5275], [1.6625, -1.548594], [1.675, -1.569375], [1.6875, -1.589844], [1.7, -1.61], [1.7125, -1.629844], [1.725, -1.649375], [1.7375, -1.668594], [1.75, -1.6875], [1.7625, -1.706094], [1.775, -1.724375], [1.7875, -1.742344], [1.8, -1.76], [1.8125, -1.777344], [1.825, -1.794375], [1.8375, -1.811094], [1.85, -1.8275], [1.8625, -1.843594], [1.875, -1.859375], [1.8875, -1.874844], [1.9, -1.89], [1.9125, -1.904844], [1.925, -1.919375], [1.9375, -1.933594], [1.95, -1.9475], [1.9625, -1.961094], [1.975, -1.974375], [1.9875, -1.987344], [2.0, -2.0]], "c": 0}], "points": [{"at": [0, 4], "label": "v=4"}, {"at": [1, 0], "label": "v=0"}, {"at": [2, -2], "label": "v=-2"}]}}, "trap": "Integrating $v$ from the start to the end gives displacement. If $v$ changes sign, find $v=0$, work out each section separately, and add the positive sizes.", "recap": "For distance, solve $v=0$, find $s$ at each turning point, and add the positive size of every section's change."}
{"s": "maths", "t": "m2-04", "kind": "method", "why": "Moments questions appear in the mechanics papers, usually as rods or beams on supports or hinged to a wall, and one reliable method solves them all.", "hook": null, "chunks": [{"h": "Moment of a force", "b": "The **moment** of a force about a point is the force multiplied by the **perpendicular distance** from that point to the line of action of the force. It is measured in N m. It measures turning effect, so state whether it is **clockwise** or anticlockwise."}, {"h": "Equilibrium of a rod", "b": "A rod in **equilibrium** has no resultant force and no resultant turning effect. So the clockwise moments equal the anticlockwise moments about **any point**. You can also resolve forces: for a horizontal rod with vertical forces, upward forces equal downward forces."}, {"h": "Modelling words", "b": "**Uniform**: the weight acts at the midpoint. **Light**: the weight is zero, so ignore it. **Rigid**: the rod does not bend. A person or load is a particle, a point mass at its position. Never treat uniform and light as the same."}, {"h": "Choosing the pivot", "b": "Take moments about the point where an **unknown force** acts. Its distance is zero, so it drops out. A rod is **about to tilt** about a support when the reaction at the other support is **zero**. For an angled force, use the perpendicular distance, such as $L\\sin\\theta$."}], "example": {"task": "A uniform plank AB, length 6 m and mass 20 kg, rests horizontally on supports at C and D, AC = 1 m, DB = 1 m. A 40 kg person stands 2 m from B. Find both reactions (g = 9.8). Drag the graph slider to move the person.", "steps": [{"do": "Mark the forces: plank weight 20g at 3 m from A, person's weight 40g at 4 m from A, R_C at 1 m from A, R_D at 5 m from A.", "why": "Uniform means the plank's weight acts at its midpoint."}, {"do": "Take moments about C. Distances from C: plank weight 2 m, person 3 m, R_D 4 m.", "why": "R_C acts through C, so it has no moment and drops out."}, {"do": "Both weights turn one way and R_D the other: 4R_D = 20g × 2 + 40g × 3 = 160g. So R_D = 40g = 392 N.", "why": "In equilibrium, clockwise moments equal anticlockwise moments."}, {"do": "Resolve vertically: R_C + R_D = 20g + 40g = 588. So R_C = 588 − 392 = 196 N.", "why": "Equilibrium also needs upward forces to equal downward forces."}], "answer": "R_D = 392 N and R_C = 196 N. Check: moments about D give 4R_C = 20g × 2 + 40g × 1 = 80g, so R_C = 20g = 196 N.", "fig": {"type": "graph", "anim": "frames", "x": [0, 6], "xstep": 1, "y": [0, 700], "ystep": 100, "xlabel": "Person's distance from A / m", "ylabel": "Reaction / N", "lines": [{"c": 0, "pts": [[0.0, 588.0], [6.0, 0.0]], "label": "R_C"}, {"c": 1, "pts": [[0.0, 0.0], [6.0, 588.0]], "label": "R_D"}, {"dash": true, "c": 2, "label": "Total 588 N", "pts": [[0, 588], [6, 588]]}], "points": [], "frames": [{"lines": [{"dash": true, "c": 3, "pts": [[0.0, 0.0], [0.0, 588.0]]}], "points": [{"at": [0.0, 588.0], "label": "R_C"}, {"at": [0.0, 0.0], "label": "R_D"}], "read": ["Person 0 m from A", "R_C = 588 N, R_D = 0 N", "R_C + R_D = 588 N"]}, {"lines": [{"dash": true, "c": 3, "pts": [[0.5, 0.0], [0.5, 588.0]]}], "points": [{"at": [0.5, 539.0], "label": "R_C"}, {"at": [0.5, 49.0], "label": "R_D"}], "read": ["Person 0.5 m from A", "R_C = 539 N, R_D = 49 N", "R_C + R_D = 588 N"]}, {"lines": [{"dash": true, "c": 3, "pts": [[1.0, 0.0], [1.0, 588.0]]}], "points": [{"at": [1.0, 490.0], "label": "R_C"}, {"at": [1.0, 98.0], "label": "R_D"}], "read": ["Person 1 m from A", "R_C = 490 N, R_D = 98 N", "R_C + R_D = 588 N"]}, {"lines": [{"dash": true, "c": 3, "pts": [[1.5, 0.0], [1.5, 588.0]]}], "points": [{"at": [1.5, 441.0], "label": "R_C"}, {"at": [1.5, 147.0], "label": "R_D"}], "read": ["Person 1.5 m from A", "R_C = 441 N, R_D = 147 N", "R_C + R_D = 588 N"]}, {"lines": [{"dash": true, "c": 3, "pts": [[2.0, 0.0], [2.0, 588.0]]}], "points": [{"at": [2.0, 392.0], "label": "R_C"}, {"at": [2.0, 196.0], "label": "R_D"}], "read": ["Person 2 m from A", "R_C = 392 N, R_D = 196 N", "R_C + R_D = 588 N"]}, {"lines": [{"dash": true, "c": 3, "pts": [[2.5, 0.0], [2.5, 588.0]]}], "points": [{"at": [2.5, 343.0], "label": "R_C"}, {"at": [2.5, 245.0], "label": "R_D"}], "read": ["Person 2.5 m from A", "R_C = 343 N, R_D = 245 N", "R_C + R_D = 588 N"]}, {"lines": [{"dash": true, "c": 3, "pts": [[3.0, 0.0], [3.0, 588.0]]}], "points": [{"at": [3.0, 294.0], "label": "R_C"}, {"at": [3.0, 294.0], "label": "R_D"}], "read": ["Person 3 m from A", "R_C = 294 N, R_D = 294 N", "R_C + R_D = 588 N"]}, {"lines": [{"dash": true, "c": 3, "pts": [[3.5, 0.0], [3.5, 588.0]]}], "points": [{"at": [3.5, 245.0], "label": "R_C"}, {"at": [3.5, 343.0], "label": "R_D"}], "read": ["Person 3.5 m from A", "R_C = 245 N, R_D = 343 N", "R_C + R_D = 588 N"]}, {"lines": [{"dash": true, "c": 3, "pts": [[4.0, 0.0], [4.0, 588.0]]}], "points": [{"at": [4.0, 196.0], "label": "R_C"}, {"at": [4.0, 392.0], "label": "R_D"}], "read": ["Person 4 m from A", "R_C = 196 N, R_D = 392 N", "R_C + R_D = 588 N"]}, {"lines": [{"dash": true, "c": 3, "pts": [[4.5, 0.0], [4.5, 588.0]]}], "points": [{"at": [4.5, 147.0], "label": "R_C"}, {"at": [4.5, 441.0], "label": "R_D"}], "read": ["Person 4.5 m from A", "R_C = 147 N, R_D = 441 N", "R_C + R_D = 588 N"]}, {"lines": [{"dash": true, "c": 3, "pts": [[5.0, 0.0], [5.0, 588.0]]}], "points": [{"at": [5.0, 98.0], "label": "R_C"}, {"at": [5.0, 490.0], "label": "R_D"}], "read": ["Person 5 m from A", "R_C = 98 N, R_D = 490 N", "R_C + R_D = 588 N"]}, {"lines": [{"dash": true, "c": 3, "pts": [[5.5, 0.0], [5.5, 588.0]]}], "points": [{"at": [5.5, 49.0], "label": "R_C"}, {"at": [5.5, 539.0], "label": "R_D"}], "read": ["Person 5.5 m from A", "R_C = 49 N, R_D = 539 N", "R_C + R_D = 588 N"]}, {"lines": [{"dash": true, "c": 3, "pts": [[6.0, 0.0], [6.0, 588.0]]}], "points": [{"at": [6.0, 0.0], "label": "R_C"}, {"at": [6.0, 588.0], "label": "R_D"}], "read": ["Person 6 m from A", "R_C = 0 N, R_D = 588 N", "R_C + R_D = 588 N"]}], "ctl": {"type": "slider", "label": "p", "vals": ["0", "0.5", "1", "1.5", "2", "2.5", "3", "3.5", "4", "4.5", "5", "5.5", "6"], "start": 8}}}, "selfx": {"q": "Why were moments taken about C in step 2 rather than about the plank's midpoint?", "o": ["Moments can only be taken about a support in equilibrium problems", "R_C acts through C, so its moment is zero and only R_D is unknown", "The reaction at C is zero whenever moments are taken about C", "The plank's weight has no moment about C, so it can be ignored"], "a": 1, "f": ["Wrong. In equilibrium you may take moments about any point. C is chosen for convenience, not because it is the only allowed point.", "Right. The line of action of R_C passes through C, so its perpendicular distance is zero. One equation then contains only R_D.", "Wrong. R_C is not zero. Its moment about C is zero, because the distance is zero. Confusing force with moment is the slip here.", "Wrong. The weight acts 2 m from C, so it has a moment. Ignoring it would give the wrong R_D."]}, "faded": {"task": "A uniform beam PQ, length 6 m and mass 12 kg, rests on supports at P and R, where PR = 4 m. A 4 kg mass hangs from Q. Find the reaction at R. Use g = 9.8.", "given": ["Take moments about P, so the reaction at P drops out.", "Distances from P: beam's weight 12g at 3 m, the 4 kg mass's weight 4g at 6 m, R at 4 m."], "q": "Which moments equation comes next?", "o": ["4R = 12g × 3 + 4g × 4", "6R = 12g × 3 + 4g × 6", "4R = 12g × 3 + 4g × 6", "4R = 12g × 3 − 4g × 6"], "a": 2, "f": ["Wrong. The 4 kg mass hangs from Q, 6 m from P. Using 4 m uses the position of R, not of the mass.", "Wrong. R is 4 m from P, not 6 m. Using the beam's length for the reaction's distance is the slip.", "Right. Both weights turn the same way about P, and R turns the other way. So 4R = 36g + 24g = 60g, giving R = 15g = 147 N.", "Wrong. Both weights are on the same side of P, so their moments add. Subtracting treats them as opposing."]}, "trap": "Using the distance along the rod for an angled force. Moments need the perpendicular distance. For a string at angle θ to a rod of length L, that distance is L sin θ.", "recap": "In equilibrium, clockwise moments equal anticlockwise moments about any point, so take moments about the point where an unknown force acts."}
{"s": "maths", "t": "m2-05", "kind": "method", "why": "Paper 2 mechanics questions often hinge on resolving forces to find the normal reaction R first, then using friction, and this earns most of the marks.", "hook": null, "chunks": [{"h": "Resolving a force", "b": "To **resolve** a force $P$ at angle $\\theta$ to a direction, take its **component** $P\\cos\\theta$ along that direction and $P\\sin\\theta$ perpendicular to it. Check which angle you are given. Choose two perpendicular directions and resolve every force into them. Use one **sign convention** throughout."}, {"h": "Resultants and equilibrium", "b": "The **resultant** is found by adding components in each direction to give totals $X$ and $Y$. Its magnitude is $\\sqrt{X^2+Y^2}$, and its direction comes from $\\tan^{-1}$ of the components. In **equilibrium** the resultant is zero, so the components sum to zero in each direction. Otherwise, use $F=ma$ in each direction."}, {"h": "The friction model", "b": "**Friction** opposes motion, or the tendency to move. It satisfies $F\\le\\mu R$, where $\\mu$ is the **coefficient of friction** and $R$ the normal reaction. On the graph, drag the slider: $F$ equals the push $P$ until it reaches **limiting friction**, $F=\\mu R$. This applies only when about to slip or sliding (the flat part). Before that, $F$ balances the other forces.", "fig": {"type": "graph", "anim": "frames", "x": [0, 8], "y": [0, 6], "xstep": 1, "ystep": 1, "xlabel": "applied horizontal force P (N)", "ylabel": "friction force F (N)", "lines": [{"label": "F", "c": 0, "pts": [[0, 0], [4, 4], [8, 4]]}, {"dash": true, "label": "F = P if no limit", "c": 1, "pts": [[0, 0], [6, 6]]}], "points": [{"at": [4, 4], "label": "F = μR"}], "frames": [{"lines": [], "points": [{"at": [0.0, 0.0], "label": "now"}], "read": ["P = 0 N", "F = 0 N"]}, {"lines": [], "points": [{"at": [0.5, 0.5], "label": "now"}], "read": ["P = 0.5 N", "F = 0.5 N"]}, {"lines": [], "points": [{"at": [1.0, 1.0], "label": "now"}], "read": ["P = 1 N", "F = 1 N"]}, {"lines": [], "points": [{"at": [1.5, 1.5], "label": "now"}], "read": ["P = 1.5 N", "F = 1.5 N"]}, {"lines": [], "points": [{"at": [2.0, 2.0], "label": "now"}], "read": ["P = 2 N", "F = 2 N"]}, {"lines": [], "points": [{"at": [2.5, 2.5], "label": "now"}], "read": ["P = 2.5 N", "F = 2.5 N"]}, {"lines": [], "points": [{"at": [3.0, 3.0], "label": "now"}], "read": ["P = 3 N", "F = 3 N"]}, {"lines": [], "points": [{"at": [3.5, 3.5], "label": "now"}], "read": ["P = 3.5 N", "F = 3.5 N"]}, {"lines": [], "points": [{"at": [4.0, 4.0], "label": "now"}], "read": ["P = 4 N", "F = 4 N"]}, {"lines": [], "points": [{"at": [4.5, 4.0], "label": "now"}], "read": ["P = 4.5 N", "F = 4 N"]}, {"lines": [], "points": [{"at": [5.0, 4.0], "label": "now"}], "read": ["P = 5 N", "F = 4 N"]}, {"lines": [], "points": [{"at": [5.5, 4.0], "label": "now"}], "read": ["P = 5.5 N", "F = 4 N"]}, {"lines": [], "points": [{"at": [6.0, 4.0], "label": "now"}], "read": ["P = 6 N", "F = 4 N"]}, {"lines": [], "points": [{"at": [6.5, 4.0], "label": "now"}], "read": ["P = 6.5 N", "F = 4 N"]}, {"lines": [], "points": [{"at": [7.0, 4.0], "label": "now"}], "read": ["P = 7 N", "F = 4 N"]}, {"lines": [], "points": [{"at": [7.5, 4.0], "label": "now"}], "read": ["P = 7.5 N", "F = 4 N"]}, {"lines": [], "points": [{"at": [8.0, 4.0], "label": "now"}], "read": ["P = 8 N", "F = 4 N"]}], "ctl": {"type": "slider", "label": "p", "vals": ["0", "0.5", "1", "1.5", "2", "2.5", "3", "3.5", "4", "4.5", "5", "5.5", "6", "6.5", "7", "7.5", "8"], "start": 0}}}, {"h": "Finding R first", "b": "The **normal reaction** $R$ acts perpendicular to the surface, so resolve perpendicular to the surface to find it. It is not always $mg$. On a slope with no other forces, $R=mg\\cos\\theta$, where $\\theta$ is the **angle of the slope**. With a rope pulling partly upwards, $R$ is smaller than $mg$. Then resolve along the surface for $F$."}], "example": {"task": "An 8 kg box on rough horizontal ground is pulled by a rope at 30° above the horizontal with tension 50 N. The box is on the point of slipping. Find $\\mu$. Use $g=9.8$.", "steps": [{"do": "Mark the forces: weight $8g$ down, $R$ up, tension 50 N at 30° above the horizontal, and friction $F$ opposing the slipping.", "why": "A complete force list stops you missing or misplacing a force."}, {"do": "Resolve vertically: $R+50\\sin30^\\circ=8\\times9.8$.", "why": "There is no vertical acceleration, so upward forces equal downward forces."}, {"do": "$R=78.4-25=53.4$ N.", "why": "R is less than $mg$ because the rope supports part of the weight."}, {"do": "Resolve horizontally: $F=50\\cos30^\\circ\\approx43.30$ N.", "why": "The box is not accelerating, so friction balances the horizontal component of the tension."}, {"do": "Use $F=\\mu R$: $\\mu=\\dfrac{43.30}{53.4}\\approx0.81$.", "why": "On the point of slipping, friction is at its maximum, so equality holds."}], "answer": "$\\mu\\approx0.81$ (to 2 d.p.)"}, "selfx": {"q": "Why does the worked example find $R$ from the vertical equation before using friction?", "o": ["Friction acts vertically, so the vertical forces must be dealt with first", "$R$ is unknown but needed for $\\mu R$, and the vertical equation gives it", "$R$ always equals $mg$, so the vertical equation is a quick check", "Vertical forces must always be resolved before horizontal ones in any problem"], "a": 1, "f": ["Friction acts along the surface, here horizontally. The vertical equation is used for R, not for friction.", "Correct. $F=\\mu R$ needs $R$. With no vertical acceleration, the vertical forces balance, which gives $R$.", "$R=mg$ only when no other vertical forces act. Here the rope's vertical component changes R.", "There is no fixed order rule. You resolve perpendicular to the surface first here because R is needed."]}, "faded": {"task": "A 4 kg box on rough horizontal ground is pushed by a 30 N force at 25° below the horizontal. Find $R$. Use $g=9.8$.", "given": ["Forces: weight $4g$ down, $R$ up, 30 N at 25° below the horizontal, friction $F$.", "No vertical acceleration, so forces up = forces down."], "q": "Which vertical equation comes next?", "o": ["$R=4\\times9.8-30\\sin25^\\circ$", "$R=4\\times9.8+30\\cos25^\\circ$", "$R=4\\times9.8+30\\sin25^\\circ$", "$R=4\\times9.8$"], "a": 2, "f": ["The push is directed downwards, so its vertical component adds to the downward forces. Subtracting it is a sign error.", "$\\cos25^\\circ$ gives the horizontal component here. The vertical component of a force at 25° to the horizontal is $30\\sin25^\\circ$.", "Correct. $R$ balances the weight plus the downward component of the push: $R=39.2+30\\sin25^\\circ\\approx51.9$ N.", "This assumes $R=mg$. The downward push adds to the load on the ground, so $R$ is larger."]}, "trap": "Assuming $R=mg$ every time. A rope, a push or a slope changes R. Resolve perpendicular to the surface to find it, and use $F=\\mu R$ only when friction is limiting.", "recap": "Find $R$ by resolving perpendicular to the surface, then use $F=\\mu R$ only when the object is about to slip or is sliding."}
{"s": "maths", "t": "m2-06", "kind": "method", "why": "Projectile questions appear in Paper 2 mechanics, usually asking for time, range, maximum height or velocity, and all are solved by splitting the motion in two.", "hook": null, "chunks": [{"h": "Split the motion", "b": "Resolve the initial velocity into a **horizontal component** $u\\cos\\alpha$ and a **vertical component** $u\\sin\\alpha$. The two motions are independent. The only quantity they share is the **time** of flight."}, {"h": "Two separate models", "b": "Horizontally, $a=0$, so the velocity is constant and $x=u\\cos\\alpha\\,t$. Vertically, the acceleration is $g$ downwards, so use **suvat** with $a=-g$ (up positive). The model assumes a **particle**, no air resistance and constant $g$."}, {"h": "Find the time first", "b": "Use the vertical motion to find $t$. Choose the sign of the **displacement** $s$ carefully: final height minus starting height. For landing on level ground, solve $s=0$, giving $t=\\frac{2u\\sin\\alpha}{g}$. Put $t$ into the horizontal equation to find the **range**. Drag the slider (graph: $u=14$, $g=9.8$, level ground) to change α. Which angle gives the greatest range?", "fig": {"type": "graph", "anim": "frames", "x": [0, 24], "xstep": 4, "y": [0, 10], "ystep": 2, "xlabel": "horizontal distance x / m", "ylabel": "height y / m", "lines": [{"dash": true, "c": 1, "pts": [[0.0, 0.0], [0.125, 0.1242], [0.25, 0.2469], [0.375, 0.368], [0.5, 0.4875], [0.625, 0.6055], [0.75, 0.7219], [0.875, 0.8367], [1.0, 0.95], [1.125, 1.0617], [1.25, 1.1719], [1.375, 1.2805], [1.5, 1.3875], [1.625, 1.493], [1.75, 1.5969], [1.875, 1.6992], [2.0, 1.8], [2.125, 1.8992], [2.25, 1.9969], [2.375, 2.093], [2.5, 2.1875], [2.625, 2.2805], [2.75, 2.3719], [2.875, 2.4617], [3.0, 2.55], [3.125, 2.6367], [3.25, 2.7219], [3.375, 2.8055], [3.5, 2.8875], [3.625, 2.968], [3.75, 3.0469], [3.875, 3.1242], [4.0, 3.2], [4.125, 3.2742], [4.25, 3.3469], [4.375, 3.418], [4.5, 3.4875], [4.625, 3.5555], [4.75, 3.6219], [4.875, 