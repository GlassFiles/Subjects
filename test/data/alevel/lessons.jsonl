2], [3.5625, -0.5525], [3.5938, -0.2467], [3.625, 0.0723], [3.6562, 0.4047], [3.6875, 0.7507], [3.7188, 1.1106], [3.75, 1.4844], [3.7812, 1.8723], [3.8125, 2.2747], [3.8438, 2.6915], [3.875, 3.123], [3.9062, 3.5695], [3.9375, 4.031], [3.9688, 4.5078], [4.0, 5.0]], "label": "y = x³ − 4x² + 5"}], "points": [], "frames": [{"lines": [{"dash": true, "c": 1, "pts": [[-1.0, 0.0], [4.0, 55.0]]}], "points": [{"at": [-1.0, 0.0], "label": "P"}], "read": ["x = −1", "dy/dx = 11", "d²y/dx² = −14"]}, {"lines": [{"dash": true, "c": 1, "pts": [[-1.0, 0.406], [4.0, 38.844]]}], "points": [{"at": [-0.75, 2.3281], "label": "P"}], "read": ["x = −0.75", "dy/dx = 7.69", "d²y/dx² = −12.5"]}, {"lines": [{"dash": true, "c": 1, "pts": [[-1.0, 1.5], [4.0, 25.25]]}], "points": [{"at": [-0.5, 3.875], "label": "P"}], "read": ["x = −0.5", "dy/dx = 4.75", "d²y/dx² = −11"]}, {"lines": [{"dash": true, "c": 1, "pts": [[-1.0, 3.094], [4.0, 14.031]]}], "points": [{"at": [-0.25, 4.7344], "label": "P"}], "read": ["x = −0.25", "dy/dx = 2.19", "d²y/dx² = −9.5"]}, {"lines": [{"dash": true, "c": 1, "pts": [[-1.0, 5.0], [4.0, 5.0]]}], "points": [{"at": [0.0, 5.0], "label": "P"}], "read": ["x = 0", "dy/dx = 0", "d²y/dx² = −8"]}, {"lines": [{"dash": true, "c": 1, "pts": [[-1.0, 7.031], [4.0, -2.031]]}], "points": [{"at": [0.25, 4.7656], "label": "P"}], "read": ["x = 0.25", "dy/dx = −1.81", "d²y/dx² = −6.5"]}, {"lines": [{"dash": true, "c": 1, "pts": [[-1.0, 9.0], [4.0, -7.25]]}], "points": [{"at": [0.5, 4.125], "label": "P"}], "read": ["x = 0.5", "dy/dx = −3.25", "d²y/dx² = −5"]}, {"lines": [{"dash": true, "c": 1, "pts": [[-1.0, 10.719], [4.0, -10.844]]}], "points": [{"at": [0.75, 3.1719], "label": "P"}], "read": ["x = 0.75", "dy/dx = −4.31", "d²y/dx² = −3.5"]}, {"lines": [{"dash": true, "c": 1, "pts": [[-1.0, 12.0], [4.0, -13.0]]}], "points": [{"at": [1.0, 2.0], "label": "P"}], "read": ["x = 1", "dy/dx = −5", "d²y/dx² = −2"]}, {"lines": [{"dash": true, "c": 1, "pts": [[-1.0, 12.656], [4.0, -13.906]]}], "points": [{"at": [1.25, 0.7031], "label": "P"}], "read": ["x = 1.25", "dy/dx = −5.31", "d²y/dx² = −0.5"]}, {"lines": [{"dash": true, "c": 1, "pts": [[-1.0, 12.5], [4.0, -13.75]]}], "points": [{"at": [1.5, -0.625], "label": "P"}], "read": ["x = 1.5", "dy/dx = −5.25", "d²y/dx² = 1"]}, {"lines": [{"dash": true, "c": 1, "pts": [[-1.0, 11.344], [4.0, -12.719]]}], "points": [{"at": [1.75, -1.8906], "label": "P"}], "read": ["x = 1.75", "dy/dx = −4.81", "d²y/dx² = 2.5"]}, {"lines": [{"dash": true, "c": 1, "pts": [[-1.0, 9.0], [4.0, -11.0]]}], "points": [{"at": [2.0, -3.0], "label": "P"}], "read": ["x = 2", "dy/dx = −4", "d²y/dx² = 4"]}, {"lines": [{"dash": true, "c": 1, "pts": [[-1.0, 5.281], [4.0, -8.781]]}], "points": [{"at": [2.25, -3.8594], "label": "P"}], "read": ["x = 2.25", "dy/dx = −2.81", "d²y/dx² = 5.5"]}, {"lines": [{"dash": true, "c": 1, "pts": [[-1.0, 0.0], [4.0, -6.25]]}], "points": [{"at": [2.5, -4.375], "label": "P"}], "read": ["x = 2.5", "dy/dx = −1.25", "d²y/dx² = 7"]}, {"lines": [{"dash": true, "c": 1, "pts": [[-1.0, -4.482], [4.0, -4.481]]}], "points": [{"at": [2.6667, -4.4815], "label": "P"}], "read": ["x = 2.67", "dy/dx = 0", "d²y/dx² = 8"]}, {"lines": [{"dash": true, "c": 1, "pts": [[-1.0, -7.031], [4.0, -3.594]]}], "points": [{"at": [2.75, -4.4531], "label": "P"}], "read": ["x = 2.75", "dy/dx = 0.69", "d²y/dx² = 8.5"]}, {"lines": [{"dash": true, "c": 1, "pts": [[-1.0, -16.0], [4.0, -1.0]]}], "points": [{"at": [3.0, -4.0], "label": "P"}], "read": ["x = 3", "dy/dx = 3", "d²y/dx² = 10"]}, {"lines": [{"dash": true, "c": 1, "pts": [[-1.0, -27.094], [4.0, 1.344]]}], "points": [{"at": [3.25, -2.9219], "label": "P"}], "read": ["x = 3.25", "dy/dx = 5.69", "d²y/dx² = 11.5"]}, {"lines": [{"dash": true, "c": 1, "pts": [[-1.0, -40.5], [4.0, 3.25]]}], "points": [{"at": [3.5, -1.125], "label": "P"}], "read": ["x = 3.5", "dy/dx = 8.75", "d²y/dx² = 13"]}, {"lines": [{"dash": true, "c": 1, "pts": [[-1.0, -56.406], [4.0, 4.531]]}], "points": [{"at": [3.75, 1.4844], "label": "P"}], "read": ["x = 3.75", "dy/dx = 12.19", "d²y/dx² = 14.5"]}, {"lines": [{"dash": true, "c": 1, "pts": [[-1.0, -75.0], [4.0, 5.0]]}], "points": [{"at": [4.0, 5.0], "label": "P"}], "read": ["x = 4", "dy/dx = 16", "d²y/dx² = 16"]}], "ctl": {"type": "play", "label": "p", "vals": ["−1", "−0.75", "−0.5", "−0.25", "0", "0.25", "0.5", "0.75", "1", "1.25", "1.5", "1.75", "2", "2.25", "2.5", "2.67", "2.75", "3", "3.25", "3.5", "3.75", "4"], "start": 0}}}, {"h": "First principles", "b": "The gradient function is the **limit** $f'(x)=\\lim_{h\\to0}\\frac{f(x+h)-f(x)}{h}$. Expand $f(x+h)$ carefully, since $(x+h)^2=x^2+2xh+h^2$. Subtract $f(x)$, **divide by $h$**, and only then let $h\\to0$. Every remaining $h$ term vanishes. On the graph, press Play to move Q towards P(2, -3) on $y=x^3-4x^2+5$, from either side, and the chord PQ turns into the tangent.", "fig": {"type": "graph", "anim": "frames", "ms": 700, "x": [1, 3], "xstep": 0.5, "y": [-9, 3], "ystep": 2, "xlabel": "x", "ylabel": "y", "lines": [{"c": 0, "pts": [[1.0, 2.0], [1.0125, 1.9373], [1.025, 1.8744], [1.0375, 1.8111], [1.05, 1.7476], [1.0625, 1.6838], [1.075, 1.6198], [1.0875, 1.5555], [1.1, 1.491], [1.1125, 1.4263], [1.125, 1.3613], [1.1375, 1.2962], [1.15, 1.2309], [1.1625, 1.1654], [1.175, 1.0997], [1.1875, 1.0339], [1.2, 0.968], [1.2125, 0.9019], [1.225, 0.8358], [1.2375, 0.7695], [1.25, 0.7031], [1.2625, 0.6367], [1.275, 0.5702], [1.2875, 0.5036], [1.3, 0.437], [1.3125, 0.3704], [1.325, 0.3037], [1.3375, 0.237], [1.35, 0.1704], [1.3625, 0.1037], [1.375, 0.0371], [1.3875, -0.0295], [1.4, -0.096], [1.4125, -0.1625], [1.425, -0.2289], [1.4375, -0.2952], [1.45, -0.3614], [1.4625, -0.4275], [1.475, -0.4935], [1.4875, -0.5593], [1.5, -0.625], [1.5125, -0.6905], [1.525, -0.7559], [1.5375, -0.8211], [1.55, -0.8861], [1.5625, -0.9509], [1.575, -1.0155], [1.5875, -1.0799], [1.6, -1.144], [1.6125, -1.2079], [1.625, -1.2715], [1.6375, -1.3348], [1.65, -1.3979], [1.6625, -1.4606], [1.675, -1.5231], [1.6875, -1.5852], [1.7, 