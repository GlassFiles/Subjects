": "water now"}], "read": ["HA 11.5 mmol, A⁻ 8.5 mmol", "Buffer pH = 4.63", "Water pH = 1.82"]}, {"lines": [], "points": [{"at": [2.0, 4.5834], "label": "buffer now"}, {"at": [2.0, 1.699], "label": "water now"}], "read": ["HA 12 mmol, A⁻ 8 mmol", "Buffer pH = 4.58", "Water pH = 1.7"]}, {"lines": [], "points": [{"at": [2.5, 4.5376], "label": "buffer now"}, {"at": [2.5, 1.6021], "label": "water now"}], "read": ["HA 12.5 mmol, A⁻ 7.5 mmol", "Buffer pH = 4.54", "Water pH = 1.6"]}, {"lines": [], "points": [{"at": [3.0, 4.4906], "label": "buffer now"}, {"at": [3.0, 1.5229], "label": "water now"}], "read": ["HA 13 mmol, A⁻ 7 mmol", "Buffer pH = 4.49", "Water pH = 1.52"]}, {"lines": [], "points": [{"at": [3.5, 4.442], "label": "buffer now"}, {"at": [3.5, 1.4559], "label": "water now"}], "read": ["HA 13.5 mmol, A⁻ 6.5 mmol", "Buffer pH = 4.44", "Water pH = 1.46"]}, {"lines": [], "points": [{"at": [4.0, 4.3915], "label": "buffer now"}, {"at": [4.0, 1.3979], "label": "water now"}], "read": ["HA 14 mmol, A⁻ 6 mmol", "Buffer pH = 4.39", "Water pH = 1.4"]}, {"lines": [], "points": [{"at": [4.5, 4.3384], "label": "buffer now"}, {"at": [4.5, 1.3468], "label": "water now"}], "read": ["HA 14.5 mmol, A⁻ 5.5 mmol", "Buffer pH = 4.34", "Water pH = 1.35"]}, {"lines": [], "points": [{"at": [5.0, 4.2823], "label": "buffer now"}, {"at": [5.0, 1.301], "label": "water now"}], "read": ["HA 15 mmol, A⁻ 5 mmol", "Buffer pH = 4.28", "Water pH = 1.3"]}, {"lines": [], "points": [{"at": [5.5, 4.2223], "label": "buffer now"}, {"at": [5.5, 1.2596], "label": "water now"}], "read": ["HA 15.5 mmol, A⁻ 4.5 mmol", "Buffer pH = 4.22", "Water pH = 1.26"]}, {"lines": [], "points": [{"at": [6.0, 4.1574], "label": "buffer now"}, {"at": [6.0, 1.2218], "label": "water now"}], "read": ["HA 16 mmol, A⁻ 4 mmol", "Buffer pH = 4.16", "Water pH = 1.22"]}, {"lines": [], "points": [{"at": [6.5, 4.086], "label": "buffer now"}, {"at": [6.5, 1.1871], "label": "water now"}], "read": ["HA 16.5 mmol, A⁻ 3.5 mmol", "Buffer pH = 4.09", "Water pH = 1.19"]}, {"lines": [], "points": [{"at": [7.0, 4.0061], "label": "buffer now"}, {"at": [7.0, 1.1549], "label": "water now"}], "read": ["HA 17 mmol, A⁻ 3 mmol", "Buffer pH = 4.01", "Water pH = 1.15"]}, {"lines": [], "points": [{"at": [7.5, 3.9144], "label": "buffer now"}, {"at": [7.5, 1.1249], "label": "water now"}], "read": ["HA 17.5 mmol, A⁻ 2.5 mmol", "Buffer pH = 3.91", "Water pH = 1.12"]}, {"lines": [], "points": [{"at": [8.0, 3.8052], "label": "buffer now"}, {"at": [8.0, 1.0969], "label": "water now"}], "read": ["HA 18 mmol, A⁻ 2 mmol", "Buffer pH = 3.81", "Water pH = 1.1"]}, {"lines": [], "points": [{"at": [8.5, 3.6684], "label": "buffer now"}, {"at": [8.5, 1.0706], "label": "water now"}], "read": ["HA 18.5 mmol, A⁻ 1.5 mmol", "Buffer pH = 3.67", "Water pH = 1.07"]}, {"lines": [], "points": [{"at": [9.0, 3.4807], "label": "buffer now"}, {"at": [9.0, 1.0458], "label": "water now"}], "read": ["HA 19 mmol, A⁻ 1 mmol", "Buffer pH = 3.48", "Water pH = 1.05"]}, {"lines": [], "points": [{"at": [9.5, 3.1684], "label": "buffer now"}, {"at": [9.5, 1.0223], "label": "water now"}], "read": ["HA 19.5 mmol, A⁻ 0.5 mmol", "Buffer pH = 3.17", "Water pH = 1.02"]}, {"lines": [], "points": [{"at": [9.9, 2.4606], "label": "buffer now"}, {"at": [9.9, 1.0044], "label": "water now"}], "read": ["HA 19.9 mmol, A⁻ 0.1 mmol", "Buffer pH = 2.46", "Water pH = 1"]}], "ctl": {"type": "slider", "label": "a", "vals": ["0", "0.5", "1", "1.5", "2", "2.5", "3", "3.5", "4", "4.5", "5", "5.5", "6", "6.5", "7", "7.5", "8", "8.5", "9", "9.5", "9.9"], "start": 10}}}], "example": {"task": "Calculate the pH of 0.0400 mol dm⁻³ sodium hydroxide at 298 K. Kw = 1.00 × 10⁻¹⁴ mol² dm⁻⁶.", "steps": [{"do": "NaOH is a strong base, so [OH⁻] = 0.0400 mol dm⁻³.", "why": "Full dissociation, one OH⁻ per NaOH."}, {"do": "Rearrange Kw = [H⁺][OH⁻] to [H⁺] = Kw ÷ [OH⁻].", "why": "pH needs [H⁺], but the question gives [OH⁻]."}, {"do": "[H⁺] = 1.00 × 10⁻¹⁴ ÷ 0.0400 = 2.50 × 10⁻¹³ mol dm⁻³.", "why": "Substituting the values into the rearranged expression."}, {"do": "pH = −log(2.50 × 10⁻¹³) = 12.60.", "why": "This is the definition of pH."}, {"do": "Check: 12.60 is above 7.", "why": "An alkaline solution must have pH above 7."}], "answer": "pH = 12.60"}, "selfx": {"q": "Why does the worked example use Kw instead of taking −log(0.0400) directly?", "o": ["Because NaOH is a weak base, so its concentration cannot be used", "Because pH is defined using [H⁺], and Kw links [OH⁻] to [H⁺]", "Because Kw changes the concentration of the NaOH solution", "Because logarithms cannot be taken of hydroxide concentrations"], "a": 1, "f": ["NaOH is a strong base and fully dissociated. Its strength is not the reason Kw is needed.", "Correct. pH = −log[H⁺]. The question gives [OH⁻], so Kw converts it into [H⁺].", "Kw describes water's equilibrium. It does not change the NaOH concentration; it relates [H⁺] and [OH⁻].", "You can take the log of any positive number. The point is that −log[OH⁻] gives pOH, not pH."]}, "faded": {"task": "Find the pH of 0.0250 mol dm⁻³ barium hydroxide, Ba(OH)₂, at 298 K. Kw = 1.00 × 10⁻¹⁴ mol² dm⁻⁶.", "given": ["Ba(OH)₂ is a strong base giving 2 OH⁻ per formula unit.", "[OH⁻] = 2 × 0.0250 = 0.0500 mol dm⁻³"], "q": "What is the next step?", "o": ["[H⁺] = 1.00 × 10⁻¹⁴ × 0.0500 = 5.00 × 10⁻¹⁶ mol dm⁻³", "[H⁺] = 1.00 × 10⁻¹⁴ ÷ 0.0250 = 4.00 × 10⁻¹³ mol dm⁻³", "[H⁺] = 1.00 × 10⁻¹⁴ ÷ 0.0500 = 2.00 × 10⁻¹³ mol dm⁻³", "pH = −log(0.0500) = 1.30"], "a": 2, "f": ["Multiplying by [OH⁻] is wrong. Kw = [H⁺][OH⁻], so you must divide Kw by [OH⁻].", "This divides by 0.0250 and ignores the doubling already found. Use [OH⁻] = 0.0500.", "Correct. [H⁺] = Kw ÷ [OH⁻] = 2.00 × 10⁻¹³, and the next step is pH = −log(2.00 × 10⁻¹³) = 12.70.", "This treats [OH⁻] as [H⁺], giving the pOH. A base cannot have pH 1.30."]}, "trap": "Using the wrong route: treating a weak acid as fully dissociated, or taking −log of a base's concentration. First decide strong or weak, acid or base, then choose the formula.", "recap": "Choose the route first: strong acid uses concentration, strong base uses Kw, weak acid uses Ka with a square root, buffer uses a ratio."}
{"s": "chem", "t": "3.1.4", "kind": "method", "why": "Energetics calculations appear regularly in AQA A-level Chemistry papers, and required practical 2 is assessed through questions on readings, errors and heat loss.", "hook": null, "chunks": [{"h": "Enthalpy change basics", "b": "**Enthalpy change** (ΔH) is the heat change at constant pressure. **Exothermic** reactions have ΔH negative (products lower on the graph); endothermic reactions have ΔH positive (products higher). Standard conditions are 100 kPa and a stated temperature, usually 298 K. **Standard enthalpy of formation** (ΔfH) is for 1 mol of a compound formed from its elements in their standard states.", "fig": {"type": "graph", "x": [0, 14], "y": [0, 10], "xstep": 2, "ystep": 2, "xlabel": "Progress of reaction", "ylabel": "Enthalpy", "lines": [{"pts": [[0, 6], [2, 6], [3, 9], [4, 2], [6, 2]], "label": "Exothermic", "c": 0}, {"pts": [[8, 2], [10, 2], [11, 9], [12, 6], [14, 6]], "label": "Endothermic", "c": 1}], "points": [{"at": [2, 6], "label": "reactants"}, {"at": [4, 2], "label": "products"}, {"at": [10, 2], "label": "reactants"}, {"at": [12, 6], "label": "products"}]}}, {"h": "Calorimetry", "b": "Burn a fuel under a beaker of water and use **q = mcΔT**. Here m is the mass of the **water**, not the fuel. With c in J g⁻¹ K⁻¹, q is in J, so divide by 1000 for kJ. Then **ΔH = −q ÷ n**, where n is moles of fuel burned. Heat loss makes results less exothermic."}, {"h": "Hess's law", "b": "**Hess's law**: the enthalpy change is the same whatever route is taken. Using formation data, **ΔH = ΣΔfH(products) − ΣΔfH(reactants)**. Using combustion data, it is ΣΔcH(reactants) − ΣΔcH(products). Elements in their standard states have ΔfH = 0. Multiply each value by its number of moles in the equation."}, {"h": "Bond enthalpies", "b": "Breaking bonds takes in energy. Making bonds releases it. **ΔH = Σ(bonds broken) − Σ(bonds made)**. **Mean bond enthalpies** are averages over many compounds, and apply to gaseous molecules. Answers are therefore less accurate than values from Hess cycles using data for the actual substances."}], "example": {"task": "Burning 0.800 g of methanol (Mr = 32.0) raises the temperature of 200 g of water from 19.0 °C to 40.5 °C. c = 4.18 J g⁻¹ K⁻¹. Calculate ΔcH of methanol.", "steps": [{"do": "m = 200 g (the water). ΔT = 40.5 − 19.0 = 21.5 K.", "why": "The water absorbs the heat and is the thing whose temperature was measured."}, {"do": "q = mcΔT = 200 × 4.18 × 21.5 = 17 974 J.", "why": "Use c in J g⁻¹ K⁻¹, so q comes out in joules."}, {"do": "q = 17 974 ÷ 1000 = 17.97 kJ.", "why": "ΔH is quoted in kJ mol⁻¹, so convert before dividing by moles."}, {"do": "n(methanol) = 0.800 ÷ 32.0 = 0.0250 mol.", "why": "The fuel's mass is used only here, to find the moles that produced the heat."}, {"do": "ΔH = −q ÷ n = −17.97 ÷ 0.0250 = −719 kJ mol⁻¹.", "why": "The water gained heat, so the reaction lost it: ΔH is negative. Give 3 significant figures."}], "answer": "ΔcH(methanol) = −719 kJ mol⁻¹. It is negative because the water warmed up, so the combustion was exothermic. Heat loss to the surroundings means the true value is more negative."}, "selfx": {"q": "Why does step 1 use 200 g rather than the 0.800 g of methanol in q = mcΔT?", "o": ["Methanol's mass is too small to give a sensible answer.", "The water absorbs the heat, and its temperature change is what was measured.", "The methanol has all burned, so no mass of it is left to use.", "The mass of the fuel is only used in mcΔT for gases."], "a": 1, "f": ["Wrong. The size of the mass is irrelevant. The slip is thinking mcΔT could use the fuel, whose temperature change was never measured.", "Right. q is the heat taken in by the water, so m is the water's mass and ΔT is the water's temperature rise.", "Wrong. Fuel mass is still known from the initial mass and used for moles. The real reason is that the temperature change belongs to the water.", "Wrong. There is no such rule about gases. In mcΔT, m is always the mass of whatever substance's temperature changed."]}, "faded": {"task": "Use ΔfH (kJ mol⁻¹): C₂H₄(g) = +52, H₂O(g) = −242, C₂H₅OH(g) = −235 to find ΔH for C₂H₄(g) + H₂O(g) → C₂H₅OH(g).", "given": ["ΣΔfH(products) = −235 kJ mol⁻¹", "ΣΔfH(reactants) = +52 + (−242) = −190 kJ mol⁻¹"], "q": "What is the next step?", "o": ["ΔH = −190 − (−235) = +45 kJ mol⁻¹", "ΔH = −235 + (−190) = −425 kJ mol⁻¹", "ΔH = −235 − (−190) = −45 kJ mol⁻¹", "ΔH = −235 − 52 − 242 = −529 kJ mol⁻¹"], "a": 2, "f": ["Wrong. This is reactants − products, the wrong way round, which gives the wrong sign. It is products minus reactants.", "Wrong. This adds the two totals. Hess's law with formation data needs products minus reactants.", "Right. ΔH = ΣΔfH(products) − ΣΔfH(reactants) = −235 − (−190) = −45 kJ mol⁻¹, so the reaction is exothermic.", "Wrong. This subtracts both reactant values separately, so the sign of ΔfH(H₂O) is mishandled. Sum the reactants first, then subtract that total."]}, "trap": "Using the fuel's mass in mcΔT, forgetting to change J to kJ, or dropping the negative sign for an exothermic reaction. Always use the water's mass, divide q by 1000, and check the sign against the temperature rise.", "recap": "Find q from the water with mcΔT, convert to kJ, divide by moles of fuel, and make ΔH negative if the temperature rose."}
{"s": "chem", "t": "3.1.5", "kind": "idea", "why": "Explain-why questions on rate are worth several marks in written papers, and required practical 3 (effect of temperature on rate) is tested there too.", "hook": {"q": "A gas mixture stays at constant temperature. Which change makes collisions more frequent without giving each collision more energy?", "o": ["Adding a catalyst to the mixture", "Compressing the mixture into a smaller volume", "Heating the mixture by 10 K", "Enlarging the container to lower the pressure"], "a": 1, "f": ["A catalyst lowers the activation energy. It does not make particles collide more often.", "Right. Particles are squeezed into a smaller volume, so they collide more often. Their energies are unchanged.", "Heating gives particles more energy and changes their energy distribution. That is more than a change in collision frequency.", "Lowering the pressure spaces particles further apart, so collisions become less frequent, not more."]}, "chunks": [{"h": "Collision theory", "b": "Particles react only if they **collide** with energy at least equal to the **activation energy**, Ea. Most collisions are not successful. Rate depends on the number of **successful collisions** per unit time. In the diagram, drag the slider and compare the two counts. It is a small, random model.", "fig": {"type": "box", "h": 0.6, "ea": 2.4, "seed": 5, "sp": [{"name": "particle A", "n": 14, "r": 3, "c": 0, "v": 1}, {"name": "particle B", "n": 14, "r": 3, "c": 1, "v": 1}], "param": {"name": "T", "label": "Temperature", "vals": ["Low", "Medium", "High", "Very high"], "start": 0, "v": [0.7, 1, 1.3, 1.7]}, "read": ["all collisions per second: {coll}", "collisions with E ≥ Ea per second: {succ}"], "alt": "Particles A and B moving in a box. A temperature slider changes their speed. Counters show all collisions per second and those with enough energy to react."}}, {"h": "Reading the curve", "b": "The **Maxwell–Boltzmann distribution** shows how many molecules have each energy. It starts at the origin and has a peak. The tail never touches the axis. The **area under the curve** is the total number of molecules. The area to the right of Ea is the number of molecules with enough energy to react."}, {"h": "Raising the temperature", "b": "Drag the slider on the graph to raise the temperature. The peak moves **right and lower**, and the area stays the same. Ea does not move. A much **larger fraction of molecules has E ≥ Ea**, so more collisions succeed. Collisions are also slightly more frequent, but that is a minor effect.", "fig": {"type": "graph", "anim": "frames", "x": [0, 8], "y": [0, 0.35], "xstep": 1, "ystep": 0.05, "xlabel": "Energy", "ylabel": "Number of molecules", "xnums": false, "ynums": false, "lines": [{"c": 0, "pts": [[0.0, 0.0], [0.05, 0.038], [0.1, 0.0724], [0.15, 0.1033], [0.2, 0.131], [0.25, 0.1558], [0.3, 0.1778], [0.35, 0.1973], [0.4, 0.2145], [0.45, 0.2295], [0.5, 0.2426], [0.55, 0.2539], [0.6, 0.2634], [0.65, 0.2715], [0.7, 0.2781], [0.75, 0.2834], [0.8, 0.2876], [0.85, 0.2906], [0.9, 0.2927], [0.95, 0.2939], [1.0, 0.2943], [1.05, 0.2939], [1.1, 0.2929], [1.15, 0.2913], [1.2, 0.2891], [1.25, 0.2865], [1.3, 0.2834], [1.35, 0.28], [1.4, 0.2762], [1.45, 0.2721], [1.5, 0.2678], [1.55, 0.2632], [1.6, 0.2584], [1.65, 0.2535], [1.7, 0.2484], [1.75, 0.2433], [1.8, 0.238], [1.85, 0.2327], [1.9, 0.2273], [1.95, 0.2219], [2.0, 0.2165], [2.05, 0.2111], [2.1, 0.2057], [2.15, 0.2004], [2.2, 0.195], [2.25, 0.1897], [2.3, 0.1845], [2.35, 0.1793], [2.4, 0.1742], [2.45, 0.1691], [2.5, 0.1642], [2.55, 0.1593], [2.6, 0.1545], [2.65, 0.1498], [2.7, 0.1452], [2.75, 0.1406], [2.8, 0.1362], [2.85, 0.1319], [2.9, 0.1277], [2.95, 0.1235], [3.0, 0.1195], [3.05, 0.1156], [3.1, 0.1117], [3.15, 0.108], [3.2, 0.1044], [3.25, 0.1008], [3.3, 0.0974], [3.35, 0.094], [3.4, 0.0908], [3.45, 0.0876], [3.5, 0.0846], [3.55, 0.0816], [3.6, 0.0787], [3.65, 0.0759], [3.7, 0.0732], [3.75, 0.0706], [3.8, 0.068], [3.85, 0.0655], [3.9, 0.0632], [3.95, 0.0608], 