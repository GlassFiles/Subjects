00.0, 0.833333]], "c": 0, "label": "curve"}, {"pts": [[20, 0.5], [80, 0.8]], "dash": true, "label": "chord (mean rate)", "c": 1}], "points": [{"at": [20, 0.5], "label": "A"}, {"at": [80, 0.8], "label": "B"}], "xnums": true, "ynums": true}}, {"h": "Rate at one moment", "b": "The slope of a curve keeps changing. To find the rate at one time, draw a **tangent**: a straight line touching the curve at that point without crossing it. Pick two points far apart on it. Rate = **gradient** = change in y ÷ change in x. Drag the slider to move the tangent along the graph.", "fig": {"type": "graph", "anim": "frames", "x": [0, 100], "xstep": 20, "y": [0, 0.9], "ystep": 0.1, "xlabel": "time / s", "ylabel": "mass lost / g", "lines": [{"c": 0, "pts": [[0.0, 0.0], [0.625, 0.0303], [1.25, 0.0588], [1.875, 0.0857], [2.5, 0.1111], [3.125, 0.1351], [3.75, 0.1579], [4.375, 0.1795], [5.0, 0.2], [5.625, 0.2195], [6.25, 0.2381], [6.875, 0.2558], [7.5, 0.2727], [8.125, 0.2889], [8.75, 0.3043], [9.375, 0.3191], [10.0, 0.3333], [10.625, 0.3469], [11.25, 0.36], [11.875, 0.3725], [12.5, 0.3846], [13.125, 0.3962], [13.75, 0.4074], [14.375, 0.4182], [15.0, 0.4286], [15.625, 0.4386], [16.25, 0.4483], [16.875, 0.4576], [17.5, 0.4667], [18.125, 0.4754], [18.75, 0.4839], [19.375, 0.4921], [20.0, 0.5], [20.625, 0.5077], [21.25, 0.5152], [21.875, 0.5224], [22.5, 0.5294], [23.125, 0.5362], [23.75, 0.5429], [24.375, 0.5493], [25.0, 0.5556], [25.625, 0.5616], [26.25, 0.5676], [26.875, 0.5733], [27.5, 0.5789], [28.125, 0.5844], [28.75, 0.5897], [29.375, 0.5949], [30.0, 0.6], [30.625, 0.6049], [31.25, 0.6098], [31.875, 0.6145], [32.5, 0.619], [33.125, 0.6235], [33.75, 0.6279], [34.375, 0.6322], [35.0, 0.6364], [35.625, 0.6404], [36.25, 0.6444], [36.875, 0.6484], [37.5, 0.6522], [38.125, 0.6559], [38.75, 0.6596], [39.375, 0.6632], [40.0, 0.6667], [40.625, 0.6701], [41.25, 0.6735], [41.875, 0.6768], [42.5, 0.68], [43.125, 0.6832], [43.75, 0.6863], [44.375, 0.6893], [45.0, 0.6923], [45.625, 0.6952], [46.25, 0.6981], [46.875, 0.7009], [47.5, 0.7037], [48.125, 0.7064], [48.75, 0.7091], [49.375, 0.7117], [50.0, 0.7143], [50.625, 0.7168], [51.25, 0.7193], [51.875, 0.7217], [52.5, 0.7241], [53.125, 0.7265], [53.75, 0.7288], [54.375, 0.7311], [55.0, 0.7333], [55.625, 0.7355], [56.25, 0.7377], [56.875, 0.7398], [57.5, 0.7419], [58.125, 0.744], [58.75, 0.746], [59.375, 0.748], [60.0, 0.75], [60.625, 0.7519], [61.25, 0.7538], [61.875, 0.7557], [62.5, 0.7576], [63.125, 0.7594], [63.75, 0.7612], [64.375, 0.763], [65.0, 0.7647], [65.625, 0.7664], [66.25, 0.7681], [66.875, 0.7698], [67.5, 0.7714], [68.125, 0.773], [68.75, 0.7746], [69.375, 0.7762], [70.0, 0.7778], [70.625, 0.7793], [71.25, 0.7808], [71.875, 0.7823], [72.5, 0.7838], [73.125, 0.7852], [73.75, 0.7867], [74.375, 0.7881], [75.0, 0.7895], [75.625, 0.7908], [76.25, 0.7922], [76.875, 0.7935], [77.5, 0.7949], [78.125, 0.7962], [78.75, 0.7975], [79.375, 0.7987], [80.0, 0.8], [80.625, 0.8012], [81.25, 0.8025], [81.875, 0.8037], [82.5, 0.8049], [83.125, 0.8061], [83.75, 0.8072], [84.375, 0.8084], [85.0, 0.8095], [85.625, 0.8107], [86.25, 0.8118], [86.875, 0.8129], [87.5, 0.814], [88.125, 0.815], [88.75, 0.8161], [89.375, 0.8171], [90.0, 0.8182], [90.625, 0.8192], [91.25, 0.8202], [91.875, 0.8212], [92.5, 0.8222], [93.125, 0.8232], [93.75, 0.8242], [94.375, 0.8251], [95.0, 0.8261], [95.625, 0.827], [96.25, 0.828], [96.875, 0.8289], [97.5, 0.8298], [98.125, 0.8307], [98.75, 0.8316], [99.375, 0.8325], [100.0, 0.8333]], "label": "curve"}, {"dash": true, "c": 1, "label": "chord A to B", "pts": [[20, 0.5], [80, 0.8]]}], "points": [{"at": [20, 0.5], "label": "A"}, {"at": [80, 0.8], "label": "B"}], "frames": [{"lines": [{"c": 2, "pts": [[0.0, 0.25], [40.0, 0.75]], "label": "tangent"}], "points": [{"at": [20.0, 0.5], "label": "P"}], "read": ["t = 20 s", "Tangent gradient = 0.0125 g/s", "Chord A to B: 0.005 g/s"]}, {"lines": [{"c": 2, "pts": [[5.0, 0.358], [45.0, 0.753]], "label": "tangent"}], "points": [{"at": [25.0, 0.5556], "label": "P"}], "read": ["t = 25 s", "Tangent gradient = 0.0099 g/s", "Chord A to B: 0.005 g/s"]}, {"lines": [{"c": 2, "pts": [[10.0, 0.44], [50.0, 0.76]], "label": "tangent"}], "points": [{"at": [30.0, 0.6], "label": "P"}], "read": ["t = 30 s", "Tangent gradient = 0.008 g/s", "Chord A to B: 0.005 g/s"]}, {"lines": [{"c": 2, "pts": [[15.0, 0.504], [55.0, 0.769]], "label": "tangent"}], "points": [{"at": [35.0, 0.6364], "label": "P"}], "read": ["t = 35 s", "Tangent gradient = 0.0066 g/s", "Chord A to B: 0.005 g/s"]}, {"lines": [{"c": 2, "pts": [[20.0, 0.556], [60.0, 0.778]], "label": "tangent"}], "points": [{"at": [40.0, 0.6667], "label": "P"}], "read": ["t = 40 s", "Tangent gradient = 0.0056 g/s", "Chord A to B: 0.005 g/s"]}, {"lines": [{"c": 2, "pts": [[25.0, 0.598], [65.0, 0.787]], "label": "tangent"}], "points": [{"at": [45.0, 0.6923], "label": "P"}], "read": ["t = 45 s", "Tangent gradient = 0.0047 g/s", "Chord A to B: 0.005 g/s"]}, {"lines": [{"c": 2, "pts": [[30.0, 0.633], [70.0, 0.796]], "label": "tangent"}], "points": [{"at": [50.0, 0.7143], "label": "P"}], "read": ["t = 50 s", "Tangent gradient = 0.0041 g/s", "Chord A to B: 0.005 g/s"]}, {"lines": [{"c": 2, "pts": [[35.0, 0.662], [75.0, 0.804]], "label": "tangent"}], "points": [{"at": [55.0, 0.7333], "label": "P"}], "read": ["t = 55 s", "Tangent gradient = 0.0036 g/s", "Chord A to B: 0.005 g/s"]}, {"lines": [{"c": 2, "pts": [[40.0, 0.688], [80.0, 0.812]], "label": "tangent"}], "points": [{"at": [60.0, 0.75], "label": "P"}], "read": ["t = 60 s", "Tangent gradient = 0.0031 g/s", "Chord A to B: 0.005 g/s"]}, {"lines": [{"c": 2, "pts": [[45.0, 0.709], [85.0, 0.82]], "label": "tangent"}], "points": [{"at": [65.0, 0.7647], "label": "P"}], "read": ["t = 65 s", "Tangent gradient = 0.0028 g/s", "Chord A to B: 0.005 g/s"]}, {"lines": [{"c": 2, "pts": [[50.0, 0.728], [90.0, 0.827]], "label": "tangent"}], "points": [{"at": [70.0, 0.7778], "label": "P"}], "read": ["t = 70 s", "Tangent gradient = 0.0025 g/s", "Chord A to B: 0.005 g/s"]}, {"lines": [{"c": 2, "pts": [[55.0, 0.745], [95.0, 0.834]], "label": "tangent"}], "points": [{"at": [75.0, 0.7895], "label": "P"}], "read": ["t = 75 s", "Tangent gradient = 0.0022 g/s", "Chord A to B: 0.005 g/s"]}, {"lines": [{"c": 2, "pts": [[60.0, 0.76], [100.0, 0.84]], "label": "tangent"}], "points": [{"at": [80.0, 0.8], "label": "P"}], "read": ["t = 80 s", "Tangent gradient = 0.002 g/s", "Chord A to B: 0.005 g/s"]}], "ctl": {"type": "slider", "label": "p", "vals": ["20", "25", "30", "35", "40", "45", "50", "55", "60", "65", "70", "75", "80"], "start": 0}}}], "example": {"task": "The graph shows mass lost (g) against time (s) with a tangent at 40 s. The tangent passes through (20 s, 0.30 g) and (80 s, 0.90 g). Find the rate of reaction at 40 s.", "steps": [{"do": "State that the rate at 40 s is the gradient of the tangent at 40 s.", "why": "The curve's slope keeps changing, so only the tangent gives the slope at that one moment."}, {"do": "Take the two points given on the tangent line: (20 s, 0.30 g) and (80 s, 0.90 g).", "why": "They lie on the straight tangent, not the curve, and they are far apart, which keeps the gradient accurate."}, {"do": "Find the change in mass: 0.90 − 0.30 = 0.60 g.", "why": "This is the change in y, the amount of gas lost between the two points."}, {"do": "Find the change in time: 80 − 20 = 60 s.", "why": "This is the change in x. It is the gap between the two points, not the 40 s where the tangent touches."}, {"do": "Divide: 0.60 ÷ 60 = 0.01 g/s.", "why": "Gradient = change in y ÷ change in x. The unit is grams per second."}], "answer": "The rate of reaction at 40 s is 0.01 g/s.", "fig": {"type": "graph", "x": [0, 100], "y": [0, 1.2], "xstep": 20, "ystep": 0.3, "xlabel": "time / s", "ylabel": "mass lost / g", "lines": [{"pts": [[0.0, 0.0], [0.625, 0.009728], [1.25, 0.01938], [1.875, 0.028958], [2.5, 0.038462], [3.125, 0.047893], [3.75, 0.057252], [4.375, 0.06654], [5.0, 0.075758], [5.625, 0.084906], [6.25, 0.093985], [6.875, 0.102996], [7.5, 0.11194], [8.125, 0.120818], [8.75, 0.12963], [9.375, 0.138376], [10.0, 0.147059], [10.625, 0.155678], [11.25, 0.164234], [11.875, 0.172727], [12.5, 0.181159], [13.125, 0.189531], [13.75, 0.197842], [14.375, 0.206093], [15.0, 0.214286], [15.625, 0.22242], [16.25, 0.230496], [16.875, 0.238516], [17.5, 0.246479], [18.125, 0.254386], [18.75, 0.262238], [19.375, 0.270035], [20.0, 0.277778], [20.625, 0.285467], [21.25, 0.293103], [21.875, 0.300687], [22.5, 0.308219], [23.125, 0.3157], [23.75, 0.323129], [24.375, 0.330508], [25.0, 0.337838], [25.625, 0.345118], [26.25, 0.352349], [26.875, 0.359532], [27.5, 0.366667], [28.125, 0.373754], [28.75, 0.380795], [29.375, 0.387789], [30.0, 0.394737], [30.625, 0.401639], [31.25, 0.408497], [31.875, 0.415309], [32.5, 0.422078], [33.125, 0.428803], [33.75, 0.435484], [34.375, 0.442122], [35.0, 0.448718], [35.625, 0.455272], [36.25, 0.461783], [36.875, 0.468254], [37.5, 0.474684], [38.125, 0.481073], [38.75, 0.487421], [39.375, 0.49373], [40.0, 0.5], [40.625, 0.506231], [41.25, 0.512422], [41.875, 0.518576], [42.5, 0.524691], [43.125, 0.530769], [43.75, 0.53681], [44.375, 0.542813], [45.0, 0.54878], [45.625, 0.554711], [46.25, 0.560606], [46.875, 0.566465], [47.5, 0.572289], [48.125, 0.578078], [48.75, 0.583832], [49.375, 0.589552], [50.0, 0.595238], [50.625, 0.60089], [51.25, 0.606509], [51.875, 0.612094], [52.5, 0.617647], [53.125, 0.623167], [53.75, 0.628655], [54.375, 0.634111], [55.0, 0.639535], [55.625, 0.644928], [56.25, 0.650289], [56.875, 0.65562], [57.5, 0.66092], [58.125, 0.666189], [58.75, 0.671429], [59.375, 0.676638], [60.0, 0.681818], [60.625, 0.686969], [61.25, 0.69209], [61.875, 0.697183], [62.5, 0.702247], [63.125, 0.707283], [63.75, 0.712291], [64.375, 0.71727], [65.0, 0.722222], [65.625, 0.727147], [66.25, 0.732044], [66.875, 0.736915], [67.5, 0.741758], [68.125, 0.746575], [68.75, 0.751366], [69.375, 0.756131], [70.0, 0.76087], [70.625, 0.765583], [71.25, 0.77027], [71.875, 0.774933], [72.5, 0.77957], [73.125, 0.784182], [73.75, 0.78877], [74.375, 0.793333], [75.0, 0.797872], [75.625, 0.802387], [76.25, 0.806878], [76.875, 0.811346], [77.5, 0.815789], [78.125, 0.82021], [78.75, 0.824607], [79.375, 0.828982], [80.0, 0.833333], [80.625, 0.837662], [81.25, 0.841969], [81.875, 0.846253], [82.5, 0.850515], [83.125, 0.854756], [83.75, 0.858974], [84.375, 0.863171], [85.0, 0.867347], [85.625, 0.871501], [86.25, 0.875635], [86.875, 0.879747], [87.5, 0.883838], [88.125, 0.887909], [88.75, 0.89196], [89.375, 0.89599], [90.0, 0.9], [90.625, 0.90399], [91.25, 0.90796], [91.875, 0.911911], [92.5, 0.915842], [93.125, 0.919753], [93.75, 0.923645], [94.375, 0.927518], [95.0, 0.931373], [95.625, 0.935208], [96.25, 0.939024], [96.875, 0.942822], [97.5, 0.946602], [98.125, 0.950363], [98.75, 0.954106], [99.375, 0.957831], [100.0, 0.961538]], "c": 0, "label": "curve"}, {"pts": [[0, 0.1], [100, 1.1]], "label": "tangent", "dash": true, "c": 1}], "points": [{"at": [20, 0.3], "label": "A"}, {"at": [80, 0.9], "label": "B"}], "xnums": true, "ynums": true}}, "selfx": {"q": "Why does the working use 80 − 20 = 60 s rather than 40 s as the time?", "o": ["40 s is the time when the reaction stops, so it cannot be used in the sum.", "The gradient needs the gap between the two points on the tangent, which is 60 s.", "The tangent must always be divided by the final time on the x-axis.", "A rate in g/s must always be found by dividing by 60."], "a": 1, "f": ["The reaction has not stopped at 40 s. This is just where the tangent touches the curve. The slip is confusing a point on the curve with the time gap.", "Correct. Gradient = change in y ÷ change in x, and the change in x is the gap between the two points used, 80 − 20 = 60 s.", "The calculation uses the gap between the two chosen points, not the final time on the axis. Using one time instead of a change is the slip.", "Dividing by 60 here is only because the gap is 60 s. It is not a fixed rule, and a different tangent would give a different gap."], "a_note": null}, "faded": {"task": "A curve shows gas volume (cm³) against time (s). Find the rate of reaction at 30 s from a tangent drawn at 30 s.", "given": ["Tangent at 30 s passes through (10 s, 6 cm³) and (50 s, 38 cm³).", "Change in volume = 38 − 6 = 32 cm³."], "q": "What is the next step, and the rate at 30 s?", "o": ["Divide by 30 s, the time of the tangent: 32 ÷ 30 = 1.1 cm³/s", "Divide 38 by 50, the last point: 38 ÷ 50 = 0.76 cm³/s", "Time gap = 50 − 10 = 40 s; rate = 32 ÷ 40 = 0.8 cm³/s", "Time gap = 40 s; rate = 40 ÷ 32 = 1.25 cm³/s"], "a": 2, "f": ["The time of the tangent, 30 s, is not the time gap. You need the change in time between the two points: 50 − 10 = 40 s.", "This uses single readings, not changes. Subtract the times first (50 − 10), then divide the change in volume by that gap.", "Correct. The change in time is 50 − 10 = 40 s, and gradient = change in volume ÷ change in time = 32 ÷ 40 = 0.8 cm³/s.", "The time gap is right, but the division is upside down. Rate = change in volume ÷ change in time, so 32 ÷ 40."]}, "trap": "Using one reading, such as 44 ÷ 60, or using the time where the tangent touches the curve. Subtract the two readings and the two times first, then divide. Check the units.", "recap": "Rate is a change in amount divided by a change in time, and the rate at one moment is the gradient of a tangent."}
{"s": "chemistry", "t": "4.6.1.2", "kind": "idea", "why": "Paper 2 often asks you to explain a change in rate using particles and collisions, and many marks are lost through vague wording.", "hook": {"q": "Pupils wander randomly around a hall and bump into each other. Which hall gives the most bumps each minute?", "o": ["20 pupils in a large hall", "20 pupils in a small hall", "10 pupils in a small hall", "10 pupils in a large hall"], "a": 1, "f": ["Wrong. Plenty of pupils, but lots of space, so they meet less often. Spread-out particles collide less often.", "Right. More pupils in less space means more bumps. Particles work the same way: more crowded means more frequent collisions.", "Wrong. The small hall helps, but only 10 pupils means fewer to bump into than 20 in the same space.", "Wrong. This is the least crowded case. Few pupils and a lot of space give the fewest bumps."]}, "chunks": [{"h": "Collision theory", "b": "Particles react only when they **collide** with enough energy. The minimum energy needed is the **activation energy**. A collision with at least this energy is a **successful collision**. Collisions with less energy just bounce apart. The rate of reaction depends on how many successful collisions happen each second."}, {"h": "More frequent collisions", "b": "Higher **concentration** (solutions) or higher **pressure** (gases) puts more particles into the same space. They are closer together, so they collide more often. A larger **surface area** of a solid exposes more of its particles to the other reactant. Particle energy does not change."}, {"h": "Temperature has two effects", "b": "Raising the **temperature** makes particles move faster. They collide more often. They also collide with more energy, so a greater proportion of collisions have at least the **activation energy**. Both effects give more successful collisions each second. The activation energy itself does not change."}, {"h": "Catalysts", "b": "A **catalyst** speeds up a reaction and is not used up. It provides an **alternative pathway** with a lower activation energy, shown by the lower peak on the graph. More collisions then have enough energy, so more are successful each second. Reactants and products stay at the same energy. Different reactions need different catalysts.", "fig": {"type": "graph", "x": [0, 10], "y": [0, 10], "xstep": 2, "ystep": 2, "xlabel": "Progress of reaction", "ylabel": "Energy", "lines": [{"pts": [[0, 4], [1, 4], [2, 5], [3, 7.2], [4, 8], [5, 7.2], [6, 5], [7, 2.8], [8, 2], [10, 2]], "c": 0}, {"pts": [[0, 4], [1, 4], [2, 4.8], [3, 5.8], [4, 6], [5, 5.4], [6, 3.8], [7, 2.6], [8, 2], [10, 2]], "c": 1}], "points": [{"at": [4, 8], "label": "no catalyst"}, {"at": [4, 6], "label": "catalyst"}]}}], "example": {"task": "Magnesium reacts with hydrochloric acid. Explain, in terms of particles, why using more concentrated acid increases the rate of reaction. (4 marks)", "steps": [{"do": "Concentrated acid has more acid particles in the same volume of solution.", "why": "Concentration means amount of substance per volume. This is the actual change you are explaining."}, {"do": "The acid particles are closer together, so they are more likely to meet magnesium particles.", "why": "This links the change in number of particles to what the particles do."}, {"do": "So collisions between acid and magnesium particles are more frequent.", "why": "Frequency of collisions is the key idea the mark scheme looks for."}, {"do": "There are more successful collisions each second, so the rate of reaction increases.", "why": "It finishes by linking back to the rate. The rate depends on successful collisions per second."}], "answer": "More concentrated acid has more particles in the same volume. They are closer together, so collisions with magnesium are more frequent. More successful collisions happen each second, so the rate increases."}, "selfx": {"q": "Why does the answer NOT say the acid particles collide with more energy?", "o": ["Energy only matters in reactions between two gases", "Concentration does not change the particles' energy, only how often they collide", "A more concentrated acid has a lower activation energy", "Particles only gain energy when a catalyst is added"], "a": 1, "f": ["Wrong. Energy matters in every reaction. Activation energy applies to solutions and solids as well as gases.", "Right. Temperature is unchanged, so particles have the same energy. Only the number of collisions each second changes.", "Wrong. Activation energy is not changed by concentration. Only a catalyst gives a lower activation energy.", "Wrong. Heating also gives particles more energy. A catalyst lowers the activation energy and does not add energy."]}, "faded": {"task": "The graph shows the reaction profile for hydrogen peroxide breaking down, with and without manganese(IV) oxide. Explain why adding it makes the reaction faster, in terms of collisions. (3 marks)", "given": ["Manganese(IV) oxide is a catalyst.", "A catalyst provides an alternative reaction pathway."], "q": "What is the next point to make?", "o": ["The catalyst makes the particles move faster, so they collide more often", "The catalyst raises the concentration of hydrogen peroxide, so collisions are more frequent", "The catalyst is used up, which adds extra particles that can collide", "The new pathway has a lower activation energy, so more collisions are successful"], "a": 3, "f": ["Wrong. Only a temperature rise makes particles move faster. A catalyst does not change particle speed.", "Wrong. A catalyst does not change the concentration. It changes the activation energy of the reaction.", "Wrong. A catalyst is not used up. It is still there, unchanged, at the end of the reaction.", "Right. The lower activation energy means a greater proportion of collisions have enough energy, so more are successful each second."], "fig": {"type": "graph", "x": [0, 10], "y": [0, 10], "xstep": 2, "ystep": 2, "xlabel": "Progress of reaction", "ylabel": "Energy", "lines": [{"pts": [[0, 4], [1, 4], [2, 5], [3, 7.2], [4, 8], [5, 7.2], [6, 5], [7, 2.8], [8, 2], [10, 2]], "c": 0}, {"pts": [[0, 4], [1, 4], [2, 4.8], [3, 5.8], [4, 6], [5, 5.4], [6, 3.8], [7, 2.6], [8, 2], [10, 2]], "c": 1}], "points": [{"at": [4, 8], "label": "no catalyst"}, {"at": [4, 6], "label": "catalyst"}]}}, "trap": "Saying only 'more collisions'. Rate depends on successful collisions. For temperature, also say more particles have at least the activation energy. Never say temperature or concentration lowers the activation energy. Only a catalyst does.", "recap": "Rate depends on successful collisions per second: more frequent collisions, more energetic collisions, or a catalyst lowering activation energy."}
{"s": "chemistry", "t": "4.6.2.1", "kind": "idea", "why": "Paper 2 often asks you to explain what happens at equilibrium, and 'the reactions stop' is a common way to lose marks.", "hook": {"q": "A bath has the tap running and the plug out, and the water level stays the same. What must be true?", "o": ["Water flows in more slowly than it drains out", "The tap and the drain have both stopped working", "Water flows in at the same rate as it drains out", "The bath is exactly half full"], "a": 2, "f": ["If water drained faster than it came in, the level would fall. A steady level needs the two rates to balance.", "Water is still moving. A steady level does not mean the flow has stopped.", "Correct. Both flows carry on, but they balance, so the level stays constant. Equilibrium works in a similar way.", "A constant level can be at any height. It does not have to be half full."]}, "chunks": [{"h": "Reactions that go both ways", "b": "In a **reversible reaction**, the products can react to make the reactants again. The symbol ⇌ shows this. Hydrated copper(II) sulfate ⇌ anhydrous copper(II) sulfate + water. Left to right is the **forward reaction**. Right to left is the **reverse reaction**."}, {"h": "Energy changes both ways", "b": "If the forward reaction is **exothermic**, the reverse reaction is **endothermic**. The amount of energy is the same in each direction. If the forward reaction releases 90 kJ, the reverse reaction takes in 90 kJ. One direction releases energy, the other takes it in."}, {"h": "How equilibrium is reached", "b": "At the start there are only reactants, so the **forward reaction** is fastest. As products build up, the **reverse reaction** speeds up. The forward reaction slows because reactants are used up. Eventually the two rates become equal. Watch the graph draw itself, then press Replay to see it again.", "fig": {"type": "graph", "anim": "draw", "ms": 5000, "x": [0, 10], "y": [0, 10], "xstep": 2, "ystep": 2, "xlabel": "Time", "ylabel": "Rate of r