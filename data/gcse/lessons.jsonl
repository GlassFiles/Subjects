"at": [4.5, 20.5], "label": "Q"}], "read": ["Q at t = 4.5", "Chord gradient = 5", "Tangent gradient = 4"]}, {"lines": [{"c": 2, "pts": [[1.0, 3.667], [5.0, 22.333]], "label": "chord PQ"}], "points": [{"at": [4.0, 17.6667], "label": "Q"}], "read": ["Q at t = 4", "Chord gradient = 4.67", "Tangent gradient = 4"]}, {"lines": [{"c": 2, "pts": [[1.0, 4.333], [5.0, 21.667]], "label": "chord PQ"}], "points": [{"at": [3.5, 15.1667], "label": "Q"}], "read": ["Q at t = 3.5", "Chord gradient = 4.33", "Tangent gradient = 4"]}, {"lines": [{"c": 2, "pts": [[1.0, 4.667], [5.0, 21.333]], "label": "chord PQ"}], "points": [{"at": [3.25, 14.0417], "label": "Q"}], "read": ["Q at t = 3.25", "Chord gradient = 4.17", "Tangent gradient = 4"]}, {"lines": [{"c": 2, "pts": [[1.0, 4.867], [5.0, 21.133]], "label": "chord PQ"}], "points": [{"at": [3.1, 13.4067], "label": "Q"}], "read": ["Q at t = 3.1", "Chord gradient = 4.07", "Tangent gradient = 4"]}, {"lines": [{"c": 2, "pts": [[1.0, 4.987], [5.0, 21.013]], "label": "chord PQ"}], "points": [{"at": [3.01, 13.0401], "label": "Q"}], "read": ["Q at t = 3.01", "Chord gradient = 4.01", "Tangent gradient = 4"]}], "ctl": {"type": "slider", "label": "q", "vals": ["5", "4.5", "4", "3.5", "3.25", "3.1", "3.01"], "start": 0}}}, {"h": "Finding its gradient", "b": "Pick two points **on the tangent line**, not on the curve. Choose them far apart, with values that are easy to read. Then use $\\frac{\\text{change in } y}{\\text{change in } x}$. The units are the $y$ unit per $x$ unit, such as m/s. A **negative** gradient means $y$ is decreasing."}], "example": {"task": "The graph shows N thousand bacteria after t hours. The curve gets steeper. The dashed tangent touches it at P, where t = 3. Estimate the rate of growth at t = 3 hours.", "steps": [{"do": "Draw a tangent to the curve at t = 3. Rest the ruler on the curve at that point only. Draw a long straight line.", "why": "The rate of change at a point is the gradient of the tangent at that point."}, {"do": "