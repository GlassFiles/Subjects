4], [0.831, 7.481], [0.853, 7.678], [0.875, 7.875], [0.897, 8.072], [0.919, 8.269], [0.941, 8.466], [0.963, 8.663], [0.984, 8.859], [1.006, 9.0], [1.028, 9.0], [1.05, 9.0], [1.072, 9.0], [1.094, 9.0], [1.116, 9.0], [1.137, 9.0], [1.159, 9.0], [1.181, 9.0], [1.203, 9.0], [1.225, 9.0], [1.247, 9.0], [1.269, 9.0], [1.291, 9.0], [1.312, 9.0], [1.334, 9.0], [1.356, 9.0], [1.378, 9.0], [1.4, 9.0], [1.422, 9.0], [1.444, 9.0], [1.466, 9.0], [1.488, 9.0], [1.509, 9.0], [1.531, 9.0], [1.553, 9.0], [1.575, 9.0], [1.597, 9.0], [1.619, 9.0], [1.641, 9.0], [1.662, 9.0], [1.684, 9.0], [1.706, 9.0], [1.728, 9.0], [1.75, 9.0]], "label": "Water made"}], "points": [{"at": [1.75, 9.0], "label": "now"}], "read": ["H₂ ÷ 2 = 0.4375 mol", "O₂ ÷ 1 = 0.25 mol (fixed)", "Water made = 9 g"]}, {"lines": [{"c": 0, "pts": [[0.0, 0.0], [0.025, 0.225], [0.05, 0.45], [0.075, 0.675], [0.1, 0.9], [0.125, 1.125], [0.15, 1.35], [0.175, 1.575], [0.2, 1.8], [0.225, 2.025], [0.25, 2.25], [0.275, 2.475], [0.3, 2.7], [0.325, 2.925], [0.35, 3.15], [0.375, 3.375], [0.4, 3.6], [0.425, 3.825], [0.45, 4.05], [0.475, 4.275], [0.5, 4.5], [0.525, 4.725], [0.55, 4.95], [0.575, 5.175], [0.6, 5.4], [0.625, 5.625], [0.65, 5.85], [0.675, 6.075], [0.7, 6.3], [0.725, 6.525], [0.75, 6.75], [0.775, 6.975], [0.8, 7.2], [0.825, 7.425], [0.85, 7.65], [0.875, 7.875], [0.9, 8.1], [0.925, 8.325], [0.95, 8.55], [0.975, 8.775], [1.0, 9.0], [1.025, 9.0], [1.05, 9.0], [1.075, 9.0], [1.1, 9.0], [1.125, 9.0], [1.15, 9.0], [1.175, 9.0], [1.2, 9.0], [1.225, 9.0], [1.25, 9.0], [1.275, 9.0], [1.3, 9.0], [1.325, 9.0], [1.35, 9.0], [1.375, 9.0], [1.4, 9.0], [1.425, 9.0], [1.45, 9.0], [1.475, 9.0], [1.5, 9.0], [1.525, 9.0], [1.55, 9.0], [1.575, 9.0], [1.6, 9.0], [1.625, 9.0], [1.65, 9.0], [1.675, 9.0], [1.7, 9.0], [1.725, 9.0], [1.75, 9.0], [1.775, 9.0], [1.8, 9.0], [1.825, 9.0], [1.85, 9.0], [1.875, 9.0], [1.9, 9.0], [1.925, 9.0], [1.95, 9.0], [1.975, 9.0], [2.0, 9.0]], "label": "Water made"}], "points": [{"at": [2.0, 9.0], "label": "now"}], "read": ["H₂ ÷ 2 = 0.5 mol", "O₂ ÷ 1 = 0.25 mol (fixed)", "Water made = 9 g"]}], "ctl": {"type": "slider", "label": "m", "vals": ["0", "0.25", "0.5", "0.75", "1", "1.25", "1.5", "1.75", "2"], "start": 2}}}, {"h": "Equations from masses", "b": "To find an equation from reacting masses, divide each mass by its Mr to get **moles** (use 32 for O₂). Divide all the moles by the smallest. If you get a half, such as 1.5, multiply everything by 2. The whole numbers are the **balancing numbers**. For example, 0.10 mol : 0.30 mol is 1 : 3."}], "example": {"task": "Iron is made in the blast furnace: Fe₂O₃ + 3CO → 2Fe + 3CO₂. What mass of iron forms from 80 g of Fe₂O₃? (Ar: Fe = 56, O = 16)", "steps": [{"do": "Mr of Fe₂O₃ = (2 × 56) + (3 × 16) = 112 + 48 = 160.", "why": "You need the Mr of the known substance to turn its mass into moles."}, {"do": "Moles of Fe₂O₃ = 80 ÷ 160 = 0.50 mol.", "why": "Moles = mass ÷ Mr, using the substance you are given."}, {"do": "Ratio Fe₂O₃ : Fe is 1 : 2, so moles of Fe = 0.50 × 2 = 1.0 mol.", "why": "The equation shows that 1 mol of Fe₂O₃ makes 2 mol of Fe."}, {"do": "Mass of Fe = 1.0 × 56 = 56 g.", "why": "Mass = moles × relative mass of the substance you want. Iron is an element, so use its Ar, 56."}], "answer": "56 g of iron forms."}, "selfx": {"q": "In the last step, why is the Ar of Fe (56) used and not the Mr of Fe₂O₃ (160)?", "o": ["160 can only be used for the first substance written in the equation.", "The mass asked for is iron's, so you use iron's Ar, which is 56.", "56 is the smaller number, and the smaller one always gives the answer.", "The 1 : 2 ratio changes the Mr of Fe₂O₃ into 56."], "a": 1, "f": ["Wrong. The relative mass you use depends on which substance's mass you are finding, not on where it sits in the equation.", "Right. Mass = moles × relative mass, and both must belong to the same substance. Here that is 1.0 mol of Fe.", "Wrong. Size has nothing to do with it. The relative mass must belong to the substance whose mass you are finding.", "Wrong. The ratio changes the number of moles, not the Mr. Each substance's relative mass is fixed."]}, "faded": {"task": "Hydrogen peroxide decomposes: 2H₂O₂ → 2H₂O + O₂. What mass of O₂ forms from 6.8 g of H₂O₂? (Ar: H = 1, O = 16)", "given": ["Mr of H₂O₂ = 2 + 32 = 34", "Moles of H₂O₂ = 6.8 ÷ 34 = 0.20 mol"], "q": "What is the next step?", "o": ["Moles of O₂ = 0.20 × 2 = 0.40 mol, because the ratio is 2 : 1.", "Moles of O₂ = 0.20 mol, because one product forms for each reactant.", "Moles of O₂ = 0.20 ÷ 2 = 0.10 mol, because 2 mol H₂O₂ gives 1 mol O₂.", "Mass of O₂ = 0.20 × 34 = 6.8 g, using the Mr of H₂O₂."], "a": 2, "f": ["Wrong. You have turned the ratio upside down. O₂ is the smaller number in the equation, so there are fewer moles of it.", "Wrong. This assumes a 1 : 1 ratio. The equation has 2H₂O₂ for each O₂, so you must halve the moles.", "Right. 2 mol of H₂O₂ makes 1 mol of O₂, so you halve the moles. The last step is 0.10 × 32 = 3.2 g.", "Wrong. This skips the ratio and uses the Mr of the reactant. It just gives back the starting mass."]}, "trap": "Using grams as the ratio, or using the Mr of the reactant in the last step. Write 'moles of known → moles of wanted → mass of wanted' and check each Mr matches its substance.", "recap": "Convert to moles, use the equation's ratio, then convert back to mass using the Mr of the substance you want."}
{"s": "chemistry", "t": "4.3.2.5", "kind": "method", "why": "Concentration questions are common calculations worth 2 or 3 marks, and forgetting to convert cm³ to dm³ is an easy way to lose a mark.", "hook": null, "chunks": [{"h": "What concentration means", "b": "**Concentration** tells you how much **solute** is dissolved in a set volume of solution. In g/dm³ it is the number of grams of solute in every 1 dm³. More grams in the same volume means a more concentrated solution."}, {"h": "The formula and its rearrangements", "b": "**Concentration** (g/dm³) = $\\frac{\\text{mass in g}}{\\text{volume in dm}^3}$. Rearranged: mass = concentration × volume, and volume = mass ÷ concentration. The mass is the **solute** only, not the water. The volume is the whole solution."}, {"h": "Convert cm³ to dm³ first", "b": "The formula needs volume in **dm³**. Questions often give **cm³**. 1 dm³ = 1000 cm³, so divide by 1000. For example, 250 cm³ = 0.250 dm³. Do this conversion before any other step."}, {"h": "Samples keep their concentration", "b": "If you pour out part of a solution, its **concentration** stays the same. The mass of **solute** in the sample changes, because the volume changes. Convert the sample's volume to dm³, then use mass = concentration × volume."}], "example": {"task": "3.6 g of copper sulfate is dissolved in water to make 150 cm³ of solution. Calculate the concentration in g/dm³.", "steps": [{"do": "Write down what you know: mass = 3.6 g, volume = 150 cm³.", "why": "Listing the values shows that the volume is in cm³, not dm³."}, {"do": "Convert the volume: 150 ÷ 1000 = 0.150 dm³.", "why": "The formula needs dm³. Dividing by 1000 converts cm³ to dm³."}, {"do": "Write the formula: concentration = mass ÷ volume.", "why": "You are finding concentration, so no rearranging is needed."}, {"do": "Substitute: concentration = 3.6 ÷ 0.150 = 24.", "why": "Use the mass in g and the volume in dm³, so the answer comes out in g/dm³."}, {"do": "Add the unit: 24 g/dm³.", "why": "The unit is part of the answer and can earn a mark."}], "answer": "Concentration = 24 g/dm³."}, "selfx": {"q": "In the worked example, why is 150 cm³ divided by 1000 before using the formula?", "o": ["The formula needs dm³, and 1 dm³ is 1000 cm³, so you divide cm³ by 1000", "Dividing by 1000 changes the mass from grams into kilograms", "A dm³ is smaller than a cm³, so you divide to make the number smaller", "Every volume in a chemistry calculation must be divided by 1000"], "a": 0, "f": ["Correct. The formula gives g/dm³, so the volume must be in dm³. Since 1 dm³ = 1000 cm³, divide the cm³ value by 1000.", "The mass stays in grams. The conversion changes only the volume, from cm³ to dm³.", "A dm³ is bigger than a cm³ (1000 times bigger). The number gets smaller because the unit gets bigger.", "Only cm³ needs converting. A volume already in dm³ is used as it is."]}, "faded": {"task": "A solution has a concentration of 12 g/dm³. Find the mass of solute in 250 cm³ of this solution.", "given": ["Concentration = 12 g/dm³", "Volume = 250 cm³ = 0.250 dm³"], "q": "What is the next step?", "o": ["Mass = 12 ÷ 0.250 = 48 g", "Mass = 12 × 250 = 3000 g", "Mass = 12 × 0.250 = 3.0 g", "Mass = 0.250 ÷ 12 = 0.021 g"], "a": 2, "f": ["Dividing the concentration by the volume is the wrong rearrangement. Mass = concentration × volume.", "This uses 250 cm³ instead of 0.250 dm³, so it ignores the conversion you have just done.", "Correct. Mass = concentration × volume = 12 × 0.250 = 3.0 g. The volume is already in dm³.", "This divides volume by concentration, which is not a rearrangement of the formula. Mass = concentration × volume."]}, "trap": "Putting the volume in cm³ straight into the formula. 250 cm³ is 0.250 dm³, not 250 dm³. Convert first, then check that your answer is sensible.", "recap": "Convert volume to dm³ first, then use concentration = mass ÷ volume, rearranged as needed."}
{"s": "chemistry", "t": "4.3.3", "kind": "method", "why": "Paper 1 often has a 2 to 4 mark calculation on percentage yield or atom economy, and sometimes asks why industry cares about them.", "hook": null, "chunks": [{"h": "Percentage yield", "b": "The **actual yield** is the mass you really collect. The **theoretical yield** is the most the equation says you could make. Percentage yield = actual yield ÷ theoretical yield × 100. It is below 100% because of losses, side reactions or reversible reactions."}, {"h": "Finding theoretical yield", "b": "Work in **moles**. Moles = mass ÷ Mr. Use the **balancing numbers** to turn moles of reactant into moles of product. Then mass = moles × Mr. Never use the mass of the reactant as the theoretical yield."}, {"h": "Atom economy", "b": "**Atom economy** shows how much of the reactants' mass ends up as the **desired product**. $\\text{Atom economy} = \\frac{M_r \\text{ of desired product}}{\\text{sum of } M_r \\text{ of all reactants}} \\times 100$. Multiply each Mr by its **balancing number** first."}, {"h": "Why industry cares", "b": "Industry wants a **high yield**, so less reactant is wasted and costs fall. It wants a **high atom economy**, so fewer waste products form and raw materials last longer. A reaction can have a high yield but a low atom economy."}], "example": {"task": "Iron is made: Fe₂O₃ + 3CO → 2Fe + 3CO₂. Calculate the atom economy for making iron. Ar: Fe = 56, C = 12, O = 16.", "steps": [{"do": "Mr of Fe₂O₃ = (2 × 56) + (3 × 16) = 112 + 48 = 160.", "why": "Multiply each Ar by the number of atoms of that element in the formula, then add."}, {"do": "Mr of CO = 12 + 16 = 28. With the balancing number, 3CO = 3 × 28 = 84.", "why": "The 3 in the equation means three CO are used, so all three count."}, {"do": "Total Mr of reactants = 160 + 84 = 244.", "why": "Atom economy divides by all the reactants, not just one."}, {"do": "Mr of desired product: 2Fe = 2 × 56 = 112.", "why": "The balancing number applies to the desired product too."}, {"do": "Atom economy = 112 ÷ 244 × 100 = 45.9%.", "why": "This is the formula: desired product Mr ÷ total reactant Mr × 100."}], "answer": "Atom economy = 112 ÷ 244 × 100 = 45.9%. So less than half the mass of the reactants becomes iron. The rest is waste CO₂."}, "selfx": {"q": "Why does the answer use 2 × 56 for the Mr of the desired product, not just 56?", "o": ["Fe₂O₃ contains two iron atoms, so iron's Mr is doubled", "The equation has a 2 in front of Fe, so two Fe are made", "All metals have their Ar doubled in atom economy sums", "The sum of reactant Mr is 244, so the product must be doubled"], "a": 1, "f": ["That is wrong. The two Fe atoms in Fe₂O₃ are already counted in the 160. The product is doubled because of the 2 in the equation.", "Right. The balancing number 2 means the equation makes 2Fe, so its mass is 2 × 56 = 112.", "That is wrong. There is no such rule. You multiply by a number only when the equation has that balancing number.", "That is wrong. The product is not scaled to match the reactants. Its Mr comes from the equation's own balancing number."]}, "faded": {"task": "Ammonia: N₂ + 3H₂ → 2NH₃. Calculate the atom economy for making ammonia. Ar: H = 1, N = 14.", "given": ["Mr of N₂ = 28", "Mr of 3H₂ = 3 × 2 = 6", "Total Mr of reactants = 28 + 6 = 34"], "q": "What is the next step?", "o": ["Mr of desired product = 14 + 3 = 17", "Mr of desired product = 3 × 17 = 51", "Mr of desired product = 2 × 17 = 34", "Mr of desired product = 14 + 1 = 15"], "a": 2, "f": ["That is wrong. 17 is the Mr of one NH₃, but the equation makes 2NH₃. Forgetting the 2 would give 50%.", "That is wrong. The 3 belongs to H₂ in the reactants. The product has a 2 in front of NH₃.", "Right. NH₃ has Mr 14 + 3 = 17, and the equation makes 2NH₃, so 34. Then 34 ÷ 34 × 100 = 100%.", "That is wrong. NH₃ has three H atoms, so its Mr is 14 + (3 × 1) = 17, not 14 + 1."]}, "trap": "Using the Mr of only one reactant, or leaving out a balancing number such as the 3 in 3H₂. Multiply each Mr by its number, add all reactants, then divide.", "recap": "Percentage yield = actual ÷ theoretical × 100; atom economy = Mr of desired product ÷ total Mr of all reactants × 100, using balancing numbers."}
{"s": "chemistry", "t": "4.3.4", "kind": "method", "why": "Higher tier papers include multi-step calculations that link solution concentrations to gas volumes, and they are usually worth several marks, so a fixed method saves you time.", "hook": null, "chunks": [{"h": "Concentration in mol/dm³", "b": "**Concentration** is the amount of solute in 1 dm³ of solution. $\\text{moles} = \\text{concentration} \\times \\text{volume}$. The volume must be in **dm³**. To change cm³ to dm³, divide by 1000. So 25.0 cm³ is 0.0250 dm³."}, {"h": "Gas volumes", "b": "At room temperature and pressure, 1 **mole** of any gas takes up **24 dm³**. So $\\text{volume} = \\text{moles} \\times 24$, with the volume in dm³. To change dm³ to cm³, multiply by 1000. Use the same rule for every gas."}, {"h": "Link them with the ratio", "b": "The **balancing numbers** in the equation give the **mole ratio**. Work in a chain. Start from what you know and find its moles. Use the ratio to get the moles of the other substance. Then turn those moles into a volume or concentration."}], "example": {"task": "25.0 cm³ of 0.200 mol/dm³ hydrochloric acid reacts with excess magnesium. Mg + 2HCl → MgCl₂ + H₂. Find the volume of H₂ at room temperature and pressure, in cm³.", "steps": [{"do": "Convert the acid volume: 25.0 ÷ 1000 = 0.0250 dm³.", "why": "Concentration is in mol per dm³, so the volume must be in dm³."}, {"do": "Moles of HCl = 0.200 × 0.0250 = 0.00500 mol.", "why": "Moles = concentration × volume."}, {"do": "Use the ratio 2 HCl : 1 H₂. Moles of H₂ = 0.00500 ÷ 2 = 0.00250 mol.", "why": "The equation shows 2 mol of acid makes 1 mol of hydrogen, so H₂ is half."}, {"do": "Volume of H₂ = 0.00250 × 24 = 0.0600 dm³.", "why": "1 mole of any gas is 24 dm³ at room temperature and pressure."}, {"do": "Convert to cm³: 0.0600 × 1000 = 60.0 cm³.", "why": "The question asks for the answer in cm³."}], "answer": "The volume of hydrogen is 60.0 cm³."}, "selfx": {"q": "Why is the moles of HCl divided by 2 to find the moles of H₂?", "o": ["Because HCl has two atoms in its formula", "Because the equation gives 2 mol HCl for every 1 mol H₂", "Because the acid volume was halved earlier", "Because gases always have half the moles of acids"], "a": 1, "f": ["Wrong. The number of atoms in a formula is not the ratio. The balancing numbers in the equation give the ratio.", "Right. The balancing numbers show 2 mol HCl makes 1 mol H₂, so the moles of H₂ are half the moles of HCl.", "Wrong. The volume was only changed to dm³, not halved. The division comes from the equation's ratio.", "Wrong. There is no general rule like this. Each equation has its own ratio."]}, "faded": {"task": "30.0 cm³ of 0.400 mol/dm³ sulfuric acid reacts with excess magnesium. Mg + H₂SO₄ → MgSO₄ + H₂. Find the volume of H₂ at room temperature and pressure.", "given": ["Volume of acid = 30.0 ÷ 1000 = 0.0300 dm³", "Moles of H₂SO₄ = 0.400 × 0.0300 = 0.0120 mol"], "q": "What is the next step?", "o": ["Halve it, as 2 HCl gave 1 H₂ before: 0.00600 mol H₂", "Double it, as H₂SO₄ has two H atoms: 0.0240 mol H₂", "Keep it the same, as the ratio H₂SO₄ : H₂ is 1 : 1: 0.0120 mol H₂", "Divide by 24, as gas volumes use 24: 0.000500 mol H₂"], "a": 2, "f": ["Wrong. You copied the 2 : 1 ratio from the last problem. Read the ratio from this equation. It is 1 : 1.", "Wrong. Atoms in the formula do not set the ratio. The balancing numbers do, and both are 1.", "Right. The balancing numbers are both 1, so moles of H₂ = 0.0120 mol. The final volume is 0.0120 × 24 = 0.288 dm³ = 288 cm³.", "Wrong. You divide by 24 to turn a gas volume into moles. Here you have moles already, so you multiply by 24 later."]}, "trap": "Using cm³ in moles = concentration × volume, or skipping the ratio. Divide cm³ by 1000 first. Then read the ratio from the balanced equation every time, even when it is 1 : 1.", "recap": "Convert to dm³, find moles, use the equation's ratio, then use 24 dm³ per mole for gas volumes."}
{"s": "chemistry", "t": "4.4.1.1", "kind": "idea", "why": "Paper 1 often asks you to predict displacement reactions and to explain why a metal is extracted by carbon or by another method.", "hook": {"q": "Gold is found in rivers as pure metal. Iron is only found joined to other elements in compounds. What is the best explanation?", "o": ["Gold is denser, so it sinks away from other elements", "Gold is so unreactive that it does not combine with other elements", "Gold is more reactive than iron, so it separates itself out", "Iron is rarer than gold, so little of it is ever found as metal"], "a": 1, "f": ["Density does not decide whether a metal combines with other elements. Reactivity does.", "Correct. Gold is very low in the reactivity series, so it hardly reacts and stays as the metal itself.", "Reversed. A more reactive metal combines more easily with other elements, so it is found in compounds, not as pure metal.", "Iron is actually common. The difference is that it reacts easily, so it is found combined in ores."]}, "chunks": [{"h": "The reactivity series", "b": "The **reactivity series** lists metals from most to least reactive: potassium, sodium, lithium, calcium, magnesium, aluminium, carbon, zinc, iron, hydrogen, copper (then silver, gold). The higher a metal is, the more easily it forms **positive ions**. Reactions with water and dilute acid show the order. Carbon and hydrogen are non-metals included for comparison."}, {"h": "Displacement reactions", "b": "In a **displacement reaction**, a **more reactive** metal takes the place of a less reactive metal in a compound. Iron + copper sulfate → iron sulfate + copper. Iron is above copper, so it works. Copper added to iron sulfate solution does nothing, because copper is below iron."}, {"h": "Oxidation and reduction", "b": "**Oxidation** is gain of oxygen. **Reduction** is loss of oxygen. Magnesium burning in oxygen to make magnesium oxide is oxidation. Many metals are found as oxides in **ores**. An ore is rock containing enough metal to be worth extracting. Getting the metal out of its oxide is reduction."}, {"h": "Extraction using carbon", "b": "Metals **below carbon**, such as zinc and iron, are extracted by heating their oxide with carbon. Carbon is more reactive, so it takes the oxygen. Metals **above carbon** need electrolysis. Very unreactive metals, such as gold, are found as the metal itself, so no chemical reaction is needed to extract them."}], "example": {"task": "Iron is extracted by heating iron oxide with carbon. Explain why this method works for iron but cannot be used to extract aluminium from aluminium oxide.", "steps": [{"do": "Carbon is more reactive than iron, so it is higher than iron in the reactivity series.", "why": "A more reactive element can take oxygen from a less reactive one."}, {"do": "When iron oxide is heated with carbon, the carbon takes oxygen from the iron oxide. Iron metal is left.", "why": "Taking away the oxygen is what releases the metal."}, {"do": "The iron oxide loses oxygen, so it is reduced. The carbon gains oxygen, so it is oxidised.", "why": "Reduction is loss of oxygen. Oxidation is gain of oxygen."}, {"do": "Aluminium is more reactive than carbon, so carbon cannot take oxygen from aluminium oxide. Electrolysis is used instead.", "why": "Carbon is lower in the series, so it cannot displace aluminium."}], "answer": "Carbon is more reactive than iron, so it takes oxygen from iron oxide. Iron oxide is reduced and carbon is oxidised. Aluminium is more reactive than carbon, so carbon cannot remove its oxygen. Aluminium is extracted by electrolysis."}, "selfx": {"q": "Why does step 1 of the answer compare carbon with iron?", "o": ["Because carbon has a lower melting point than iron does", "Because a metal in an oxide must be more reactive than carbon", "Because iron oxide is a less reactive compound than iron is", "Because carbon can only take oxygen from a metal less reactive than itself"], "a": 3, "f": ["Melting points do not decide this. The reaction depends on the order of reactivity.", "This is the wrong way round. Carbon works only if the metal is less reactive than carbon, not more.", "Reactivity compares elements in the series, not an oxide with its metal. The comparison is between carbon and iron.", "Correct. Carbon removes oxygen only from metals below it in the series, so you must check where iron sits relative to carbon."]}, "faded": {"task": "Explain why zinc displaces copper from copper sulfate solution, but copper does not displace zinc from zinc sulfate solution.", "given": ["Zinc is more reactive than copper, so zinc is higher in the reactivity series."], "q": "Which point comes next in the explanation?", "o": ["So copper takes the place of zinc in zinc sulfate, forming copper sulfate and zinc.", "So zinc does not react, as a more reactive metal cannot displace a less reactive one.", "So zinc takes the place of copper in copper sulfate, forming zinc sulfate and copper.", "So zinc is reduced, because it gains oxygen from the copper sulfate."], "a": 2, "f": ["This has the direction wrong. The less reactive metal, copper, cannot take the place of zinc.", "This reverses the rule. A more reactive metal can displace a less reactive one.", "Correct. The more reactive zinc takes copper's place in the compound. You can then add that copper is less reactive, so it cannot displace zinc.", "Zinc does not gain oxygen here; it swaps places with copper. Also, gaining oxygen would be oxidation, not reduction."]}, "trap": "Getting displacement the wrong way round, or saying carbon can extract any metal. Check the series: only a more reactive metal displaces another, and carbon only removes oxygen from oxides of metals below it.", "recap": "A more reactive element displaces a less reactive one, so carbon can extract only metals below it in the series, by reduction (removing oxygen)."}
{"s": "chemistry", "t": "4.4.1.4", "kind": "idea", "why": "Higher-tier questions give you an equation and ask which substance is oxidised or reduced, and you earn the marks by explaining it in terms of electrons.", "hook": {"q": "A sodium atom, Na, becomes a sodium ion, Na⁺. What has happened to its electrons?", "o": ["It has gained one electron", "It has lost one proton", "It has lost one electron", "It has gained one neutron"], "a": 2, "f": ["Gaining an electron would make the particle more negative. Na⁺ is positive, so an electron has been removed.", "Protons are in the nucleus and do not move in chemical reactions. Only electrons are transferred.", "Correct. Electrons are negative. Removing one negative charge leaves the particle with an overall 1+ charge.", "Neutrons have no charge and stay in the nucleus. They do not change an atom into an ion."]}, "chunks": [{"h": "OIL RIG", "b": "**Oxidation** Is Loss of electrons. **Reduction** Is Gain of electrons. That spells OIL RIG. Oxidation and reduction always happen together in the same reaction. A reaction where both happen is called a **redox** reaction."}, {"h": "Half-equations", "b": "A **half-equation** shows one change only, with electrons (e⁻) written in. Oxidation has electrons on the right: Mg → Mg²⁺ + 2e⁻. Reduction has electrons on the left: Cu²⁺ + 2e⁻ → Cu. Electrons are negative, so gaining them makes a **charge** fall."}, {"h": "Spotting it in equations", "b": "Look for particles whose **charge** changes. If the charge goes up, electrons were lost, so it is oxidised. If the charge goes down, electrons were gained, so it is reduced. Ions that stay the same are **spectator ions**. They are not oxidised or reduced."}], "example": {"task": "Zinc reacts with silver nitrate solution: Zn + 2Ag⁺ → Zn²⁺ + 2Ag. Explain why this is a redox reaction.", "steps": [{"do": "Zn atoms become Zn²⁺ ions. The charge goes from 0 to 2+, so each zinc atom loses two electrons: Zn → Zn²⁺ + 2e⁻.", "why": "A rise in positive charge means electrons have been lost."}, {"do": "Loss of electrons is oxidation, so zinc is oxidised.", "why": "This links the electron change to the word oxidation (OIL)."}, {"do": "Ag⁺ ions become Ag atoms. The charge goes from 1+ to 0, so each ion gains one electron: Ag⁺ + e⁻ → Ag.", "why": "A fall in charge means electrons have been gained."}, {"do": "Gain of electrons is reduction, so silver ions are reduced.", "why": "This links the electron change to the word reduction (RIG)."}, {"do": "The two electrons lost by one Zn atom are gained by two Ag⁺ ions. Oxidation and reduction happen together.", "why": "A redox reaction needs both. Electrons lost equal electrons gained."}], "answer": "Zinc atoms lose two electrons to form Zn²⁺, so zinc is oxidised. Silver ions gain one electron each to form Ag atoms, so they are reduced. Both happen at the same time, so it is a redox reaction."}, "selfx": {"q": "Why does step 5 say two Ag⁺ ions are needed for each zinc atom?", "o": ["Each Ag⁺ ion loses one electron, so two ions give the two electrons zinc needs", "Each Ag⁺ ion gains only one electron, but each Zn atom loses two electrons", "Silver ions are reduced, so they must always react in pairs", "Zinc is reduced, so it needs two silver ions to take its electrons"], "a": 1, "f": ["Ag⁺ ions gain electrons, not lose them. Zinc is the one giving electrons away.", "Correct. Electrons lost must equal electrons gained. Two electrons from zinc need two Ag⁺ ions taking one each.", "Reduced particles do not always come in pairs. The number needed depends on the electrons each one gains.", "Zinc loses electrons, so it is oxidised, not reduced. Mixing up the two reverses the whole explanation."]}, "faded": {"task": "Iron reacts with copper(II) sulfate solution: Fe + Cu²⁺ → Fe²⁺ + Cu. Explain why this is a redox reaction.", "given": ["Fe atoms become Fe²⁺ ions, so each Fe atom loses two electrons: Fe → Fe²⁺ + 2e⁻.", "Loss of electrons is oxidation, so iron is oxidised."], "q": "Which is the next step in the explanation?", "o": ["Cu²⁺ becomes Cu, so the charge goes up and the ion is reduced", "Cu²⁺ becomes Cu, so each ion loses two electrons and is oxidised", "Cu²⁺ becomes Cu, so each ion gains two electrons and is oxidised", "Cu²⁺ becomes Cu, so each ion gains two electrons and is reduced"], "a": 3, "f": ["The charge goes from 2+ to 0, so it falls. A rise in charge would mean oxidation, not reduction.", "Electrons are gained here, not lost. Copper ions go from 2+ to 0, which needs two electrons added.", "The electron gain is right, but gaining electrons is reduction. Oxidation is loss (OIL RIG).", "Correct. The charge falls from 2+ to 0, so each ion gains two electrons. Gain of electrons is reduction."]}, "trap": "Thinking reduction makes the charge go up. Electrons are negative, so gaining them makes the charge fall (Cu²⁺ → Cu). Check by writing the half-equation: electrons on the left means reduction.", "recap": "OIL RIG: oxidation is loss of electrons, reduction is gain, and they always happen together in a redox reaction."}
{"s": "chemistry", "t": "4.4.2.1", "kind": "idea", "why": "Exam questions ask you to name the products of acid reactions and to describe the required practical for making pure, dry crystals of a soluble salt.", "hook": {"q": "Vinegar is an acid. It is poured onto limescale (calcium carbonate) and fizzes. Which gas is most likely in the bubbles?", "o": ["Hydrogen", "Carbon dioxide", "Oxygen", "Chlorine"], "a": 1, "f": ["Hydrogen is made when an acid reacts with a metal. Limescale is a carbonate, not a metal.", "Right. Acids react with carbonates to give a salt, water and carbon dioxide. The fizzing is carbon dioxide escaping.", "Oxygen is not a product of any of the common acid reactions. Do not confuse it with the carbon dioxide made here.", "Chlorine is not made when an acid reacts with a carbonate. Hydrochloric acid contains chloride, but that ends up in the salt."]}, "chunks": [{"h": "Three acid reactions", "b": "An acid reacts with three types of substance to make a salt.\n• acid + **metal** → salt + hydrogen\n• acid + **base** (metal oxide or hydroxide) → salt + water\n• acid + **carbonate** → salt + water + carbon dioxide\nCarbonates fizz because a gas is made."}, {"h": "Naming salts and gases", "b": "The salt's first name comes from the metal in the other reactant. The second name comes from the acid: hydrochloric acid gives **chlorides**, sulfuric acid gives **sulfates**, nitric acid gives **nitrates**. Example: zinc oxide + sulfuric acid → zinc sulfate + water. Tests: hydrogen gives a squeaky pop with a lit splint. Carbon dioxide turns limewater milky."}, {"h": "Adding the solid in excess", "b": "To make a soluble salt, warm the acid. Add an **insoluble** solid (a base, carbonate or metal) a little at a time, stirring. Keep adding until some solid is left over. This is **excess**. It means all the acid has reacted. The acid limits how much salt forms, not the solid."}, {"h": "Getting dry crystals", "b": "**Filter** the mixture. The excess solid stays in the filter paper. The **filtrate** is salt solution only. Heat it gently in an evaporating basin to remove some water. Stop when crystals start to form, then leave it to cool. Filter off the crystals and pat them dry with filter paper."}], "example": {"task": "Describe how to make pure, dry crystals of copper sulfate from copper oxide (insoluble) and dilute sulfuric acid.", "steps": [{"do": "Measure dilute sulfuric acid into a beaker and warm it gently. Add copper oxide a little at a time, stirring.", "why": "The base reacts with the acid to make copper sulfate and water. Warming speeds this up."}, {"do": "Keep adding copper oxide until some black solid stays at the bottom, undissolved.", "why": "Leftover solid shows the copper oxide is in excess, so all the acid has reacted."}, {"do": "Filter the mixture and keep the filtrate.", "why": "Copper oxide is insoluble, so the excess stays in the paper. Only copper sulfate solution passes through."}, {"do": "Heat the filtrate gently in an evaporating basin to remove some water. Stop when crystals begin to form, then leave it to cool.", "why": "Removing water makes the solution concentrated. Crystals form as it cools."}, {"do": "Filter off the crystals and pat them dry with filter paper.", "why": "This removes the remaining solution and leaves pure, dry copper sulfate crystals."}], "answer": "Warm the acid and add copper oxide, stirring, until some stays undissolved. Filter off the excess. Heat the filtrate to remove some water until crystals begin to form. Leave to cool, filter off the crystals and pat them dry with filter paper."}, "selfx": {"q": "Why does the answer filter the mixture before heating it to make crystals?", "o": ["To remove the leftover acid from the solution", "To take out water so that crystals can form", "To remove the excess copper oxide, which is insoluble", "To make more copper sulfate form from the extra copper oxide"], "a": 2, "f": ["No acid is left. The excess solid made sure it all reacted. Filtering cannot remove dissolved acid anyway.", "Removing water is the job of heating and evaporation, not filtering. Filtering separates solid from liquid.", "Right. The unreacted copper oxide does not dissolve, so filtering takes it out. Only copper sulfate solution is left to crystallise.", "Excess does not make more salt. The amount of salt is set by the acid, and filtering does not start any reaction."]}, "faded": {"task": "Describe how to make pure, dry zinc sulfate crystals from zinc carbonate (insoluble) and dilute sulfuric acid.", "given": ["Warm the acid and add zinc carbonate a little at a time, stirring, until the fizzing stops.", "Keep adding until some zinc carbonate stays undissolved at the bottom."], "q": "What is the next step?", "o": ["Boil the mixture until it is completely dry in an evaporating basin", "Add more acid until the leftover zinc carbonate has all dissolved", "Add a few drops of indicator, then add alkali until the mixture is neutral", "Filter the mixture and keep the filtrate, which is zinc sulfate solution"], "a": 3, "f": ["Drying out the whole mixture would leave the excess zinc carbonate mixed in with the salt. The solid must be filtered off first.", "Adding more acid would dissolve the excess, but then acid is left in the solution. The salt would not be pure.", "No acid is left to neutralise. Adding alkali and indicator would put new substances in, so the salt would not be pure.", "Right. The excess zinc carbonate is insoluble, so filtering removes it. The filtrate is only zinc sulfate solution, ready to crystallise."]}, "trap": "Saying the excess solid makes more salt or speeds up the reaction. The acid limits how much salt forms. The excess only makes sure no acid is left.", "recap": "Add the insoluble solid in excess so all the acid reacts, filter off the extra, then crystallise the salt solution."}
{"s": "chemistry", "t": "4.4.2.4", "kind": "method", "why": "Titration questions in separate science Paper 1 give marks for the end-point colour, choosing concordant titres and calculating a concentration.", "hook": null, "chunks": [{"h": "pH and indicators", "b": "The **pH scale** runs from 0 to 14. Below 7 is acidic, 7 is neutral and above 7 is alkaline. **Phenolphthalein** is pink in alkali and colourless in acid. It changes sharply, so it suits titrations."}, {"h": "Running a titration", "b": "Use a pipette to put 25.0 cm³ of alkali in a flask. Add a few drops of phenolphthalein, which turns it pink. Add acid from a burette, swirling. The **end-point** is when the pink just disappears and the solution is colourless. The volume of acid used is the **titre**."}, {"h": "Choosing the titre", "b": "Do a rough run first. Then repeat, adding acid drop by drop near the end-point. **Concordant** results are within 0.10 cm³ of each other. Ignore the rough run and take the **mean** of the concordant results."}, {"h": "Finding concentration", "b": "Moles = **concentration** × volume in dm³. Divide cm³ by 1000 to get dm³. Find the moles of the known solution first. Then use the **balanced equation** ratio to find the moles of the other. Concentration = moles ÷ volume in dm³."}], "example": {"task": "25.0 cm³ NaOH is titrated with 0.200 mol/dm³ HCl. Titres (cm³): 21.20 (rough), 20.45, 20.35, 20.40. Find the NaOH concentration. NaOH + HCl → NaCl + H₂O", "steps": [{"do": "Ignore 21.20. The other three are within 0.10 cm³ of each other. Mean = (20.45 + 20.35 + 20.40) ÷ 3 = 61.20 ÷ 3 = 20.40 cm³.", "why": "The rough run is not accurate. Only concordant results go into the mean."}, {"do": "Convert the mean titre: 20.40 ÷ 1000 = 0.02040 dm³.", "why": "Concentration is in mol/dm³, so the volume must be in dm³."}, {"do": "Moles of HCl = 0.200 × 0.02040 = 0.00408 mol.", "why": "Moles = concentration × volume. HCl is the solution of known concentration."}, {"do": "The equation shows a 1 : 1 ratio, so moles of NaOH = 0.00408 mol.", "why": "One NaOH reacts with one HCl, so the moles are equal."}, {"do": "Concentration of NaOH = 0.00408 ÷ 0.0250 = 0.163 mol/dm³.", "why": "Concentration = moles ÷ volume. 25.0 cm³ = 0.0250 dm³. Give 3 significant figures."}], "answer": "The concentration of the NaOH is 0.163 mol/dm³ (3 significant figures)."}, "selfx": {"q": "Why is 21.20 cm³ left out when the mean titre is worked out?", "o": ["It is the first result, and the first result in any set of data is always removed.", "It is not within 0.10 cm³ of the others, so it is not concordant. It was a rough run.", "It is the highest value, and the highest value is always removed before taking a mean.", "A mean must use exactly three results, so one of the four has to be left out."], "a": 1, "f": ["Wrong. Results are chosen by how close they are, not by their position. The first run is dropped here only because it was a rough run.", "Right. The rough run is done quickly and overshoots. Only titres within 0.10 cm³ of each other are concordant and go into the mean.", "Wrong. You never remove a value just for being the highest. You remove results that are not concordant.", "Wrong. You use all the concordant results, however many there are. The number three is a coincidence in this question."], "hook_note": null}, "faded": {"task": "25.0 cm³ KOH needs a mean titre of 18.0 cm³ of 0.0500 mol/dm³ H₂SO₄. 2KOH + H₂SO₄ → K₂SO₄ + 2H₂O. Find the KOH concentration.", "given": ["Mean titre: 18.0 cm³ = 0.0180 dm³", "Moles H₂SO₄ = 0.0500 × 0.0180 = 0.000900 mol"], "q": "What is the next step?", "o": ["Moles KOH = 0.000900 mol, because the moles of acid and alkali are always equal.", "Concentration of KOH = 0.000900 ÷ 0.0180 = 0.0500 mol/dm³, using the titre volume.", "Moles KOH = 0.000900 × 2 = 0.00180 mol, because 2 KOH react with each H₂SO₄.", "Moles KOH = 0.000900 ÷ 2 = 0.000450 mol, because H₂SO₄ has two hydrogens."], "a": 2, "f": ["Wrong. The moles are equal only when the ratio is 1 : 1. Here the equation shows 2 KOH to 1 H₂SO₄.", "Wrong. This uses the acid's moles with the acid's volume, which just gives back the acid's concentration. You need the moles of KOH first.", "Right. The equation shows 2 KOH for each 1 H₂SO₄, so the moles of KOH are double the moles of acid.", "Wrong. The ratio is applied upside down. KOH has the bigger number in the equation, so its moles are larger, not smaller."]}, "trap": "Saying the indicator turns pink at the end-point. In this titration the alkali in the flask is already pink, so the end-point is when the pink just disappears to colourless.", "recap": "Take the mean of concordant titres, convert cm³ to dm³, use moles = concentration × volume, then apply the equation's ratio."}
{"s": "chemistry", "t": "4.4.2.6", "kind": "idea", "why": "Higher tier questions often ask you to explain pH differences between acids using ionisation, while keeping strength and concentration clearly apart.", "hook": {"q": "Two acids both have concentration 0.1 mol/dm³. One has pH 1 and the other pH 3. What best explains the difference?", "o": ["The pH 3 acid has more water in it, so it is more dilute.", "In the pH 3 acid, fewer molecules ionise, so there are fewer H⁺ ions.", "The pH 3 acid has more H⁺ ions, because a higher pH means more H⁺.", "The pH 1 acid has fewer moles of acid dissolved in each dm³."], "a": 1, "f": ["The concentrations are the same, so the amount of acid per dm³ is equal. Dilution is not the cause of the difference.", "Right. A higher pH means a lower H⁺ concentration. With equal concentrations, the difference comes from how much each acid ionises.", "A higher pH means fewer H⁺ ions, not more. Low pH means a high H⁺ concentration.", "Equal concentration means equal moles of acid per dm³. The pH 1 acid does not contain less acid."]}, "chunks": [{"h": "Strong acids", "b": "A **strong acid** is **completely ionised** in water. Every molecule splits to release a hydrogen ion. For example: HCl → H⁺ + Cl⁻. Hydrochloric, nitric and sulfuric acids are strong acids. The single arrow shows the reaction goes to completion."}, {"h": "Weak acids", "b": "A **weak acid** is only **partially ionised** in water. Most of its molecules stay whole. Ethanoic, citric and carbonic acids are weak acids. For example: CH₃COOH ⇌ CH₃COO⁻ + H⁺. The **⇌** sign shows the reaction is reversible, so ions and molecules are both present."}, {"h": "Strength or concentration?", "b": "**Strength** is how much of an acid ionises in water. **Concentration** is how much acid is dissolved in each dm³, in mol/dm³. They are independent. You can have a dilute strong acid or a concentrated weak acid. Never use 'strong' to mean 'concentrated'."}, {"h": "Linking to pH", "b": "**pH** measures the **hydrogen ion concentration**. A lower pH means more H⁺ ions. For acids of equal concentration, the strong acid has the lower pH. A tenfold rise in H⁺ concentration lowers the pH by 1."}], "example": {"task": "Explain why 0.1 mol/dm³ ethanoic acid has a higher pH than 0.1 mol/dm³ hydrochloric acid.", "steps": [{"do": "State that both solutions have the same concentration, so they contain the same number of moles of acid in each dm³.", "why": "This rules out concentration as the reason for the pH difference."}, {"do": "Hydrochloric acid is a strong acid. It is completely ionised: HCl → H⁺ + Cl⁻. Every molecule releases an H⁺ ion.", "why": "This gives the highest possible H⁺ concentration for that concentration of acid."}, {"do": "Ethanoic acid is a weak acid. It is only partially ionised: CH₃COOH ⇌ CH₃COO⁻ + H⁺. Most molecules stay unionised.", "why": "Only a small fraction of the molecules release H⁺."}, {"do": "So ethanoic acid has a lower H⁺ concentration. pH measures H⁺ concentration, so its pH is higher.", "why": "This links ionisation to pH and answers the question directly."}], "answer": "Both acids have the same concentration. HCl is strong, so it is fully ionised and gives a high H⁺ concentration. Ethanoic acid is weak, so it is only partly ionised and gives a lower H⁺ concentration. So its pH is higher."}, "selfx": {"q": "Why does the answer write ⇌ for ethanoic acid but → for hydrochloric acid?", "o": ["Ethanoic acid is more concentrated, so its reaction must go both ways.", "Hydrochloric acid ionises more slowly, so it only needs a forward arrow.", "Ethanoic acid ionises only partly, so the change is reversible and molecules remain.", "Ethanoic acid is the stronger acid, so it needs the double arrow."], "a": 2, "f": ["Concentration is the same for both acids here. The arrow shows the extent of ionisation, not how much acid is dissolved.", "The arrow does not show speed. A single arrow shows that the reaction goes to completion, so all the HCl ionises.", "Right. ⇌ shows a reversible reaction that does not go to completion. Ethanoic acid molecules and ions are both present.", "Ethanoic acid is the weaker acid here. The ⇌ sign shows it is only partly ionised."]}, "faded": {"task": "Explain why citric acid has a higher pH than nitric acid when both solutions have the same concentration.", "given": ["Both solutions contain the same number of moles of acid per dm³, so concentration is not the cause.", "Nitric acid is a strong acid, so it is completely ionised: HNO₃ → H⁺ + NO₃⁻."], "q": "Which statement should come next?", "o": ["Citric acid is weak, so it is only partly ionised and gives a lower H⁺ concentration.", "Citric acid is weak, so it is more dilute and gives fewer H⁺ ions.", "Citric acid is weak, so it does not ionise at all and gives no H⁺ ions.", "Citric acid is weak, so each H⁺ ion it gives is less acidic than in nitric acid."], "a": 0, "f": ["Right. Partial ionisation means a lower H⁺ concentration than in nitric acid. So the pH of citric acid is higher.", "Weak does not mean dilute. The concentrations are the same. The difference is in how much each acid ionises.", "A weak acid does ionise, but only partly. It still gives some H⁺ ions, which is why its pH is below 7.", "All H⁺ ions are identical. The difference is the number of H⁺ ions in solution, not how acidic each one is."]}, "trap": "Writing that a weak acid is 'dilute' or a strong acid is 'concentrated'. Strength is the extent of ionisation. Concentration is the amount of acid per dm³. Always name which one you mean.", "recap": "A strong acid is fully ionised and a weak acid only partly; this is separate from concentration, which is the amount of acid per dm³."}
{"s": "chemistry", "t": "4.4.3.1", "kind": "idea", "why": "Exam questions often ask you to explain how aluminium is extracted, or to say what forms at each electrode, so you need the reasons as well as the facts.", "hook": {"q": "Solid sodium chloride does not conduct electricity, but molten sodium chloride does. What is the best reason?", "o": ["Melting creates new electrons that carry the current", "Melting frees the ions, so charged particles can move", "Melting changes the ionic bonds into metallic bonds", "Melting splits the compound into sodium and chlorine atoms"], "a": 1, "f": ["No new electrons are made. The electrons stay in the ions. Current in a liquid is carried by moving ions.", "Right. In the solid, ions are fixed in a lattice. When molten, they are free to move and carry charge.", "The bonding stays ionic. Metallic bonding only exists in metals, not in compounds like sodium chloride.", "Melting only frees the ions. It does not split the compound into atoms. That happens later, at the electrodes."]}, "chunks": [{"h": "What electrolysis does", "b": "**Electrolysis** uses electricity to break down an ionic compound. The compound must be molten or dissolved, so its ions can move. This liquid is the **electrolyte**. Current enters and leaves it through two **electrodes**. Solid ionic compounds do not conduct, because their ions are fixed in place."}, {"h": "Ions go to opposite electrodes", "b": "Positive ions go to the negative electrode, the **cathode**. They gain electrons. Negative ions go to the positive electrode, the **anode**. They lose electrons. So in a molten compound, the metal forms at the cathode and the non-metal at the anode. Molten lead bromide gives lead at the cathode and bromine at the anode."}, {"h": "Why aluminium needs electrolysis", "b": "Aluminium is **more reactive than carbon**, so carbon cannot remove it from its ore. Electrolysis is used instead. The ore, bauxite, contains **aluminium oxide**, which melts above 2000 °C. It is dissolved in molten **cryolite**. This mixture melts at a much lower temperature, which saves energy and cost."}, {"h": "Inside the aluminium cell", "b": "Al³⁺ ions move to the cathode and gain electrons, forming **aluminium**. O²⁻ ions move to the anode and lose electrons, forming **oxygen**. The anodes are carbon. The hot oxygen reacts with them to make **carbon dioxide**, so the anodes wear away and must be replaced."}], "example": {"task": "Explain how aluminium is extracted from aluminium oxide by electrolysis. Include why cryolite is used and why the anodes need replacing.", "steps": [{"do": "Aluminium oxide is dissolved in molten cryolite.", "why": "Al₂O₃ melts above 2000 °C. Cryolite lowers the melting point, saving energy. The ions are free to move in the liquid."}, {"do": "Al³⁺ ions move to the negative electrode (cathode). They gain electrons and form aluminium.", "why": "Positive ions are attracted to the cathode. A metal forms there."}, {"do": "O²⁻ ions move to the positive electrode (anode). They lose electrons and form oxygen.", "why": "Negative ions are attracted to the anode. A non-metal forms there."}, {"do": "The oxygen reacts with the hot carbon anodes to make carbon dioxide, so the anodes burn away and are replaced.", "why": "This links the product at the anode to a real cost of the process."}], "answer": "Aluminium oxide is dissolved in molten cryolite to lower its melting point and save energy. Al³⁺ ions gain electrons at the cathode to make aluminium. O²⁻ ions lose electrons at the anode to make oxygen. The oxygen reacts with the carbon anodes to make carbon dioxide, so they must be replaced."}, "selfx": {"q": "Why does the answer say the Al³⁺ ions move to the cathode?", "o": ["The cathode is positive, so Al³⁺ ions are drawn towards it", "Al³⁺ ions are heavier than O²⁻ ions, so they sink towards the cathode", "Positive ions are attracted to the negative electrode, which is the cathode", "The cathode is where electrons are lost, so positive ions are pulled there"], "a": 2, "f": ["The cathode is the negative electrode. Positive ions would be repelled by a positive electrode.", "Mass does not decide direction. Ions move because of opposite charges attracting, not because of weight.", "Right. Opposite charges attract, so positive ions go to the negative electrode, the cathode.", "Positive ions gain electrons at the cathode, not lose them. The attraction is due to charge, not electron loss."]}, "faded": {"task": "Molten lead bromide, PbBr₂, is electrolysed. Explain what is formed at each electrode.", "given": ["Lead bromide must be molten so its ions are free to move and carry the current.", "Pb²⁺ ions are positive, so they move to the cathode."], "q": "What is the next step in the answer?", "o": ["Pb²⁺ ions lose electrons at the cathode and become lead atoms", "Pb²⁺ ions gain electrons at the cathode and become bromine gas", "Pb²⁺ ions stay in the liquid while electrons carry the current through it", "Pb²⁺ ions gain electrons at the cathode and become lead atoms"], "a": 3, "f": ["Positive ions gain electrons, not lose them. Gaining electrons turns Pb²⁺ into neutral lead.", "Bromine comes from the bromide ions at the anode. A metal ion at the cathode makes the metal.", "Electrons do not travel through the electrolyte. Ions carry the current there. The Pb²⁺ ions are discharged at the cathode.", "Right. Pb²⁺ ions gain two electrons each at the cathode to form lead metal. Bromide ions are discharged at the anode."]}, "trap": "Saying cryolite is a catalyst or that it speeds up the reaction. It does not. Its job is to lower the melting point of the electrolyte, which saves energy and cost.", "recap": "Molten ionic compounds: metal forms at the negative cathode, non-metal at the positive anode; cryolite lowers aluminium oxide's melting point."}
{"s": "chemistry", "t": "4.4.3.4", "kind": "idea", "why": "Exam questions often ask what forms at each electrode, and you must give a reason using reactivity at the cathode and halide ions at the anode.", "hook": {"q": "Water, H₂O, splits very slightly into ions. Which two ions does it make?", "o": ["H₂⁺ and O²⁻", "H⁻ and OH⁺", "H⁺ and OH⁻", "H⁺ and O²⁻"], "a": 2, "f": ["Water does not form H₂⁺ or O²⁻. The oxygen stays joined to one hydrogen. Water splits into one H⁺ and one OH⁻.", "The charges are the wrong way round. Hydrogen forms the positive ion, H⁺, and the hydroxide ion, OH⁻, is negative.", "Correct. Water splits slightly into H⁺ and OH⁻. These ions are in every aqueous solution, along with the ions of the dissolved compound.", "Water does not make O²⁻. The oxygen stays joined to one hydrogen as the hydroxide ion, OH⁻."]}, "chunks": [{"h": "Two sets of ions", "b": "An **aqueous solution** has two sources of ions. The dissolved compound gives its ions. Water gives a few H⁺ and OH⁻ ions. At each electrode, two ions compete. Only one is **discharged**, meaning it gains or loses electrons. The other stays in solution."}, {"h": "The cathode rule", "b": "At the **cathode** (negative), positive ions are attracted: H⁺ and the metal ion. If the metal is **less reactive than hydrogen** (copper, silver), the metal forms. If it is more reactive (sodium, potassium, magnesium, zinc), **hydrogen** forms: 2H⁺ + 2e⁻ → H₂."}, {"h": "The anode rule", "b": "At the **anode** (positive), negative ions are attracted: OH⁻ and the negative ion from the compound. If a **halide ion** (Cl⁻, Br⁻, I⁻) is present, the halogen forms. If not, **oxygen** forms from OH⁻. Sulfate and nitrate ions are not discharged."}, {"h": "Practical and tests", "b": "Use **inert electrodes** such as graphite, so they do not react. Collect gases in upturned test tubes. Hydrogen gives a **squeaky pop** with a lit splint. Oxygen relights a glowing splint. Chlorine **bleaches** damp litmus paper. Copper coats the cathode as a brown solid."}], "example": {"task": "Sodium chloride solution is electrolysed using inert electrodes. Explain what forms at each electrode.", "steps": [{"do": "List the ions present: Na⁺ and Cl⁻ from the compound, H⁺ and OH⁻ from water.", "why": "Every aqueous solution has ions from the compound and from water."}, {"do": "At the cathode, Na⁺ and H⁺ compete. Sodium is more reactive than hydrogen.", "why": "Positive ions go to the cathode. Reactivity decides which one is discharged."}, {"do": "So H⁺ ions gain electrons and hydrogen gas forms: 2H⁺ + 2e⁻ → H₂.", "why": "The more reactive metal ion stays in solution. The less reactive ion, H⁺, is discharged."}, {"do": "At the anode, Cl⁻ and OH⁻ compete. Chloride is a halide ion.", "why": "Negative ions go to the anode. A halide present decides the product."}, {"do": "So chloride ions lose electrons and chlorine gas forms: 2Cl⁻ → Cl₂ + 2e⁻.", "why": "Oxygen only forms when no halide ions are present."}], "answer": "Hydrogen forms at the cathode because sodium is more reactive than hydrogen. Chlorine forms at the anode because chloride is a halide ion. Na⁺ and OH⁻ stay in solution."}, "selfx": {"q": "Why does the answer say hydrogen forms at the cathode, not sodium?", "o": ["Sodium ions are attracted to the anode, so only H⁺ ions reach the cathode", "Sodium is more reactive than hydrogen, so Na⁺ stays in solution and H⁺ is discharged", "Chloride ions are present, and halides always make hydrogen at the cathode", "Hydrogen is a gas, and gases always form before metals at the cathode"], "a": 1, "f": ["Sodium ions are positive, so they go to the cathode too. They compete with H⁺ there, and reactivity decides which is discharged.", "Correct. Sodium is more reactive than hydrogen, so Na⁺ ions stay in solution. The less reactive H⁺ ions gain electrons and form hydrogen.", "Halide ions affect the anode, not the cathode. The cathode product depends only on the metal's reactivity compared with hydrogen.", "There is no rule that gases come first. Copper, which is less reactive than hydrogen, forms at the cathode instead of hydrogen."]}, "faded": {"task": "Copper nitrate solution is electrolysed using inert electrodes. Explain what forms at the cathode.", "given": ["Ions present: Cu²⁺ and NO₃⁻ from the compound, H⁺ and OH⁻ from water.", "At the cathode, Cu²⁺ and H⁺ ions compete."], "q": "What is the next step?", "o": ["Hydrogen forms, because H⁺ ions come from water and water is always present", "Hydrogen forms, because copper is more reactive than hydrogen", "Copper forms, because copper is less reactive than hydrogen", "Copper forms, because metals are always discharged at the cathode"], "a": 2, "f": ["Water's H⁺ ions do not win just because water is present. You must compare the metal's reactivity with hydrogen.", "This reverses the reactivity. Copper is below hydrogen in the reactivity series, so it is less reactive, not more.", "Correct. Copper is less reactive than hydrogen, so Cu²⁺ ions gain electrons and copper forms at the cathode: Cu²⁺ + 2e⁻ → Cu.", "Metals are not always discharged. A metal more reactive than hydrogen, such as sodium, stays in solution and hydrogen forms instead."]}, "trap": "Writing that hydrogen forms for every solution, or that sulfur or nitrogen forms at the anode. Compare the metal with hydrogen. At the anode, check for a halide first, otherwise oxygen forms.", "recap": "Cathode: the metal if less reactive than hydrogen, otherwise hydrogen. Anode: the halogen if a halide is present, otherwise oxygen."}
{"s": "chemistry", "t": "4.4.3.5", "kind": "method", "why": "Higher-tier electrolysis questions often ask for an electrode half equation, worth 1 or 2 marks, and a fixed method earns these marks reliably.", "hook": null, "chunks": [{"h": "Which electrode, which change", "b": "Positive ions move to the cathode (negative electrode). They gain electrons, which is **reduction**. Negative ions move to the anode (positive electrode). They lose electrons, which is **oxidation**. Decide the electrode first. It tells you which side the electrons go on."}, {"h": "Where the electrons go", "b": "Electrons are written as e⁻. At the cathode, ions gain electrons, so the e⁻ go on the **left** of the arrow. At the anode, ions lose electrons, so the e⁻ go on the **right**. A **half equation** shows only one electrode's change."}, {"h": "Balance atoms, then charge", "b": "First write the correct formulas. Non-metal gases are **diatomic molecules**: H₂, Cl₂, Br₂, O₂. Balance the atoms. Then add electrons until the **total charge** on the left equals the total charge on the right. Check both sides at the end."}], "example": {"task": "Molten aluminium oxide contains Al³⁺ and O²⁻ ions. It is electrolysed. Write the half equation for each electrode.", "steps": [{"do": "Cathode: Al³⁺ ions are positive, so they move to the cathode and gain electrons. Write Al³⁺ + e⁻ → Al.", "why": "Positive ions are reduced at the cathode, so electrons go on the left."}, {"do": "Balance the charge. The left needs a total charge of 0 to match Al. So Al³⁺ + 3e⁻ → Al.", "why": "3+ and 3− add up to 0, the charge on an Al atom."}, {"do": "Anode: O²⁻ ions move to the anode and lose electrons. Oxygen forms O₂ molecules, so write 2O²⁻ → O₂.", "why": "Oxygen gas is O₂, so two ions are needed to balance the atoms."}, {"do": "Balance the charge. The left has 2 × 2− = 4−. The right has 0. Add 4e⁻ to the right: 2O²⁻ → O₂ + 4e⁻.", "why": "Electrons are lost at the anode, so they go on the right."}, {"do": "Check both equations. Cathode: 0 = 0. Anode: 4− = 4−. The atoms also match.", "why": "A half equation must balance in both atoms and charge."}], "answer": "Cathode: Al³⁺ + 3e⁻ → Al. Anode: 2O²⁻ → O₂ + 4e⁻."}, "selfx": {"q": "Why are 4 electrons added on the right in 2O²⁻ → O₂ + 4e⁻?", "o": ["To balance the number of oxygen atoms, which is 4 on the right", "Because an O₂ molecule has a charge of 4−, so it needs 4 electrons", "Because the 2 oxide ions have a total charge of 4−, and the right must match it", "Because aluminium gains 3 electrons, so oxygen must lose 4 to even it out"], "a": 2, "f": ["Wrong. The atoms are already balanced with 2 on each side. The electrons are added to balance charge, not atoms.", "Wrong. O₂ is a neutral molecule. The 4− comes from the two O²⁻ ions on the left.", "Right. Two O²⁻ ions give 4− on the left. Four electrons (4−) on the right make the total charge equal.", "Wrong. Each half equation balances by itself. The number of electrons comes from the ions' charges, not from the other electrode."]}, "faded": {"task": "Molten magnesium iodide contains Mg²⁺ and I⁻ ions. Write the half equation at the anode.", "given": ["I⁻ ions are negative, so they go to the anode and lose electrons.", "Iodine is a molecule, I₂. Balance the atoms: 2I⁻ → I₂."], "q": "Which equation completes the anode half equation?", "o": ["2I⁻ + 2e⁻ → I₂", "2I⁻ → I₂ + 2e⁻", "2I⁻ → I₂ + e⁻", "2I⁻ → I₂ + 4e⁻"], "a": 1, "f": ["Wrong. This puts the electrons on the left, which is gaining electrons. Anode ions lose electrons, so they go on the right. The charge is also unbalanced.", "Right. Two I⁻ ions give 2− on the left. Two electrons on the right give 2−. Atoms and charge both balance.", "Wrong. One electron gives 1− on the right, but the left has 2−. Count the charge of every ion, not just one.", "Wrong. Four electrons give 4− on the right, but the left is only 2−. Each I⁻ loses one electron, so two ions lose 2e⁻."]}, "trap": "Balancing only the atoms. Always count the charge on both sides too. Then put electrons on the left at the cathode and on the right at the anode.", "recap": "Write the ions and gas formulas, balance atoms, then add electrons until the charges match: left at the cathode, right at the anode."}
{"s": "chemistry", "t": "4.5.1.1", "kind": "idea", "why": "Paper 1 questions ask you to link a temperature change to exothermic or endothermic, and to read or describe a reaction profile.", "hook": {"q": "You click a hand warmer and it quickly gets hot. What is happening to energy?", "o": ["The reaction creates new energy from nothing", "The reaction transfers energy to the surroundings", "The reaction takes in energy from your hand", "The reaction uses up energy, so less energy exists afterwards"], "a": 1, "f": ["Energy is never created. The pack feels hot because energy moves from the chemicals to the surroundings.", "Right. The chemicals give out energy to the surroundings, so the pack and your hand get warmer. The total energy stays the same.", "If energy were taken in from your hand, the pack would feel cold. Hot means energy is going out.", "Energy is not used up. It is transferred, here from the reacting chemicals to the surroundings."]}, "chunks": [{"h": "Exothermic reactions", "b": "An **exothermic** reaction transfers energy to the **surroundings**. The surroundings get hotter, so a thermometer reading goes up. Combustion, neutralisation and many oxidation reactions are exothermic. Uses include hand warmers and self-heating cans."}, {"h": "Endothermic reactions", "b": "An **endothermic** reaction takes in energy from the surroundings. The surroundings get colder, so the temperature falls. **Thermal decomposition** is endothermic. So is citric acid reacting with sodium hydrogencarbonate. Instant cold packs for sports injuries use endothermic reactions."}, {"h": "Reading reaction profiles", "b": "A **reaction profile** plots energy against progress of reaction. The graph shows both types. The line starts at the reactants, rises to a peak, then ends at the products. The rise to the peak is the **activation energy**: the minimum energy particles need to react. Products lower than reactants means exothermic. Products higher means endothermic.", "fig": {"type": "graph", "x": [0, 10], "y": [0, 12], "xstep": 2, "ystep": 2, "xlabel": "Progress of reaction", "ylabel": "Energy", "lines": [{"pts": [[0, 4], [2, 4], [3, 6], [4, 8], [5, 6], [6, 3], [7, 2], [10, 2]], "label": "Exothermic", "c": 0}, {"pts": [[0, 4], [2, 4], [3, 7], [4, 10], [5, 9.5], [6, 8.5], [7, 8], [10, 8]], "label": "Endothermic", "c": 1}], "points": [{"at": [2, 4], "label": "Reactants"}, {"at": [8, 2], "label": "Products (exothermic)"}, {"at": [8, 8], "label": "Products (endothermic)"}]}}, {"h": "Measuring temperature change", "b": "Use a **polystyrene cup** with a lid. It is an **insulator**, so less energy is lost to the air. Measure the start temperature, mix the reactants, stir, and record the highest or lowest temperature. A rise means exothermic. A fall means endothermic."}], "example": {"task": "A student mixes citric acid solution with sodium hydrogencarbonate in a cup. The temperature falls from 21 °C to 14 °C. Explain what this shows and describe the reaction profile in the graph.", "steps": [{"do": "The temperature of the mixture fell from 21 °C to 14 °C.", "why": "The thermometer measures the surroundings. A fall means they lost energy."}, {"do": "Energy was transferred from the surroundings to the reacting chemicals, so the reaction is endothermic.", "why": "Taking in energy from the surroundings is the definition of endothermic."}, {"do": "The products have more energy than the reactants.", "why": "The energy taken in is stored in the products."}, {"do": "On the profile, the line starts at the reactants, rises to a peak (the activation energy), then falls to products at a higher level than the start.", "why": "Endothermic means products higher. The peak is always above both levels."}], "answer": "The temperature fell, so energy was taken in from the surroundings. The reaction is endothermic. The products have more energy than the reactants. The profile rises to a peak, then ends above the starting level.", "fig": {"type": "graph", "x": [0, 8], "y": [0, 10], "xstep": 1, "ystep": 2, "xlabel": "Progress of reaction", "ylabel": "Energy", "lines": [{"pts": [[0, 2], [1.5, 2], [2.5, 3.5], [3.5, 7.5], [4, 8], [4.5, 7.6], [5.5, 6.3], [6, 6], [8, 6]], "c": 0}], "points": [{"at": [1, 2], "label": "Reactants"}, {"at": [4, 8], "label": "Peak"}, {"at": [7, 6], "label": "Products"}]}}, "selfx": {"q": "Why does the answer say the products have more energy than the reactants?", "o": ["Because the products are colder, so they must hold more energy", "Because the activation energy is always bigger than the overall change", "Because endothermic reactions always need a catalyst to work", "Because energy taken in from the surroundings ends up in the products"], "a": 3, "f": ["Colder surroundings do not mean colder products. The surroundings cooled because they lost energy to the reaction.", "Activation energy is the rise to the peak. It does not decide whether products end higher or lower.", "Catalysts lower activation energy. They do not decide whether a reaction is endothermic.", "Right. The surroundings lose energy and the products gain it. So the products end up at a higher energy than the reactants."]}, "faded": {"task": "Magnesium is added to dilute hydrochloric acid. The temperature rises from 20 °C to 38 °C. Describe the reaction profile.", "given": ["The temperature rose, so energy was transferred to the surroundings.", "So the reaction is exothermic."], "q": "What is the next point in describing the profile?", "o": ["The products are at a lower energy than the reactants, so the line ends below its start", "The products are at a higher energy than the reactants, so the line ends above its start", "There is no peak, because exothermic reactions need no activation energy", "The overall energy change is the height of the peak above the reactants"], "a": 0, "f": ["Right. Energy given out means the products hold less energy, so the line ends below the reactants' level.", "This describes an endothermic reaction. Energy given out leaves the products with less energy, not more.", "Every reaction has an activation energy, so every profile has a peak. Exothermic profiles still rise first.", "The height of the peak above the reactants is the activation energy. The overall change is the gap between reactants and products."]}, "trap": "Thinking lower products means energy is taken in. Lower products mean energy was given out, so the surroundings warm up. Also, activation energy (reactants to peak) is not the overall energy change (reactants to products).", "recap": "Exothermic means products lower, energy given out and temperature rising; endothermic means products higher, energy taken in and temperature falling."}
{"s": "chemistry", "t": "4.5.1.3", "kind": "method", "why": "Higher tier questions give you bond energies in a table and ask you to calculate the overall energy change of a reaction, then say whether it is exothermic or endothermic.", "hook": null, "chunks": [{"h": "Breaking and making bonds", "b": "**Breaking** bonds takes in energy from the surroundings. **Making** bonds releases energy. Every reaction does both. A **bond energy** in kJ/mol is the energy needed to break one mole of that bond. The same amount is released when that bond forms."}, {"h": "The calculation", "b": "**Overall energy change = energy to break bonds − energy released making bonds.** Add up the bond energies for all bonds in the **reactants**. Add up the bond energies for all bonds in the **products**. Then subtract: broken minus made. The unit is kJ/mol."}, {"h": "Reading the sign", "b": "If the answer is **negative**, more energy is released making bonds than is taken in breaking them. The reaction is **exothermic**. If the answer is positive, the reaction is **endothermic**. Always write the sign, even for a positive answer."}, {"h": "Count every bond", "b": "Work out how many of each bond are in the **molecules**, then multiply by the number in front of the formula. 2H₂O has two molecules, each with two O–H bonds, so four O–H bonds. Drawing the **displayed formula** of each molecule helps you avoid missing any."}], "example": {"task": "2H₂ + O₂ → 2H₂O. Bond energies in kJ/mol: H–H 436, O=O 498, O–H 464. Calculate the overall energy change.", "steps": [{"do": "Bonds broken: 2 × H–H and 1 × O=O.", "why": "Each H₂ has one H–H bond. The equation has two H₂ and one O₂."}, {"do": "Energy to break bonds = (2 × 436) + 498 = 872 + 498 = 1370 kJ/mol.", "why": "Add all the bonds broken. Breaking bonds takes in energy."}, {"do": "Bonds made: 4 × O–H.", "why": "Each H₂O has two O–H bonds. There are two H₂O, so 2 × 2 = 4."}, {"do": "Energy released making bonds = 4 × 464 = 1856 kJ/mol.", "why": "Add all the bonds made. Making bonds releases energy."}, {"do": "Overall energy change = 1370 − 1856 = −486 kJ/mol.", "why": "Energy to break minus energy released. The negative sign means the reaction is exothermic."}], "answer": "Energy to break bonds = 1370 kJ/mol. Energy released making bonds = 1856 kJ/mol. Overall energy change = 1370 − 1856 = −486 kJ/mol. The reaction is exothermic.", "fig": {"type": "graph", "anim": "steps", "x": [0, 6], "xstep": 1, "y": [-800, 1600], "ystep": 400, "xlabel": "Bonds broken, then bonds made", "ylabel": "Running total / kJ/mol", "lines": [{"dash": true, "c": 3, "pts": [[0, 0], [6, 0]]}, {"label": "Break H–H", "step": 1, "c": 1, "pts": [[0, 0], [1, 872]]}, {"label": "Break O=O", "step": 2, "c": 1, "pts": [[1, 872], [2, 1370]]}, {"label": "Make 4 O–H: −1856", "step": 3, "c": 2, "pts": [[2, 1370], [6, -486]]}, {"dash": true, "step": 4, "c": 0, "pts": [[6, 0], [6, -486]]}], "points": [{"at": [1, 872], "label": "872", "step": 1}, {"at": [2, 1370], "label": "1370 in", "step": 2}, {"at": [6, -486], "label": "−486", "step": 4}], "steps": ["Break 2 × H–H: 2 × 436 = 872 kJ/mol taken in. The running total rises to 872.", "Break 1 × O=O: 498 more taken in. The total reaches 1370 kJ/mol, the energy to break bonds.", "Make 4 × O–H: each releases 464, so 4 × 464 = 1856 released. The total falls by 1856, from 1370.", "It ends at 1370 − 1856 = −486 kJ/mol, below the start line (0). Negative means exothermic."]}}, "selfx": {"q": "Why does step 3 count four O–H bonds?", "o": ["The 2 in front of H₂O is doubled to match the 2 in front of H₂.", "Each H₂O has two O–H bonds, and there are two H₂O, so four form.", "Bonds made are always counted twice as many times as bonds broken.", "Each of the two H₂ has two H–H bonds, so four bonds become O–H."], "a": 1, "f": ["Wrong. Coefficients are not doubled to match each other. Count the bonds in each molecule, then multiply by the number of molecules.", "Right. Water is H–O–H, so each molecule has two O–H bonds. Two molecules give 2 × 2 = 4 bonds made.", "Wrong. There is no such rule. The number of bonds made depends only on the product molecules and how many there are.", "Wrong. Each H₂ has only one H–H bond, not two. The bonds made are counted from the product molecules, not from the reactants."]}, "faded": {"task": "N₂ + O₂ → 2NO. Bond energies in kJ/mol: N≡N 945, O=O 498, N=O 630. Find the overall energy change.", "given": ["Bonds broken: 1 × N≡N and 1 × O=O.", "Energy to break bonds = 945 + 498 = 1443 kJ/mol."], "q": "What is the next step?", "o": ["Bonds made: 630 kJ/mol, as NO has one N=O bond.", "Bonds made: 945 + 498 = 1443 kJ/mol, as the same bonds form again.", "Bonds made: 1443 + 630 = 2073 kJ/mol, adding everything together.", "Bonds made: 2 × 630 = 1260 kJ/mol, as 2NO has two N=O bonds."], "a": 3, "f": ["Wrong. NO does have one N=O bond, but 2NO means two molecules. You must multiply by 2 to get 1260.", "Wrong. The bonds that form are in the products, not the reactants. Those are the bonds in 2NO.", "Wrong. You must not add the broken bonds to the made bonds. Work out the energy released from the product bonds alone.", "Right. Each NO has one N=O bond. The 2 in front of NO means two bonds form: 2 × 630 = 1260 kJ/mol. Then 1443 − 1260 = +183 kJ/mol."]}, "trap": "Missing bonds. Multiply by the number in front of each formula, and count every bond inside each molecule. Then subtract broken minus made, not the other way round, or you lose the sign.", "recap": "Overall energy change = energy to break bonds − energy released making bonds; count every bond, and a negative answer means exothermic."}
{"s": "chemistry", "t": "4.5.2", "kind": "idea", "why": "Separate science papers often ask you to explain how a cell or hydrogen fuel cell works, or to compare fuel cells with batteries, usually for 3 to 6 marks.", "hook": {"q": "A torch battery goes flat after a few weeks of use. What has most likely happened inside it?", "o": ["The electrons have all been used up and cannot be replaced", "A reactant has been used up, so the reaction has stopped", "The electrolyte has evaporated, leaving the metals dry", "The voltage was stored in the metal and has run out"], "a": 1, "f": ["Electrons are not used up. They flow round the circuit. What runs out is a chemical reactant.", "Right. A cell's voltage comes from a chemical reaction. When a reactant is used up, the reaction stops and the voltage falls to zero.", "Evaporation is not the usual cause. The battery goes flat because the chemicals have reacted, not because it dried out.", "Voltage is not stored inside the metal. It is produced by a reaction, and it stops when the reaction stops."]}, "chunks": [{"h": "How a cell makes voltage", "b": "A **cell** has two different metals, called electrodes, dipping into an **electrolyte**. A chemical reaction pushes electrons round the circuit, which gives a voltage. Metals further apart in the reactivity series give a bigger voltage. The electrolyte also affects the voltage."}, {"h": "Cells and batteries", "b": "A **battery** is two or more cells connected in series. Their voltages add up. In a non-rechargeable (alkaline) battery, the reaction carries on until a reactant is used up, and then it is flat. In a **rechargeable** battery, an external current reverses the reaction."}, {"h": "Hydrogen fuel cells", "b": "A **fuel cell** is supplied with a fuel and oxygen (from air) all the time. In a hydrogen fuel cell, hydrogen is **oxidised** and gives a voltage. The only product is water: 2H₂ + O₂ → 2H₂O. It keeps working as long as it is supplied."}, {"h": "Fuel cell or battery?", "b": "**Fuel cells**: make only water and are refuelled, not recharged, but hydrogen is flammable, hard to store and usually made using energy. **Rechargeable batteries**: easy to use, but they run flat, recharging takes time, and they contain toxic chemicals that need careful disposal. Compare both in evaluation answers."}], "example": {"task": "Explain how a hydrogen fuel cell in a car produces electricity and why it does not need to be recharged. (4 marks)", "steps": [{"do": "Hydrogen from a tank and oxygen from the air are fed into the fuel cell.", "why": "The reactants are supplied continuously from outside the cell."}, {"do": "The hydrogen is oxidised by the oxygen, and this reaction produces a voltage.", "why": "Hydrogen reacting with oxygen is oxidation. The reaction is what makes the electricity."}, {"do": "The overall reaction is 2H₂ + O₂ → 2H₂O, so the only product is water.", "why": "Shows you know the equation and that no carbon dioxide is made."}, {"do": "The cell keeps working while hydrogen and oxygen are supplied. The driver refills the tank instead of recharging.", "why": "Used reactants are replaced from outside, so the cell does not go flat like a battery."}], "answer": "Hydrogen and oxygen are fed in continuously. Hydrogen is oxidised, which produces a voltage. The overall reaction is 2H₂ + O₂ → 2H₂O, so only water is made. It works as long as the gases are supplied, so it is refilled, not recharged."}, "selfx": {"q": "Why does the answer say that the only product is water and no carbon dioxide is made?", "o": ["Fuel cells absorb carbon dioxide from the air as they work", "The reaction is too slow to make any carbon dioxide", "The reactants, hydrogen and oxygen, contain no carbon to make it from", "Any carbon dioxide made dissolves in the water that is formed"], "a": 2, "f": ["Fuel cells do not absorb carbon dioxide. The real reason is about what is in the reactants.", "Speed is not the reason. Carbon dioxide cannot form at any speed without carbon in the reactants.", "Right. Carbon dioxide needs carbon atoms. Hydrogen and oxygen have none, so the only product is water.", "No carbon dioxide is made in the first place, so there is nothing to dissolve. This is a made-up explanation."]}, "faded": {"task": "Explain why an alkaline battery in a torch stops working, but a hydrogen fuel cell in a bus can keep working. (3 marks)", "given": ["In the battery, the chemicals inside react to produce a voltage.", "The reaction cannot be reversed and a reactant gets used up, so the battery goes flat."], "q": "Which sentence should come next to complete the explanation?", "o": ["In the fuel cell, hydrogen and oxygen are supplied all the time, so they never run out", "In the fuel cell, a current is passed through to reverse the reaction and recharge it", "In the fuel cell, carbon dioxide is made, which keeps the reaction going", "In the fuel cell, several cells are in series, so the voltage is higher and lasts longer"], "a": 0, "f": ["Right. The fuel cell is fed with fresh reactants all the time, so the reaction carries on and it never goes flat while supplied.", "This describes a rechargeable battery. A fuel cell is not recharged. It is supplied with reactants.", "A hydrogen fuel cell makes only water. Carbon dioxide is not a product and does not keep anything going.", "Cells in series add voltage, not running time. The difference is the continuous supply of reactants."]}, "trap": "Do not say a fuel cell makes carbon dioxide or that it is recharged. A hydrogen fuel cell makes only water and is supplied with hydrogen and oxygen continuously.", "recap": "A hydrogen fuel cell is fed hydrogen and oxygen continuously, oxidises hydrogen, makes only water (2H₂ + O₂ → 2H₂O) and is never recharged."}
{"s": "chemistry", "t": "4.6.1.1", "kind": "method", "why": "Exam questions often give you a table or a curve and ask for a rate, with marks for the method and the answer with units.", "hook": null, "chunks": [{"h": "Mean rate from results", "b": "**Mean rate** = amount of reactant used or product formed ÷ time taken. Use the **change** between two times. Subtract the two readings, subtract the two times, then divide. The units come from the measurements: g/s, cm³/s or mol/s."}, {"h": "Mean rate from a graph", "b": "Read two values from the axes at chosen times, then calculate as before. The graph's chord gives a mean rate of (0.8 − 0.5) ÷ 60 = 0.005 g/s. A **steeper** line means a faster rate; a **flat** line means the reaction has stopped. A curve's rate is fastest at the start and falls as reactants are used up.", "fig": {"type": "graph", "x": [0, 100], "y": [0, 0.9], "xstep": 20, "ystep": 0.1, "xlabel": "time / s", "ylabel": "mass lost / g", "lines": [{"pts": [[0.0, 0.0], [0.625, 0.030303], [1.25, 0.058824], [1.875, 0.085714], [2.5, 0.111111], [3.125, 0.135135], [3.75, 0.157895], [4.375, 0.179487], [5.0, 0.2], [5.625, 0.219512], [6.25, 0.238095], [6.875, 0.255814], [7.5, 0.272727], [8.125, 0.288889], [8.75, 0.304348], [9.375, 0.319149], [10.0, 0.333333], [10.625, 0.346939], [11.25, 0.36], [11.875, 0.372549], [12.5, 0.384615], [13.125, 0.396226], [13.75, 0.407407], [14.375, 0.418182], [15.0, 0.428571], [15.625, 0.438596], [16.25, 0.448276], [16.875, 0.457627], [17.5, 0.466667], [18.125, 0.47541], [18.75, 0.483871], [19.375, 0.492063], [20.0, 0.5], [20.625, 0.507692], [21.25, 0.515152], [21.875, 0.522388], [22.5, 0.529412], [23.125, 0.536232], [23.75, 0.542857], [24.375, 0.549296], [25.0, 0.555556], [25.625, 0.561644], [26.25, 0.567568], [26.875, 0.573333], [27.5, 0.578947], [28.125, 0.584416], [28.75, 0.589744], [29.375, 0.594937], [30.0, 0.6], [30.625, 0.604938], [31.25, 0.609756], [31.875, 0.614458], [32.5, 0.619048], [33.125, 0.623529], [33.75, 0.627907], [34.