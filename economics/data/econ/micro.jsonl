// Rep Max questions: Microeconomics (Themes 1 and 3), Pearson Edexcel A level Economics A (9EC0). One question per line.
// Fields: id, s, t (topic id from spec.json), lv (1 warm-up, 2 working set, 3 hardest), q, o (four options), a (index 0-3), x (explanation), w (why each wrong option is wrong).
// Written by Sonnet 5.5, checked by Sonnet 5.5, flagged items settled by Opus 5.5 (provenance FNF_RepMax_E1_*, E2_*).
{"id": "econ-001", "s": "micro", "t": "1.2.3", "lv": 1, "q": "A firm raises its price by 10% and the quantity demanded falls by 15%. What is the price elasticity of demand?", "o": ["−0.67", "+1.5", "−25", "−1.5"], "a": 3, "x": "PED = %ΔQd ÷ %ΔP = −15 ÷ 10 = −1.5. Price up, quantity down, so the sign is negative. Demand is elastic because the value is beyond −1 (magnitude above 1).", "w": ["You divided %ΔP by %ΔQd; the formula has quantity demanded on top.", "Dropped the sign. Price rises and quantity falls, so PED is negative.", "You added the percentages instead of dividing them.", ""]}
{"id": "econ-002", "s": "micro", "t": "1.2.3", "lv": 1, "q": "The income elasticity of demand for own-brand bus tickets is −0.4. What does this tell you about the good?", "o": ["It is a normal necessity with income-inelastic demand", "It is an inferior good", "It is a normal good with income-elastic demand", "It is a luxury good"], "a": 1, "x": "A negative YED means demand falls as income rises, so the good is inferior. Size only shows how responsive demand is; the sign gives the type. Normal goods have positive YED.", "w": ["A necessity has a positive YED between 0 and 1; the negative sign means inferior.", "", "Normal goods have positive YED; a negative value cannot be normal, and −0.4 is not elastic anyway.", "Luxuries have YED above +1; this value is negative."]}
{"id": "econ-003", "s": "micro", "t": "1.2.3", "lv": 2, "q": "Monthly income rises from £2,000 to £2,200. A household's restaurant meals rise from 10 to 13 a month. What is YED?", "o": ["+30", "+3.0", "+1.3", "+0.33"], "a": 1, "x": "%ΔY = 200/2,000 = 10%. %ΔQ = 3/10 = 30%. YED = 30 ÷ 10 = +3.0. Positive and above 1, so a normal, income-elastic (luxury-type) good.", "w": ["That is the %ΔQ alone; you forgot to divide by %ΔY.", "", "You divided 13 by 10 using the raw quantities rather than percentage changes.", "You inverted the formula: income goes on the bottom, not the top."]}
{"id": "econ-004", "s": "micro", "t": "1.2.3", "lv": 2, "q": "The price of tea rises from £2.00 to £2.50 and the quantity of coffee demanded rises from 400 to 440. What is XED of coffee with respect to tea?", "o": ["+0.4; complements", "−0.4; weak complements", "+0.4; weak substitutes", "+2.5; close substitutes"], "a": 2, "x": "%ΔP of tea = 25%. %ΔQ of coffee = 40/400 = 10%. XED = 10 ÷ 25 = +0.4. Positive means substitutes; a small value means a weak link.", "w": ["The value is right, but a positive XED means substitutes, not complements.", "Wrong sign: coffee demand rose when tea's price rose, so XED is positive.", "", "You inverted the ratio; the change in demand for coffee goes on top."]}
{"id": "econ-005", "s": "micro", "t": "1.2.3", "lv": 2, "q": "A firm's product has PED of −0.5. It raises price by 8%. What happens to its total revenue?", "o": ["Stays the same, because the changes cancel out", "Rises, because demand is price elastic here", "Falls, because quantity demanded falls a lot", "Rises, as quantity falls by less than price rises"], "a": 3, "x": "Quantity falls about 4% (0.5 × 8%), less than the 8% rise in price. Demand is inelastic, so revenue (P × Q) rises. Revenue only falls from a price rise if demand is elastic.", "w": ["Revenue only stays the same at unit elasticity (PED = −1), not −0.5.", "The conclusion is right but the reason is wrong: −0.5 is inelastic, not elastic.", "Quantity does fall, but by less than price rises, so revenue rises.", ""]}
{"id": "econ-006", "s": "micro", "t": "1.2.3", "lv": 3, "q": "PED is −0.5. A good sells 1,000 units at £4. A tax raises the price to £4.40. Assuming the PED applies, what happens to consumer spending (revenue)?", "o": ["Rises by £400 to £4,400", "Is unchanged at £4,000", "Rises by £180 to £4,180", "Falls by £200 to £3,800"], "a": 2, "x": "%ΔP = 10%, so %ΔQ = −5%: Q = 950. New spending = £4.40 × 950 = £4,180, against £4,000 before. A rise of £180, because demand is inelastic.", "w": ["You applied the new price to the old quantity; quantity falls 5% to 950 units.", "Spending is unchanged only if PED = −1; here demand is inelastic.", "", "£3,800 is £4 × 950: you cut quantity to 950 but kept the old price of £4, ignoring the rise to £4.40."]}
{"id": "econ-007", "s": "micro", "t": "1.2.9", "lv": 1, "q": "On a supply and demand diagram, how is a per-unit indirect tax of £2 shown?", "o": ["Both curves pivot to become steeper by £2", "Supply shifts right by £2 at every quantity", "Demand shifts left by £2 at every price", "Supply shifts up by £2 at every quantity"], "a": 3, "x": "A per-unit tax raises firms' costs by £2 on each unit, so the supply curve shifts vertically up by the tax. Demand does not move, because the tax is levied on firms, not on buyers' tastes or incomes.", "w": ["A per-unit tax gives a parallel shift of supply. Pivoting is for ad valorem taxes, and neither curve changes in this way here.", "A rightward shift would show a subsidy or lower costs, not a tax. A tax moves supply upwards or leftwards.", "Demand is not the curve affected; the tax raises producers' costs, so it is the supply curve that shifts.", ""]}
{"id": "econ-008", "s": "micro", "t": "1.2.9", "lv": 1, "q": "After a per-unit tax, which area shows the burden of the tax borne by consumers?", "o": ["Rectangle between the old and new market price, up to the old quantity", "Rectangle between the new market price and the supply curve before tax", "Rectangle between the old and new market price, up to the new quantity", "The whole tax rectangle between the two supply curves, at the new quantity"], "a": 2, "x": "Consumers' burden is the rise in the price they pay, from the old price to the new price, multiplied by the new quantity sold. Using the old quantity is the common slip.", "w": ["The old quantity is no longer sold after the tax. Use the new, lower quantity for every incidence area.", "This does not show the price rise consumers face; the area is bounded by the old and new market prices.", "", "This is the total tax revenue, shared between consumers and producers, not the consumers' burden alone."]}
{"id": "econ-009", "s": "micro", "t": "1.2.9", "lv": 2, "q": "A £2 per-unit tax raises the market price from £5.00 to £6.50. Quantity falls from 1,000 to 800 units. What is the burden of the tax on producers?", "o": ["£400", "£500", "£1,600", "£1,200"], "a": 0, "x": "Consumers pay £1.50 more per unit, so producers bear £2.00 − £1.50 = £0.50 per unit. Multiply by the new quantity: £0.50 × 800 = £400. Using 1,000 gives £500, which is the old-quantity trap.", "w": ["", "This uses the old quantity of 1,000. Tax is only paid on units still sold, which is 800.", "This is total tax revenue (£2 × 800), not the producers' share.", "This is the consumers' burden (£1.50 × 800), not the producers'."]}
{"id": "econ-010", "s": "micro", "t": "1.2.9", "lv": 2, "q": "A government taxes a good with price inelastic demand and price elastic supply. Which outcome is most likely?", "o": ["Consumers bear most of the tax; quantity falls slightly", "Consumers bear a small share because they can switch away", "Producers bear most of the tax and quantity falls sharply", "Both groups share the tax equally whatever the elasticities"], "a": 0, "x": "Inelastic demand means buyers keep buying when price rises, so firms pass most of the tax on. Elastic supply means firms can cut output easily. Consumers bear more, and quantity falls only a little.", "w": ["", "Switching away needs elastic demand. Here demand is inelastic, so consumers bear a large share.", "This reverses the effect. Firms pass on the tax when buyers are unresponsive, so producers do not bear most.", "The split depends on the relative elasticities. It is equal only in special cases."]}
{"id": "econ-011", "s": "micro", "t": "1.2.9", "lv": 2, "q": "A £2 per-unit subsidy increases quantity from 500 to 600 units and lowers the market price from £10.00 to £9.20. What is the cost to the government?", "o": ["£1,200", "£1,000", "£480", "£1,100"], "a": 0, "x": "Subsidy spending is the subsidy per unit times the new quantity: £2 × 600 = £1,200. The old quantity of 500 is the trap. The price fall of £0.80 only gives the consumers' gain.", "w": ["", "This uses the old quantity of 500. The subsidy is paid on every unit now produced, 600.", "This is the consumers' gain (£0.80 × 600), not the whole cost to the government.", "This has no basis in the data. The cost is the subsidy per unit times the new quantity sold."]}
{"id": "econ-012", "s": "micro", "t": "1.2.9", "lv": 3, "q": "Demand for a good is perfectly inelastic at 200 units. A £3 per-unit tax is imposed and supply is upward sloping. What is the result?", "o": ["Price rises by £3; consumers bear £600, producers nothing", "Price is unchanged and producers bear the full £600", "Price rises by less than £3 and quantity falls", "Price rises by £3 and tax revenue is zero"], "a": 0, "x": "With perfectly inelastic demand, quantity stays 200, so the supply shift raises price by the full £3. Consumers bear £3 × 200 = £600 and producers bear none. Revenue is also £600.", "w": ["", "Producers can only bear the tax if buyers will not accept a higher price, which is the case for elastic demand.", "Quantity cannot fall when demand is perfectly inelastic, and the whole tax passes to the price.", "Revenue is £3 × 200 = £600, because the quantity sold is unchanged. It is not zero."]}
{"id": "econ-013", "s": "micro", "t": "1.3.2", "lv": 1, "q": "A paper mill's production pollutes a river, harming a fishing club. The mill pays its own costs of £50 per tonne. The club's loss is £12 per tonne. What is the social cost per tonne?", "o": ["£62", "£50", "£38", "£12"], "a": 0, "x": "Social cost = private cost + external cost = £50 + £12 = £62. The trap is using only one part, or subtracting the external cost as if it were a benefit.", "w": ["", "£50 is only the private cost; it ignores the cost to third parties.", "Subtracting the external cost is wrong; external costs are added to private costs.", "£12 is only the external cost; social cost also includes the mill's own private cost."]}
{"id": "econ-014", "s": "micro", "t": "1.3.2", "lv": 1, "q": "Which statement describes a positive externality of consumption?", "o": ["The good is produced at a lower cost than other goods", "The consumer's benefit is higher than the price paid for the good", "Marginal social cost is greater than marginal private cost", "Third parties gain a benefit not reflected in consumer demand"], "a": 3, "x": "A positive externality of consumption is a benefit to third parties, so MSB is above MPB. The consumer ignores it, so demand (MPB) understates social benefit.", "w": ["Low production cost is not an externality; externalities affect third parties.", "This describes consumer surplus, not an external benefit to third parties.", "This describes a negative externality of production, not a consumption benefit.", ""]}
{"id": "econ-015", "s": "micro", "t": "1.3.2", "lv": 2, "q": "Demand (MPB) is $P=20-Q$ and MPC is $P=4+Q$. The external cost is a constant £4 per unit, so MSC is $P=8+Q$. What is the welfare loss at the free-market output? (Price in £.)", "o": ["£8", "£4", "£2", "£16"], "a": 1, "x": "Market: 20−Q=4+Q gives Q=8. Optimum: 20−Q=8+Q gives Q=6. At Q=8 the gap between MSC (16) and MSB (12) is 4. Triangle = ½×2×4 = £4.", "w": ["Using the full rectangle 2×4 forgets that welfare loss is a triangle, so halve it.", "", "£2 is the excess output (8−6), not the area of the loss.", "£16 is the MSC at output 8; it is not the welfare loss."]}
{"id": "econ-016", "s": "micro", "t": "1.3.2", "lv": 2, "q": "A firm produces 500 units. At this output MPC is £10 per unit and MSC is £14 per unit. What is the total external cost at this output?", "o": ["£2,000", "£5,000", "£4 in total", "£7,000"], "a": 0, "x": "External cost per unit = MSC − MPC = £4. Total = £4 × 500 = £2,000. The trap is multiplying a curve's height, rather than the gap between curves, by output.", "w": ["", "This is MPC × output, the firm's private cost only.", "£4 is the external cost per unit; the question asks for the total.", "This is MSC × output, which is the total social cost, not the external cost."]}
{"id": "econ-017", "s": "micro", "t": "1.3.2", "lv": 2, "q": "MPB is $P=40-Q$ and MPC=MSC is $P=10+Q$. The external benefit is £6 per unit, so MSB is $P=46-Q$. What is the welfare gain from moving to the social optimum?", "o": ["£9", "£18", "£6", "£3"], "a": 0, "x": "Market: 40−Q=10+Q gives Q=15. Optimum: 46−Q=10+Q gives Q=18. At Q=15 the MSB–MSC gap is 31−25=6. Gain = ½×3×6 = £9.", "w": ["", "£18 is 3×6, a rectangle; the gain is a triangle so you halve it.", "£6 is the external benefit per unit, not the area of the welfare gain.", "£3 is the extra output (18−15), not the area."]}
{"id": "econ-018", "s": "micro", "t": "1.3.2", "lv": 3, "q": "Noisy fireworks impose costs on neighbours who do not buy them. Treating this as a negative externality of consumption, which statement is correct?", "o": ["MSC lies above MPC, so the free market over-produces the good", "MSB lies below MPB, so the free market under-consumes the good", "MSB lies above MPB, so the free market under-consumes the good", "MSB lies below MPB, so the free market over-consumes the good"], "a": 3, "x": "Harm to others in consumption makes MSB lie below MPB. Buyers equate MPB with MPC, so consumption exceeds the social optimum, where MSB=MSC, causing a welfare loss.", "w": ["This describes a negative externality of production; here the harm arises from consumption.", "MSB below MPB is correct, but it leads to over-consumption, not under-consumption.", "MSB above MPB is a positive consumption externality, giving under-consumption.", ""]}
{"id": "econ-037", "s": "micro", "t": "3.3.4", "lv": 1, "q": "At which output does a firm that wants to maximise profit produce?", "o": ["Where marginal revenue is at its highest point", "Where average cost is at its lowest point", "Where MC equals MR, with MC cutting MR from below", "Where average revenue equals average cost exactly"], "a": 2, "x": "Profit is maximised where MC = MR. Before that point, extra units add more to revenue than to cost. After it, they add more to cost. AR = AC is only normal profit, and minimum AC is not the rule.", "w": ["Highest MR is not the rule; MR must be compared with MC. Ignores the cost side.", "Minimum AC is productive efficiency, not profit maximisation. Mixes up cost minimising with profit maximising.", "", "AR = AC gives normal profit only; it is not the profit-maximising rule. Confuses breaking even with maximising profit."]}
{"id": "econ-038", "s": "micro", "t": "3.3.4", "lv": 1, "q": "A firm is earning normal profit. Which statement must be true?", "o": ["MR is greater than MC at the current output", "Total revenue is greater than total cost", "AR equals AC, covering the owner's opportunity cost", "Total revenue just covers total variable cost only"], "a": 2, "x": "Normal profit is the minimum profit needed to keep the firm in its current use. AR = AC, so TR = TC, and costs include the owner's opportunity cost. TR > TC would be supernormal profit.", "w": ["At the profit-maximising output MR = MC, not MR > MC. Also says nothing about whether profit is normal.", "TR > TC means supernormal profit, not normal profit. Confuses normal with supernormal.", "", "TR = TVC is the short-run shutdown point, not normal profit. Ignores fixed costs."]}
{"id": "econ-039", "s": "micro", "t": "3.3.4", "lv": 2, "q": "A firm sells 200 units at a price of £12. At this output its average cost is £9 per unit. What is its supernormal profit?", "o": ["£1,800", "£2,400", "£3", "£600"], "a": 3, "x": "Supernormal profit = (AR − AC) × Q = (£12 − £9) × 200 = £600. The trap is giving profit per unit, or using total revenue or total cost alone.", "w": ["£1,800 is total cost (£9 × 200), not profit. Forgot to subtract it from revenue.", "£2,400 is total revenue (£12 × 200), not profit. Forgot to subtract total cost.", "£3 is profit per unit, not the total. Forgot to multiply by quantity.", ""]}
{"id": "econ-040", "s": "micro", "t": "3.3.4", "lv": 2, "q": "At 500 units a firm has AR £6, AVC £5 and AC £8. What should it do in the short run?", "o": ["Continue; it makes a supernormal profit as AR exceeds AVC", "Continue; its £1,000 loss is below the £1,500 fixed costs", "Shut down, because AR is below AC so it makes a loss", "Shut down, because that avoids the £1,000 loss from producing"], "a": 1, "x": "Loss = (£8 − £6) × 500 = £1,000. Fixed costs = (£8 − £5) × 500 = £1,500, paid even if it closes. AR exceeds AVC, so it continues. Compare AR with AVC, not AC.", "w": ["AR above AVC does not mean profit; AR is below AC, so there is a loss.", "", "Compares AR with AC. In the short run the test is AR against AVC, because fixed costs are unavoidable.", "Closing does not avoid the loss; it leaves a bigger loss of £1,500 in fixed costs."]}
{"id": "econ-041", "s": "micro", "t": "3.3.4", "lv": 2, "q": "A firm's MC is rising. At its current output of 40 units, MR is £15 and MC is £11. To raise profit, what should it do?", "o": ["Increase output until MR equals average cost", "Cut output, because MR is greater than MC", "Keep output the same, as MR above MC shows maximum profit", "Increase output, as each extra unit adds more revenue than cost"], "a": 3, "x": "When MR > MC, each extra unit adds more revenue than cost, so profit rises. Output should expand until MC rises to equal MR. The profit-maximising condition is MC = MR, not MR = AC.", "w": ["The comparison is with MC, not AC. Using average cost instead of marginal cost is the slip.", "Cutting output is right only when MC exceeds MR. Reverses the rule.", "Profit is maximised only where MR = MC. At MR > MC there is still profit to gain.", ""]}
{"id": "econ-042", "s": "micro", "t": "3.3.4", "lv": 3, "q": "Output 1–5 units: TR £30, £56, £78, £96, £110; TC £20, £38, £57, £80, £105. At which output is profit maximised, and what kind of profit is it?", "o": ["3 units; supernormal profit of £21", "3 units; normal profit only, because MR exceeds MC", "2 units; supernormal profit of £18, where MC is lowest", "4 units; supernormal profit of £16, the first unit where MC exceeds MR"], "a": 0, "x": "MR: 30, 26, 22, 18, 14. MC: 20, 18, 19, 23, 25. At 3 units MR £22 > MC £19, and at 4 units MC £23 > MR £18. Profit at 3 units = £78 − £57 = £21, so supernormal.", "w": ["", "TR > TC gives supernormal profit. MR > MC only means the unit is worth producing, not that profit is normal.", "Lowest MC is not the rule. At 2 units MR (£26) still exceeds MC (£18), so profit can rise.", "At 4 units MC exceeds MR, so the fourth unit reduces profit from £21 to £16."]}
{"id": "econ-043", "s": "micro", "t": "3.4.4", "lv": 1, "q": "In a market, five groups hold these shares: A 30%, B 22%, C 18%, D 10%, all other firms combined 20%. What is the three-firm concentration ratio?", "o": ["70%", "80%", "20%", "30%"], "a": 0, "x": "Add the three largest shares: 30 + 22 + 18 = 70%. The trap is adding four firms (80%) or confusing the ratio with the leader's share or the 'others' share.", "w": ["", "80% adds the top four firms, which is the four-firm ratio, not the three-firm ratio.", "20% is the share of all other firms combined, not the combined share of the top three.", "30% is only the largest firm's share, so it is a one-firm ratio."]}
{"id": "econ-044", "s": "micro", "t": "3.4.4", "lv": 1, "q": "Which statement best explains why firms in an oligopoly are described as interdependent?", "o": ["Each firm sells an identical product and must accept the market price", "Each firm is so small that its decisions have no effect on others", "Each firm can enter or leave the market at no cost, so rivals react", "Each firm's best choice depends on how its few rivals react"], "a": 3, "x": "With only a few large firms, each one's decision affects rivals, who respond. Firms must therefore predict reactions. Price taking and tiny size describe perfect competition, not oligopoly.", "w": ["Identical products and price taking describe perfect competition, not interdependence between a few large firms.", "Tiny firms with no effect on others describe perfect competition; oligopolists are large enough to affect rivals.", "Costless entry and exit describe contestable or perfectly competitive markets; oligopoly has high barriers to entry.", ""]}
{"id": "econ-045", "s": "micro", "t": "3.4.4", "lv": 2, "q": "Two firms each choose High or Low price. Profits (£m, A then B): both High 10, 10; A High, B Low 4, 12; A Low, B High 12, 4; both Low 6, 6. They cannot collude. What is the likely outcome?", "o": ["Both Low, each earning £6m", "A Low and B High, with profits £12m and £4m", "A High and B Low, with profits £4m and £12m", "Both High, each earning £10m"], "a": 0, "x": "Low is each firm's dominant strategy: if the rival charges High, Low earns 12 not 10; if the rival charges Low, Low earns 6 not 4. So both choose Low, earning £6m. This is the prisoners' dilemma.", "w": ["", "B High is never best for B, since Low is dominant for B whatever A does.", "A High is never best for A, since Low is dominant for A whatever B does.", "Both High gives the best joint profit but needs collusion; without it each firm gains by switching to Low."]}
{"id": "econ-046", "s": "micro", "t": "3.4.4", "lv": 2, "q": "Three firms in a cartel agree to restrict output to keep the price high. Why is such an agreement likely to break down?", "o": ["Each member can raise its profit by secretly exceeding its quota", "Restricting output always makes the firms' costs rise", "Cartels are only profitable if there are many firms in the market", "Higher prices reduce the barriers to entry so rivals leave"], "a": 0, "x": "At the high agreed price, each firm gains by cheating and selling extra. If all cheat, output rises and price falls. Cheating incentives, not barriers or costs, make collusion unstable.", "w": ["", "Restricting output does not always raise costs; the instability comes from the incentive to cheat, not from costs.", "Collusion is easier with few firms, which is why it is linked to oligopoly rather than many-firm markets.", "Higher profits tend to attract entry, but that is not why members cheat; this also reverses the role of barriers."]}
{"id": "econ-047", "s": "micro", "t": "3.4.4", "lv": 2, "q": "Total market sales are £250m. The four largest firms sell £60m, £50m, £30m and £20m. What is the three-firm concentration ratio?", "o": ["64%", "47%", "70%", "56%"], "a": 3, "x": "Top three sales = 60 + 50 + 30 = £140m. Divide by the market total: 140 ÷ 250 × 100 = 56%. Using four firms gives 64%, and averaging the three gives the wrong measure.", "w": ["64% is the four-firm ratio (160 ÷ 250), which includes the fourth firm.", "47% comes from dividing £140m by 3 (an average), which is not a share of the market.", "70% divides by £200m, which is not the total market sales given.", ""]}
{"id": "econ-048", "s": "micro", "t": "3.4.4", "lv": 3, "q": "A dominant supermarket in a four-firm oligopoly cuts prices to gain share. Which reason best explains why it may then prefer non-price competition?", "o": ["Rivals can match cuts fast, so shares stay similar and margins fall", "Non-price competition has no cost, unlike price cuts", "Demand is perfectly inelastic, so price cuts raise no revenue at all", "Price cuts are illegal in oligopoly markets"], "a": 0, "x": "Interdependence means rivals notice and match price cuts, so no share is gained and a price war lowers profits. Branding, quality or loyalty schemes are harder to copy quickly. Price cuts are not illegal.", "w": ["", "Advertising, quality and loyalty schemes cost money, so claiming non-price competition is costless is wrong.", "Demand is not perfectly inelastic; the problem is rivals matching the cut, not zero responsiveness.", "Price cuts are not generally illegal; only price-fixing agreements are, so this misstates the reason."]}
{"id": "econ-061", "s": "micro", "t": "1.1.1", "lv": 1, "q": "What does the assumption of ceteris paribus mean when an economist analyses a change in the price of a good?", "o": ["The market is always in equilibrium", "Consumers always act irrationally", "All other factors affecting demand are held constant", "The price of every other good rises by the same percentage"], "a": 2, "x": "Ceteris paribus means 'all else equal'. Only the variable being studied changes, so its effect can be isolated. The trap is thinking it describes reality rather than being a simplifying assumption.", "w": ["Equilibrium is a separate concept; ceteris paribus is about holding other variables fixed.", "Irrationality has nothing to do with it; models often assume rational behaviour instead.", "", "Confuses ceteris paribus with a general price rise; it means other factors are held constant, not changed."]}
{"id": "econ-062", "s": "micro", "t": "1.1.1", "lv": 1, "q": "Why is economics described as a social science?", "o": ["It studies human behaviour using models and testing against evidence", "It is concerned only with the behaviour of firms in markets", "It can prove laws with controlled laboratory experiments", "It only studies society's views and opinions, not data"], "a": 0, "x": "Economics applies scientific methods (building models, testing hypotheses against data) to human behaviour in society. The trap is claiming it can use controlled experiments like natural sciences.", "w": ["", "Wrong: economics also covers households, governments and whole economies, not just firms.", "Wrong: economies cannot be placed in a laboratory, which is a key difference from natural sciences.", "Wrong: economists use data and evidence to test theories, not just opinions."]}
{"id": "econ-063", "s": "micro", "t": "1.1.1", "lv": 1, "q": "Which is the main reason economists cannot test a theory about a whole economy by a controlled experiment?", "o": ["Economists have no data to use at all", "Governments forbid nearly all economic research", "Economic theories are always correct already", "Other factors cannot be held constant in a real economy"], "a": 3, "x": "In a real economy many variables change at once and cannot be controlled, so the effect of one change is hard to isolate. This is why economists rely on models and ceteris paribus.", "w": ["Data exists in large amounts; the problem is isolating one variable, not lack of data.", "Research is not generally forbidden; the issue is practical control of variables.", "Theories are tested and often revised, so they are not always correct.", ""]}
{"id": "econ-064", "s": "micro", "t": "1.1.1", "lv": 2, "q": "A model of the market for coffee predicts that a rise in income raises demand. Real data show demand fell after incomes rose, in a year when a new cheaper rival drink launched. What best explains this?", "o": ["Income has no effect on the demand for coffee", "The model is proved wrong with complete certainty", "Ceteris paribus failed: a substitute's price changed", "Coffee must be an inferior good in this market"], "a": 2, "x": "The prediction assumed other factors constant. A cheaper substitute shifted demand the other way, so ceteris paribus failed. The trap is rejecting the model outright or labelling the good inferior without isolating the effect.", "w": ["Income can affect demand; the other change is a better explanation.", "One observation cannot prove a model wrong when other factors changed at the same time.", "", "Concluding inferior good ignores the substitute launch, which is a confounding change."]}
{"id": "econ-065", "s": "micro", "t": "1.1.1", "lv": 2, "q": "A model assumes consumers are rational and have perfect information. Which is the most valid evaluation of this model?", "o": ["The assumptions make the model completely useless", "Assumptions matter only in the natural sciences", "Assumptions mean the model is always accurate", "Simplifies analysis, but may be less accurate if behaviour differs"], "a": 3, "x": "Assumptions simplify reality so that cause and effect can be analysed, but where they are unrealistic, predictions may be weaker. Good evaluation weighs both, not just one side.", "w": ["Too extreme: simplification is a strength as well as a limitation, so models are still useful.", "Wrong: all models, including in economics, rely on assumptions.", "Wrong: unrealistic assumptions can reduce accuracy, so accuracy is not guaranteed.", ""]}
{"id": "econ-066", "s": "micro", "t": "1.1.1", "lv": 3, "q": "A toy shop's owner says: 'Cutting my prices by 10% will raise sales, ceteris paribus.' Over the next month sales fall because a rival opens next door. Which statement is correct?", "o": ["The claim is disproved because sales fell", "The claim was wrong as businesses cannot use ceteris paribus", "Not disproved: the rival's entry broke ceteris paribus", "The claim is proved because prices were cut"], "a": 2, "x": "The prediction held only if other factors stayed constant. The rival's entry changed demand, so the result does not test the claim fairly. Observed outcomes mix several changes, which is why controlled experiments are impossible.", "w": ["Falling sales alone do not disprove it, as another factor changed at the same time.", "Ceteris paribus is used by all economic decision makers, including businesses.", "", "Cutting prices cannot prove anything when other factors changed; the result is inconclusive."]}
{"id": "econ-067", "s": "micro", "t": "1.1.2", "lv": 1, "q": "Which of the following is a positive statement?", "o": ["The government should raise the minimum wage to help low-paid workers", "Unemployment in the UK is too high", "Healthcare is more important than defence spending", "A rise in income tax will reduce the incomes of households"], "a": 3, "x": "A rise in income tax reducing household incomes can be tested against evidence. The others use value words (should, too high, more important). The trap is thinking only true statements are positive.", "w": ["'Should' signals a value judgement, so it is normative, not testable by data alone.", "'Too high' depends on opinion about what level is acceptable, so it is normative.", "'More important' ranks priorities by opinion, so it is normative.", ""]}
{"id": "econ-068", "s": "micro", "t": "1.1.2", "lv": 1, "q": "Which statement is normative?", "o": ["The unemployment rate fell between two quarters", "Wealthy households ought to pay a higher tax rate", "UK inflation rose in 2022 compared with 2020", "Raising fuel duty will reduce demand for petrol"], "a": 1, "x": "'Ought to' expresses a value judgement about fairness. It cannot be proved or disproved with data. The other three can be checked against evidence, so they are positive.", "w": ["This reports a measurable change, so it is positive.", "", "This is a claim about data that can be checked, so it is positive.", "Predicts an effect that can be tested with evidence, so it is positive even if the prediction might be wrong."]}
{"id": "econ-069", "s": "micro", "t": "1.1.2", "lv": 2, "q": "'The UK economy grew by 8% last year, so the government is clearly doing a good job.' Which description of this statement is correct?", "o": ["Neither, because it is a political statement", "Positive growth claim plus a normative judgement", "Entirely positive, because it contains a statistic", "Entirely normative, because it mentions the government"], "a": 1, "x": "The growth claim is testable, but 'doing a good job' is a value judgement. Statements can mix both. The trap is labelling a whole sentence positive because it includes a number.", "w": ["Economic statements about government can be classified; this one has both parts.", "", "Including a number does not make the whole statement positive; 'a good job' is opinion.", "Mentioning the government does not make it entirely normative; the growth figure can be tested."]}
{"id": "econ-070", "s": "micro", "t": "1.1.2", "lv": 2, "q": "A student says: 'The statement that a minimum wage increases unemployment is normative, because the evidence is disputed.' What is the error?", "o": ["It is positive, as it can be tested despite disputed evidence", "It is normative because it concerns workers' welfare", "It is neither, since disputed claims cannot be classified", "It is normative because economists disagree about it"], "a": 0, "x": "A statement is positive if it can be tested against evidence, even if the evidence is mixed or it turns out false. Disagreement about the evidence does not make it a value judgement.", "w": ["", "Topic being welfare does not make a claim normative; the claim is about cause and effect.", "Disputed claims are still classified by whether they can be tested, so it is positive.", "Disagreement over evidence is not the test; testability is. This confuses 'disputed' with 'opinion'."]}
{"id": "econ-071", "s": "micro", "t": "1.1.2", "lv": 2, "q": "Why do value judgements matter when a government chooses between two policies that economists agree have different effects?", "o": ["They make normative statements testable with data", "Positive analysis cannot say which outcome is preferable", "Value judgements determine which facts are true", "Value judgements replace the need for any evidence"], "a": 1, "x": "Positive economics can show the effects of a policy, but choosing between outcomes, such as greater equity or greater efficiency, needs value judgements. Policy therefore combines evidence with opinion.", "w": ["Normative statements stay untestable by data alone, whatever the policy context.", "", "Values do not change what is true; facts remain testable regardless of opinion.", "Good policy still uses evidence; values guide the choice, they do not replace it."]}
{"id": "econ-072", "s": "micro", "t": "1.1.2", "lv": 3, "q": "Which statement could be tested using data, even if it might turn out to be false?", "o": ["Sugary drinks ought to be taxed more heavily", "The tax on sugary drinks is unfair to poorer households", "Reducing sugar consumption is more valuable than lower prices", "A sugary drinks tax will reduce sugary drink consumption"], "a": 3, "x": "Whether the tax reduces consumption can be checked with sales data, so it is positive whether true or false. The other statements rely on fairness or priorities, which are value judgements.", "w": ["'Ought' is a value judgement, so it is normative.", "'Unfair' is a value judgement about fairness, so it is normative.", "'More valuable' ranks outcomes by opinion, so it is normative.", ""]}
{"id": "econ-073", "s": "micro", "t": "1.1.3", "lv": 1, "q": "Which statement best defines scarcity in economics?", "o": ["A shortage of a good at the current market price", "Goods that are expensive to buy", "Resources that are running out and cannot be replaced", "Finite resources set against unlimited wants"], "a": 3, "x": "Scarcity is the basic economic problem: finite resources cannot satisfy unlimited wants. It exists for every economy, rich or poor. Confusing it with a market shortage is the common slip.", "w": ["A shortage is excess demand at one price; scarcity is a permanent, universal problem, so this confuses the two.", "Price is not the issue; scarcity exists even for cheap or free goods.", "This describes non-renewable resources only; scarcity applies to all resources, including renewable ones.", ""]}
{"id": "econ-074", "s": "micro", "t": "1.1.3", "lv": 1, "q": "Which of the following is a renewable resource?", "o": ["Timber from a managed forest", "Iron ore from a mine", "Natural gas from a field", "Coal from a deep mine"], "a": 0, "x": "Renewable resources can regenerate if managed sustainably, such as managed forests. Coal, gas and iron ore are finite stocks that cannot be replaced on a human timescale. The trap is thinking renewable means unlimited.", "w": ["", "Iron ore is a mineral deposit that is used up once extracted, so it is non-renewable.", "Natural gas takes millions of years to form, so it is non-renewable.", "Coal is a fossil fuel formed over millions of years, so it is non-renewable."]}
{"id": "econ-075", "s": "micro", "t": "1.1.3", "lv": 2, "q": "A student has a free Saturday. Options ranked: 1) paid shift earning £60, 2) revising, 3) football with friends. She chooses the shift. What is her opportunity cost?", "o": ["£60", "Revising", "Football with friends", "Revising and football together"], "a": 1, "x": "Opportunity cost is the next best alternative forgone. Revising is ranked second, so it is the cost. Adding all alternatives together is the common error, as is quoting the £60 gained.", "w": ["£60 is the benefit of the chosen option, not what is given up.", "", "Football is her third choice, not the next best alternative.", "Opportunity cost counts only the single next best alternative, not all forgone options combined."]}
{"id": "econ-076", "s": "micro", "t": "1.1.3", "lv": 2, "q": "A farmer uses a field to grow wheat worth £8,000 a year. The next best use is rapeseed worth £6,500, and the third is grazing worth £5,000. What is the opportunity cost of growing wheat?", "o": ["£6,500 of rapeseed", "£5,000 of grazing", "£1,500, the difference between wheat and rapeseed", "£11,500 from rapeseed and grazing"], "a": 0, "x": "The opportunity cost is the value of the next best alternative: rapeseed, £6,500. Adding the other options or subtracting from the wheat income are the usual slips.", "w": ["", "Grazing is the third best use, not the next best.", "Subtracting gives a net gain, not the value of the forgone option.", "Adding all alternatives is wrong; only the next best is the opportunity cost."]}
{"id": "econ-077", "s": "micro", "t": "1.1.3", "lv": 2, "q": "The government spends £2 billion on a new hospital rather than on new railway upgrades, its next best use of funds. Which statement is correct?", "o": ["There is no opportunity cost, as the government can borrow", "The opportunity cost is the value of all other public projects", "The opportunity cost is the hospital's £2 billion", "The opportunity cost is the benefit of the railway upgrades"], "a": 3, "x": "The opportunity cost is the benefit forgone from the next best use: the railway upgrades. Borrowing does not remove it, since resources used for the hospital cannot be used elsewhere.", "w": ["Borrowing still uses real resources and leaves other projects unfunded, so an opportunity cost remains.", "Only the next best alternative counts, not every other project.", "£2 billion is the money cost of the hospital, not the forgone alternative.", ""]}
{"id": "econ-078", "s": "micro", "t": "1.1.3", "lv": 3, "q": "A council can use a site for a £4m car park, a £5m leisure centre or £3m of housing. It builds the leisure centre. Which statement is correct?", "o": ["Opportunity cost is £3m, as housing is the least valuable", "Opportunity cost is £7m, from car park and housing combined", "Opportunity cost is £4m, the value of the car park", "Opportunity cost is £5m, the cost of the centre"], "a": 2, "x": "Forgone options rank car park £4m then housing £3m. The next best alternative to the leisure centre is the car park, so £4m. Adding alternatives or picking the lowest are common errors.", "w": ["The least valuable option is not the next best; the car park is worth more.", "Only the next best alternative counts; adding both overstates it.", "", "£5m is the value of the chosen option, not the forgone one."]}
{"id": "econ-079", "s": "micro", "t": "1.1.4", "lv": 1, "q": "A point inside a country's PPF shows that the economy is:", "o": ["Wasting resources through unemployment", "Using all resources fully and efficiently", "Producing a combination that is unattainable", "Experiencing economic growth this year"], "a": 0, "x": "Points inside the PPF mean resources are unemployed or misallocated, so output is below potential. Points on the curve are efficient; points outside are unattainable with current resources.", "w": ["", "Full and efficient use puts the economy on the PPF, not inside it.", "Unattainable combinations lie outside the PPF, not inside.", "Growth is an outward shift of the PPF, not a point inside it."]}
{"id": "econ-080", "s": "micro", "t": "1.1.4", "lv": 1, "q": "Which event would shift a country's PPF outwards?", "o": ["A fall in unemployment levels", "A move from one point on the PPF to another", "A recession ending after a long period", "A rise in the quantity and quality of capital"], "a": 3, "x": "Growth in productive capacity, such as more or better capital, shifts the PPF outwards. Falling unemployment or ending a recession only moves the economy towards the existing curve.", "w": ["Lower unemployment moves the economy from inside towards the curve; it does not shift the curve.", "Moving along the curve is a trade-off, not growth.", "Ending a recession moves output towards the PPF, not the PPF itself.", ""]}
{"id": "econ-081", "s": "micro", "t": "1.1.4", "lv": 2, "q": "An economy on its PPF can produce 100 units of consumer goods and 0 capital goods, or 60 consumer and 20 capital goods. Moving between these points, the opportunity cost of one capital good is:", "o": ["0.5 consumer goods", "3 consumer goods", "40 consumer goods", "2 consumer goods"], "a": 3, "x": "Capital rises by 20 and consumer goods fall by 40. Opportunity cost per capital good is 40 ÷ 20 = 2 consumer goods. Dividing the wrong way round gives the cost of a consumer good.", "w": ["20 ÷ 40 is the opportunity cost of a consumer good in capital goods, inverted.", "3 uses 60 ÷ 20, but 60 is the final consumer output, not the amount given up.", "40 is the total sacrificed, not the cost per unit of capital.", ""]}
{"id": "econ-082", "s": "micro", "t": "1.1.4", "lv": 2, "q": "A straight-line PPF between consumer goods and capital goods implies that:", "o": ["Resources are perfectly specialised", "The economy is inefficient", "Opportunity cost is constant", "Opportunity cost is increasing"], "a": 2, "x": "A straight-line PPF has a constant slope, so the opportunity cost is constant. This means resources are equally suited to both goods. A bowed-out PPF shows increasing opportunity cost.", "w": ["Specialised resources give a bowed curve; a straight line means they transfer equally well.", "Points on a PPF are efficient whatever its shape.", "", "Increasing opportunity cost gives a PPF that is concave (bowed outwards), not straight."]}
{"id": "econ-083", "s": "micro", "t": "1.1.4", "lv": 2, "q": "A government diverts resources from consumer goods to capital goods. Other things equal, the likely long-run effect on the PPF is:", "o": ["The PPF shifts inwards because consumption falls", "The economy moves to a point outside the current PPF immediately", "The PPF shifts outwards as productive capacity grows", "There is no effect because the economy stays on the same curve"], "a": 2, "x": "More capital goods raise productive capacity, so the PPF shifts outwards over time. The sacrifice of consumption now is the opportunity cost. Output cannot exceed the current PPF immediately.", "w": ["Falling current consumption is a movement along the curve, not a loss of capacity.", "Points outside the current PPF are unattainable now; growth takes time.", "", "Investment in capital increases capacity, so the curve moves rather than staying fixed."]}
{"id": "econ-084", "s": "micro", "t": "1.1.4", "lv": 3, "q": "A technological advance doubles the output per worker in capital goods only. The maximum consumer goods output is unchanged. The PPF (capital on the vertical axis) will:", "o": ["Shift out parallel on both axes together", "Shift out on the consumer axis only, with capital fixed", "Pivot out on the capital axis only", "Shift inwards on the capital axis only"], "a": 2, "x": "Only the capital maximum rises, so the vertical intercept moves up while the consumer intercept stays fixed. The curve pivots outwards. A parallel shift needs both goods' capacity to rise.", "w": ["A parallel shift needs capacity to rise for both goods; here only capital improves.", "The horizontal intercept is unchanged because consumer goods technology has not changed.", "", "Better technology raises capacity; it cannot lower the maximum."]}
{"id": "econ-085", "s": "micro", "t": "1.1.5", "lv": 1, "q": "Which is the best definition of the division of labour?", "o": ["Sharing total output equally between all workers in a firm", "Workers choosing between work and leisure each day", "Splitting production into tasks done by different workers", "Each country producing only goods in which it has a cost advantage"], "a": 2, "x": "Division of labour splits production into separate tasks, each done by different workers. Specialisation is the wider term for focusing on one activity; confusing it with country-level trade or income sharing is the slip.", "w": ["This describes distribution of income, not how production is organised.", "This is the work-leisure choice, not a production method.", "", "This describes international specialisation by comparative advantage, not division of labour within production."]}
{"id": "econ-086", "s": "micro", "t": "1.1.5", "lv": 1, "q": "Which is a likely DISADVANTAGE of the division of labour for a worker on a bakery production line?", "o": ["Greater skill gained from repeating one task", "Higher output per hour from each worker", "Boredom from repetitive tasks, lowering motivation", "Time saved by not switching between different tasks"], "a": 2, "x": "Repetitive tasks cause boredom and lower motivation, a key drawback. The other options are benefits: higher productivity, no switching time and greater dexterity.", "w": ["Skill from repetition is a benefit of specialisation.", "This is a benefit of specialising, not a drawback.", "", "Saving switching time is a benefit; the slip is listing advantages as drawbacks."]}
{"id": "econ-087", "s": "micro", "t": "1.1.5", "lv": 2, "q": "In a barter economy, Asha makes bread and wants shoes, but the shoemaker wants eggs, not bread. Which problem does this show, and which function of money solves it?", "o": ["Lack of a unit of account; store of value", "Diminishing returns; medium of exchange", "Opportunity cost; standard of deferred payment", "Double coincidence of wants; medium of exchange"], "a": 3, "x": "Barter needs a double coincidence of wants: each party must want what the other offers. Money as a medium of exchange removes this, since everyone accepts it. Unit of account only gives prices.", "w": ["Unit of account helps compare values but does not remove the need for matching wants.", "Diminishing returns concern production, not exchange.", "Opportunity cost is not the barter problem; deferred payment relates to future debts.", ""]}
{"id": "econ-088", "s": "micro", "t": "1.1.5", "lv": 2, "q": "A firm splits making a chair into 4 tasks. Before, 5 workers each made 2 chairs a day (10 in total). After, the same 5 workers make 18 chairs a day. What is the output per worker now?", "o": ["4 chairs", "8 chairs", "3.6 chairs", "1.8 chairs"], "a": 2, "x": "Labour productivity is output divided by workers: 18 ÷ 5 = 3.6 chairs per worker, up from 2. Using the wrong divisor, such as the number of tasks, gives the wrong answer.", "w": ["4 would come from dividing by the 4 tasks rather than the 5 workers.", "8 is the increase in total output (18 − 10), not output per worker.", "", "1.8 comes from dividing 18 by 10, the old total output, not by workers."]}
{"id": "econ-089", "s": "micro", "t": "1.1.5", "lv": 2, "q": "Why does specialisation lead to trade?", "o": ["Workers make a surplus and swap it for other goods", "Government requires firms to sell their outputs abroad", "Money is eliminated, so goods must be bartered instead", "Workers produce less than they need and must import the rest"], "a": 0, "x": "Specialists produce a surplus beyond their own needs, and they need other goods they no longer make, so they exchange. Trade follows from specialisation, not from government orders or the end of money.", "w": ["", "Trade arises from interdependence, not legal compulsion.", "Specialisation increases the need for money as a medium of exchange, not barter.", "Specialisation raises output; the issue is a surplus of one good, not a shortfall of everything."]}
{"id": "econ-090", "s": "micro", "t": "1.1.5", "lv": 3, "q": "A town's economy relies heavily on one car factory using extreme division of labour. The factory closes. Which drawback of specialisation does this best illustrate?", "o": ["A fall in labour productivity due to boredom", "Loss of the medium of exchange function of money", "Over-dependence on one industry and narrow skills", "Diminishing marginal utility for local consumers"], "a": 2, "x": "Specialisation creates over-dependence and occupational immobility: narrowly skilled workers struggle to find other jobs when the industry fails. Boredom is a different drawback, and money functions are unaffected.", "w": ["Boredom is a drawback in work, but a closure is about dependence, not falling productivity.", "Money still works as a medium of exchange; this confuses specialisation with money's functions.", "", "Diminishing marginal utility concerns consumption, not job losses."]}
{"id": "econ-091", "s": "micro", "t": "1.1.6", "lv": 1, "q": "In a free market economy, which mechanism mainly allocates resources?", "o": ["Government production targets", "The price mechanism", "Rationing by the state", "Central planning committees"], "a": 1, "x": "In a free market, prices signal scarcity and consumer demand, so resources are allocated through the price mechanism. Government targets and central planning belong to command economies.", "w": ["Targets are a feature of command economies, not free markets.", "", "Rationing is state allocation, typical of command systems.", "Central planning is the command economy method, not the free market one."]}
{"id": "econ-092", "s": "micro", "t": "1.1.6", "lv": 1, "q": "Which economist is most associated with the idea of the 'invisible hand'?", "o": ["John Maynard Keynes", "Adam Smith", "Friedrich Hayek", "Karl Marx"], "a": 1, "x": "Adam Smith argued that individuals pursuing self-interest in markets unintentionally promote the wider good, as if guided by an invisible hand. Marx and Hayek are linked to other ideas.", "w": ["Keynes is linked to government demand management, not this idea.", "", "Hayek stressed dispersed knowledge and prices, not the phrase 'invisible hand'.", "Marx criticised capitalism and favoured collective ownership of the means of production."]}
{"id": "econ-093", "s": "micro", "t": "1.1.6", "lv": 2, "q": "Hayek argued against central planning mainly because planners:", "o": ["Ignore the profits of private owners", "Lack the scattered knowledge prices reveal", "Always produce too many consumer goods", "Cannot collect enough tax revenue"], "a": 1, "x": "Hayek's point is knowledge: information about wants and costs is scattered among millions of people, and prices bring it together. Planners cannot gather it, so allocation is poor.", "w": ["Profit is not the core point; it is the knowledge problem.", "", "He did not claim planners overproduce consumer goods; the issue is poor information.", "Hayek's argument concerns information, not the government's tax revenue."]}
{"id": "econ-094", "s": "micro", "t": "1.1.6", "lv": 2, "q": "A government runs the NHS and state schools but leaves most goods to private firms. This economy is best described as:", "o": ["A command economy, because the state provides key public services", "A subsistence economy, because some goods are provided free", "A free market economy, because most goods are privately supplied", "A mixed economy, as state and market both allocate resources"], "a": 3, "x": "A mixed economy combines market allocation with significant state provision and regulation. Some state provision does not make an economy a command one; that needs the state to dominate allocation.", "w": ["Command economies have state control of most resources, not just some services.", "Subsistence means producing mainly for own needs, which is not described.", "Free markets have minimal state provision; here the state provides major services.", ""]}
{"id": "econ-095", "s": "micro", "t": "1.1.6", "lv": 2, "q": "Which is a typical disadvantage of a command economy compared with a free market?", "o": ["Prices change far too quickly", "Inequality is always greater", "Weak incentives and little choice", "Unemployment is always higher"], "a": 2, "x": "Without profit incentives and market signals, command economies often suffer inefficiency, shortages or surpluses, and limited choice. Claims using 'always' about unemployment or inequality are wrong.", "w": ["Prices are often fixed in command economies, so this is not a typical weakness.", "Command systems aim for lower inequality, so this is the reverse.", "", "Command economies typically claim full employment; 'always higher' is unsupported."]}
{"id": "econ-096", "s": "micro", "t": "1.1.6", "lv": 3, "q": "Marx believed capitalism would be replaced by collective ownership. Which statement best fits his view of the free market?", "o": ["It allocates resources efficiently without any intervention", "It works best when the state sets all prices and output", "Owners of capital exploit workers by taking surplus value", "It cannot produce any economic growth at all"], "a": 2, "x": "Marx argued capital owners exploit workers by keeping surplus value, creating class conflict. He did not deny that capitalism produces growth. Efficient self-correction is Smith's view instead.", "w": ["This is closer to Smith's view, which Marx disputed.", "Price setting is not the core of Marx's critique; ownership and exploitation are.", "", "Marx accepted capitalism generated production and growth, while criticising its distribution and ownership."]}
{"id": "econ-097", "s": "micro", "t": "1.2.1", "lv": 1, "q": "In standard economic theory, what do rational consumers aim to maximise when they decide what to buy?", "o": ["Their total spending", "The number of goods they consume", "The profit of the firms they buy from", "Their utility"], "a": 3, "x": "Rational consumers are assumed to maximise utility, the satisfaction gained from consuming goods and services. Confusing utility with quantity consumed is the trap: more goods do not always mean more satisfaction.", "w": ["Spending is not the aim; consumers want satisfaction from what they buy, not to spend as much as possible.", "Quantity is not the goal; beyond some point extra units add little or negative utility.", "Consumers do not aim at firms' profits; that is the firm's objective, not the consumer's.", ""]}
{"id": "econ-098", "s": "micro", "t": "1.2.1", "lv": 1, "q": "Which profit-maximising rule do firms follow under the standard assumption of rational behaviour?", "o": ["Produce where average revenue is highest", "Produce where total cost is at its lowest", "Produce where marginal revenue equals marginal cost", "Produce where marginal cost is at its minimum"], "a": 2, "x": "Profit is maximised where MR = MC, with the last unit adding as much to revenue as to cost. Minimising cost or maximising revenue alone does not guarantee maximum profit.", "w": ["Highest average revenue ignores costs, so profit need not be maximised.", "Lowest total cost would mean producing nothing; it ignores revenue entirely.", "", "Minimum MC is the lowest cost of a unit, not where marginal revenue matches it."]}
{"id": "econ-099", "s": "micro", "t": "1.2.1", "lv": 2, "q": "A shop owner finds that selling the 51st unit of a product adds £8 to revenue and £11 to cost. If the owner is a rational profit maximiser, what should they do?", "o": ["Reduce output, as MC exceeds MR", "Keep output at 51, as revenue is still rising", "Increase output, as MR is positive", "Raise output until MC falls to zero"], "a": 0, "x": "MC (£11) is greater than MR (£8), so the 51st unit lowers profit by £3. A rational profit maximiser cuts output until MR = MC. The trap is that positive MR alone does not justify production.", "w": ["", "Rising revenue is irrelevant if cost rises by more; profit falls.", "Positive MR is not enough; the extra unit costs more than it earns.", "Output is not pushed until MC is zero; the rule compares MC with MR."]}
{"id": "econ-100", "s": "micro", "t": "1.2.1", "lv": 2, "q": "A consumer buys a sandwich at £4 and gets satisfaction they value at £6. Which statement best fits the assumption of rational behaviour?", "o": ["Buying is rational because the benefit exceeds the cost", "Buying is irrational because the consumer gains less than £4", "Buying is irrational because all goods should be valued equally", "Buying is rational only if the sandwich is the cheapest available"], "a": 0, "x": "A rational consumer buys when perceived benefit (£6) exceeds cost (£4), giving a net gain of £2. Rationality is about weighing costs and benefits, not choosing the cheapest option.", "w": ["", "The gain is £6 against £4 cost, so there is a net benefit, not a loss.", "Goods are valued differently by individuals; rationality does not require equal valuation.", "Rational choice weighs benefit against cost; it need not be the cheapest option."]}
{"id": "econ-101", "s": "micro", "t": "1.2.1", "lv": 2, "q": "A shopper buys a product because a sign says 'Only 2 left!' even though they did not plan to. Which comment is most accurate?", "o": ["It shows the firm is maximising social welfare", "It shows demand is perfectly price inelastic", "Behaviour may deviate from rational choice", "It proves that consumers are always rational"], "a": 2, "x": "Responding to scarcity messages rather than weighing costs and benefits is an example of behavioural influences that challenge the assumption of rationality. One example does not prove anything about elasticity.", "w": ["The sign is a firm's sales tactic; it says nothing about social welfare.", "Nothing here measures price responsiveness, so elasticity cannot be concluded.", "", "Impulse buying prompted by a sign cuts against the rationality assumption, not for it."]}
{"id": "econ-102", "s": "micro", "t": "1.2.1", "lv": 3, "q": "Which is a limitation of assuming that firms always maximise profit?", "o": ["Profit maximisation is only possible in perfect competition", "Firms always know their exact marginal revenue and cost", "Owners may pursue other aims, like sales growth", "Firms ignore costs completely when setting output"], "a": 2, "x": "Firms may have other objectives, such as revenue or sales maximisation, growth, or satisfying shareholders, and may lack full information. This weakens the assumption. Claiming perfect information would support it, not limit it.", "w": ["Firms in any market structure can aim at MR = MC, so this is false.", "Perfect knowledge would support the assumption; in practice firms lack it, which is the limitation.", "", "Profit maximisers consider costs; ignoring them is not the assumption or the limitation."]}
{"id": "econ-103", "s": "micro", "t": "1.2.2", "lv": 1, "q": "The price of a coffee shop's latte falls from £3.20 to £2.80 and more lattes are bought. What does this show on the demand curve for lattes?", "o": ["An extension of demand, a movement down the curve", "A leftward shift of the demand curve", "A contraction of demand, a movement up the curve", "A rightward shift of the demand curve"], "a": 0, "x": "A fall in the good's own price causes an extension of demand: a movement along the existing curve. A shift needs a change in a condition of demand, not price itself.", "w": ["", "Price is on the axis, so it cannot shift the curve, and the direction would also be wrong.", "A contraction is caused by a price rise, not a fall; direction is wrong.", "Price changes do not shift the curve; confuses a movement along with a shift."]}
{"id": "econ-104", "s": "micro", "t": "1.2.2", "lv": 1, "q": "Which one of the following would cause the demand curve for train travel to shift to the right?", "o": ["A fall in consumers' real incomes, train travel being a normal good", "A rise in the price of petrol, a substitute", "A fall in train fares", "A rise in the price of train tickets"], "a": 1, "x": "Dearer petrol makes car travel, a substitute, less attractive, so more people want trains at every price: demand shifts right. Own-price changes only cause movements along the curve.", "w": ["Lower income reduces demand for a normal good, shifting the curve left.", "", "Own price falling causes an extension along the curve, not a shift.", "Own price rising causes a contraction along the curve, not a shift."]}
{"id": "econ-105", "s": "micro", "t": "1.2.2", "lv": 1, "q": "Marginal utility is best defined as the:", "o": ["price a consumer pays for an extra unit of a good", "average satisfaction per unit consumed", "total satisfaction from consuming all units of a good", "satisfaction from consuming one extra unit"], "a": 3, "x": "Marginal utility is the additional satisfaction from consuming one more unit. Do not confuse it with total utility, which is the sum of all the marginal utilities.", "w": ["Price is what is paid, not satisfaction gained; utility is not the same as price.", "That is average utility, which is not the marginal concept.", "That is total utility, not marginal utility.", ""]}
{"id": "econ-106", "s": "micro", "t": "1.2.2", "lv": 2, "q": "Cinema tickets and streaming subscriptions are substitutes. The price of streaming subscriptions rises. What happens to the demand curve for cinema tickets, and why?", "o": ["It shifts left, as consumers switch away from cinemas", "It shifts right, as cinemas become relatively cheaper", "It shifts right, as cinema tickets become cheaper in absolute terms", "It stays still, with a contraction along the curve"], "a": 1, "x": "With substitutes, a rise in one price raises demand for the other at every price, so the curve shifts right. Cinema ticket prices have not changed, so there is no movement along the curve.", "w": ["That is the pattern for complements; mixes up substitutes and complements.", "", "Cinema prices have not fallen; only their relative price has changed.", "The cinema price has not changed, so there is no contraction; the related price shifts the curve."]}
{"id": "econ-107", "s": "micro", "t": "1.2.2", "lv": 2, "q": "A consumer eats slices of pizza. Marginal utility, in utils, is 20, 14, 8, 2 for slices 1 to 4. What is total utility after three slices, and what does the pattern show?", "o": ["34 utils; diminishing marginal utility", "42 utils; diminishing marginal utility", "8 utils; diminishing marginal utility", "42 utils; total utility is falling"], "a": 1, "x": "Total utility is the sum of marginal utilities: 20 + 14 + 8 = 42. Marginal utility falls with each extra slice, which is diminishing marginal utility; total utility still rises while marginal utility is positive.", "w": ["34 is 20 + 14 only, the first two slices; the third slice was left out.", "", "8 is only the third slice's marginal utility, not the total; marginal and total confused.", "The sum is correct, but total utility does not fall here; marginal utility does."]}
{"id": "econ-108", "s": "micro", "t": "1.2.2", "lv": 3, "q": "Pasta and pasta sauce are complements. A supermarket cuts the price of pasta. Which pair of changes to the demand curve for sauce, and to the quantity of pasta demanded, is correct?", "o": ["Sauce curve unchanged; pasta quantity extends", "Sauce curve shifts right; pasta quantity extends", "Sauce curve shifts left; pasta quantity contracts", "Sauce curve shifts right; pasta curve shifts right"], "a": 1, "x": "Cheaper pasta extends the quantity of pasta demanded along its own curve. As a complement, more pasta raises demand for sauce at every price, shifting its curve right. Pasta's own curve does not shift.", "w": ["Ignores the complement link: a related price change shifts the sauce curve.", "", "Treats complements as substitutes and gets the pasta direction wrong too.", "Pasta's own price change only moves along its curve; it does not shift it."]}
{"id": "econ-109", "s": "micro", "t": "1.2.4", "lv": 1, "q": "The price of bread rises and bakeries produce more loaves. How is this shown on a supply diagram?", "o": ["A movement down along the supply curve", "A movement up along the supply curve", "A rightward shift of the supply curve", "A leftward shift of the supply curve"], "a": 1, "x": "A change in the good's own price causes a movement along the supply curve. A higher price gives an extension of supply. The trap is calling it a shift.", "w": ["A fall in price would cause a movement down, a contraction; here the price has risen.", "", "Shifts come from changes in conditions of supply, not from the good's own price changing.", "A leftward shift means supply falls at every price, which is not what happens here."]}
{"id": "econ-110", "s": "micro", "t": "1.2.4", "lv": 1, "q": "Which one of the following would shift the supply curve for new cars to the right?", "o": ["New technology that cuts the cost of making cars", "A rise in the price of new cars", "A rise in the price of steel used in cars", "A fall in the price of new cars"], "a": 0, "x": "Lower costs of production through technology are a condition of supply, so supply increases at every price. Changes in the car's own price only move along the curve.", "w": ["", "The good's own price causes a movement along the curve, not a shift.", "Higher input costs raise costs of production and shift supply left.", "A fall in own price causes a contraction along the curve, not a shift."]}
{"id": "econ-111", "s": "micro", "t": "1.2.4", "lv": 2, "q": "The government introduces a per-unit subsidy on the production of solar panels. What is the effect on the supply curve?", "o": ["It shifts left, as firms receive less", "It becomes steeper but does not shift", "It stays unchanged; only demand is affected", "It shifts right, as costs fall"], "a": 3, "x": "A subsidy lowers firms' costs per unit, so they supply more at every price. The supply curve shifts right (down). Subsidies are a condition of supply, not a demand factor.", "w": ["That describes an indirect tax, which raises costs and shifts supply left.", "A per-unit subsidy gives a parallel shift; steepness changes only for percentage-based taxes or subsidies.", "Subsidies are paid to producers, so they affect supply directly.", ""]}
{"id": "econ-112", "s": "micro", "t": "1.2.4", "lv": 2, "q": "A poor harvest cuts wheat output. At the same time, the price of wheat rises. Which describes the supply diagram?", "o": ["Rightward shift, then an extension along the new curve", "Contraction along the original curve only", "Leftward shift of supply, then an extension along the new curve", "Leftward shift of supply, then a contraction along the new curve"], "a": 2, "x": "The harvest is a conditions-of-supply change, shifting supply left. The higher price then causes an extension along the new curve. Both effects need identifying separately.", "w": ["A poor harvest reduces supply, so the shift is left, not right.", "This ignores the shift caused by the harvest, which is a condition of supply.", "", "A price rise causes an extension, not a contraction."]}
{"id": "econ-113", "s": "micro", "t": "1.2.4", "lv": 2, "q": "A toy shop's supplier raises wholesale prices by 10%. The shop buys the toys to resell. What is the effect on the shop's supply of toys?", "o": ["Extension along the supply curve", "Leftward shift of the supply curve", "Contraction along the supply curve", "Rightward shift of the supply curve"], "a": 1, "x": "Higher wholesale prices raise the shop's costs, so it supplies less at every price. The curve shifts left. Do not confuse input costs with the good's own price.", "w": ["Extension needs a rise in the toy's own selling price.", "", "Contraction needs a fall in the good's own price, not a rise in costs.", "A rightward shift needs lower costs or a subsidy."]}
{"id": "econ-114", "s": "micro", "t": "1.2.4", "lv": 3, "q": "Supply of a good is $Q_s = 40 + 5P$ (P in £, Q in units). A new tax cuts supply by 20 units at every price. What is quantity supplied at £6 after the tax?", "o": ["70 units", "10 units", "50 units", "30 units"], "a": 2, "x": "Before the tax at £6: $40+5\\times6=70$. A 20-unit fall at every price gives 50. This is a leftward shift of the curve, not a movement along it.", "w": ["That is the original quantity at £6, ignoring the shift.", "That is an arithmetic slip; 70 minus 20 is 50, not 10.", "", "That subtracts 40 from the original quantity; the shift is only 20 units."]}
{"id": "econ-115", "s": "micro", "t": "1.2.5", "lv": 1, "q": "Which formula gives price elasticity of supply (PES)?", "o": ["$\\frac{\\%\\Delta Q_d}{\\%\\Delta P}$", "$\\frac{\\Delta Q_s}{\\Delta P}$", "$\\frac{\\%\\Delta P}{\\%\\Delta Q_s}$", "$\\frac{\\%\\Delta Q_s}{\\%\\Delta P}$"], "a": 3, "x": "PES is the percentage change in quantity supplied divided by the percentage change in price. Inverting it or using absolute changes is the common slip.", "w": ["This is the formula for PED, which uses quantity demanded.", "This uses absolute changes, which depend on units; PES needs percentage changes.", "This is inverted; it puts price change on top instead of quantity supplied.", ""]}
{"id": "econ-116", "s": "micro", "t": "1.2.5", "lv": 2, "q": "A straight-line supply curve starts at the origin and slopes upwards. What is its PES at every point?", "o": ["Exactly 1", "Infinity", "Greater than 1", "Zero"], "a": 0, "x": "Any straight-line supply curve through the origin has unit elasticity, because quantity changes in the same proportion as price. Steepness alone does not decide PES.", "w": ["", "Infinity means a horizontal supply curve, not an upward-sloping line.", "PES greater than 1 needs a straight supply line that cuts the price axis above the origin; a line from the origin gives exactly 1.", "Zero means perfectly inelastic, a vertical supply curve, not a ray from the origin."]}
{"id": "econ-117", "s": "micro", "t": "1.2.5", "lv": 2, "q": "The price of a bakery's loaves rises from £2.00 to £2.40. Quantity supplied rises from 500 to 540 loaves a day. What is PES?", "o": ["1.25", "0.8", "0.4", "2.5"], "a": 2, "x": "%ΔQs = 40/500 = 8%. %ΔP = 0.40/2.00 = 20%. PES = 8 ÷ 20 = 0.4. Inverting gives 2.5, a common slip.", "w": ["This does not match 8% and 20%; it comes from a wrong base or inversion.", "Doubling the correct 0.4 is an arithmetic slip; 8 ÷ 20 is 0.4, not 0.8.", "", "This inverts the formula: 20 ÷ 8 = 2.5."]}
{"id": "econ-118", "s": "micro", "t": "1.2.5", "lv": 2, "q": "A firm's PES for its product is 1.5. The price rises by 6%. By what percentage does quantity supplied rise?", "o": ["1.5%", "4%", "9%", "7.5%"], "a": 2, "x": "Rearrange: %ΔQs = PES × %ΔP = 1.5 × 6 = 9%. Dividing instead of multiplying is the usual slip.", "w": ["This just repeats the PES value rather than applying it to the price change.", "This divides 6 by 1.5, rearranging the formula wrongly.", "", "This adds 1.5 to 6, which is not how PES works."]}
{"id": "econ-119", "s": "micro", "t": "1.2.5", "lv": 2, "q": "Which change would make a firm's supply of a good more price elastic?", "o": ["Production needs scarce, specialised workers", "The time period considered is shortened", "The firm holds large stocks of finished goods", "The firm is already at full capacity"], "a": 2, "x": "Large stocks let a firm raise output quickly when price rises, so supply is more elastic. Full capacity, scarce factors and a shorter time all make supply less elastic.", "w": ["Scarce, immobile factors make it harder to expand output, so supply is less elastic.", "Less time means firms cannot adjust inputs, making supply less elastic.", "", "At full capacity, output cannot rise easily, so supply is inelastic."]}
{"id": "econ-120", "s": "micro", "t": "1.2.5", "lv": 3, "q": "Demand for strawberries rises, so price rises sharply in the short run. Which best explains why the price rise is smaller in the long run?", "o": ["Strawberries become a luxury good", "Producers' costs of production fall automatically", "Demand becomes more elastic over time", "Farmers can plant more, so supply is more elastic"], "a": 3, "x": "In the long run farmers can plant more and enter the market, so PES is higher. The same rise in demand then causes a larger rise in quantity and a smaller rise in price.", "w": ["Luxury status relates to income elasticity, not the time period of supply.", "Costs need not fall; the key is that factors become adjustable, raising PES.", "This confuses supply with demand; the question is about supply responding over time.", ""]}
{"id": "econ-121", "s": "micro", "t": "1.2.6", "lv": 1, "q": "In a free market, the price is currently above the equilibrium price. Which statement is correct?", "o": ["Excess demand, so demand curve shifts right", "Excess supply, so price falls", "Excess supply, so supply curve shifts left", "Excess demand, so price rises"], "a": 1, "x": "Above equilibrium, quantity supplied exceeds quantity demanded: excess supply. Unsold stock pushes price down, a movement along both curves. The trap is shifting curves when only price is changing.", "w": ["Excess demand is wrong here, and price changes do not shift demand.", "", "Price changes cause movements along curves, not shifts of the supply curve.", "Excess demand occurs below equilibrium, not above it."]}
{"id": "econ-122", "s": "micro", "t": "1.2.6", "lv": 1, "q": "A rise in consumers' incomes increases demand for a normal good. What happens to equilibrium price and quantity?", "o": ["Price rises, quantity rises", "Price falls, quantity rises", "Price rises, quantity falls", "Price and quantity are unchanged"], "a": 0, "x": "Demand shifts right, creating excess demand at the old price. Price rises, causing supply to extend along the supply curve, so quantity also rises. The trap is forgetting the extension of supply.", "w": ["", "Price falls would need a rightward shift of supply, not demand.", "Quantity falls would need a leftward shift of demand or supply.", "Income is a non-price factor so it does shift demand and changes equilibrium."]}
{"id": "econ-123", "s": "micro", "t": "1.2.6", "lv": 2, "q": "Demand: Qd = 120 − 4P. Supply: Qs = 20 + 6P. (P in £, Q in units.) What is the equilibrium price?", "o": ["£8", "£12", "£10", "£14"], "a": 2, "x": "Set Qd = Qs: 120 − 4P = 20 + 6P, so 100 = 10P and P = £10. Check: Q = 80 on both curves. The trap is mis-signing when collecting terms.", "w": ["At £8, Qd = 88 but Qs = 68, so it is not equilibrium.", "£12 gives Qd = 72 but Qs = 92, so it is not equilibrium.", "", "£14 gives Qd = 64 but Qs = 104, so it is not equilibrium."]}
{"id": "econ-124", "s": "micro", "t": "1.2.6", "lv": 2, "q": "Using Qd = 120 − 4P and Qs = 20 + 6P, the price is fixed at £6. What is the market outcome?", "o": ["Excess demand of 40 units", "Excess supply of 20 units", "Excess demand of 20 units", "Excess supply of 40 units"], "a": 0, "x": "At £6, Qd = 120 − 24 = 96 and Qs = 20 + 36 = 56. Qd exceeds Qs by 40, so excess demand of 40. The trap is mixing up the two quantities.", "w": ["", "Price £6 is below equilibrium £10, so it is excess demand, and the size is wrong.", "Direction is right but 20 is not Qd − Qs at £6, which is 40.", "Price is below equilibrium, so there is excess demand, not supply."]}
{"id": "econ-125", "s": "micro", "t": "1.2.6", "lv": 2, "q": "A new tax on producers shifts supply left for a good with a downward-sloping demand curve. Compared with before, what happens to equilibrium?", "o": ["Price rises, quantity falls", "Price falls, quantity falls", "Price falls, quantity rises", "Price rises, quantity rises"], "a": 0, "x": "Supply shifts left, so at the old price there is excess demand. Price rises, and demand contracts along its curve, so quantity falls. The trap is thinking quantity rises with price.", "w": ["", "Falling price would need a rightward shift of supply, not leftward.", "This describes a rightward supply shift, the opposite of a tax.", "Demand has not shifted, so higher price means contraction in quantity, not a rise."]}
{"id": "econ-126", "s": "micro", "t": "1.2.6", "lv": 3, "q": "Demand and supply of a good both shift right, with the demand shift much larger. What is certain about the new equilibrium compared with the old?", "o": ["Quantity is higher, price is uncertain", "Price is lower and quantity is higher", "Price is higher, quantity is uncertain", "Price is higher and quantity is higher"], "a": 3, "x": "Both shifts raise quantity. Price rises because the larger demand shift outweighs the supply shift. If sizes were unknown, price would be uncertain; here demand shifts more, so price rises.", "w": ["Price is determined by the larger shift, which is demand, so it is not uncertain.", "A lower price needs the supply shift to be larger than demand's.", "Quantity rises with both rightward shifts, so it is not uncertain.", ""]}
{"id": "econ-127", "s": "micro", "t": "1.2.7", "lv": 1, "q": "In a free market, what is meant by the rationing function of the price mechanism?", "o": ["Price falls so firms are encouraged to produce more of the good", "Price changes tell firms which goods consumers will want in future", "Price rises when a good is scarce, so only those able to pay buy it", "The government shares out goods using coupons so everyone gets an equal amount"], "a": 2, "x": "Rationing means a higher price allocates scarce goods to those willing and able to pay, reducing quantity demanded. Telling firms what consumers want is signalling; coupons are government allocation.", "w": ["A falling price would reduce supply incentives; this misreads the incentive function and the direction of price change.", "This describes the signalling function, not rationing; the functions are often confused.", "", "Coupon rationing is government allocation, not the price mechanism; confuses rationing with administered distribution."]}
{"id": "econ-128", "s": "micro", "t": "1.2.7", "lv": 1, "q": "A sudden rise in demand for electric bikes raises their price and profits. Which function of the price mechanism encourages firms to supply more?", "o": ["Redistribution", "Rationing", "Fixed pricing", "Incentive"], "a": 3, "x": "Higher prices and profit give firms an incentive to produce more. Rationing restricts demand, not encourages supply. Redistribution is not a price mechanism function.", "w": ["Redistribution is a government aim using tax and benefits, not a function of the price mechanism.", "Rationing limits demand among buyers; it does not explain why firms increase output.", "Fixed prices would stop prices responding; the price mechanism relies on changing prices.", ""]}
{"id": "econ-129", "s": "micro", "t": "1.2.7", "lv": 2, "q": "Demand for oat milk rises, shifting the demand curve right. Which sequence best shows the signalling function at work?", "o": ["Price rises, so supply shifts left as input costs increase", "Price rises, telling producers to move resources into oat milk", "Price rises, so consumers buy less and the market clears", "Price rises, so the government decides to subsidise oat milk"], "a": 1, "x": "Signalling: the higher price (and profit) tells producers that consumers want more oat milk, so resources move into it. Buying less until the market clears is rationing; students often mix the two functions.", "w": ["Supply does not shift left; higher price leads to an extension of supply.", "", "This describes rationing, a reduced quantity demanded, not a message to producers.", "Government subsidy is intervention, not the price mechanism working freely."]}
{"id": "econ-130", "s": "micro", "t": "1.2.7", "lv": 2, "q": "Heavy snow cuts the supply of fresh vegetables in a UK town. Prices rise. Which statement correctly describes the effect?", "o": ["Higher prices remove the need for any producers to respond at all", "Higher prices mean that excess demand remains permanently in place", "Higher prices ration limited stock to those willing and able to pay", "Higher prices increase demand, shifting the demand curve to the right"], "a": 2, "x": "The supply curve shifts left, creating excess demand at the old price. Price rises and quantity demanded contracts along the demand curve, rationing the scarce stock. Demand does not shift because of price.", "w": ["Higher prices give an incentive for suppliers elsewhere to send more vegetables.", "The market moves to a new equilibrium as price rises, so excess demand is removed.", "", "A price change causes a movement along demand, not a shift; confusing movement with shift."]}
{"id": "econ-131", "s": "micro", "t": "1.2.7", "lv": 2, "q": "Tastes move away from diesel cars. Demand falls, price falls and profits fall. What does the price mechanism signal to producers?", "o": ["Increase diesel production to try to restore the price", "Raise prices to protect profit margins on diesel cars", "Keep output unchanged as the price will soon rise again", "Reduce diesel output and move resources to higher-demand uses"], "a": 3, "x": "Falling price and profit signal that consumers want less, so resources leave diesel cars for more profitable uses. Increasing output would waste resources. Raising price ignores the signal.", "w": ["Expanding output when demand falls ignores the signal and would lower price further.", "Firms in a competitive market cannot simply raise price against falling demand; this ignores the signal.", "Waiting contradicts the signal; falling profit gives incentive to reallocate now.", ""]}
{"id": "econ-132", "s": "micro", "t": "1.2.7", "lv": 3, "q": "Concert tickets are priced below equilibrium, creating excess demand and queues. Which statement is correct about the price mechanism here?", "o": ["Price is not rationing by willingness to pay; allocation is by queue or luck", "Producers have a stronger incentive to expand supply at this low price", "Price is rationing efficiently because tickets go to those who value them most", "Excess demand sends a signal to lower the price even further"], "a": 0, "x": "Below equilibrium, price does not ration by willingness to pay; allocation is by queue or luck. The signal to raise price is not acted on. Producers' incentive is weaker than at equilibrium.", "w": ["", "A low price gives less profit incentive, not more, so supply incentives are weaker.", "Allocation by queue need not favour highest valuation; price is not doing the rationing.", "Excess demand signals price should rise, not fall; direction error."]}
{"id": "econ-133", "s": "micro", "t": "1.2.8", "lv": 1, "q": "Which statement correctly defines consumer surplus?", "o": ["The gap between willingness to pay and the price actually paid", "The total amount consumers spend on a good in a market", "The difference between the price paid and the cost of producing the good", "The extra revenue firms gain when price rises above equilibrium"], "a": 0, "x": "Consumer surplus is the gap between willingness to pay (shown by the demand curve) and the price actually paid. Confusing it with the price-minus-cost gap mixes it up with producer surplus.", "w": ["", "This is consumer expenditure (P × Q), not surplus; surplus is the extra benefit above what is paid.", "This describes producer-style profit margin, not consumer surplus; consumer surplus uses willingness to pay.", "This describes a producer gain, not consumer surplus, and consumers do not receive revenue."]}
{"id": "econ-134", "s": "micro", "t": "1.2.8", "lv": 1, "q": "On a standard supply and demand diagram, producer surplus at the equilibrium price is shown by the area:", "o": ["below the supply curve, down to the quantity axis", "above supply and below the equilibrium price, up to equilibrium quantity", "above the demand curve and below the equilibrium price level", "between the supply and demand curves beyond equilibrium quantity"], "a": 1, "x": "Producer surplus is the gap between the price received and the minimum price producers would accept (supply curve), up to equilibrium output. Mixing it up with total cost, the area below supply, is the slip.", "w": ["The area under supply shows total variable cost of production, not surplus.", "", "The area above demand and below price is not a surplus; consumer surplus lies under demand and above price.", "Beyond equilibrium quantity, supply lies above demand, so no surplus is earned on those units."]}
{"id": "econ-135", "s": "micro", "t": "1.2.8", "lv": 2, "q": "Demand is P = 20 − 2Q and supply is P = 2 + Q, with P in £ and Q in units. What is consumer surplus at equilibrium?", "o": ["£72", "£36", "£60", "£18"], "a": 1, "x": "Equilibrium: 20 − 2Q = 2 + Q, so Q = 6 and P = £8. Consumer surplus = ½ × 6 × (20 − 8) = £36. Using 20 as the height, or omitting the ½, is the trap.", "w": ["This forgets the ½ for a triangle: 6 × 12 = 72.", "", "This uses ½ × 6 × 20, taking the full intercept as the height instead of the gap 20 − 8.", "This is producer surplus, ½ × 6 × (8 − 2), not consumer surplus."]}
{"id": "econ-136", "s": "micro", "t": "1.2.8", "lv": 2, "q": "Demand for a UK product rises, shifting the demand curve to the right. Supply is upward-sloping and unchanged. Which is certain to happen?", "o": ["Consumer surplus falls because the equilibrium price rises", "Producer surplus rises because price and quantity both rise", "Producer surplus is unchanged because the supply curve has not shifted", "Producer surplus falls because firms must produce more units"], "a": 1, "x": "Higher price and higher quantity widen the area above supply and below price, so producer surplus rises. Thinking surplus only changes when supply shifts is the slip; movement along supply changes the area.", "w": ["The demand curve moves out too, so consumer surplus is not certain to fall just because price rises.", "", "The area depends on price and quantity, which change, even though the curve itself does not shift.", "More units at a higher price enlarge producer surplus; output rising does not shrink it."]}
{"id": "econ-137", "s": "micro", "t": "1.2.8", "lv": 2, "q": "Demand is P = 30 − 3Q. New technology shifts supply right, so price falls from £15 to £9 and quantity rises from 5 to 7. What is the change in consumer surplus?", "o": ["It rises by £73.50", "It rises by £36", "It rises by £18", "It falls by £36"], "a": 1, "x": "Before: ½ × 5 × 15 = £37.50. After: ½ × 7 × (30 − 9) = £73.50. The change is +£36. Giving the new level instead of the change is the slip.", "w": ["£73.50 is the new consumer surplus, not the change from the old level.", "", "This halves the change again; the £36 difference is already the difference between two triangle areas.", "Cheaper price with more sold enlarges the triangle, so consumer surplus rises, not falls."]}
{"id": "econ-138", "s": "micro", "t": "1.2.8", "lv": 3, "q": "Demand is P = 20 − 2Q, supply P = 2 + Q (£, units). A minimum price of £10 cuts sales to 5 units. Producers sell all 5; the 5 units go to the highest-value buyers. Change in total surplus?", "o": ["Falls by £11, the loss of consumer surplus", "Falls by £1.50", "Rises by £9.50, as producers gain", "No change, as surplus is only transferred"], "a": 1, "x": "Before: CS £36 + PS £18 = £54. After: CS ½ × 5 × 10 = £25; PS = ½ × 5 × 5 + 5 × 3 = £27.50; total £52.50. Total falls £1.50. Ignoring the lost trade is the trap.", "w": ["£11 is the consumer surplus loss only; producers gain £9.50, so the net change is smaller.", "", "£9.50 is the rise in producer surplus alone; consumers lose £11, so the total does not rise.", "Some surplus moves to producers, but trades between 5 and 6 units are lost, so the total falls."]}
{"id": "econ-139", "s": "micro", "t": "1.2.10", "lv": 1, "q": "Which statement best describes the traditional economic assumption that behavioural economics challenges?", "o": ["Consumers only buy goods with price-elastic demand", "Consumers have unlimited incomes to spend", "Consumers never respond to changes in price", "Consumers act rationally to maximise their utility"], "a": 3, "x": "Traditional theory assumes rational consumers who maximise utility using full information. Behavioural economics shows that social influences, habits and limited calculation ability can lead people away from this. Unlimited income is not assumed.", "w": ["Wrong: elasticity describes responsiveness and is not an assumption about how consumers decide.", "Wrong: consumers are assumed to face a budget constraint, so this confuses rationality with income.", "Wrong: traditional theory says price changes do affect demand, so this misstates the assumption.", ""]}
{"id": "econ-140", "s": "micro", "t": "1.2.10", "lv": 1, "q": "A teenager buys a particular trainer brand only because most of her friends have bought it. Which concept from behavioural economics does this best illustrate?", "o": ["Herd behaviour", "Rule of thumb", "Perfect information", "Habitual behaviour"], "a": 0, "x": "Copying the choices of others is herd behaviour, where social influence overrides personal evaluation of costs and benefits. Habit means repeating your own past choices, not following a group.", "w": ["", "Wrong: a rule of thumb is a simple shortcut for decisions, not copying a group.", "Wrong: she lacks independent information, so perfect information is the opposite of the case.", "Wrong: habit comes from repeating your own past purchases, not from copying friends."]}
{"id": "econ-141", "s": "micro", "t": "1.2.10", "lv": 1, "q": "A commuter buys the same brand of coffee from the same café every morning without comparing prices. This is best described as:", "o": ["Habitual behaviour", "Bounded rationality caused by social pressure", "Utility maximisation with full information", "Herd behaviour"], "a": 0, "x": "Repeating a past choice automatically, without weighing up alternatives, is habitual behaviour. It saves effort but means the consumer may miss cheaper options, so demand responds less to price changes.", "w": ["", "Wrong: no social pressure is described, only repetition of her own routine.", "Wrong: she does not compare prices, so she is not weighing up all information.", "Wrong: no one else's choices are influencing her; herd behaviour needs copying others."]}
{"id": "econ-142", "s": "micro", "t": "1.2.10", "lv": 2, "q": "Many customers choose a mobile phone contract by comparing only the monthly fee, ignoring data limits and handset costs. Which is the best explanation of this behaviour?", "o": ["They are maximising utility with full information", "They are simply following a long-held buying habit", "They are copying the choices of other consumers", "They find complex sums hard, so use a simple shortcut"], "a": 3, "x": "Comparing total cost and value across many features is hard, so consumers rely on a rule of thumb such as the monthly fee. This is difficulty with calculations, not herd behaviour or habit.", "w": ["Wrong: ignoring key features means information is not being fully used.", "Wrong: nothing suggests repeating past choices; the issue is the difficulty of comparing.", "Wrong: no copying of others is described, only a simplified comparison.", ""]}
{"id": "econ-143", "s": "micro", "t": "1.2.10", "lv": 2, "q": "A new restaurant has a long queue. Passers-by join it without checking reviews or the menu. What is the likely effect on the restaurant's demand, and why?", "o": ["Demand is unchanged because consumers are rational", "Demand falls because queues raise the time cost", "Demand rises as herd behaviour attracts more customers", "Demand falls because habit makes consumers loyal elsewhere"], "a": 2, "x": "People infer quality from others' choices, so the queue itself attracts more customers. Herd behaviour can raise demand beyond what quality alone would justify, shifting the demand curve right.", "w": ["Wrong: the passers-by skip checking information, so they are not acting rationally.", "Wrong: this applies rational time-cost reasoning, but the scenario shows people copying others.", "", "Wrong: habit would keep them at other places, but they are choosing the new one because of the queue."]}
{"id": "econ-144", "s": "micro", "t": "1.2.10", "lv": 3, "q": "Energy customers rarely switch supplier even when a cheaper tariff exists, leaving many on the standard variable tariff. Which explanation draws on two behavioural factors?", "o": ["Perfect information and herd behaviour", "Utility maximisation and social norms", "Habit and difficulty comparing tariffs", "Rational choice and a lack of substitutes"], "a": 2, "x": "Staying with the same supplier is habit, and complex tariffs make comparison hard. Together they explain inertia and weaker price responsiveness. Rational choice would mean switching to the cheaper tariff.", "w": ["Wrong: customers lack full information, and herd behaviour would involve copying others, not staying put.", "Wrong: utility maximisation would lead to switching, so it cannot explain inertia.", "", "Wrong: rational choice contradicts the behaviour, and many substitute suppliers exist."]}
{"id": "econ-145", "s": "micro", "t": "1.3.1", "lv": 1, "q": "Which statement best defines market failure?", "o": ["Firms in a market make losses, so many of them leave the industry", "Prices in a market rise because of a fall in the supply of a good", "Free markets allocate resources inefficiently, so welfare is not maximised", "The government has to provide a good or service for consumers"], "a": 2, "x": "Market failure means the market misallocates resources, so society's welfare is not maximised. Falling profits, price rises or state provision are not the definition; the trap is confusing failure of firms with failure of the market.", "w": ["Firms leaving after losses is normal market adjustment, not misallocation; this confuses business failure with market failure.", "A price rise from a supply fall is just a market adjusting; it does not show misallocation.", "", "State provision may be a response to failure, not its definition; this confuses cause with remedy."]}
{"id": "econ-146", "s": "micro", "t": "1.3.1", "lv": 1, "q": "A good is non-rival and non-excludable. Which problem does this create for a private firm?", "o": ["It must charge a price equal to marginal cost to break even", "It cannot charge a price as it cannot stop non-payers using it", "It cannot produce the good because demand for it is zero", "It faces a negative externality in the consumption of the good"], "a": 1, "x": "Non-excludability means people can free-ride, so the firm cannot make them pay. Demand exists, but is not revealed through payment, so the private market under-provides or does not provide the good.", "w": ["Marginal cost pricing is not the issue; with no payment possible, there is no price to set.", "", "Demand exists, since people value the good; the problem is collecting payment, not zero demand.", "Free-riding is about non-payment, not a negative externality; this mixes up the two types of failure."]}
{"id": "econ-147", "s": "micro", "t": "1.3.1", "lv": 2, "q": "A factory's production has a marginal private cost of £8 per unit and causes pollution costing neighbours £3 per unit. What is the marginal social cost per unit?", "o": ["£11", "£3", "£5", "£24"], "a": 0, "x": "MSC = MPC + marginal external cost = £8 + £3 = £11. The trap is to omit the private cost, or to subtract the external cost instead of adding it.", "w": ["", "£3 is only the external cost; this forgets to include the firm's own private cost.", "£5 subtracts the external cost; external costs add to private costs.", "£24 multiplies the figures; social cost is found by adding, not multiplying."]}
{"id": "econ-148", "s": "micro", "t": "1.3.1", "lv": 2, "q": "Smokers underestimate the health harm of smoking. In market failure terms, which is the best description of this problem?", "o": ["Asymmetric information, so consumers misjudge the true cost", "A monopoly that restricts output to raise price", "A positive externality in production for third parties", "A public good that is under-provided by the market"], "a": 0, "x": "Consumers lack full information about the harm, an information gap, so they overconsume. It is not a public good or monopoly issue. The trap is labelling any harmful good as an externality without checking the cause.", "w": ["", "Nothing in the question concerns market power; this guesses a failure unrelated to the information problem.", "Externalities in production concern third parties with benefits; here the issue is the buyer's own misjudgement.", "Cigarettes are rival and excludable, so they are not public goods; this mixes up the types of failure."]}
{"id": "econ-149", "s": "micro", "t": "1.3.1", "lv": 2, "q": "A town's private bus firms run a service with marginal private benefit (MPB) of £6 per journey. Each journey also gives £2 of benefit to local shops. Which is correct?", "o": ["MSB is £8 and the free market under-consumes it", "MSB is £6 because only the buyers' benefits count", "MSB is £8 and the free market over-consumes it", "MSB is £4 and the free market over-consumes it"], "a": 0, "x": "MSB = MPB + marginal external benefit = £6 + £2 = £8. Consumers ignore the £2 benefit to others, so the market consumes less than the social optimum: under-consumption, a positive externality of consumption.", "w": ["", "Social benefit includes third-party benefits; ignoring them is exactly the market's own mistake.", "The sum is right, but positive externalities lead to under-consumption, not over-consumption.", "Subtracting the £2 treats the benefit as a cost; positive externalities add to private benefit."]}
{"id": "econ-150", "s": "micro", "t": "1.3.1", "lv": 3, "q": "A street light lights a road for all. Which pair of reasons best explains why the free market would fail to provide it efficiently?", "o": ["It has a high price elasticity of demand, so profits are low", "It is rival and excludable, so firms can overcharge users", "It is non-rival and non-excludable, so free riding stops revenue", "It is a demerit good, so consumers overvalue it greatly"], "a": 2, "x": "A street light is a pure public good: one person's use does not reduce another's (non-rival) and nobody can be stopped from using it (non-excludable). Free riding means no revenue, so private firms do not supply it.", "w": ["Elasticity is irrelevant to the missing market; this brings in an unrelated concept.", "Street lights are not rival or excludable; this describes a private good and invents overcharging.", "", "Demerit goods are overconsumed because of misjudged harm; a street light is not harmful, so this misapplies the concept."]}
{"id": "econ-151", "s": "micro", "t": "1.3.3", "lv": 1, "q": "Which pair of characteristics defines a pure public good?", "o": ["Rival and non-excludable", "Non-rival and non-excludable", "Non-rival and excludable", "Provided by government and free at the point of use"], "a": 1, "x": "A pure public good is non-rival (one person's consumption doesn't reduce another's) and non-excludable (non-payers can't be stopped). Government provision is a policy response, not part of the definition.", "w": ["Rival and non-excludable describes a common access resource such as an open-access fishery, not a public good.", "", "Non-rival but excludable describes a quasi-public or club good, such as a subscription service.", "Government provision and zero price are consequences of the market failure, not defining characteristics."]}
{"id": "econ-152", "s": "micro", "t": "1.3.3", "lv": 1, "q": "A free rider is best described as a consumer who:", "o": ["Receives a good free from the government", "Pays less than others for the same good", "Consumes more than the socially optimal amount", "Benefits from a good without paying for it"], "a": 3, "x": "Free riders enjoy a non-excludable good without paying. Because they can't be stopped, firms can't collect revenue from them, which undermines private provision.", "w": ["This confuses free riding with state provision; free riders avoid paying when they could be asked to.", "Paying less is price discrimination, not free riding; a free rider pays nothing.", "Over-consumption describes demerit goods or negative consumption externalities, not free riding.", ""]}
{"id": "econ-153", "s": "micro", "t": "1.3.3", "lv": 1, "q": "Which is the best example of a pure public good in the UK?", "o": ["Public library book loans", "National defence", "A state secondary school", "A toll motorway"], "a": 1, "x": "Defence protects everyone in the country at once (non-rival) and nobody can be excluded. Schools and libraries are rival or excludable, and tolls exclude non-payers. Public funding does not make a good public.", "w": ["Books borrowed are rival, since a borrowed copy can't be used by others at the same time.", "", "Schools are rival (class places are limited) and excludable, so they are publicly provided merit goods.", "A toll excludes non-payers, so it is excludable and not a pure public good."]}
{"id": "econ-154", "s": "micro", "t": "1.3.3", "lv": 2, "q": "Why will a private firm usually fail to provide street lighting for a town?", "o": ["Marginal cost is too high because each extra user adds cost", "Consumers value street lighting too little to want it at all", "Demand is perfectly price inelastic, so profit is guaranteed", "It cannot exclude non-payers, so revenue is too low"], "a": 3, "x": "Non-excludability lets people use the lighting without paying, so the firm can't collect enough revenue. The market fails to provide it despite real demand. Marginal cost of an extra user is zero, not high.", "w": ["Non-rivalry means the marginal cost of an extra user is zero, not high. The problem is revenue, not cost.", "People do value it; the free-rider problem hides this demand, so effective demand is understated.", "Free riding means little or no revenue is collected, so profit isn't guaranteed.", ""]}
{"id": "econ-155", "s": "micro", "t": "1.3.3", "lv": 2, "q": "A lighthouse's beam helps all ships nearby. Ship owners each hope others will pay for it. What does this show about the market?", "o": ["Government failure caused by too much regulation of shipping", "Missing market: no price signal, so it is under-provided", "Allocative efficiency, since the benefit is shared so widely", "Over-provision, since ships benefit without having to pay"], "a": 1, "x": "Ship owners free ride, so revealed demand is far below true social benefit. No market forms, so provision is zero or too low. This is complete market failure, not over-provision.", "w": ["No government intervention is involved; the failure arises from the good's characteristics in a free market.", "", "Allocative efficiency needs P = MC with true benefits revealed; here a missing market means output is too low.", "Free riding reduces payments and so provision; it leads to under-provision, not over."]}
{"id": "econ-156", "s": "micro", "t": "1.3.3", "lv": 3, "q": "A council pays for a park with no entry gates, funded by council tax. Which statement is correct?", "o": ["It is excludable because only council tax payers fund the park", "Provision by the local council makes it a pure public good", "Largely non-excludable and non-rival until crowding sets in", "It is rival because the council employs staff to run the park"], "a": 2, "x": "Without gates, non-payers can't be excluded, and use is mostly non-rival until crowded. Who pays or provides doesn't define a public good; the characteristics do. Tax funding overcomes free riding.", "w": ["Funding by council tax is not exclusion from use; non-payers can still enter.", "Public provision is not the test; characteristics of the good decide whether it is a public good.", "", "Employing staff is irrelevant to rivalry; rivalry is about one person's use reducing others'."]}
{"id": "econ-157", "s": "micro", "t": "1.3.4", "lv": 1, "q": "Which statement best describes asymmetric information?", "o": ["Information is provided free by the government to all parties", "One party to a transaction has more relevant information", "Buyers and sellers both have equal but incomplete knowledge", "Consumers have no information about any product at all"], "a": 1, "x": "Asymmetric information means unequal knowledge between buyer and seller. Equal but incomplete knowledge is symmetric information, a common confusion with 'imperfect'.", "w": ["This describes a possible remedy, not the definition of the information gap.", "", "This is symmetric information: both sides are equally informed, even if neither knows everything.", "Asymmetry is about unequal knowledge, not total absence of knowledge on both sides."]}
{"id": "econ-158", "s": "micro", "t": "1.3.4", "lv": 1, "q": "A second-hand car seller knows the car has a serious fault; the buyer cannot tell. Who has the information advantage, and what is this an example of?", "o": ["The buyer; symmetric information", "The seller; asymmetric information", "The seller; a positive externality", "The buyer; asymmetric information"], "a": 1, "x": "The seller knows more than the buyer, so information is asymmetric. Hidden quality is an information failure, not an externality, which concerns third parties.", "w": ["The buyer lacks knowledge, and symmetric would mean equal knowledge.", "", "Externalities affect third parties; this is a gap between the two parties themselves.", "The buyer is the less informed party here, so has no advantage."]}
{"id": "econ-159", "s": "micro", "t": "1.3.4", "lv": 2, "q": "Consumers underestimate the long-term health harm of a sugary drink. Compared with the socially optimal level, what is likely to happen to consumption and why?", "o": ["Underconsumption, because the price is too high", "Underconsumption, because private benefit is below social benefit", "Optimal consumption, because consumers choose freely", "Overconsumption, as perceived benefit exceeds true benefit"], "a": 3, "x": "Consumers overestimate the benefit (or underestimate the cost), so demand is too high and the good is overconsumed. Free choice only gives efficiency when choices are well informed.", "w": ["Price is not the issue; misperceived benefits push demand up, not down.", "That fits a merit good where benefits are underestimated, the reverse of this case.", "Free choice is efficient only with full information; here the information gap distorts demand.", ""]}
{"id": "econ-160", "s": "micro", "t": "1.3.4", "lv": 2, "q": "A health insurer cannot observe how risky each applicant is, so it charges one average premium. Low-risk people leave and the average risk of those insured rises. This is best called:", "o": ["A positive externality", "Adverse selection", "Price discrimination", "Moral hazard"], "a": 1, "x": "Adverse selection arises before the contract when hidden information about risk means the 'worse' risks remain in the market. Moral hazard is changed behaviour after being insured.", "w": ["No third-party spillover is described; the problem is hidden risk information.", "", "Price discrimination means charging different prices to different groups, but here one price is charged.", "Moral hazard is riskier behaviour after taking cover, not who chooses to buy it."]}
{"id": "econ-161", "s": "micro", "t": "1.3.4", "lv": 2, "q": "Which policy is most directly aimed at reducing an information gap in the market for processed food?", "o": ["A maximum price set on all food", "Mandatory nutritional labelling", "A per-unit tax on all food", "A subsidy to all food producers"], "a": 1, "x": "Mandatory labelling gives consumers the information needed to choose well, reducing asymmetry. Taxes, price controls and subsidies alter prices but do not tackle the lack of information itself.", "w": ["A price ceiling creates shortages and does nothing for consumer knowledge.", "", "A tax changes price, so it addresses externalities more directly than missing information.", "A subsidy lowers costs but leaves the information gap unchanged."]}
{"id": "econ-162", "s": "micro", "t": "1.3.4", "lv": 3, "q": "Evaluating compulsory labelling to correct information failure, which is the strongest limitation?", "o": ["Consumers may ignore or misread labels, and compliance has costs", "It always eliminates overconsumption of the good in the market", "It raises the price elasticity of supply to infinity for firms", "It makes information asymmetric between buyers and sellers"], "a": 0, "x": "Labelling only works if consumers notice, understand and act on it, and firms bear compliance costs passed on in prices. It cannot guarantee a fully optimal outcome.", "w": ["", "That overstates its effect; it is a claimed strength, not a limitation.", "This is not a plausible effect and has no link to information.", "Labelling reduces asymmetry rather than creating it."]}
{"id": "econ-163", "s": "micro", "t": "1.4.1", "lv": 1, "q": "A government imposes a specific tax on a good. What happens to the supply curve?", "o": ["It shifts left by a growing amount as price rises", "It shifts left by the tax amount at every quantity", "It pivots, getting steeper as price rises", "It shifts right by the amount of the tax"], "a": 1, "x": "A specific tax is a fixed £ amount per unit, so supply shifts vertically up (left) by that amount: a parallel shift. An ad valorem tax would pivot the curve. Mixing the two is the trap.", "w": ["Growing gaps describe ad valorem tax; a specific tax is the same £ per unit everywhere.", "", "Pivoting describes an ad valorem tax, which is a percentage of price, not a specific tax.", "A shift right is what a subsidy does, not a tax; taxes raise costs."]}
{"id": "econ-164", "s": "micro", "t": "1.4.1", "lv": 1, "q": "A maximum price is set below the free-market equilibrium price. What is the result?", "o": ["No effect, because the price is already below equilibrium", "A fall in demand until the market clears", "Excess demand, as quantity demanded exceeds quantity supplied", "A surplus, because firms produce more at the lower price"], "a": 2, "x": "A binding maximum price below equilibrium raises quantity demanded and cuts quantity supplied, creating excess demand. Students often confuse this with a minimum price, which creates a surplus.", "w": ["A cap below equilibrium is binding, so it does affect the market.", "Demand does not shift; the price is held down so the market cannot clear.", "", "Lower prices reduce quantity supplied, so a surplus is wrong; that confuses it with a minimum price."]}
{"id": "econ-165", "s": "micro", "t": "1.4.1", "lv": 2, "q": "The market for a good has equilibrium at £12. A £3 specific tax is imposed and the new equilibrium price paid by consumers is £14. How much of the tax is borne by producers?", "o": ["£3", "£1", "£2", "£14"], "a": 1, "x": "Consumers pay £2 more (£14 − £12), so they bear £2 of the £3 tax. Producers bear the remainder: £3 − £2 = £1. The trap is reading the price rise as the producers' share.", "w": ["£3 is the whole tax; the burden is shared because the price rose by less than £3.", "", "£2 is the consumers' burden; the slip is giving the consumer share as the producer share.", "£14 is the new market price, not a share of the tax."]}
{"id": "econ-166", "s": "micro", "t": "1.4.1", "lv": 2, "q": "The government sets a minimum price above equilibrium in a market. Which outcome is most likely?", "o": ["A fall in the price paid by consumers", "Excess demand and queues for the good", "A rise in quantity demanded by consumers", "Excess supply that the state may buy up"], "a": 3, "x": "A minimum price above equilibrium raises quantity supplied and reduces quantity demanded, creating excess supply. Producers gain per unit, but surplus stock may need buying. Confusing it with a maximum price gives queues.", "w": ["A minimum price above equilibrium raises the price consumers pay.", "Excess demand arises from a maximum price below equilibrium, not a minimum price.", "Higher prices reduce quantity demanded along the demand curve, not raise it.", ""]}
{"id": "econ-167", "s": "micro", "t": "1.4.1", "lv": 2, "q": "Which is the best reason a tradable permit scheme may reduce pollution efficiently?", "o": ["Firms with low abatement costs cut more and sell permits", "It gives firms free information about pollution levels", "It sets a tax equal to the marginal social cost", "It bans all firms from polluting at any level"], "a": 0, "x": "Permits cap total pollution. Trading lets firms with cheaper abatement cut more and sell spare permits, so the cut is made where cost is lowest. It is not a ban or a tax.", "w": ["", "Information provision is a separate intervention; permits work through a capped, tradable quantity.", "That describes a tax on pollution, a different tool from permits.", "Permits allow pollution up to a cap, so it is not a ban."]}
{"id": "econ-168", "s": "micro", "t": "1.4.1", "lv": 3, "q": "A good has highly inelastic demand and elastic supply. A per-unit tax is imposed. Which statement is most accurate?", "o": ["Consumers bear none of the tax because supply is elastic", "Producers bear most of the tax, so price barely changes", "The tax is shared equally whatever the elasticities", "Consumers bear most of the tax; quantity falls only slightly"], "a": 3, "x": "Inelastic demand means buyers cannot easily cut back, so the price rises by nearly the full tax and they bear most of it. Quantity falls little. Reversing the elasticities is the common slip.", "w": ["Elastic supply shifts the burden onto consumers when demand is inelastic, not away from them.", "That fits elastic demand and inelastic supply; the elasticities are reversed.", "Incidence depends on relative elasticities, so it is not equal.", ""]}
{"id": "econ-169", "s": "micro", "t": "1.4.2", "lv": 1, "q": "Which statement best defines government failure?", "o": ["Intervention that causes a net welfare loss versus no intervention", "A policy that raises the government's budget deficit each year", "A policy that fails to meet its stated target or objective", "Any market where the government has to step in to correct a problem"], "a": 0, "x": "Government failure is intervention that causes a net welfare loss, so resources are allocated less efficiently than without it. Missing a target is not enough; the outcome must be worse than before.", "w": ["", "Deficits are a fiscal issue; they do not by themselves show a welfare loss in the market.", "Missing a target is not necessarily a net welfare loss; this confuses effectiveness with efficiency.", "That describes market failure, the reason for intervening, not government failure."]}
{"id": "econ-170", "s": "micro", "t": "1.4.2", "lv": 1, "q": "A government sets a maximum price below the equilibrium price in a private rental market. Which is a likely unintended consequence?", "o": ["A surplus of rental housing at the capped price", "A fall in the demand for rented homes overall", "A rise in the quantity of rental housing supplied", "Excess demand, with quantity supplied falling"], "a": 3, "x": "A maximum price below equilibrium lowers quantity supplied and raises quantity demanded, creating excess demand (a shortage). A surplus comes from a minimum price above equilibrium.", "w": ["Surplus arises with a minimum price above equilibrium; this mixes up the two price controls.", "Quantity demanded rises along the curve at the lower price; it does not fall.", "Quantity supplied contracts along the supply curve as price falls, it does not rise.", ""]}
{"id": "econ-171", "s": "micro", "t": "1.4.2", "lv": 1, "q": "Which is an example of regulatory capture?", "o": ["A regulator sets a price cap that is too low for firms", "A regulator is replaced after a change of government", "A regulator fines a firm for breaking competition law", "A regulator serves the interests of the firms it regulates"], "a": 3, "x": "Regulatory capture occurs when a regulator, influenced by the industry it oversees, serves producers' interests rather than consumers'. It is a source of government failure.", "w": ["A badly set cap is a different cause, poor information, not capture by the industry.", "A change of personnel is not capture; capture needs influence by the regulated firms.", "Fining a law-breaker is the regulator doing its job, not being captured.", ""]}
{"id": "econ-172", "s": "micro", "t": "1.4.2", "lv": 2, "q": "The government imposes an indirect tax on a good with a negative externality, but sets it at £6 per unit when the marginal external cost is £4 per unit. What is the likely effect?", "o": ["No change occurs because tax and external cost differ", "Efficiency is restored because output falls", "Output falls below the social optimum, causing welfare loss", "Output rises above the social optimum after the tax"], "a": 2, "x": "A tax above the marginal external cost cuts output below the social optimum, where marginal social benefit exceeds marginal social cost on the lost units. That is a welfare loss: government failure.", "w": ["The tax still shifts supply, so output changes; the mismatch causes the loss.", "Output falls too far, not just to the optimum; a tax of £4 would restore efficiency.", "", "Tax shifts supply left, so output falls; it cannot rise above the optimum."]}
{"id": "econ-173", "s": "micro", "t": "1.4.2", "lv": 2, "q": "A government subsidises a farm product, which leads to persistent overproduction that is bought up and stored. Which cause of government failure is this best an example of?", "o": ["Regulatory capture by the farming industry", "Distorted price signals and side effects", "Lack of any externality in the market", "Excessive administrative costs only"], "a": 1, "x": "The subsidy distorts price signals, so farmers produce beyond what consumers value, and surpluses emerge as an unintended side effect. Resources are misallocated, giving a welfare loss.", "w": ["No sign that the industry controls the regulator; this is not capture.", "", "The issue is the policy's effect on output, not whether an externality exists.", "Storage costs are admin-related, but the core problem is the distorted incentive to overproduce."]}
{"id": "econ-174", "s": "micro", "t": "1.4.2", "lv": 3, "q": "A tax set above the marginal external cost cuts output below the social optimum, creating a welfare loss triangle. The tax is then reduced so output rises towards the optimum. What happens to the welfare loss?", "o": ["It rises because more is produced", "It shrinks as output nears the social optimum", "It stays the same because the tax still exists", "It grows because the tax is lower"], "a": 1, "x": "Welfare loss is the area between marginal social benefit and cost over units lost relative to the optimum. Moving output towards the optimum shrinks the triangle; it vanishes at the optimum.", "w": ["More output is not automatically worse; here it moves towards the optimum, so the loss falls.", "", "The loss depends on how far output is from the optimum, not whether a tax exists.", "A lower tax moves output closer to the optimum, so the loss falls; this reverses the link."]}
{"id": "econ-229", "s": "micro", "t": "3.1.1", "lv": 1, "q": "Which statement best describes the principal-agent problem in a large public limited company?", "o": ["Workers aim to raise their wages while managers try to cut labour costs", "Managers (agents) may pursue aims different from shareholders (principals)", "The government sets targets that conflict with those of private owners", "Shareholders cannot sell their shares, so managers ignore their views"], "a": 1, "x": "Ownership is separated from control. Shareholders are principals and managers are agents, who may chase their own pay, status or sales growth instead of profit. The problem is not workers against managers.", "w": ["This is a conflict between employer and employees, not between owners and managers. Confusing the principal-agent problem with industrial disputes is the common slip.", "", "The problem arises inside private firms from separated ownership and control. Government targets are not what defines it.", "Shares in a plc can normally be sold. The problem comes from differing objectives and managers' better information, not from share illiquidity."]}
{"id": "econ-230", "s": "micro", "t": "3.1.1", "lv": 1, "q": "Which of the following is a not-for-profit organisation?", "o": ["A sole trader running a hairdressing salon", "A partnership of two opticians sharing profits", "A public limited company listed on the stock exchange", "A registered charity reinvesting any surplus"], "a": 3, "x": "Not-for-profit organisations such as charities put surpluses into their social aims rather than distributing profit to owners. Partnerships, plcs and sole traders are private sector firms with profit as the main aim.", "w": ["A sole trader keeps the profit. Being small does not make a firm not-for-profit.", "Partners share the profits, so this is a private sector profit-seeking firm. Not-for-profit means surplus is not distributed to owners.", "A plc distributes profits to shareholders as dividends. Being large does not make a firm not-for-profit.", ""]}
{"id": "econ-231", "s": "micro", "t": "3.1.1", "lv": 2, "q": "In the 2025 AGM season, Indigo Governance recorded 65.63% of votes against Melrose Industries' pay report. Why does this illustrate the principal-agent problem?", "o": ["Owners objected to managers' pay, so aims seem misaligned", "Workers wanted higher wages than managers offered them", "The firm is state-owned, so it is not run for profit", "Managers were shown to be maximising profit for owners"], "a": 0, "x": "A large vote against the pay report suggests shareholders thought manager pay did not reflect their interests. That is a conflict between principals and agents. The vote is not about workers' wages.", "w": ["", "A pay report covers directors' pay and is voted on by shareholders; it is not a worker–employer wage dispute.", "Melrose is a listed company owned by shareholders, so the vote shows owners' discontent, not state ownership.", "Owners would be unlikely to vote against managers who maximised profit for them; the vote suggests misaligned aims."]}
{"id": "econ-232", "s": "micro", "t": "3.1.1", "lv": 2, "q": "A toy shop sells hand-made wooden toys to a small number of collectors. Which is the most likely reason it remains small?", "o": ["It already enjoys large economies of scale", "The principal-agent problem is severe in a sole-trader firm", "Its niche market has limited demand, so growth is hard", "It has too high a market share to grow further"], "a": 2, "x": "Firms in niche markets face limited demand, so growth may not be profitable. The principal-agent problem needs separated ownership and control, which a small owner-run shop does not have.", "w": ["Small niche producers rarely gain big economies of scale. Economies of scale are a reason to grow, not to stay small.", "An owner-manager has no separation of ownership and control, so there is no principal-agent problem.", "", "Nothing suggests a high market share. A niche market is small in total, which is different from having dominant share."]}
{"id": "econ-233", "s": "micro", "t": "3.1.1", "lv": 2, "q": "At the start of 2026, 8,355 large firms generated 50% of UK private sector turnover, and SMEs provided 60% of private sector jobs. Which conclusion is supported?", "o": ["SMEs generate most turnover because they are 99.85% of firms", "A tiny share of firms produces half of private sector turnover", "Large firms employ 50% of private sector workers", "SMEs provide fewer jobs than large firms do"], "a": 1, "x": "8,355 large firms are a tiny fraction of 5.6 million businesses yet make half of turnover. Large firms generate 50% of turnover, so SMEs cannot generate most of it; large firms' jobs share is at most 40%.", "w": ["Large firms generate 50% of turnover, so SMEs do not generate most of it. Share of firms does not equal share of turnover.", "", "SMEs provide 60% of jobs, so large firms provide at most 40%. The 50% figure is turnover, not employment.", "SMEs provide 60% of jobs, which is more than large firms can provide. Reading the figure backwards is the slip."]}
{"id": "econ-234", "s": "micro", "t": "3.1.1", "lv": 3, "q": "A plc gives managers share options that can be exercised only if the share price rises over three years. How does this reduce the principal-agent problem, and what is one limitation?", "o": ["It aligns pay with shareholders' aim of higher share value; may cause short-termism", "It removes the separation of ownership and control; but it raises wage costs", "It makes managers maximise sales revenue; but this lowers shareholder wealth", "It lets government monitor managers; but this reduces competition"], "a": 0, "x": "Share options tie manager reward to the share price, aligning the agent's aims with the principals'. A limitation is that managers may chase short-term price rises. Separation of ownership and control remains.", "w": ["", "Managers with some options still do not own most of the firm, so separation continues. The policy reduces the problem rather than removing it.", "Sales maximising is a typical manager aim that the problem is about; options reward share-price growth instead.", "Share options are a private-sector incentive and involve no government monitoring."]}
{"id": "econ-235", "s": "micro", "t": "3.1.2", "lv": 1, "q": "A bakery chain buys a flour mill that supplies it. What type of growth is this?", "o": ["Conglomerate integration", "Forward vertical integration", "Horizontal integration", "Backward vertical integration"], "a": 3, "x": "The mill is at an earlier stage of production, a supplier. Moving towards suppliers is backward vertical integration. Forward would be towards customers, such as buying shops.", "w": ["Conglomerate means unrelated products; flour supplies the bakery directly, so they are related.", "Forward is towards the customer or retailer; a flour mill is a supplier, so this is the wrong direction.", "Horizontal means buying a firm at the same stage, such as another bakery chain.", ""]}
{"id": "econ-236", "s": "micro", "t": "3.1.2", "lv": 1, "q": "Which of the following is an example of organic growth?", "o": ["A café chain opens new branches funded by its own profits", "A café chain takes over a rival café chain in the same town", "A café chain merges with a coffee bean importer abroad", "A café chain buys a clothing retailer on the high street"], "a": 0, "x": "Organic (internal) growth comes from expanding using the firm's own resources, such as new outlets. Takeovers and mergers are external growth, whatever the type of integration.", "w": ["", "A takeover of a rival is external growth, specifically horizontal integration, not organic expansion.", "A merger with an importer is external growth, specifically backward vertical integration.", "Buying an unrelated retailer is external growth, conglomerate integration."]}
{"id": "econ-237", "s": "micro", "t": "3.1.2", "lv": 2, "q": "A toy shop chain buys a toy manufacturer, then a firm making garden furniture. Which pair of terms correctly describes these two deals?", "o": ["Horizontal, then conglomerate", "Forward vertical, then conglomerate", "Backward vertical, then horizontal", "Backward vertical, then conglomerate"], "a": 3, "x": "A retailer buying its manufacturer moves towards its supplier: backward vertical. Garden furniture is an unrelated market, so conglomerate. Forward integration would be a manufacturer buying shops.", "w": ["A manufacturer is at a different stage from a retailer, so the first deal is vertical, not horizontal.", "The shop chain is moving towards suppliers, not customers, so forward is the wrong direction.", "Garden furniture is not the same industry as toys, so it is not horizontal; it is unrelated.", ""]}
{"id": "econ-238", "s": "micro", "t": "3.1.2", "lv": 2, "q": "Which is the most likely benefit specific to conglomerate integration, compared with horizontal integration?", "o": ["Spreading risk across different markets", "Gaining larger market share in the same market", "Reducing costs through bulk buying in one industry", "Securing a guaranteed supply of inputs"], "a": 0, "x": "Conglomerates operate in unrelated markets, so a downturn in one may be offset by another: risk spreading. Market share, bulk buying and secure supply are linked to horizontal or vertical integration.", "w": ["", "Larger share of the same market comes from horizontal integration, not from entering unrelated markets.", "Bulk-buying economies are stronger when firms in the same industry combine, so this fits horizontal integration.", "Secure input supply is the benefit of backward vertical integration, not conglomerate."]}
{"id": "econ-239", "s": "micro", "t": "3.1.2", "lv": 2, "q": "Which is a limit on organic growth that is LESS of a problem for growth by takeover?", "o": ["Cultural clashes between the two workforces", "Diseconomies of scale as the firm gets larger", "Regulation and scrutiny by the CMA", "Slow growth because it relies on retained profits"], "a": 3, "x": "Organic growth is limited by the funds and time available internally. Takeovers can expand faster, using borrowing or shares. Culture clashes and CMA scrutiny are mainly problems for takeovers.", "w": ["Culture clashes arise when two firms combine, so they are a problem for takeovers rather than organic growth.", "Diseconomies of scale can affect any large firm, however it grew, so this does not distinguish organic growth.", "CMA scrutiny applies to mergers and takeovers, so it is more a limit on external growth.", ""]}
{"id": "econ-240", "s": "micro", "t": "3.1.2", "lv": 3, "q": "On 1 July 2025 the CMA granted Phase 1 clearance to Aviva's anticipated acquisition of Direct Line. Both are UK insurers. Which statement is correct?", "o": ["It is horizontal integration, so the CMA assesses competition", "It is forward vertical integration, as insurers sell to customers", "It is conglomerate integration, as they are different firms", "It is organic growth, as Aviva paid for it from its own funds"], "a": 0, "x": "Two insurers at the same stage of the same industry means horizontal integration. A takeover is external growth, however it is funded. The CMA checks whether it would substantially lessen competition.", "w": ["", "Both firms sell insurance to customers at the same stage, so there is no move along the supply chain.", "Both are in insurance, so the markets are related, not unrelated as conglomerate requires.", "Acquiring another firm is external growth, whatever the funding; organic means expanding internally."]}
{"id": "econ-241", "s": "micro", "t": "3.1.3", "lv": 1, "q": "Which of the following best describes a demerger?", "o": ["Two firms join to form one larger firm", "A firm buys one of its suppliers", "A firm splits into two or more separate businesses", "A firm sells shares to the public for the first time"], "a": 2, "x": "A demerger is when a firm breaks up into separate businesses, often with shareholders receiving shares in each. Merging, vertical integration and flotation are different forms of change.", "w": ["This describes a merger, the opposite of a demerger.", "This is backward vertical integration, a way of growing, not splitting.", "", "This is a flotation, which does not split the firm."]}
{"id": "econ-242", "s": "micro", "t": "3.1.3", "lv": 1, "q": "Which is the most likely reason a very large firm would choose to demerge?", "o": ["To gain more economies of scale in production", "To cut diseconomies of scale and regain focus", "To increase its market share by takeover", "To diversify into more unrelated markets"], "a": 1, "x": "Very large firms can suffer diseconomies of scale, such as poor communication and weak control. Splitting into smaller units can restore focus and lower average costs. The other options point the opposite way.", "w": ["Demerging usually loses economies of scale; this option reverses the logic.", "", "Takeovers are a form of external growth, the opposite of splitting.", "Diversifying is more likely to cause a loss of focus, which demergers aim to fix."]}
{"id": "econ-243", "s": "micro", "t": "3.1.3", "lv": 2, "q": "On 6 December 2025 Unilever demerged its ice cream arm, issuing one Magnum Ice Cream share per five Unilever shares. How many new shares would a holder of 1,000 Unilever shares receive?", "o": ["200", "1,000", "5,000", "20"], "a": 0, "x": "One new share per five held: $1000 \\div 5 = 200$. Multiplying by five reverses the ratio; holders receive fewer new shares than they hold.", "w": ["", "This assumes one new share per share held, ignoring the ratio of one per five.", "This multiplies by five instead of dividing, reversing the ratio.", "This divides by 50, a miscalculation of the one-for-five ratio."]}
{"id": "econ-244", "s": "micro", "t": "3.1.3", "lv": 2, "q": "A conglomerate demerges into two firms, each with its own head office. Which is the most likely disadvantage for its workers?", "o": ["Communication between managers and staff becomes slower", "Workers lose all of their legal employment rights", "Staff face a larger, more bureaucratic organisation", "Duplicated head-office roles may go, causing redundancies"], "a": 3, "x": "Two separate firms may not need duplicated central functions such as finance or HR, so jobs can go. Smaller firms usually improve communication, and employment rights are unchanged by a demerger.", "w": ["Smaller firms usually have better communication, so this is a likely benefit, not a disadvantage.", "Employment rights are protected by law and do not disappear because of a demerger.", "The firms become smaller, so bureaucracy tends to fall.", ""]}
{"id": "econ-245", "s": "micro", "t": "3.1.3", "lv": 2, "q": "A firm with 70% of a market demerges into two rival firms, each making similar products. Ceteris paribus, what is the most likely benefit to consumers?", "o": ["Higher prices, as monopoly power increases", "More rivalry, so lower prices and wider choice", "No change, as total output stays the same", "Less choice, as there are fewer firms"], "a": 1, "x": "Splitting a dominant firm into rivals raises competition, so firms compete on price, quality and variety. Market power falls, not rises.", "w": ["Market concentration falls after the split, so monopoly power falls, not rises.", "", "Rivals now compete, so prices and choice can change even if total output is unchanged.", "The dominant firm becomes two rivals, so the number of firms rises, not falls."]}
{"id": "econ-246", "s": "micro", "t": "3.1.3", "lv": 3, "q": "Which situation would make it LEAST likely that a demerger reduces a firm's average costs?", "o": ["Its divisions sell in unrelated markets with separate managers", "The firm has many layers of management and slow decisions", "The divisions share one factory network and bulk-buying deals", "Head office struggles to coordinate very different divisions"], "a": 2, "x": "Shared facilities and bulk-buying give economies of scale, which a split would lose, so costs may rise. The other options describe diseconomies of scale, where a demerger is more likely to cut average costs.", "w": ["Unrelated divisions gain little from being together, so splitting is likely to cut costs.", "Many layers and slow decisions are diseconomies of scale that a split can reduce.", "", "Coordination problems are diseconomies of scale, which a split could reduce."]}
{"id": "econ-247", "s": "micro", "t": "3.2.1", "lv": 1, "q": "On a standard cost and revenue diagram, at which output does a profit-maximising firm produce?", "o": ["Where AR = AC, so the firm earns only normal profit", "Where MR = 0, the top of the total revenue curve", "Where MC = MR and MC cuts MR from below", "Where MC = AC, the lowest point of average cost"], "a": 2, "x": "Profit is greatest where MC = MR with MC cutting MR from below. Before this, MR > MC so extra units add profit; after it, MC > MR so they reduce profit.", "w": ["This is the sales-maximising point with only normal profit, not the point of greatest profit.", "MR = 0 is the revenue-maximising output; it ignores costs, so it is not the profit-maximising output.", "", "MC = AC is the minimum of average cost, productive efficiency. It is not where profit is greatest."]}
{"id": "econ-248", "s": "micro", "t": "3.2.1", "lv": 2, "q": "A firm faces demand P = 20 − 2Q (in £), giving MR = 20 − 4Q. Which output and price maximise its total revenue?", "o": ["Q = 5, P = £10", "Q = 4, P = £12", "Q = 10, P = £0", "Q = 3, P = £14"], "a": 0, "x": "Revenue is maximised where MR = 0: 20 − 4Q = 0, so Q = 5. Then P = 20 − 10 = £10 and TR = £50. The trap is solving AR = 0 instead of MR = 0.", "w": ["", "At Q = 4, MR is still +£4, so selling another unit still raises total revenue (£48 is below £50).", "This solves AR = 0, not MR = 0. At Q = 10 total revenue is zero, not at its peak.", "At Q = 3, MR is £8, still positive, so total revenue (£42) is still rising. This is not the revenue peak."]}
{"id": "econ-249", "s": "micro", "t": "3.2.1", "lv": 2, "q": "The firm has demand P = 20 − 2Q, constant MC of £4 and fixed costs of £10. What profit does it make if it maximises revenue?", "o": ["£50", "£22", "£30", "£20"], "a": 3, "x": "MR = 0 gives Q = 5, P = £10, TR = £50. TC = 10 + 4 × 5 = £30. Profit = 50 − 30 = £20, below the £22 at the profit-maximising output of 4.", "w": ["£50 is total revenue. Profit is revenue minus total cost, so costs must be subtracted.", "£22 is the profit at Q = 4, where MC = MR. That is profit maximisation, not revenue maximisation.", "£30 is the total cost, or revenue minus variable cost only. Fixed costs of £10 have not been counted.", ""]}
{"id": "econ-250", "s": "micro", "t": "3.2.1", "lv": 1, "q": "On a diagram, where is output for a sales-maximising firm, with no target above normal profit?", "o": ["Where MR = 0, as extra sales add no more revenue", "Where MC = MR, with the price then set equal to MC", "At the highest output where AR = AC, normal profit", "Where AC is at its minimum, so costs are lowest"], "a": 2, "x": "Sales maximisation pushes output as high as possible without making a loss. That is the highest output where AR = AC, giving normal profit only. It is usually beyond the profit-maximising output.", "w": ["MR = 0 is revenue maximisation. Sales maximisation is about volume subject to a profit constraint, not the top of the TR curve.", "MC = MR is profit maximisation. Setting price equal to MC is allocative efficiency; neither is sales maximisation.", "", "Minimum AC is productive efficiency. A sales maximiser keeps expanding past it until AR meets AC."]}
{"id": "econ-251", "s": "micro", "t": "3.2.1", "lv": 2, "q": "In the 52 weeks to 22 February 2026, Tesco tripled Everyday Low Prices to 3,000 lines and lifted UK market share to 28.5%, with £3,152 million adjusted operating profit. Best objective?", "o": ["Growing market share and sales, keeping healthy profit", "Profit maximisation, because a firm always sets MC = MR", "Satisficing, because profit simply stayed above zero", "Revenue maximisation, because MR must have been zero"], "a": 0, "x": "Cutting prices to win share fits a sales or market-share objective with a profit constraint. Positive profit alone does not show satisficing, and the facts cannot show MC = MR or MR = 0.", "w": ["", "The facts do not show MC = MR. Cutting prices to win share points to a volume objective.", "Satisficing means settling for acceptable profit and not pushing further. Tesco was actively growing share, so positive profit alone does not mean satisficing.", "MR = 0 cannot be inferred from the figures, and Tesco still earned a large profit."]}
{"id": "econ-252", "s": "micro", "t": "3.2.1", "lv": 3, "q": "A firm must pay a higher fixed annual licence fee (a lump sum), and stays in the market. MC and demand are unchanged. What happens to its profit-maximising and revenue-maximising outputs?", "o": ["Profit-maximising output falls; revenue-maximising output is unchanged", "Neither output changes; only the profit earned falls", "Both outputs fall, because costs have risen", "Profit-maximising output is unchanged; revenue-maximising output rises"], "a": 1, "x": "A fixed cost shifts AC and TC up, but not MC or MR. MC = MR and MR = 0 occur at the same outputs as before. Only profit falls.", "w": ["Fixed costs do not change MC, so the point where MC = MR stays put. This wrongly treats a fixed cost as marginal.", "", "Higher total costs do not move MC or MR, which fix both outputs. This confuses total cost with marginal cost.", "Revenue-maximising output depends only on demand (MR = 0), so a cost change cannot move it."]}
{"id": "econ-253", "s": "micro", "t": "3.3.1", "lv": 1, "q": "Which statement correctly defines marginal revenue (MR)?", "o": ["Extra total revenue from selling one more unit", "Total revenue divided by the quantity sold", "The price multiplied by the quantity sold", "The change in price needed to sell one more unit"], "a": 0, "x": "MR is the addition to total revenue from selling one extra unit, ΔTR ÷ ΔQ. The trap is confusing it with average revenue (TR ÷ Q), which equals price.", "w": ["", "This is average revenue, not marginal revenue. It confuses the average with the extra unit.", "This is total revenue, P × Q. It is the whole amount, not the addition from one more unit.", "MR is about revenue, not price. This mixes up the price change with the change in revenue."]}
{"id": "econ-254", "s": "micro", "t": "3.3.1", "lv": 1, "q": "A firm in a perfectly competitive market is a price taker. Which statement about its revenue curves is correct?", "o": ["MR lies below AR, which slopes downward", "AR and MR are equal, horizontal at market price", "MR lies above AR, while AR is horizontal", "AR is flat but MR falls to zero as output rises"], "a": 1, "x": "A price taker sells every unit at the same market price, so each extra unit adds exactly the price to revenue. AR = MR = price, shown as one horizontal line.", "w": ["MR below a downward-sloping AR applies to a firm with market power, not a price taker.", "", "MR cannot exceed AR here. Each extra unit adds exactly the price, so the two are equal.", "MR does not fall because the price stays constant however much the firm sells."]}
{"id": "econ-255", "s": "micro", "t": "3.3.1", "lv": 2, "q": "A toy shop sells 40 puzzles a week at £15 each. It cuts the price to £13 and sells 50 puzzles. What is the marginal revenue of the extra 10 puzzles?", "o": ["£5", "£50", "£10", "£13"], "a": 0, "x": "TR rises from 40 × £15 = £600 to 50 × £13 = £650. ΔTR = £50 over ΔQ = 10, so MR = £5 per extra puzzle. £13 is the new price, which is AR.", "w": ["", "£50 is the change in TR. You must divide by the 10 extra units sold.", "£10 is the change in quantity, not revenue. You have used the wrong variable.", "£13 is the new price, which equals AR. MR is the extra revenue per additional unit, which is lower."]}
{"id": "econ-256", "s": "micro", "t": "3.3.1", "lv": 2, "q": "A train operator cuts its price by 10% and the quantity demanded rises by 4%. What is the PED and what happens to total revenue?", "o": ["PED = −0.4; total revenue falls", "PED = −2.5; total revenue falls", "PED = −2.5; total revenue rises", "PED = −0.4; total revenue rises"], "a": 0, "x": "PED = 4% ÷ −10% = −0.4, so demand is inelastic. The percentage rise in quantity is smaller than the percentage fall in price, so total revenue falls.", "w": ["", "You inverted the formula. PED is %ΔQ ÷ %ΔP = 4 ÷ −10, not 10 ÷ 4.", "You inverted the formula to get −2.5. Also, elastic demand would raise TR, but here PED is below 1 in size.", "PED is right but inelastic demand means a price cut lowers TR. You may be assuming lower prices always raise revenue."]}
{"id": "econ-257", "s": "micro", "t": "3.3.1", "lv": 2, "q": "A firm faces the demand curve P = 20 − 2Q, where P is in £. Its marginal revenue is MR = 20 − 4Q. What is MR when Q = 4?", "o": ["£12", "£16", "£48", "£4"], "a": 3, "x": "MR = 20 − 4(4) = £4. Price at Q = 4 is 20 − 8 = £12, which is AR. MR lies below AR because a price cut applies to all units sold.", "w": ["£12 is the price (AR) at Q = 4. MR is lower than price along a downward-sloping demand curve.", "£16 comes from subtracting only 4 from 20. MR has a slope of −4, so 4 × 4 = 16 must be subtracted.", "£48 is total revenue (12 × 4), not marginal revenue.", ""]}
{"id": "econ-258", "s": "micro", "t": "3.3.1", "lv": 3, "q": "Demand is P = 40 − 2Q, so MR = 40 − 4Q. At Q = 12, what is true and what follows for TR if the firm lowers its price further?", "o": ["MR = £16; demand is elastic, so TR is rising", "MR = −£8; demand is inelastic, so TR falls", "MR = £8; demand is inelastic, so TR is falling", "MR = −£8; demand is elastic, so TR is falling"], "a": 1, "x": "MR = 40 − 48 = −£8. Negative MR means extra sales reduce TR, which happens on the inelastic part of the demand curve (here PED ≈ −0.67 at P = £16). Cutting price further lowers TR.", "w": ["£16 is the price at Q = 12. MR is 40 − 4 × 12, which is negative.", "", "MR is not £8; 40 − 48 = −8. The sign is lost. Falling TR does go with inelastic demand.", "MR is correctly negative, but negative MR occurs where demand is inelastic, not elastic."]}
{"id": "econ-259", "s": "micro", "t": "3.3.2", "lv": 1, "q": "A toy shop pays £400 a week in rent (fixed). Its variable costs are £600 when it sells 50 toys. What is its average total cost per toy at 50 toys?", "o": ["£12", "£20", "£8", "£1,000"], "a": 1, "x": "TC = £400 + £600 = £1,000. ATC = TC ÷ Q = £1,000 ÷ 50 = £20. The trap is stopping at one component of cost, or forgetting to divide by output.", "w": ["That is average variable cost (£600 ÷ 50); it leaves out fixed costs.", "", "That is average fixed cost (£400 ÷ 50); it leaves out variable costs.", "That is total cost; the question asks for the cost per toy, so you must divide by 50."]}
{"id": "econ-260", "s": "micro", "t": "3.3.2", "lv": 2, "q": "A firm's total cost is £200 at 10 units and £212 at 11 units. Which statement is correct?", "o": ["MC of the 11th unit is £12, so ATC is rising", "MC of the 11th unit is £12, so ATC is falling", "MC of the 11th unit is £212, so ATC is rising", "MC of the 11th unit is £19.27, so ATC is falling"], "a": 1, "x": "MC = ΔTC ÷ ΔQ = £12 ÷ 1 = £12. ATC at 10 units is £20. Since MC is below ATC, it pulls ATC down. The trap is mixing up MC and AC.", "w": ["MC is correct, but MC below ATC (£20) pulls ATC down, not up.", "", "£212 is total cost at 11 units; marginal cost is the change in total cost.", "£19.27 is the ATC at 11 units, not the marginal cost of the 11th unit."]}
{"id": "econ-261", "s": "micro", "t": "3.3.2", "lv": 1, "q": "In the short run, what is the main reason a firm's marginal cost curve eventually slopes upwards?", "o": ["Fixed costs rising as total output rises", "Diseconomies of scale as the firm grows", "Diminishing returns to the variable factor", "Average cost always exceeding marginal cost"], "a": 2, "x": "With at least one factor fixed, adding more variable factors eventually adds less extra output each, so the extra cost per unit rises. Diseconomies of scale belong to the long run.", "w": ["Fixed costs do not change with output, so they cannot raise MC.", "Diseconomies of scale are a long-run idea, when all factors can change.", "", "AC and MC are related by the curves' shapes, but that is not what causes MC to rise."]}
{"id": "econ-262", "s": "micro", "t": "3.3.2", "lv": 2, "q": "A firm's average total cost is £18 at 5 units of output and its fixed costs are £30. What is its total variable cost at 5 units?", "o": ["£12", "£60", "£90", "£30"], "a": 1, "x": "TC = ATC × Q = £18 × 5 = £90. TVC = TC − FC = £90 − £30 = £60. £90 is total cost, not variable cost; remember to subtract fixed costs.", "w": ["£12 is average variable cost (£60 ÷ 5), not total variable cost.", "", "£90 is total cost; it still includes the £30 of fixed costs.", "£30 is the fixed cost, which is not part of variable cost."]}
{"id": "econ-263", "s": "micro", "t": "3.3.2", "lv": 2, "q": "A firm's long-run average cost curve falls, then rises as output increases. What explains the rising section?", "o": ["Diseconomies of scale, such as coordination problems", "Diminishing marginal returns because capital is fixed", "Fixed costs increasing as output increases", "Marginal cost falling below average cost"], "a": 0, "x": "In the long run all factors can change, so rising LRAC is due to diseconomies of scale, such as poorer communication and control. Diminishing returns explain short-run curves.", "w": ["", "Diminishing returns need a fixed factor; in the long run none is fixed.", "Fixed costs are a short-run concept and do not rise with output.", "MC below AC makes AC fall, not rise."]}
{"id": "econ-264", "s": "micro", "t": "3.3.2", "lv": 3, "q": "In Q3 FY26 (ended 30 June 2026), easyJet's fuel cost per available seat kilometre rose 13% year-on-year. Treating fuel as a variable cost, which curves shift upwards?", "o": ["AFC and ATC, with MC unchanged", "ATC only, because fuel is part of total cost", "AVC, ATC and MC, with AFC unchanged", "MC only, because fuel is a marginal cost"], "a": 2, "x": "Fuel rises with output, so it is a variable cost. Higher fuel prices raise TVC, so AVC, ATC and MC all shift up. Fixed costs are unchanged, so AFC does not move.", "w": ["Fuel is variable, so it affects MC; it does not change AFC.", "A rise in variable costs also raises AVC and MC, not just ATC.", "", "Fuel also raises AVC and ATC, because they include variable costs."]}
{"id": "econ-265", "s": "micro", "t": "3.3.3", "lv": 1, "q": "Which is an example of an internal economy of scale?", "o": ["A road upgrade lowers delivery times for every firm in the town", "A new college nearby trains skilled workers for all local bakeries", "A large bakery buys flour in bulk and gets a lower price per tonne", "Many bakeries locate together and share a specialist repair firm"], "a": 2, "x": "Bulk-buying discounts are purchasing economies, internal because they come from the firm's own size. The other options benefit the whole industry or area, so they are external economies.", "w": ["External: a road helps every firm in the town regardless of its own size.", "External: it benefits all local firms, not just one growing firm. Confusing industry-wide gains with firm-level ones.", "", "External: a shared supplier arises from the industry's clustering, not one firm's growth."]}
{"id": "econ-266", "s": "micro", "t": "3.3.3", "lv": 1, "q": "What does minimum efficient scale (MES) mean?", "o": ["The lowest output at which long-run average cost is minimised", "The output at which a firm's total profit is at its highest level", "The output at which marginal cost equals the average revenue", "The smallest output that a firm can produce in the short run"], "a": 0, "x": "MES is the lowest level of output at which LRAC reaches its minimum. It concerns cost, not profit, and it is a long-run idea. Profit maximisation uses MC = MR.", "w": ["", "Profit maximisation depends on revenue as well as cost; MES is purely about cost.", "MC = AR is not a standard rule; profit maximising uses MC = MR.", "MES is a long-run concept about average cost, not short-run capacity."]}
{"id": "econ-267", "s": "micro", "t": "3.3.3", "lv": 2, "q": "Suppose a firm's output doubles from 1,000 to 2,000 units and total cost rises from £8,000 to £14,000. What has happened to average cost, and what does this suggest?", "o": ["Stayed at £8, suggesting constant returns to scale", "Rose from £8 to £7, suggesting diseconomies of scale", "Fell from £8 to £7, suggesting diseconomies of scale", "Fell from £8 to £7, suggesting economies of scale"], "a": 3, "x": "AC = TC ÷ Q. Before: £8,000 ÷ 1,000 = £8. After: £14,000 ÷ 2,000 = £7. Average cost fell as output rose, which indicates economies of scale.", "w": ["Average cost did not stay at £8; dividing £14,000 by 2,000 gives £7.", "£8 to £7 is a fall, not a rise; the direction was misread.", "A falling average cost shows economies, not diseconomies; the interpretation is reversed.", ""]}
{"id": "econ-268", "s": "micro", "t": "3.3.3", "lv": 2, "q": "Ofcom reported Royal Mail's letter volumes fell from 20 billion twenty years earlier to 6.5 billion in 2025. Which best explains the cost effect, given its fixed national network?", "o": ["Fewer letters spread fixed network costs more thinly, raising average cost", "Falling output lowers the average fixed cost per letter sent", "Falling output creates external economies of scale for rival firms", "Falling output reduces total fixed costs of the network in the short run"], "a": 0, "x": "A large fixed network cost spread over fewer letters means higher average cost per letter, so scale economies are lost. Average fixed cost rises as output falls.", "w": ["", "AFC = TFC ÷ Q, so lower output raises AFC, not lowers it.", "External economies come from industry growth, not from one firm's falling output.", "Fixed costs by definition do not fall with output in the short run."]}
{"id": "econ-269", "s": "micro", "t": "3.3.3", "lv": 2, "q": "A growing firm finds communication between managers slows, workers feel distant from decisions and motivation falls. Long-run average cost now rises. This is best described as:", "o": ["External diseconomies of scale", "Falling minimum efficient scale", "Diminishing marginal returns in the short run", "Internal diseconomies of scale"], "a": 3, "x": "Problems such as poor communication and lost motivation arise from the firm's own size, so they are internal diseconomies of scale, shown by a rising LRAC. Diminishing returns is a short-run idea.", "w": ["External diseconomies come from industry-wide problems like congestion, not the firm's own management.", "MES is not changed by this; the firm has moved past it on the rising LRAC.", "Diminishing returns need a fixed factor in the short run; this is a long-run change in scale.", ""]}
{"id": "econ-270", "s": "micro", "t": "3.3.3", "lv": 3, "q": "Industry A has a low MES relative to market demand; industry B has an MES close to total market demand. Which conclusion is most likely correct?", "o": ["A can support many firms; B is more likely a natural monopoly", "A will have fewer firms, while B will have many small firms", "Both support many firms because LRAC always rises at large scale", "MES has no effect on how many firms a market can sustain"], "a": 0, "x": "If MES is small relative to demand, many firms can reach it and survive. If MES is near total demand, one or very few firms can be efficient, suggesting a natural monopoly.", "w": ["", "Reversed: a low MES allows many firms, a high MES allows few.", "LRAC does not always rise; with a high MES only one or two firms reach the lowest cost.", "MES matters greatly: it sets how many firms can produce at lowest cost."]}
{"id": "econ-271", "s": "micro", "t": "3.4.1", "lv": 1, "q": "At which point is a firm allocatively efficient?", "o": ["Where marginal cost equals average cost", "Where price equals marginal cost", "Where average cost is at its lowest point", "Where marginal revenue equals marginal cost"], "a": 1, "x": "Allocative efficiency is where P = MC, so the value consumers place on the last unit equals its cost to society. MR = MC only gives the profit-maximising output, which is the usual slip.", "w": ["This describes productive efficiency, where MC cuts AC at its minimum. It is a different type of efficiency.", "", "This is productive efficiency again. Lowest AC is about cost minimisation, not the allocation of resources to what consumers value.", "MR = MC is the profit-maximising rule. It matches allocative efficiency only for a price taker, where P = MR."]}
{"id": "econ-272", "s": "micro", "t": "3.4.1", "lv": 1, "q": "Why is a perfectly competitive industry unlikely to be dynamically efficient in the long run?", "o": ["Firms charge a price persistently above marginal cost", "Firms have monopoly power and so no need to innovate", "Firms produce above the lowest point of average cost", "Only normal profit, so little retained profit for R&D"], "a": 3, "x": "In the long run, free entry removes supernormal profit, leaving normal profit. Little surplus is available for R&D. The trap is assuming perfect competition is efficient in every sense.", "w": ["Price equals MC in perfect competition. P > MC describes monopoly, so this confuses the market structures.", "Perfectly competitive firms are price takers with no monopoly power. This option describes the wrong market structure.", "In the long run a competitive firm produces at the lowest point of AC. This is productive efficiency, not a failing.", ""]}
{"id": "econ-273", "s": "micro", "t": "3.4.1", "lv": 2, "q": "A profit-maximising monopoly sells 100 units at £12. At 100 units, MC is £7 and AC is £9. The lowest point of AC is £6, at 160 units. What can be said about its efficiency?", "o": ["Allocatively efficient, since it earns supernormal profits", "Productively efficient, as AC (£9) is below price (£12)", "Neither: P (£12) exceeds MC (£7), while AC (£9) exceeds £6", "Both, because it has set MR equal to MC at 100 units"], "a": 2, "x": "Allocative efficiency needs P = MC: £12 is not £7. Productive efficiency needs output at minimum AC: £9 is above £6, at 100 units rather than 160. Profit and MR = MC do not show efficiency.", "w": ["Supernormal profit does not mean allocative efficiency. That needs P = MC, and here P is £12 while MC is £7.", "Price above AC means profit, not productive efficiency. Productive efficiency needs output at the lowest AC of £6.", "", "MR = MC gives the profit-maximising output only. It does not make P = MC for a monopolist."]}
{"id": "econ-274", "s": "micro", "t": "3.4.1", "lv": 2, "q": "On 28 May 2025, Ofwat fined Thames Water, a regional monopoly, a record £104.5 million for wastewater breaches. Which concept best fits poor asset maintenance with little competitive pressure?", "o": ["Allocative efficiency, because price exceeded marginal cost", "X-inefficiency, as costs exceed the minimum without competition", "Productive efficiency, because average costs were at their minimum", "Dynamic efficiency, because the firm invested heavily in R&D"], "a": 1, "x": "X-inefficiency is where a firm shielded from competition lets costs rise above the minimum possible, through slack management or poor control. Do not confuse it with allocative inefficiency, which concerns P and MC.", "w": ["Allocative efficiency is about P and MC. Poor asset maintenance is a cost and management failure, not a pricing one.", "", "Productive efficiency needs costs at their lowest. Maintenance failings point to higher costs, not minimum costs.", "Poor maintenance is evidence of weak investment, so this is the opposite of dynamic efficiency."]}
{"id": "econ-275", "s": "micro", "t": "3.4.1", "lv": 2, "q": "In long-run equilibrium, a monopolistically competitive firm has downward-sloping AR touching AC at a point left of AC's minimum. What does this imply?", "o": ["Both, since entry and exit are free", "Productively efficient, since only normal profit is earned", "Allocatively efficient, since supernormal profit is zero", "Neither allocatively nor productively efficient"], "a": 3, "x": "AR is downward sloping, so MR lies below AR and P > MC: not allocatively efficient. Output is left of minimum AC, so there is excess capacity: not productively efficient. Normal profit alone proves neither.", "w": ["Free entry removes supernormal profit, as in perfect competition. The downward-sloping demand curve still leaves both inefficiencies.", "Normal profit comes from AR = AC at that output. It does not mean AC is at its minimum, which is right of the output.", "Zero supernormal profit is AR = AC. Allocative efficiency needs P = MC, and here P > MC.", ""]}
{"id": "econ-276", "s": "micro", "t": "3.4.1", "lv": 3, "q": "A firm sells at £8 where MC = £8. Its AC is £10 at that output, and the lowest point of its AC is £7. Which statement is correct?", "o": ["Productively efficient but not allocatively efficient", "Neither allocatively nor productively efficient", "Both allocatively and productively efficient", "Allocatively but not productively efficient"], "a": 3, "x": "P = MC = £8, so it is allocatively efficient. AC is £10, above the minimum of £7, so it is not productively efficient. It is also making a loss, as price is below AC.", "w": ["This reverses the two. P = MC shows allocative efficiency, and AC is above its minimum so it is not productively efficient.", "P equals MC, so the firm is allocatively efficient. Calling it inefficient on both counts ignores this check.", "AC of £10 is above the lowest AC of £7, so it is not productively efficient. Only one condition is met.", ""]}
{"id": "econ-277", "s": "micro", "t": "3.4.2", "lv": 1, "q": "Why is a firm in perfect competition a price taker?", "o": ["It has a unique product buyers cannot compare with others", "It sets output where MR is above MC to maximise profit", "It faces barriers to entry that fix the price", "It is small in the market and sells identical products"], "a": 3, "x": "Many small sellers of an identical product mean one firm cannot influence the market price. Its demand is perfectly elastic at the market price. Confusing price-taking with product differentiation is the trap.", "w": ["A unique product is product differentiation, which gives some price-setting power. It is not perfect competition.", "Profit maximisation is at MR=MC, not MR above MC, and it does not explain price-taking.", "Perfect competition has no barriers to entry. Barriers would give firms market power.", ""]}
{"id": "econ-278", "s": "micro", "t": "3.4.2", "lv": 1, "q": "Which statement is true of a perfectly competitive firm in long-run equilibrium?", "o": ["It earns normal profit, with P = MC = minimum AC", "It produces where P is above MC, so it is allocatively inefficient", "It earns normal profit but produces where AC is still falling", "It earns supernormal profit because P is above AC"], "a": 0, "x": "Free entry and exit remove supernormal profit and losses. The firm ends at the lowest point of its AC curve, so P=MC (allocative efficiency) and productive efficiency holds. Supernormal profit cannot last.", "w": ["", "In perfect competition P=MC, which is allocative efficiency. Only a firm with market power has P above MC.", "In long-run equilibrium the firm produces at minimum AC, where AC is neither falling nor rising.", "Supernormal profit attracts entry, which pushes price down to AC. It cannot last in the long run."]}
{"id": "econ-279", "s": "micro", "t": "3.4.2", "lv": 2, "q": "A perfectly competitive firm faces a market price of £12. At its profit-maximising output of 500 units, average cost is £9. What is its supernormal profit?", "o": ["£1,500", "£4,500", "£6,000", "£3"], "a": 0, "x": "Profit = (AR − AC) × Q = (12 − 9) × 500 = £1,500. Using total revenue (£6,000) or total cost (£4,500) alone confuses revenue or cost with profit.", "w": ["", "£4,500 is total cost (9 × 500). Profit is revenue minus cost.", "£6,000 is total revenue (12 × 500). Cost has not been subtracted.", "£3 is profit per unit. The question asks for total profit, so multiply by 500."]}
{"id": "econ-280", "s": "micro", "t": "3.4.2", "lv": 2, "q": "In the short run a perfectly competitive firm faces price £6. At its MC=MR output, AVC is £5 and AC is £7. What is the best decision?", "o": ["Shut down at once, because AR is below its AC", "Keep producing: AR exceeds AVC, so losses are smaller", "Raise price to £7 so that it can break even", "Keep producing, because it is earning normal profit"], "a": 1, "x": "The firm loses £1 per unit, but each unit adds £1 above AVC towards fixed costs. Shutting down would lose all fixed costs. The short-run shutdown rule is AR < AVC, not AR < AC.", "w": ["This applies the long-run rule. In the short run the firm stays open while AR is at least AVC.", "", "A price taker cannot raise price. Selling above the market price means selling nothing.", "AR is below AC, so the firm makes a loss, not normal profit. Normal profit needs AR=AC."]}
{"id": "econ-281", "s": "micro", "t": "3.4.2", "lv": 2, "q": "Defra recorded an average UK farm-gate milk price of 38.45 pence per litre in September 2026. Assuming perfect competition, what happens if one farmer asks 42p per litre?", "o": ["She sells the same output and so earns more profit", "Market price rises to 42p as other farmers follow her", "She sells almost nothing, as buyers go elsewhere", "She sells less, but her total revenue still goes up"], "a": 2, "x": "With a homogeneous product and perfect information, buyers switch to the market price. The firm's demand is perfectly elastic at 38.45p, so any higher price loses all sales. A price taker has no pricing power.", "w": ["Buyers would not pay more for identical milk, so she cannot keep her sales at a higher price.", "One small farmer cannot move the market price, so other farmers would not follow.", "", "Her demand is perfectly elastic, so sales fall to zero and revenue falls rather than rises."]}
{"id": "econ-282", "s": "micro", "t": "3.4.2", "lv": 3, "q": "A perfectly competitive market is in long-run equilibrium. Market demand then falls permanently. Which sequence of events is correct?", "o": ["Price falls below AC, losses, some firms exit, supply shifts left, price returns to min AC", "Price falls below AC, firms cut price further, supply shifts right, normal profit returns", "Price falls, firms make losses, each firm's AC curve shifts down until normal profit", "Price falls but stays below AC, as firms cannot leave the industry in the long run"], "a": 0, "x": "Lower demand cuts price below AC, so losses. With free exit, firms leave, industry supply shifts left and price rises until AR=AC again. The remaining firms earn normal profit.", "w": ["", "Firms are price takers and cannot cut price. Exit shifts supply left, not right.", "AC curves do not shift down automatically. Adjustment comes from firms leaving, which moves the market price.", "Free exit is a feature of perfect competition. Firms leave until losses disappear."]}
{"id": "econ-283", "s": "micro", "t": "3.4.3", "lv": 1, "q": "ONS recorded 216,000 retail businesses in the UK in March 2026. Which feature of monopolistic competition does this best illustrate?", "o": ["There are many small firms", "Firms are price takers", "Barriers to entry are high", "Products are homogeneous"], "a": 0, "x": "A fragmented market with very many small firms is a feature of monopolistic competition. Firms sell differentiated products and face low barriers to entry, so they are not price takers.", "w": ["", "Price takers belong to perfect competition; differentiated products give these firms some price-making power.", "High barriers to entry belong to monopoly or oligopoly; monopolistic competition has low barriers.", "Homogeneous products belong to perfect competition; here products are differentiated."]}
{"id": "econ-284", "s": "micro", "t": "3.4.3", "lv": 1, "q": "In long-run equilibrium, a monopolistically competitive firm earns:", "o": ["Supernormal profit, because it is a price maker with some market power", "Normal profit, because entry shifts demand until AR equals AC", "Subnormal profit, because demand becomes perfectly elastic", "Supernormal profit, because MR exceeds MC at the output produced"], "a": 1, "x": "Free entry removes supernormal profit. Demand shifts left until AR=AC at the profit-maximising output, leaving normal profit. Market power does not guarantee long-run supernormal profit.", "w": ["Some price-making power does not stop entry competing away supernormal profit when barriers are low.", "", "Demand stays downward-sloping and is not perfectly elastic; that is a perfect competition feature.", "Profit maximisation is where MR=MC, not MR>MC; and entry removes supernormal profit anyway."]}
{"id": "econ-285", "s": "micro", "t": "3.4.3", "lv": 2, "q": "Firms in a monopolistically competitive market earn supernormal profit in the short run. What happens to an existing firm's demand curve as new firms enter?", "o": ["It shifts left and becomes more elastic", "It shifts left and becomes less elastic", "It shifts right and becomes more elastic", "It shifts right and becomes less elastic"], "a": 0, "x": "New entrants take customers, so demand shifts left. More close substitutes also make demand more elastic. Entry continues until AR=AC and only normal profit remains.", "w": ["", "Left is right, but more substitutes make demand more elastic, not less.", "Demand shifts right if firms exit, not enter; entry reduces each firm's share of the market.", "Entry takes customers away, so demand falls, not rises; more substitutes make demand more elastic."]}
{"id": "econ-286", "s": "micro", "t": "3.4.3", "lv": 2, "q": "At its profit-maximising output of 200 coffees a week, a café charges £3.50 and has average cost of £3.00. What is its short-run profit?", "o": ["£700", "£100", "£600", "£0.50"], "a": 1, "x": "Profit = (AR − AC) × Q = (£3.50 − £3.00) × 200 = £100 supernormal profit. The trap is stopping at the per-unit profit or reporting revenue or cost.", "w": ["£700 is total revenue (£3.50 × 200), not profit; costs have not been subtracted.", "", "£600 is total cost (£3.00 × 200), not profit.", "£0.50 is profit per coffee; you must multiply by 200 to get total profit."]}
{"id": "econ-287", "s": "micro", "t": "3.4.3", "lv": 2, "q": "Which statement about a monopolistically competitive firm in long-run equilibrium is correct?", "o": ["Output is at the minimum point of AC, so it is productively efficient", "Output is below the minimum-AC output, so there is excess capacity", "Price equals marginal cost, so it is allocatively efficient", "Price is below average cost, so firms are making losses"], "a": 1, "x": "The AR curve is tangent to AC on its downward-sloping part, so output is below the minimum-AC output: excess capacity. Also P>MC, so it is neither productively nor allocatively efficient.", "w": ["Tangency is left of the minimum of AC, so it is not productively efficient; that is a perfect competition result.", "", "Because AR slopes down, P>MC at MR=MC, so it is not allocatively efficient.", "Price equals AC in long-run equilibrium, giving normal profit, not losses."]}
{"id": "econ-288", "s": "micro", "t": "3.4.3", "lv": 3, "q": "A monopolistically competitive market is in long-run equilibrium. Rents, a fixed cost, rise for all firms. What is the long-run result?", "o": ["Firms stay and keep making losses, because entry and exit stop", "Price is unchanged because MC and MR are unchanged, so profit stays normal", "Some firms exit; demand for the rest rises until AR=AC at a higher price", "More firms enter, demand falls and price falls to the new minimum AC"], "a": 2, "x": "Higher fixed cost raises AC, so AC exceeds AR and firms make losses. Firms exit, remaining firms' demand shifts right, and price rises until AR=AC again with normal profit.", "w": ["Free exit means losses are not permanent; firms leave until normal profit returns.", "MC is unchanged, but AC rises so firms make losses in the short run; exit then raises price in the long run.", "", "Entry occurs when there is supernormal profit; here there are losses, so firms exit."]}
{"id": "econ-289", "s": "micro", "t": "3.4.5", "lv": 1, "q": "A profit-maximising monopolist with a downward-sloping demand curve chooses its output and price. Which statement is correct?", "o": ["Output is where MR = MC, and price is read off the AR curve", "Output is where AR = MC, and price is read off the MC curve", "Output is where MR = 0, and price is read off the MC curve", "Output is where AC is lowest, and price equals minimum AC"], "a": 0, "x": "Profit is maximised where MR = MC. The price is the highest consumers will pay for that quantity, so you go up to the AR (demand) curve. Reading price off MR or MC is the trap.", "w": ["", "AR = MC is not the profit-maximising rule, and price is not read off the MC curve.", "MR = 0 maximises revenue, not profit, because it ignores costs. Price also comes from AR, not MC.", "Minimum AC is productive efficiency, not the monopolist's profit-maximising rule."]}
{"id": "econ-290", "s": "micro", "t": "3.4.5", "lv": 2, "q": "A monopolist faces demand P = 50 − 2Q (P in £). Its AC = MC = £10 at all output levels. What is its maximum supernormal profit?", "o": ["£200", "£400", "£300", "£100"], "a": 0, "x": "MR = 50 − 4Q. Setting MR = MC: 4Q = 40, so Q = 10. P = 50 − 20 = £30. Profit = (30 − 10) × 10 = £200. The trap is using the wrong price or the MR curve.", "w": ["", "£400 uses 50 − 10 = 40 as the margin. 50 is the demand intercept, not the price charged.", "£300 is total revenue (30 × 10). Profit needs the margin over average cost, so subtract £10 per unit.", "£100 comes from using a margin of £10 per unit. The margin is price minus AC = 30 − 10 = £20."]}
{"id": "econ-291", "s": "micro", "t": "3.4.5", "lv": 1, "q": "Which is a condition needed for a firm to practise third-degree price discrimination?", "o": ["Markets can be separated, with different PED and no resale", "Demand has the same price elasticity in every market", "Customers can freely resell the product between groups", "The firm is a price taker in a perfectly competitive market"], "a": 0, "x": "The firm needs market power, the ability to separate markets, no resale between them, and different PED in each. Then it can charge more where demand is less elastic.", "w": ["", "If PED were the same everywhere, there would be no profit gain from different prices.", "Resale would let low-price buyers undercut the firm, which destroys the discrimination.", "Price takers cannot set prices. Price discrimination needs market power, as a monopolist has."]}
{"id": "econ-292", "s": "micro", "t": "3.4.5", "lv": 2, "q": "Ofcom reported on 12 September 2025 that 36% of UK fixed broadband-and-landline bundle users were out of contract at end-June 2024 and paid 18% more than in-contract customers. This is best seen as:", "o": ["Perfect price discrimination, as every customer pays their maximum", "A price war, as providers compete by cutting in-contract prices", "Evidence of lower marginal cost for out-of-contract customers", "Price discrimination, as out-of-contract users likely have less elastic demand"], "a": 3, "x": "Charging different prices for the same service, not based on cost, is price discrimination. Customers who do not switch tend to have less elastic demand, so the firm charges them more.", "w": ["Perfect discrimination charges each person their exact maximum. Two broad groups is not that.", "A price war would lower prices generally. Here one group pays more, which is discrimination.", "The difference reflects willingness to switch, not cost. Price discrimination means price differences not explained by cost.", ""]}
{"id": "econ-293", "s": "micro", "t": "3.4.5", "lv": 2, "q": "In 2026 the CAA consulted on capping Heathrow's charges at £27.20 to £30.50 per passenger (2024 CPIH prices). Why regulate a natural monopoly like this?", "o": ["To force the firm to produce at the output where MR = 0", "To limit price above cost while keeping a single firm's low costs", "To split the airport into many firms so it becomes perfectly competitive", "To raise the firm's costs so that it earns only normal profit"], "a": 1, "x": "A natural monopoly has falling LRAC over the whole market, so one firm is cheapest. Splitting it would raise costs. A price cap limits its power to charge well above cost.", "w": ["MR = 0 maximises revenue and would not be a regulatory aim. Caps target price, not this output rule.", "", "Breaking it up would duplicate costs and lose economies of scale, so this is not how a cap works.", "A cap limits price. It does not aim to raise costs, and a firm with higher costs is less efficient."]}
{"id": "econ-294", "s": "micro", "t": "3.4.5", "lv": 3, "q": "A monopolist faces P = 60 − Q with constant MC = £20. A competitive market would have P = MC. What is the welfare (deadweight) loss from monopoly?", "o": ["£400", "£200", "£800", "£100"], "a": 1, "x": "MR = 60 − 2Q = 20, so Q = 20 and P = £40. Competitive output: 60 − Q = 20, so Q = 40. The loss is a triangle: ½ × (40 − 20) × (40 − 20) = £200.", "w": ["£400 forgets the ½ for the area of a triangle: 20 × 20 without halving.", "", "£800 uses a base of 40 and a height of 40. The triangle's base is only the lost output, 40 − 20 = 20.", "£100 uses a height of 10 or the wrong base. The gap between P = 40 and MC = 20 is £20."]}
{"id": "econ-295", "s": "micro", "t": "3.4.6", "lv": 1, "q": "Which statement best defines a monopsony?", "o": ["A market with one seller and many small buyers", "A firm that is the only seller of a good with no close substitutes", "A market where a few large firms agree to fix the price they charge", "A market where one buyer dominates and sets the price paid to suppliers"], "a": 3, "x": "Monopsony is about the buying side: one dominant buyer with power over the price paid. Confusing it with monopoly, which is a dominant seller, is the classic slip.", "w": ["This describes monopoly (single seller), not monopsony. Monopsony concerns a dominant buyer.", "This is the definition of monopoly, which is about selling power, not buying power.", "This describes collusion in an oligopoly, a selling-side behaviour, not a single dominant buyer.", ""]}
{"id": "econ-296", "s": "micro", "t": "3.4.6", "lv": 2, "q": "A monopsony employer faces labour supply W = 5 + 0.5L and MRP = 23 − L (W in £ per hour, L workers). Its total labour cost is 5L + 0.5L², so MC = 5 + L. What wage does it pay?", "o": ["£11.00", "£9.50", "£14.00", "£9.00"], "a": 1, "x": "Set MRP = MC: 23 − L = 5 + L, so L = 9. The wage comes from the supply curve: 5 + 0.5(9) = £9.50. Reading £14 off MC or MRP is the trap.", "w": ["£11 is the competitive wage, where MRP equals supply. A monopsony does not set MRP equal to supply.", "", "£14 is MC and MRP at 9 workers. The wage paid is lower, read from the supply curve.", "9 is the number of workers hired, not the wage. Substitute L = 9 into the supply curve."]}
{"id": "econ-297", "s": "micro", "t": "3.4.6", "lv": 2, "q": "The same monopsony (MRP = 23 − L, supply W = 5 + 0.5L) hires 9 workers at £9.50. A legal minimum wage of £11 is introduced. What happens to employment?", "o": ["It rises to 12, as MC is flat at £11 up to 12 workers", "It stays at 9, because the firm cannot change hours", "It falls to 8, because the wage has risen", "It rises to 16, because supply is higher at higher wages"], "a": 0, "x": "At £11 the wage is fixed for each extra worker up to supply of 12 (5 + 0.5L = 11). MRP is above £11 until L = 12, so employment rises to 12.", "w": ["", "Nothing stops the firm hiring more. Extra workers cost £11 each, below their MRP, so it hires more.", "This assumes a competitive-market result. In monopsony a minimum wage removes the incentive to restrict hiring.", "16 is supply at £13, not £11. The firm also stops hiring where MRP falls to the wage."]}
{"id": "econ-298", "s": "micro", "t": "3.4.6", "lv": 1, "q": "Which is a possible benefit of a firm having monopsony power?", "o": ["Suppliers always receive higher prices because demand is guaranteed", "Employment is higher than it would be in a competitive labour market", "Bulk-buying savings may be passed on as lower prices to consumers", "Output is always greater than in a competitive market"], "a": 2, "x": "Buying power can cut input costs, and some of this may be passed on to consumers as lower prices. This is not guaranteed; it depends on competition in the selling market.", "w": ["Monopsony usually pushes prices paid to suppliers down, not up.", "Monopsony typically employs fewer workers than competition, because MC of labour is above the wage.", "", "Monopsony usually restricts the quantity bought, so output is not always greater."]}
{"id": "econ-299", "s": "micro", "t": "3.4.6", "lv": 2, "q": "In the Groceries Code Adjudicator's 2026 survey, 14% of suppliers to the 14 largest UK grocery retailers reported payment delays. Which best links this to monopsony power?", "o": ["Retailers are sole sellers, so they can charge shoppers higher prices", "Suppliers have few big alternative buyers, so retailers impose poor terms", "Suppliers have market power over retailers and so delay their own invoices", "Payment delays show that supply to retailers is perfectly elastic"], "a": 1, "x": "Large retailers are main buyers. Suppliers who depend on them have little bargaining power, so poor terms such as late payment can be imposed. This is buying power, not selling power.", "w": ["This confuses monopsony with monopoly. The issue is retailers' power as buyers, not as sellers.", "", "This reverses the power relationship. The retailers are the dominant party, not the suppliers.", "Late payment does not show perfectly elastic supply. It reflects the buyer's bargaining strength."]}
{"id": "econ-300", "s": "micro", "t": "3.4.6", "lv": 3, "q": "A monopsony has MRP = 23 − L and supply W = 5 + 0.5L. It hires 9 workers. A minimum wage of £13 is set. What is the outcome?", "o": ["Employment rises to 16, where the wage meets labour supply", "Employment falls to 8, because £13 exceeds the competitive wage of £11", "Employment rises to 10, with 6 workers unemployed", "Employment stays at 9, because the firm still pays where MRP = MC"], "a": 2, "x": "With the wage fixed at £13, the firm hires until MRP = 13, so L = 10. Supply at £13 is 16, so 6 are unemployed. Employment rises from 9, but stays below the competitive 12.", "w": ["16 is the number willing to work at £13. The firm hires only where MRP falls to £13.", "Employment does not fall: at 9 workers MRP is £14, above £13, so hiring continues to 10.", "", "The old MC curve no longer applies. With a wage floor, MC is flat at £13, so the firm hires more."]}
{"id": "econ-301", "s": "micro", "t": "3.4.7", "lv": 1, "q": "Which feature is most important for a market to be described as perfectly contestable?", "o": ["Many firms already operating in the market", "Firms selling identical, homogeneous products", "Free entry and exit with no sunk costs", "Firms earning only normal profit at all times"], "a": 2, "x": "Perfect contestability needs freedom of entry and exit, with no sunk costs. The number of firms now is irrelevant; the threat of entry is what matters. Option 0 is the classic trap.", "w": ["Contestability is about potential entrants, not current numbers; a duopoly can be contestable.", "Homogeneous products belong to perfect competition, not to the definition of contestability.", "", "Normal profit is an outcome of the threat of entry, not the defining feature."]}
{"id": "econ-302", "s": "micro", "t": "3.4.7", "lv": 1, "q": "Which of the following is an example of a sunk cost for a new entrant to a market?", "o": ["A delivery van that can be resold at market price", "A rented office that can be sublet freely to another firm", "Stock of goods that can be returned to the supplier for a refund", "Local advertising spend that cannot be recovered"], "a": 3, "x": "A sunk cost cannot be recovered on exit. Advertising spend is gone once spent. Resaleable vans, returnable stock and sublet offices can be recouped, so they are not sunk.", "w": ["A van can be resold, so most of its cost is recoverable and not sunk.", "Subletting recovers the cost, so it is not sunk.", "Returnable stock can be refunded, so the cost is recoverable and not sunk.", ""]}
{"id": "econ-303", "s": "micro", "t": "3.4.7", "lv": 2, "q": "A market has two firms earning supernormal profit. There are no sunk costs and entry is free. According to contestability theory, what is most likely to happen?", "o": ["Firms keep supernormal profit because only two firms exist", "Firms raise prices further as they have market power", "Hit-and-run entry, or its threat, pushes price towards AC", "Both firms exit the market because profit is too high"], "a": 2, "x": "With no sunk costs, entrants can enter, take profit and leave at no loss. The threat pushes incumbents to cut price towards average cost. Judging by firm numbers alone is the trap.", "w": ["This treats market structure as fixed by firm numbers, ignoring the threat of entry.", "Raising prices would invite entry; the threat limits pricing power.", "", "Supernormal profit attracts entry; it does not cause incumbents to leave."]}
{"id": "econ-304", "s": "micro", "t": "3.4.7", "lv": 2, "q": "Under the CMA's 2026 Order, from 23 October 2026 outsourced out-of-hours vet providers faced a 12-month cap on notice periods and a ban on most termination fees. This mainly affects which feature of contestability?", "o": ["Higher entry barriers from economies of scale", "Higher sunk costs for incumbent firms", "Lower exit barriers, making entry less risky", "Greater product differentiation between firms"], "a": 2, "x": "Shorter notice and no termination fees make leaving a contract cheaper. Lower exit barriers reduce the risk and sunk cost of entry, so the market becomes more contestable.", "w": ["Economies of scale are not affected by notice periods or termination fees.", "The Order cuts costs of leaving; it does not raise sunk costs.", "", "Contract terms do not change how differentiated products are."]}
{"id": "econ-305", "s": "micro", "t": "3.4.7", "lv": 2, "q": "Which change would make a market LESS contestable?", "o": ["A ban on exit fees in contracts", "Easier switching for customers between providers", "A rise in the sunk costs of entering the market", "Entrants being able to lease rather than buy equipment"], "a": 2, "x": "Higher sunk costs make failure more costly, so entry is riskier and hit-and-run entry is less likely. The other options lower barriers or sunk costs, raising contestability.", "w": ["Removing exit fees lowers exit barriers, increasing contestability.", "Easier switching helps entrants win customers, increasing contestability.", "", "Leasing reduces sunk costs because equipment can be returned, increasing contestability."]}
{"id": "econ-306", "s": "micro", "t": "3.4.7", "lv": 3, "q": "A monopolist in a contestable market charges a price equal to average cost and earns normal profit. Which conclusion is best supported by contestability theory?", "o": ["The firm is acting irrationally by not maximising profit", "Consumer surplus must be zero because price equals average cost", "The market must be perfectly competitive, as there is only normal profit", "It is limit pricing to deter entry, so outcomes may resemble competition"], "a": 3, "x": "Where entry threatens, an incumbent may price at average cost to deter entrants. Outcomes can look competitive despite one firm. It is not perfect competition, which needs many firms and price-taking.", "w": ["Pricing at average cost is rational if higher prices would invite entry and loss of the market.", "Consumers still gain surplus from a price below their willingness to pay.", "Perfect competition needs many price-taking firms; one firm is a monopoly in structure.", ""]}
{"id": "econ-307", "s": "micro", "t": "3.5.1", "lv": 1, "q": "Why is the demand for labour described as a derived demand?", "o": ["The government decides how many workers each firm may hire", "Workers derive their income from the wage rate that firms offer", "Firms hire workers because of demand for the goods they produce", "Labour demand depends only on the supply of workers available"], "a": 2, "x": "Labour is wanted for the output it helps produce, so labour demand depends on demand for the product. Confusing it with the supply side or with wages misses this link.", "w": ["Firms choose hiring levels themselves; the government does not set them, so this is a misconception.", "This describes wages as income for workers, not why firms demand labour; it confuses demand with worker earnings.", "", "Supply of workers does not determine demand; this confuses the two sides of the labour market."]}
{"id": "econ-308", "s": "micro", "t": "3.5.1", "lv": 1, "q": "In a perfectly competitive labour market, a firm's demand curve for labour is its:", "o": ["Total revenue curve", "Average product of labour curve", "Marginal cost of labour curve", "Marginal revenue product curve"], "a": 3, "x": "The firm hires up to where MRP equals the wage, so the downward-sloping MRP curve is the labour demand curve. Marginal cost of labour is the supply side.", "w": ["Total revenue is a total, not the extra revenue from one more worker.", "Average product is output per worker, not the value of an extra worker's output; it is not the demand curve.", "Marginal cost of labour is the wage paid for an extra worker, which is the supply side.", ""]}
{"id": "econ-309", "s": "micro", "t": "3.5.1", "lv": 2, "q": "A firm sells each unit at a fixed £8. The 5th worker adds 6 units of output (MPP). What is the MRP of the 5th worker?", "o": ["£48", "£14", "£1.33", "£6"], "a": 0, "x": "MRP = MPP × MR. With a fixed price, MR is £8, so £8 × 6 = £48. Adding the numbers or dividing gives the wrong figure.", "w": ["", "£14 adds 8 and 6 instead of multiplying them.", "£1.33 divides 8 by 6, inverting the formula.", "6 is the physical output (MPP), not its value in £."]}
{"id": "econ-310", "s": "micro", "t": "3.5.1", "lv": 2, "q": "A bakery's wage rate rises, and nothing else changes. Which describes the effect on its labour demand curve?", "o": ["No change, because labour demand is a derived demand", "A rightward shift of the labour demand curve", "A leftward shift of the labour demand curve", "A movement along the curve to a lower quantity"], "a": 3, "x": "A wage change alters the quantity demanded, a movement along the MRP curve. The curve shifts only if MRP changes. Being derived does not stop wage changes mattering.", "w": ["Derived demand still responds to the wage along the curve, so quantity hired falls.", "Higher wages do not raise MRP, so there is no rightward shift; this confuses movement with shift.", "The curve itself does not move; only the wage changed, so a leftward shift is the classic slip.", ""]}
{"id": "econ-311", "s": "micro", "t": "3.5.1", "lv": 2, "q": "In 2026 the Low Pay Commission noted weak labour demand in retail and hospitality. Which change would most directly shift a café's labour demand curve left?", "o": ["A fall in the market wage for café workers", "A fall in consumer demand for meals out", "A rise in the supply of café workers", "A rise in worker productivity"], "a": 1, "x": "Falling product demand lowers MR and so MRP, shifting labour demand left (derived demand). A wage fall or labour supply rise only moves along the curve; higher productivity shifts it right.", "w": ["A wage fall causes a movement along the curve, so it does not shift it left.", "", "More supply changes the wage, so it moves along the demand curve and is not a shift.", "Higher productivity raises MPP and MRP, shifting demand right, not left."]}
{"id": "econ-312", "s": "micro", "t": "3.5.1", "lv": 3, "q": "A toy shop's 5th worker has MPP of 10 toys, and MR per toy is £4. The weekly wage is £35. If the firm is profit-maximising, should it hire the 5th worker?", "o": ["No, because MRP of £14 is below the wage of £35", "No, because MRP of £40 is above the wage of £35", "Yes, because MPP of 10 exceeds the wage of £35", "Yes, as MRP of £40 exceeds the wage of £35"], "a": 3, "x": "MRP = 10 × £4 = £40. Hiring adds £40 to revenue for £35 of cost, so profit rises. The firm hires while MRP is at least the wage.", "w": ["£14 adds 10 and 4 rather than multiplying them.", "MRP above the wage means hiring adds to profit, so 'No' reverses the rule.", "MPP is in toys, not £, so it cannot be compared to a wage.", ""]}
{"id": "econ-313", "s": "micro", "t": "3.5.2", "lv": 1, "q": "A rise in the wage paid to nurses in a UK hospital trust leads more people to apply. On a labour supply diagram for nurses, this is shown by:", "o": ["A movement up along the supply curve", "A rightward shift of the supply curve", "A leftward shift of the supply curve", "A movement down along the supply curve"], "a": 0, "x": "A change in the wage for that occupation causes a movement along its supply curve. Shifts need a non-wage change, such as training, migration or working conditions. Mixing these up is the classic trap.", "w": ["", "A wage change is the axis variable, so it moves you along the curve, not shifts it.", "Higher wages raise quantity supplied; supply does not fall, and shifts come from non-wage factors.", "Wages rose, so quantity supplied rises, which is up the curve, not down."]}
{"id": "econ-314", "s": "micro", "t": "3.5.2", "lv": 1, "q": "Which is an example of occupational immobility?", "o": ["A firm cannot recruit because wages are too low", "A teacher cannot afford housing in London", "A worker refuses a job because of its long commute", "A redundant car-factory worker lacks software skills"], "a": 3, "x": "Occupational immobility is difficulty moving between jobs or industries because of lacking skills or qualifications. Housing costs and location barriers are geographical immobility.", "w": ["This is a wage-related shortage, not a barrier to workers changing occupation.", "High housing costs stopping a move are geographical immobility, not a skills barrier.", "Commuting and location issues are geographical, not about skills or qualifications.", ""]}
{"id": "econ-315", "s": "micro", "t": "3.5.2", "lv": 2, "q": "The government raises the personal tax-free allowance, increasing take-home pay at every wage. Other things equal, the likely effect on labour supply in the economy is:", "o": ["Rightward shift, as work pays better than benefits", "Leftward shift, because workers all want more leisure time", "No change, because gross wages are unchanged by the policy", "Movement along the curve, because the wage has changed"], "a": 0, "x": "Higher net pay raises the incentive to work, especially for those weighing work against benefits, so labour supply shifts right. Gross wages are unchanged, but take-home reward changes at each wage.", "w": ["", "Higher net pay is more likely to draw people in; assuming only the income effect is a narrow view.", "Gross pay is unchanged, but supply depends on take-home reward, so this ignores the tax effect.", "Gross wage is unchanged, so there is no movement along the curve; a non-wage factor shifts it."]}
{"id": "econ-316", "s": "micro", "t": "3.5.2", "lv": 2, "q": "Vacancies for plumbers rise in the South East while plumbers are unemployed in the North East. The best explanation is:", "o": ["Geographical immobility, e.g. housing costs and family ties", "Occupational immobility, since plumbers lack the right skills", "A rightward shift in labour demand in the North East", "A fall in the national minimum wage for plumbers"], "a": 0, "x": "Same occupation, different regions: workers have the skills but cannot or will not move because of housing costs, family ties or lack of information. That is geographical immobility, not occupational.", "w": ["", "The unemployed are plumbers already, so skills are not the problem.", "Demand rising in the North East would reduce unemployment there, not explain it.", "A minimum wage change does not explain the regional mismatch of identical workers."]}
{"id": "econ-317", "s": "micro", "t": "3.5.2", "lv": 2, "q": "A new rule raises the minimum salary needed to hire skilled workers from overseas. Other things equal, the effect on the labour supply curve for UK care firms is:", "o": ["A rightward shift as wages rise for carers", "No effect, as care firms pay low wages anyway", "A leftward shift, as fewer overseas staff", "A movement up along the supply curve only"], "a": 2, "x": "Restricting migrant workers reduces the number available at each wage, shifting supply left. Migration is a non-wage determinant of supply, so this is a shift, not a movement.", "w": ["Wages have not caused this; restricting entry reduces the pool of workers at each wage.", "Care firms are affected because they rely on such workers; the rule cuts the pool available.", "", "The cause is a non-wage factor, so the curve shifts rather than moving along it."]}
{"id": "econ-318", "s": "micro", "t": "3.5.2", "lv": 3, "q": "A toy factory closes in a town. Which policy most directly tackles the resulting occupational immobility?", "o": ["Publicly funded retraining in skills local firms need", "Subsidised housing in a distant city for the workers", "A cut in income tax for higher earners nationally", "A lower minimum wage for under-25s in the town"], "a": 0, "x": "Occupational immobility comes from skills mismatch, so retraining targets it directly. Housing support addresses geographical immobility. Tax and minimum wage changes do not provide the skills required.", "w": ["", "Housing subsidies tackle geographical immobility, not a skills mismatch.", "Tax cuts for high earners do not give the displaced workers new skills.", "A lower youth minimum wage affects employer demand, not the skills of redundant workers."]}
{"id": "econ-319", "s": "micro", "t": "3.5.3", "lv": 1, "q": "In a perfectly competitive labour market, what determines the equilibrium wage rate for a type of worker?", "o": ["The wage at which one firm's profit is highest", "The wage the government sets each April", "The wage where labour demand (MRP) equals labour supply", "The wage the most productive worker would accept"], "a": 2, "x": "The wage is the price of labour, so it settles where the demand for labour (derived from MRP) meets labour supply. Profit-maximising choices for one firm, or government decisions, do not set the market wage in a competitive market.", "w": ["Profit-maximising decisions decide how many workers a firm hires at the market wage; they do not set the market wage itself.", "A statutory minimum can influence pay, but it does not determine the equilibrium wage in a competitive market.", "", "Wages are set by the whole market, not by the most productive worker; this confuses one worker's MRP with market equilibrium."]}
{"id": "econ-320", "s": "micro", "t": "3.5.3", "lv": 1, "q": "From 1 April 2026 the National Living Wage is £12.71 an hour. In one competitive labour market the equilibrium wage is £14. What is the effect of the NLW there?", "o": ["Excess demand for labour, because the wage is below £14", "Excess supply of labour, because any minimum wage creates unemployment", "The wage rises to £12.71 and employment rises", "None: it is below equilibrium, so wages and employment are unchanged"], "a": 3, "x": "A minimum wage only bites if set above the equilibrium wage. At £12.71 the floor is below £14, so it is not binding. The market still clears at £14 with unchanged employment.", "w": ["A shortage would need a maximum wage below equilibrium; a minimum wage below equilibrium does nothing.", "Unemployment arises only if the floor is above equilibrium. Here it is below, so it is not binding.", "Equilibrium pay is already £14, higher than £12.71; the floor cannot pull wages down to £12.71.", ""]}
{"id": "econ-321", "s": "micro", "t": "3.5.3", "lv": 2, "q": "A firm raises its hourly wage from £10 to £10.50. Employment falls from 1,000 to 980 workers. What is the wage elasticity of demand for labour?", "o": ["−2.5, so demand for labour is elastic", "−0.4, so demand for labour is inelastic", "−0.05, so demand for labour is inelastic", "−0.02, so demand for labour is inelastic"], "a": 1, "x": "Wage rises 5% (0.50/10). Employment falls 2% (20/1,000). Elasticity = −2 ÷ 5 = −0.4. This is between 0 and −1, so inelastic. The trap is inverting the ratio.", "w": ["This inverts the formula, putting the wage change over the employment change.", "", "−0.05 uses the wage change as a proportion without converting the employment change into a percentage.", "−0.02 uses the absolute fall of 20 workers over 1,000, not a percentage change divided by a percentage change."]}
{"id": "econ-322", "s": "micro", "t": "3.5.3", "lv": 2, "q": "A monopsony employer pays less than the competitive wage. A minimum wage is set above the monopsony wage but below the competitive wage. What is the likely effect?", "o": ["Employment falls, because the wage is above the monopsony wage", "Employment is unchanged, because the firm still has market power", "Wages and employment may both rise, as marginal labour cost changes", "Wages rise but labour demand shifts left, so jobs fall"], "a": 2, "x": "The floor makes the marginal cost of labour equal to the minimum wage up to the supply curve. MC now meets MRP at a higher quantity, so the firm hires more at a higher wage. Competitive-market reasoning does not apply here.", "w": ["This applies the competitive-market result. A monopsony pays below MRP, so a modest floor can raise employment.", "The floor changes the marginal cost of labour, so the profit-maximising MC = MRP point moves.", "", "The floor does not shift labour demand (MRP); a rise in the wage only causes a movement along it, and here MC changes too."]}
{"id": "econ-323", "s": "micro", "t": "3.5.3", "lv": 2, "q": "Which factor would make a firm's demand for labour MORE wage inelastic?", "o": ["Machines are easy and cheap to substitute for workers", "Labour costs are a large proportion of the firm's total costs", "The firm sells a product with highly elastic demand", "Labour costs are a small share of the firm's total costs"], "a": 3, "x": "If labour is a small part of total costs, a wage rise hardly changes total costs, so the firm cuts few jobs: demand is inelastic. The other options all make demand for labour more elastic.", "w": ["Easy substitution of capital for labour makes demand more elastic, as firms switch away when wages rise.", "A large cost share means a wage rise hits costs hard, making firms cut more jobs: more elastic.", "Elastic product demand means higher costs cannot be passed on, so firms cut more labour: more elastic.", ""]}
{"id": "econ-324", "s": "micro", "t": "3.5.3", "lv": 3, "q": "Suppose labour demand is Qd = 600 − 20W and supply is Qs = 100 + 30W (W in £ per hour, Q in workers). A minimum wage of £12 is set. How many workers are unemployed?", "o": ["40", "100", "60", "360"], "a": 1, "x": "Equilibrium: 600 − 20W = 100 + 30W, so W = £10, Q = 400. At £12: Qd = 360, Qs = 460. Unemployment = excess supply = 460 − 360 = 100. Fall in employment alone is only 40.", "w": ["40 is only the fall in employment (400 to 360); unemployment is the gap between quantity supplied and demanded.", "", "60 is only the rise in labour supplied (400 to 460), not the gap with quantity demanded.", "360 is the quantity of workers demanded at £12, i.e. the employment level, not the unemployment."]}
{"id": "econ-325", "s": "micro", "t": "3.6.1", "lv": 1, "q": "Which UK body investigates mergers that may substantially reduce competition and can clear them, block them or accept remedies?", "o": ["The CMA", "The Monetary Policy Committee", "The Office for Budget Responsibility", "Ofwat"], "a": 0, "x": "The CMA (Competition and Markets Authority) is the UK's competition authority. It reviews mergers (Phase 1, then Phase 2 if needed). Do not confuse it with sector regulators such as Ofwat, which regulate one industry.", "w": ["", "The MPC sets interest rates for the inflation target. It does not review mergers.", "The OBR forecasts the public finances. It has no merger powers.", "Ofwat regulates the water industry only. It is a sector regulator, not the general merger authority."]}
{"id": "econ-326", "s": "micro", "t": "3.6.1", "lv": 1, "q": "A regulator sets a price cap of RPI − X on a monopoly. X is 2 and RPI is 5%. What is the maximum average price rise allowed?", "o": ["3%", "2.5%", "10%", "7%"], "a": 0, "x": "The cap allows price rises of RPI minus X: 5% − 2% = 3%. X is the efficiency gain the firm is expected to make. Adding X is the common slip.", "w": ["", "This divides RPI by X. The formula is subtraction, not division.", "This multiplies RPI by X. The cap is RPI minus X.", "This adds X to RPI. X is subtracted, because it is an expected efficiency gain."]}
{"id": "econ-327", "s": "micro", "t": "3.6.1", "lv": 2, "q": "Market shares: A 28%, B 22%, C 18%, D 12%, E 8%, F 6%, G 6%. C and E merge. What is the four-firm concentration ratio after the merger?", "o": ["80%", "26%", "88%", "74%"], "a": 2, "x": "After the merger the largest four firms are A 28, merged firm 26, B 22 and D 12. Total 88%. Before, it was 28+22+18+12 = 80%. Merging firms re-ranks the market.", "w": ["This is the ratio before the merger. The merger creates a 26% firm that pushes out F and G, so it changes.", "This is only the merged firm's share, not the sum of the top four.", "", "This does not match any top-four combination after the merger. Add 28, 26, 22 and 12."]}
{"id": "econ-328", "s": "micro", "t": "3.6.1", "lv": 2, "q": "The CMA cleared the Vodafone UK and Three UK merger (December 2024) but accepted binding undertakings in March 2025, including three-year caps on selected retail tariffs. Why use remedies?", "o": ["To keep investment gains while limiting consumer harm from weaker competition", "To make sure the merged firm can never earn any supernormal profit at all", "To show that blocking mergers is illegal under UK competition law rules", "To ensure the merged firm produces where price equals marginal cost"], "a": 0, "x": "Remedies try to keep benefits such as network investment (dynamic efficiency) while limiting higher prices from reduced competition. They cannot guarantee zero supernormal profit or P = MC.", "w": ["", "Selected caps for three years do not remove all supernormal profit. This overstates what remedies achieve.", "The CMA can block mergers. Choosing remedies is a judgement about costs and benefits, not a legal bar.", "Price caps on selected tariffs do not force P = MC. That is an overstated claim of allocative efficiency."]}
{"id": "econ-329", "s": "micro", "t": "3.6.1", "lv": 3, "q": "A monopsony employer pays below the value of workers' MRP. A minimum wage is set at the competitive wage, where labour supply meets MRP. What happens to wage and employment?", "o": ["Wage rises and employment falls", "Wage rises and employment is unchanged", "Wage rises and employment rises", "Wage rises but employment cannot be predicted"], "a": 2, "x": "The minimum wage makes the marginal cost of labour equal to the wage up to the competitive quantity. The firm hires more, up to where MRP equals the wage. Applying the competitive-market result is the slip.", "w": ["This is the result in a competitive market with a wage above equilibrium. A monopsony starts with employment below the competitive level.", "Employment changes because the firm's marginal cost of labour changes. It does not stay fixed.", "", "The effect can be worked out here. The firm hires until MRP equals the wage, which is the competitive quantity."]}
{"id": "econ-330", "s": "micro", "t": "3.6.1", "lv": 2, "q": "On 22 September 2026 the CMA issued an Order requiring UK pet veterinary firms to disclose ownership, publish transparent prices and remove barriers to competition. What does this mainly tackle?", "o": ["Negative externalities arising from veterinary treatment of pets", "The free-rider problem in the provision of a public good", "Poor consumer information and barriers to entry", "A shortage caused by a legally imposed maximum price"], "a": 2, "x": "Publishing prices and ownership improves consumer information so people can compare. Removing barriers makes entry easier. Together they promote competition. No externality or public good is involved.", "w": ["Vet treatment is not mainly an externality case. The Order is about prices, ownership and entry.", "Veterinary services are private goods, so free-riding is not the issue.", "", "The Order sets no maximum price, so a price-ceiling shortage is not involved."]}
{"id": "econ-331", "s": "micro", "t": "3.6.2", "lv": 1, "q": "A government sets a maximum price below the equilibrium price in a competitive market. Which is the most likely result?", "o": ["A surplus, because supply exceeds demand at the lower price", "More units traded than at the free-market equilibrium", "Excess demand, with a risk of a black market", "Higher revenue for producers because demand rises"], "a": 2, "x": "A binding maximum price is below equilibrium, so quantity demanded rises and quantity supplied falls. Excess demand results, and a black market may appear. The trap is confusing a ceiling with a floor.", "w": ["That describes a minimum price above equilibrium. A ceiling below equilibrium causes excess demand, not a surplus.", "Trade is limited to the lower quantity supplied, which is below the equilibrium quantity.", "", "Demand does not rise; the price fall causes an extension along the demand curve, and quantity supplied contracts."]}
{"id": "econ-332", "s": "micro", "t": "3.6.2", "lv": 2, "q": "In a market, $Q_d = 100 - 2P$ and $Q_s = 20 + 2P$ (P in £, Q in units). The government sets a maximum price of £10. What is the excess demand?", "o": ["20 units", "40 units", "80 units", "60 units"], "a": 1, "x": "At £10, $Q_d = 100 - 20 = 80$ and $Q_s = 20 + 20 = 40$. Excess demand is $80 - 40 = 40$ units. The trap is quoting one quantity rather than the difference.", "w": ["20 is the equilibrium price (£20), not the shortage. The shortage is $Q_d - Q_s$ at £10.", "", "80 units is only quantity demanded at £10. You must subtract quantity supplied (40).", "60 units is the equilibrium quantity, not the gap between demand and supply at the cap."]}
{"id": "econ-333", "s": "micro", "t": "3.6.2", "lv": 2, "q": "In a market, $Q_d = 120 - 4P$ and $Q_s = 20 + 6P$ (P in £). The equilibrium price is £10. A minimum price of £12 is set. What results?", "o": ["A shortage of 20 units", "A surplus of 20 units", "A surplus of 92 units", "A surplus of 72 units"], "a": 1, "x": "At £12, $Q_d = 120 - 48 = 72$ and $Q_s = 20 + 72 = 92$. Supply exceeds demand by 20 units. The trap is reading off one quantity instead of the difference.", "w": ["A shortage needs demand above supply, which happens under a price ceiling. Here $Q_s > Q_d$.", "", "92 is the quantity supplied only. The surplus is $Q_s - Q_d$.", "72 is the quantity demanded only. The surplus is the gap between supply and demand."]}
{"id": "econ-334", "s": "micro", "t": "3.6.2", "lv": 2, "q": "With $Q_d = 120 - 4P$ and $Q_s = 20 + 6P$, a subsidy of £2 per unit is paid to producers. What price do consumers now pay? (Original equilibrium £10.)", "o": ["£8.00", "£10.80", "£8.80", "£10.00"], "a": 2, "x": "The subsidy changes supply to $Q_s = 20 + 6(P+2) = 32 + 6P$. Setting $120 - 4P = 32 + 6P$ gives $P = £8.80$. Consumers gain only £1.20 of the £2 subsidy.", "w": ["£8.00 assumes consumers get the whole £2 subsidy. The benefit is shared with producers.", "£10.80 is what producers receive per unit (£8.80 + £2), not the price consumers pay.", "", "£10 is the pre-subsidy price. A subsidy shifts supply right and lowers the market price."]}
{"id": "econ-335", "s": "micro", "t": "3.6.2", "lv": 2, "q": "In April 2026 the Low Pay Commission estimated that a single full-time worker on the £12.71 National Living Wage (up 4.1%) not on Universal Credit saw take-home pay rise by only 3.3%. Why the gap?", "o": ["Frozen tax thresholds take more of the higher pay in tax", "Firms cut the worker's hours by 0.8% after the rise", "Inflation reduced the nominal value of the wage paid", "A minimum wage above equilibrium always lowers take-home pay"], "a": 0, "x": "With tax thresholds frozen, a larger share of the pay rise goes in tax and deductions, so take-home pay rises by less than gross pay. The trap is blaming job loss or inflation.", "w": ["", "The estimate is for a full-time worker with unchanged hours; this invents an effect not in the stem.", "Inflation changes real, not nominal, pay. Take-home pay in £ is a nominal figure.", "A wage rise above equilibrium does not reduce a worker's pay in itself; the gap comes from tax."]}
{"id": "econ-336", "s": "micro", "t": "3.6.2", "lv": 3, "q": "Ofgem's default dual-fuel cap rose 4% to £1,723 per year for October to December 2026—as wholesale costs rose 11% to make up 47% of the cap—even after VAT on domestic electricity fell to 0%. What does this show?", "o": ["Price caps guarantee that household bills fall each period", "Price caps remove the need for competition in energy supply", "Energy supply is perfectly elastic, so caps have no effect", "A cost-linked cap cannot fully shield consumers from rising costs"], "a": 3, "x": "The cap is set to reflect supplier costs, so when wholesale costs rise the cap rises too. This limits its power to protect consumers. The trap is assuming a cap means a fixed or falling price.", "w": ["The cap rose by 4%, so bills did not fall. A cap limits the price but does not guarantee a fall.", "Nothing in the figures says competition is unnecessary; caps are a response to weak competition, not a substitute.", "Perfectly elastic supply is not implied. The cap rose because costs rose, so it still affects the price.", ""]}
{"id": "econ-d001", "s": "micro", "t": "1.1.4", "lv": 1, "q": "Which point on the diagram is unattainable with the economy's current resources and technology?", "o": ["Point A", "Point C", "Point B", "Both A and C"], "a": 1, "x": "Point C lies outside the PPF, so it needs more resources or better technology than the economy has. It cannot be produced at present.", "w": ["Point A is inside the PPF, so it is attainable but inefficient.", "", "Point B is on the PPF, so it is attainable and efficient.", "Point A is attainable, so it cannot be unattainable."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Consumer goods", "ylabel": "Capital goods", "lines": [{"pts": [[0, 6], [1.04, 5.91], [2.05, 5.64], [3, 5.2], [3.86, 4.6], [4.6, 3.86], [5.2, 3], [5.64, 2.05], [5.91, 1.04], [6, 0]], "label": "PPF", "c": 0}], "areas": [], "arrows": [], "points": [{"at": [2, 2], "label": "A"}, {"at": [4.6, 3.86], "label": "B"}, {"at": [6.5, 6.5], "label": "C"}]}}
{"id": "econ-d002", "s": "micro", "t": "1.1.4", "lv": 2, "q": "The straight-line PPF shows the economy moving from point A to point B. What is the opportunity cost of one extra consumer good?", "o": ["5 capital goods", "1.25 capital goods", "4 capital goods", "0.8 capital goods"], "a": 3, "x": "From A to B, consumer goods rise by 5 and capital goods fall by 4. The opportunity cost per consumer good is 4 ÷ 5 = 0.8 capital goods.", "w": ["5 is the gain in consumer goods, not the capital goods given up per unit.", "1.25 inverts the ratio; that is the cost of a capital good in consumer goods.", "4 is the total capital goods lost, not the cost per consumer good.", ""], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": true, "ynums": true, "ystep": 2, "xlabel": "Consumer goods", "ylabel": "Capital goods", "lines": [{"pts": [[0, 8], [10, 0]], "label": "PPF", "c": 0}], "areas": [], "arrows": [{"from": [0, 8], "to": [5, 4], "c": 2}], "points": [{"at": [0, 8], "label": "A"}, {"at": [5, 4], "label": "B"}, {"at": [10, 0], "label": "C"}]}}
{"id": "econ-d003", "s": "micro", "t": "1.1.4", "lv": 3, "q": "The PPF shifts from PPF1 to PPF2 (capital goods on the vertical axis). Which is the most likely cause?", "o": ["A fall in unemployment across the economy", "A rise in the labour force available to all industries", "Better technology used only in making capital goods", "Destruction of factories that make consumer goods"], "a": 2, "x": "The maximum capital output rises but the maximum consumer output is unchanged, so only capital goods production has become more productive.", "w": ["Lower unemployment moves the economy towards the PPF; it does not shift it.", "More labour for all industries would shift both axis intercepts outwards.", "", "Destroyed factories would shift the PPF inwards, not outwards."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Consumer goods", "ylabel": "Capital goods", "lines": [{"pts": [[0, 6], [1.04, 5.91], [2.05, 5.64], [3, 5.2], [3.86, 4.6], [4.6, 3.86], [5.2, 3], [5.64, 2.05], [5.91, 1.04], [6, 0]], "label": "PPF1", "c": 0, "dash": true}, {"pts": [[0, 8], [1.04, 7.88], [2.05, 7.52], [3, 6.93], [3.86, 6.13], [4.6, 5.14], [5.2, 4], [5.64, 2.74], [5.91, 1.39], [6, 0]], "label": "PPF2", "c": 1}], "areas": [], "arrows": [{"from": [0, 6], "to": [0, 8], "c": 2}], "points": []}}
{"id": "econ-d004", "s": "micro", "t": "1.2.1", "lv": 1, "q": "The firm faces MR and MC as drawn. At which labelled point is profit maximised?", "o": ["Point A, where MR is above MC", "Point X, where MR equals MC", "Point B, where output is highest", "Any of them, as MR is the same at each"], "a": 1, "x": "Profit is maximised where MR = MC, which is at X. At A, extra units still add to profit. At B, extra units add more to cost than to revenue.", "w": ["At A, MR exceeds MC, so producing more would still raise profit.", "", "At B, MC is above MR, so profit would be higher with less output.", "The same MR at each point is irrelevant; profit depends on the gap between MR and MC."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Output", "ylabel": "Costs and revenue (£)", "lines": [{"pts": [[0, 2], [10, 10]], "label": "MC", "c": 0}, {"pts": [[0, 6], [10, 6]], "label": "MR", "c": 1}], "areas": [], "arrows": [], "points": [{"at": [2, 6], "label": "A"}, {"at": [5, 6], "label": "X"}, {"at": [8, 6], "label": "B"}]}}
{"id": "econ-d005", "s": "micro", "t": "1.2.1", "lv": 2, "q": "The firm raises output from Q* to the highest level shown. Which area shows the profit it loses?", "o": ["Area A, because MR exceeds MC there", "Areas A and B together, as both involve MC", "Neither area, as MR stays positive so profit rises", "Area B, because those units cost more than they earn"], "a": 3, "x": "Beyond Q* the MC curve lies above MR. Area B is the sum of the excess of MC over MR on those units, so it is the profit lost.", "w": ["Area A is where MR exceeds MC, so it shows profit gained by expanding to Q*.", "Area A is a gain, so it cannot be added to the loss.", "Profit depends on MR compared with MC, not on MR being positive.", ""], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Output", "ylabel": "Costs and revenue (£)", "lines": [{"pts": [[0, 2], [10, 10]], "label": "MC", "c": 0}, {"pts": [[0, 6], [10, 6]], "label": "MR", "c": 1}], "areas": [{"pts": [[0, 2], [0, 6], [5, 6]], "label": "A", "c": 2, "at": [1.7, 4.8]}, {"pts": [[5, 6], [10, 6], [10, 10]], "label": "B", "c": 3, "at": [8.3, 7.2]}], "arrows": [], "points": [{"at": [5, 6], "label": "X", "guides": ["Q*"]}]}}
{"id": "econ-d006", "s": "micro", "t": "1.2.1", "lv": 3, "q": "MC1 shifts to MC2 and MR stays the same. What should a rational profit-maximising firm do?", "o": ["Cut output from Q1 to Q2, where MR now equals MC2", "Keep output at Q1, since the MR = MC rule is unchanged", "Raise output above Q1 to spread the higher costs", "Leave output alone, as MR has not moved"], "a": 0, "x": "The higher MC2 cuts MR at X2. Between Q2 and Q1, MC2 is above MR, so those units reduce profit. Output should therefore fall to Q2.", "w": ["", "At Q1 the firm would now have MC2 above MR, so staying there lowers profit.", "More output would add more cost than revenue because MC2 is above MR beyond Q2.", "The unchanged MR does not matter; the new MC changes where MR = MC."], "fig": {"type": "line", "x": [0, 10], "y": [0, 12], "grid": false, "xnums": false, "ynums": false, "xlabel": "Output", "ylabel": "Costs and revenue (£)", "lines": [{"pts": [[0, 2], [10, 10]], "label": "MC1", "c": 0, "dash": true}, {"pts": [[0, 6], [10, 6]], "label": "MR", "c": 1}, {"pts": [[0, 4], [10, 12]], "label": "MC2", "c": 2}], "areas": [], "arrows": [{"from": [1, 2.8], "to": [1, 4.8], "c": 2}], "points": [{"at": [5, 6], "label": "X1", "guides": ["Q1"]}, {"at": [2.5, 6], "label": "X2", "guides": ["Q2"]}]}}
{"id": "econ-d007", "s": "micro", "t": "1.2.2", "lv": 1, "q": "In the diagram, price falls from P1 to P2 and the market moves from point A to point B. What does this show?", "o": ["A contraction of demand along D1", "A rightward shift of the demand curve", "An extension of demand along D1", "A fall in demand at every price"], "a": 2, "x": "A fall in the good's own price causes a movement down the same curve, D1, from A to B. This is an extension of demand. The curve itself has not moved.", "w": ["A contraction needs a price rise and a movement up the curve.", "A shift would move the curve to a new position, but D1 stays put.", "", "Demand has not changed at any price; only the price and quantity have moved along D1."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price", "lines": [{"pts": [[1, 9], [9, 1]], "label": "D1", "c": 0}], "points": [{"at": [3, 7], "label": "A", "guides": ["Q1", "P1"]}, {"at": [6, 4], "label": "B", "guides": ["Q2", "P2"]}], "arrows": [{"from": [3, 7], "to": [6, 4], "c": 1}]}}
{"id": "econ-d008", "s": "micro", "t": "1.2.2", "lv": 2, "q": "The diagram shows demand moving from D1 to D2. Which event could explain this shift?", "o": ["A rise in the price of a complement to the good", "A fall in the good's own price", "A rise in the price of a substitute for the good", "A rise in real income, the good being normal"], "a": 0, "x": "D2 lies left of D1, so demand has fallen at every price. A dearer complement reduces demand for this good, shifting the curve left.", "w": ["", "A fall in own price moves along the curve rather than shifting it.", "A dearer substitute would raise demand, shifting the curve right.", "Higher income raises demand for a normal good, a rightward shift."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price", "lines": [{"pts": [[2, 8], [8, 2]], "label": "D1", "c": 0, "dash": true}, {"pts": [[0, 6], [6, 0]], "label": "D2", "c": 1}], "arrows": [{"from": [5, 5], "to": [3, 3], "c": 1}]}}
{"id": "econ-d009", "s": "micro", "t": "1.2.2", "lv": 3, "q": "Demand moves from D1 to D2 as shown. Which statement is correct about the good and the shift?", "o": ["Incomes fell and the good is normal, so a movement along D1 occurs", "Incomes rose and the good is normal, so demand shifted left", "Incomes fell and the good is inferior, so demand shifted left", "Incomes rose and the good is inferior, so demand shifted left"], "a": 3, "x": "D2 is left of D1, so demand fell at every price. Demand for an inferior good falls as income rises, so rising incomes fit this shift.", "w": ["Falling income would shift a normal good's demand left, but it is a shift, not a movement along D1.", "A rise in income raises demand for a normal good, so a left shift is inconsistent.", "Falling income raises demand for an inferior good, giving a right shift, not left.", ""], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price", "lines": [{"pts": [[1, 8], [8, 1]], "label": "D1", "c": 0, "dash": true}, {"pts": [[0, 6], [6, 0]], "label": "D2", "c": 1}], "points": [{"at": [4.5, 4.5], "label": "X"}], "arrows": [{"from": [4.5, 4.5], "to": [3, 3], "c": 1}]}}
{"id": "econ-d010", "s": "micro", "t": "1.2.3", "lv": 1, "q": "D1 and D2 both pass through point X. Which statement about demand at X is correct?", "o": ["D1 is more elastic because it is steeper", "Both are equally elastic because they cross at X", "D2 is more elastic because quantity responds more to price", "D2 is less elastic because it is flatter"], "a": 2, "x": "At the same price, a flatter curve shows a bigger change in quantity demanded for the same price change, so D2 is more price elastic than D1.", "w": ["A steeper curve means quantity responds less to price, so D1 is less elastic.", "Crossing at X gives the same price and quantity, but the responsiveness differs with slope.", "", "Flatter means more responsive quantity, so D2 is more elastic, not less."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price", "lines": [{"pts": [[4, 8], [6, 2]], "label": "D1", "c": 0}, {"pts": [[1, 7], [9, 3]], "label": "D2", "c": 1}], "areas": [], "arrows": [], "points": [{"at": [5, 5], "label": "X"}]}}
{"id": "econ-d011", "s": "micro", "t": "1.2.3", "lv": 2, "q": "Price falls from £8 at point A to £6 at point B along D. What is PED between A and B, and what happens to revenue?", "o": ["−4; revenue rises from £16 to £24", "−0.25; revenue rises from £16 to £24", "−4; revenue falls from £24 to £16", "−0.25; revenue falls from £24 to £16"], "a": 0, "x": "From the graph, quantity is 2 at A and 4 at B. %ΔP = −2 ÷ 8 × 100 = −25%. %ΔQd = +2 ÷ 2 × 100 = +100%. PED = 100 ÷ −25 = −4, so demand is elastic. Revenue rises from £8 × 2 = £16 to £6 × 4 = £24.", "w": ["", "The ratio is inverted: PED is %ΔQd ÷ %ΔP, which is −4, not −0.25.", "Revenue is £16 at A and £24 at B, so it rises; with elastic demand a price cut raises revenue.", "The ratio is inverted, and revenue rises from £16 to £24 rather than falling."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": true, "xnums": true, "ynums": true, "ystep": 2, "xlabel": "Quantity", "ylabel": "Price (£)", "lines": [{"pts": [[0, 10], [10, 0]], "label": "D", "c": 0}], "areas": [], "arrows": [{"from": [2, 8], "to": [4, 6], "c": 3}], "points": [{"at": [2, 8], "label": "A"}, {"at": [4, 6], "label": "B"}]}}
{"id": "econ-d012", "s": "micro", "t": "1.2.3", "lv": 3, "q": "The price of good B rises by 20%, shifting demand for good A from D1 to D2 at price £5. What is XED, and what is the relationship?", "o": ["+0.5; substitutes", "−2.0; complements", "+2.0; complements", "+2.0; substitutes"], "a": 3, "x": "At £5, quantity of A rises from 5 to 7, which is +40%. XED = +40 ÷ +20 = +2.0. A positive value means the goods are substitutes.", "w": ["The ratio is inverted: it is %ΔQ of A ÷ %ΔP of B, which is 2.0, not 0.5.", "Demand for A rises, so the sign is positive, not negative.", "The value is right, but a positive XED shows substitutes, not complements.", ""], "fig": {"type": "line", "x": [0, 10], "y": [0, 12], "grid": false, "xnums": true, "ynums": true, "ystep": 2, "xlabel": "Quantity of good A", "ylabel": "Price of good A (£)", "lines": [{"pts": [[0, 10], [10, 0]], "label": "D1", "c": 0}, {"pts": [[0, 12], [10, 2]], "label": "D2", "c": 1}], "areas": [], "arrows": [{"from": [5, 5], "to": [7, 5], "c": 3}], "points": [{"at": [5, 5], "label": "X", "guides": ["Q1"]}, {"at": [7, 5], "label": "Y", "guides": ["Q2"]}]}}
{"id": "econ-d013", "s": "micro", "t": "1.2.4", "lv": 1, "q": "The diagram shows a move from A to B. What does it show?", "o": ["A decrease in supply", "An extension of supply", "An increase in supply", "A contraction of supply"], "a": 1, "x": "A and B both lie on S1, and the price is higher at B. A rise in the good's own price causes an extension of supply along the curve.", "w": ["A decrease in supply is a leftward shift of the curve, not a movement along it.", "", "An increase in supply is a rightward shift, but the curve S1 has not moved.", "A contraction is a movement down the curve to a lower price, but B has a higher price."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price", "lines": [{"pts": [[0, 1], [10, 9]], "label": "S1", "c": 0}], "areas": [], "arrows": [{"from": [3, 3.4], "to": [7, 6.6], "c": 1}], "points": [{"at": [3, 3.4], "label": "A", "guides": ["Q1", "P1"]}, {"at": [7, 6.6], "label": "B", "guides": ["Q2", "P2"]}]}}
{"id": "econ-d014", "s": "micro", "t": "1.2.4", "lv": 2, "q": "Supply moves from S1 to S2. Which change could have caused this?", "o": ["A fall in the good's own price", "A subsidy paid to producers", "An improvement in technology", "A rise in wage costs for firms"], "a": 3, "x": "S2 lies to the left of S1, so supply has decreased. Higher costs of production, such as wages, reduce the quantity firms supply at every price.", "w": ["A change in own price moves along the curve rather than shifting it.", "A subsidy lowers costs and would shift supply right, not left.", "Better technology lowers costs and shifts supply right.", ""], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price", "lines": [{"pts": [[0, 1], [10, 9]], "label": "S1", "c": 0}, {"pts": [[0, 3.4], [7, 9]], "label": "S2", "c": 1}], "areas": [], "arrows": [{"from": [6, 5.8], "to": [3, 5.8], "c": 1}], "points": []}}
{"id": "econ-d015", "s": "micro", "t": "1.2.4", "lv": 3, "q": "The market moves from E1 to E2. Which best describes the change shown?", "o": ["Supply increases; price falls, quantity rises", "Decrease in supply; price rises, quantity falls", "Extension of supply along S1; price falls", "Contraction of demand along D; price rises"], "a": 0, "x": "S2 is to the right of S1 with D unchanged. Supply has increased, so the equilibrium moves from E1 to E2 with a lower price and higher quantity.", "w": ["", "A decrease in supply would shift the curve left, raising price and cutting quantity.", "An extension along S1 needs a higher price, but the supply curve has actually shifted.", "D has not moved, and price falls from E1 to E2, so this is wrong."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price", "lines": [{"pts": [[0, 10], [10, 0]], "label": "D", "c": 3}, {"pts": [[0, 1], [10, 9]], "label": "S1", "c": 0}, {"pts": [[1, 0], [10, 7.2]], "label": "S2", "c": 1}], "areas": [], "arrows": [], "points": [{"at": [5, 5], "label": "E1", "guides": ["Q1", "P1"]}, {"at": [6, 4], "label": "E2", "guides": ["Q2", "P2"]}]}}
{"id": "econ-d016", "s": "micro", "t": "1.2.5", "lv": 1, "q": "Which supply curve has a PES of exactly 1 at every point?", "o": ["S1 only", "S2 only", "S3 only", "All three curves"], "a": 2, "x": "A straight supply curve through the origin has PES of 1 at every point, because price and quantity change by equal percentages. S3 is the only curve drawn from the origin.", "w": ["S1 cuts the price axis above zero, so its PES is greater than 1 everywhere.", "S2 cuts the quantity axis, so its PES is less than 1 everywhere.", "", "Only the curve through the origin is unit elastic; S1 is elastic and S2 is inelastic."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price", "lines": [{"pts": [[0, 2], [8, 8.4]], "label": "S1", "c": 0}, {"pts": [[2, 0], [10, 8]], "label": "S2", "c": 1}, {"pts": [[0, 0], [9, 9]], "label": "S3", "c": 2}]}}
{"id": "econ-d017", "s": "micro", "t": "1.2.5", "lv": 2, "q": "Demand shifts from D1 to D2. Which statement about the supply curves S1 and S2 is correct?", "o": ["S2 is more elastic: price rises less and quantity rises more than on S1", "S1 is more elastic: quantity rises more than on S2", "S2 is less elastic: price rises further than on S1", "Both have equal elasticity; only the demand shift matters"], "a": 0, "x": "S2 is flatter, so it is more elastic. The new equilibrium B has a lower price and higher quantity than A on S1, so firms respond more to the price signal.", "w": ["", "S1 is steeper, so it is less elastic, and quantity rises less at A than at B.", "S2 is the flatter curve, so it is more elastic and the price rise is smaller.", "Different slopes mean different elasticity, so the outcomes at A and B differ."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price", "lines": [{"pts": [[0, 10], [10, 0]], "label": "D1", "c": 0}, {"pts": [[3, 10], [10, 3]], "label": "D2", "c": 0, "dash": true}, {"pts": [[3, 1], [7, 9]], "label": "S1", "c": 1}, {"pts": [[1, 3], [9, 7]], "label": "S2", "c": 2}], "points": [{"at": [5, 5], "label": "E"}, {"at": [6, 7], "label": "A"}, {"at": [7, 6], "label": "B"}]}}
{"id": "econ-d018", "s": "micro", "t": "1.2.5", "lv": 3, "q": "Using the axes, what is PES for the price rise from A to B on supply curve S?", "o": ["0.5, because price rises 25% while quantity rises 50%", "1.25, from dividing the new price by the old price", "20, from the change in quantity over the change in price", "2, because quantity rises 50% while price rises 25%"], "a": 3, "x": "Price rises from £4 to £5, which is 25%. Quantity rises from 40 to 60, which is 50%. PES = 50 ÷ 25 = 2, so supply is elastic.", "w": ["This inverts the formula, putting the price change on top.", "This is only the ratio of the two prices, not of percentage changes.", "This uses absolute changes, not percentages, and so ignores the starting values.", ""], "fig": {"type": "line", "x": [0, 100], "y": [0, 10], "grid": false, "xnums": true, "ynums": true, "ystep": 1, "xlabel": "Quantity (units)", "ylabel": "Price (£)", "lines": [{"pts": [[0, 2], [100, 7]], "label": "S", "c": 1}], "points": [{"at": [40, 4], "label": "A"}, {"at": [60, 5], "label": "B"}]}}
{"id": "econ-d019", "s": "micro", "t": "1.2.6", "lv": 1, "q": "In the diagram, the price is fixed at P2. What is the market situation at P2?", "o": ["Excess demand, so price will rise", "Excess supply, so the supply curve shifts left", "Excess supply, so price will fall towards P1", "The market clears at P2"], "a": 2, "x": "At P2 quantity supplied (Qs) exceeds quantity demanded (Qd), giving excess supply. Sellers cut price, moving along both curves back to equilibrium at E.", "w": ["Excess demand arises below the equilibrium price, where Qd exceeds Qs, not above it.", "The price change is a movement along curves; the supply curve does not shift.", "", "Only at P1 do Qd and Qs match; at P2 they differ."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price", "lines": [{"pts": [[1, 9], [9, 1]], "label": "D", "c": 0}, {"pts": [[1, 1], [9, 9]], "label": "S", "c": 1}], "areas": [], "arrows": [{"from": [2, 8], "to": [8, 8], "c": 2}], "points": [{"at": [2, 8], "label": "A", "guides": ["Qd", "P2"]}, {"at": [8, 8], "label": "B", "guides": ["Qs", "P2"]}, {"at": [5, 5], "label": "E", "guides": ["Q1", "P1"]}]}}
{"id": "econ-d020", "s": "micro", "t": "1.2.6", "lv": 2, "q": "The market moves from E1 to E2. Which change could explain this move?", "o": ["A rise in consumers' incomes", "A new tax on producers", "A fall in the cost of raw materials", "A fall in the price of a substitute"], "a": 0, "x": "Demand shifts right from D1 to D2, raising price and quantity. A rise in income increases demand for a normal good at every price.", "w": ["", "A tax shifts supply left, not demand right, and would raise price but lower quantity.", "Lower costs shift supply right, which would lower the price.", "A cheaper substitute would shift demand left, not right."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity of a normal good", "ylabel": "Price", "lines": [{"pts": [[1, 9], [9, 1]], "label": "D1", "c": 0, "dash": true}, {"pts": [[2, 10], [10, 2]], "label": "D2", "c": 2}, {"pts": [[0, 0], [10, 10]], "label": "S", "c": 1}], "areas": [], "arrows": [], "points": [{"at": [5, 5], "label": "E1", "guides": ["Q1", "P1"]}, {"at": [6, 6], "label": "E2", "guides": ["Q2", "P2"]}]}}
{"id": "econ-d021", "s": "micro", "t": "1.2.6", "lv": 3, "q": "Demand shifts from D1 to D2 and supply from S1 to S2. What is true of E2 compared with E1?", "o": ["Price is lower and quantity is higher", "Price and quantity are both higher", "Price is higher and quantity is lower", "Price is unchanged and quantity is higher"], "a": 1, "x": "Both curves shift right, so quantity rises. The demand shift is larger than the supply shift, so price is pushed up as well. E2 lies above and right of E1.", "w": ["A price fall would need the supply shift to be larger than the demand shift.", "", "Quantity rises when both curves shift right; it cannot fall.", "Price would be unchanged only if the two shifts happened to offset each other; here P2 is above P1."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price", "lines": [{"pts": [[1, 9], [9, 1]], "label": "D1", "c": 0, "dash": true}, {"pts": [[4, 10], [10, 4]], "label": "D2", "c": 0}, {"pts": [[0, 0], [10, 10]], "label": "S1", "c": 1, "dash": true}, {"pts": [[1, 0], [10, 9]], "label": "S2", "c": 2}], "areas": [], "arrows": [], "points": [{"at": [5, 5], "label": "E1", "guides": ["Q1", "P1"]}, {"at": [7.5, 6.5], "label": "E2", "guides": ["Q2", "P2"]}]}}
{"id": "econ-d022", "s": "micro", "t": "1.2.7", "lv": 1, "q": "In the diagram, the market moves from A to B. What caused this?", "o": ["A rise in supply, shown by a rightward shift of S", "A rise in demand, shown by the shift from D1 to D2", "A fall in demand, shown by the shift from D2 to D1", "A fall in costs, shown by a movement along S"], "a": 1, "x": "The demand curve has shifted right from D1 to D2. Equilibrium moves up along S from A to B, so price and quantity both rise.", "w": ["S has not moved; the supply curve is unchanged in the diagram.", "", "D2 lies to the right of D1, so demand has risen, not fallen.", "A cost fall would shift S, and would lower price rather than raise it."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price", "lines": [{"pts": [[1, 9], [9, 1]], "label": "D1", "c": 0, "dash": true}, {"pts": [[4, 10], [10, 4]], "label": "D2", "c": 0}, {"pts": [[1, 1], [9, 9]], "label": "S", "c": 1}], "areas": [], "arrows": [], "points": [{"at": [5, 5], "label": "A", "guides": ["Q1", "P1"]}, {"at": [7, 7], "label": "B", "guides": ["Q2", "P2"]}]}}
{"id": "econ-d023", "s": "micro", "t": "1.2.7", "lv": 2, "q": "After demand shifts to D2, what does the diagram show at price P1, between points X and Y, and what follows?", "o": ["Excess supply, so price falls until the surplus goods are all cleared", "Equilibrium, so price stays at P1 as the market already clears", "Excess demand, so price rises, rationing buyers and signalling firms", "Excess demand, so price falls and firms are signalled to cut output"], "a": 2, "x": "At P1 quantity demanded on D2 (Q2) exceeds quantity supplied on S (Q1), so there is excess demand. Price rises, rationing the good to buyers willing and able to pay. The higher price also signals to firms, and gives them the incentive, to supply more.", "w": ["Quantity demanded (Q2) is greater than quantity supplied (Q1) at P1, so there is no surplus.", "Equilibrium needs D2 and S to meet; at P1 they do not, so the market does not clear.", "", "Excess demand pushes price up, not down, and the higher price signals firms to expand output."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price", "lines": [{"pts": [[1, 9], [9, 1]], "label": "D1", "c": 0, "dash": true}, {"pts": [[4, 10], [10, 4]], "label": "D2", "c": 0}, {"pts": [[1, 1], [9, 9]], "label": "S", "c": 1}], "areas": [], "arrows": [], "points": [{"at": [5, 5], "label": "X", "guides": ["Q1", "P1"]}, {"at": [9, 5], "label": "Y", "guides": ["Q2", "P1"]}]}}
{"id": "econ-d024", "s": "micro", "t": "1.2.7", "lv": 3, "q": "Supply shifts from S1 to S2 and the market moves from A to B. Which statement about the price mechanism is correct?", "o": ["Quantity demanded rises to Q2 because the price has risen to P2", "Demand has shifted left, which is why price is higher at B", "Price falls to P2, signalling firms to leave the market", "Price rises to P2, rationing buyers as quantity demanded contracts to Q2"], "a": 3, "x": "The fall in supply raises price from P1 to P2. Along D, quantity demanded contracts from Q1 to Q2, so the higher price rations the scarcer good to those willing and able to pay.", "w": ["A higher price reduces quantity demanded along D; it does not raise it.", "D has not moved; only S has shifted, to S2.", "P2 is above P1, so price has risen, not fallen.", ""], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price", "lines": [{"pts": [[1, 9], [9, 1]], "label": "D", "c": 0}, {"pts": [[1, 1], [9, 9]], "label": "S1", "c": 1, "dash": true}, {"pts": [[0, 4], [6, 10]], "label": "S2", "c": 1}], "areas": [], "arrows": [], "points": [{"at": [5, 5], "label": "A", "guides": ["Q1", "P1"]}, {"at": [3, 7], "label": "B", "guides": ["Q2", "P2"]}]}}
{"id": "econ-d025", "s": "micro", "t": "1.2.8", "lv": 1, "q": "In the diagram, which area shows producer surplus at the equilibrium price P1?", "o": ["Area A", "The area below S up to Q1", "Areas A and B combined", "Area B"], "a": 3, "x": "Producer surplus is above the supply curve and below the price, up to the quantity traded. That is the triangle B between S and P1.", "w": ["Area A is above the price and below D, so it is consumer surplus.", "The area below S shows the minimum price producers accept, not their surplus.", "Areas A and B together show total surplus, not producer surplus alone.", ""], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price", "lines": [{"pts": [[0, 10], [10, 0]], "label": "D", "c": 0}, {"pts": [[0, 2], [8, 10]], "label": "S", "c": 1}], "areas": [{"pts": [[0, 10], [0, 6], [4, 6]], "label": "A", "c": 0, "at": [0.8, 7.3]}, {"pts": [[0, 6], [0, 2], [4, 6]], "label": "B", "c": 1, "at": [0.8, 4.6]}], "arrows": [], "points": [{"at": [4, 6], "label": "E", "guides": ["Q1", "P1"]}]}}
{"id": "econ-d026", "s": "micro", "t": "1.2.8", "lv": 2, "q": "Demand rises from D1 to D2. What does area Y show?", "o": ["The increase in consumer surplus as the price rises to P2", "The rise in producer surplus as demand shifts to D2", "The fall in consumer surplus caused by the higher price", "Total surplus at the new equilibrium E2"], "a": 1, "x": "Y lies between the old price P1 and new price P2, above S. It is the extra producer surplus from the higher price and extra output.", "w": ["", "", "", ""], "fig": {"type": "line", "x": [0, 12], "y": [0, 14], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price", "lines": [{"pts": [[0, 10], [10, 0]], "label": "D1", "c": 0}, {"pts": [[0, 14], [12, 2]], "label": "D2", "c": 2, "dash": true}, {"pts": [[0, 2], [12, 14]], "label": "S", "c": 1}], "areas": [{"pts": [[0, 6], [4, 6], [6, 8], [0, 8]], "label": "Y", "c": 3, "at": [1.5, 7]}], "arrows": [], "points": [{"at": [4, 6], "label": "E1", "guides": ["Q1", "P1"]}, {"at": [6, 8], "label": "E2", "guides": ["Q2", "P2"]}]}}
{"id": "econ-d027", "s": "micro", "t": "1.2.8", "lv": 3, "q": "A minimum price Pmin above equilibrium cuts quantity traded to Q2. Which statement about total surplus is correct?", "o": ["Total surplus falls by areas A and C together", "Total surplus is unchanged because C is a transfer to producers", "Total surplus falls by area C, surplus on units no longer traded", "Producer surplus rises by area C as the price is higher"], "a": 2, "x": "Units between Q2 and Q1 are no longer traded, so the surplus on them, area C, is lost to everyone. This is a deadweight loss.", "w": ["", "", "", ""], "fig": {"type": "line", "x": [0, 12], "y": [0, 12], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price", "lines": [{"pts": [[0, 10], [10, 0]], "label": "D", "c": 0}, {"pts": [[0, 2], [10, 12]], "label": "S", "c": 1}, {"pts": [[0, 8], [12, 8]], "label": "Pmin", "c": 2, "dash": true}], "areas": [{"pts": [[0, 10], [0, 8], [2, 8]], "label": "A", "c": 0, "at": [0.4, 8.8]}, {"pts": [[0, 2], [0, 8], [2, 8], [2, 4]], "label": "B", "c": 1, "at": [0.9, 5.5]}, {"pts": [[2, 8], [4, 6], [2, 4]], "label": "C", "c": 3, "at": [2.5, 6]}], "arrows": [], "points": [{"at": [2, 8], "guides": ["Q2", "P2"]}, {"at": [4, 6], "label": "E", "guides": ["Q1", "P1"]}]}}
{"id": "econ-d028", "s": "micro", "t": "1.2.9", "lv": 1, "q": "The diagram shows a per-unit tax shifting supply from S1 to S2. Which area is the deadweight loss?", "o": ["Area A", "Area C", "Area B", "Areas A and B together"], "a": 1, "x": "Deadweight loss is the triangle C between the two supply curves, over the units no longer traded between the old and new quantity.", "w": ["Area A is the consumer burden, a transfer to the government rather than a lost transaction.", "", "Area B is the producer burden, which is part of tax revenue, not lost surplus.", "Areas A and B together are tax revenue, which the government collects. It is not lost."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "xlabel": "Quantity", "ylabel": "Price (£)", "grid": false, "xnums": false, "ynums": false, "lines": [{"pts": [[0, 10], [10, 0]], "label": "D", "c": 0}, {"pts": [[0, 0], [10, 10]], "label": "S1", "c": 1}, {"pts": [[0, 2], [8, 10]], "label": "S2", "c": 2}], "areas": [{"pts": [[0, 5], [4, 5], [4, 6], [0, 6]], "label": "A", "c": 0, "at": [2, 5.5]}, {"pts": [[0, 4], [4, 4], [4, 5], [0, 5]], "label": "B", "c": 3, "at": [2, 4.5]}, {"pts": [[4, 4], [4, 6], [5, 5]], "label": "C", "c": 2, "at": [4.3, 5]}], "arrows": [], "points": []}}
{"id": "econ-d029", "s": "micro", "t": "1.2.9", "lv": 2, "q": "The diagram shows a subsidy shifting supply from S1 to S2. Read the values and find the government's spending on the subsidy.", "o": ["£8", "£5", "£12", "£10"], "a": 3, "x": "The gap between S1 and S2 is £2 per unit. New quantity at E2 is 5 units, so spending is £2 × 5 = £10.", "w": ["This uses the old quantity of 4, but the subsidy is paid on all 5 units now sold.", "This is the £1 price fall times 5, the consumers' gain, not the total cost of the subsidy.", "This multiplies the subsidy by the old price of £6, which is not a quantity.", ""], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "xlabel": "Quantity (units)", "ylabel": "Price (£)", "grid": false, "xnums": true, "ynums": true, "ystep": 1, "lines": [{"pts": [[0, 10], [10, 0]], "label": "D", "c": 0}, {"pts": [[0, 2], [8, 10]], "label": "S1", "c": 1, "dash": true}, {"pts": [[0, 0], [10, 10]], "label": "S2", "c": 2}], "areas": [], "arrows": [], "points": [{"at": [4, 6], "label": "E1"}, {"at": [5, 5], "label": "E2"}]}}
{"id": "econ-d030", "s": "micro", "t": "1.2.9", "lv": 3, "q": "The diagram shows a tax shifting supply from S1 to S2. Read the values. What is the burden on consumers and on producers?", "o": ["Consumers £6, producers £3", "Consumers £3, producers £6", "Consumers £4, producers £5", "Consumers £2, producers £1"], "a": 0, "x": "The tax is £3 per unit. Price rises from £4 to £6, so consumers bear £2 × 3 = £6. Producers bear £1 × 3 = £3.", "w": ["", "This reverses the shares. Consumers bear the larger part because the price rose £2 of the £3 tax.", "These figures do not match the price change of £2 or the new quantity of 3 units.", "These are the per-unit amounts. Multiply by the new quantity of 3 units to get the burdens."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "xlabel": "Quantity (units)", "ylabel": "Price (£)", "grid": false, "xnums": true, "ynums": true, "ystep": 1, "lines": [{"pts": [[1, 10], [6, 0]], "label": "D", "c": 0}, {"pts": [[0, 0], [10, 10]], "label": "S1", "c": 1, "dash": true}, {"pts": [[0, 3], [7, 10]], "label": "S2", "c": 2}], "areas": [], "arrows": [], "points": [{"at": [4, 4], "label": "E1"}, {"at": [3, 6], "label": "E2"}]}}
{"id": "econ-d031", "s": "micro", "t": "1.3.1", "lv": 1, "q": "The figure shows a market with a negative externality of production. At which point does the free market operate?", "o": ["Point Y, where D meets MSC", "Point X, where D meets MPC", "The point where MSC meets the vertical axis", "Point Y, because MSC is above MPC"], "a": 1, "x": "The free market ignores external costs, so it produces where demand (MPB) meets MPC. That is point X, at a higher quantity than the social optimum.", "w": ["Point Y is the socially optimal output, not where the free market operates.", "", "The vertical intercept of MSC is not a market equilibrium.", "MSC lies above MPC, but the firm decides using MPC, so Y is not chosen."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price / cost", "lines": [{"pts": [[0, 10], [10, 0]], "label": "D = MPB = MSB", "c": 0}, {"pts": [[0, 0], [10, 10]], "label": "MPC", "c": 1}, {"pts": [[0, 2], [8, 10]], "label": "MSC", "c": 2}], "areas": [], "arrows": [], "points": [{"at": [5, 5], "label": "X"}, {"at": [4, 6], "label": "Y"}]}}
{"id": "econ-d032", "s": "micro", "t": "1.3.1", "lv": 2, "q": "The figure shows a positive externality of consumption. What does area W represent?", "o": ["Extra profit to firms from producing the units beyond Q1", "Total external benefit enjoyed by third parties at Q1", "Gain to consumers from paying the market price P1", "Welfare loss as MSB exceeds MC between Q1 and Q2"], "a": 3, "x": "Between Q1 and Q2 the marginal social benefit is above marginal cost, but the market does not produce those units. Area W is the net benefit lost to society.", "w": ["The market does not produce beyond Q1, and the triangle shows a social loss, not profit.", "Total external benefit up to Q1 is the whole area between MSB and MPB from 0 to Q1, not this triangle.", "Consumer gain at price P1 is the area below MPB and above P1, not this triangle.", ""], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price / cost / benefit", "lines": [{"pts": [[0, 10], [10, 0]], "label": "MPB", "c": 0}, {"pts": [[0, 0], [10, 10]], "label": "MC", "c": 1}, {"pts": [[2, 10], [10, 2]], "label": "MSB", "c": 2}], "areas": [{"pts": [[5, 5], [6, 6], [5, 7]], "label": "W", "c": 3, "at": [5.3, 6]}], "arrows": [], "points": [{"at": [5, 5], "guides": ["Q1", "P1"]}, {"at": [6, 6], "guides": ["Q2", "P2"]}]}}
{"id": "econ-d033", "s": "micro", "t": "1.3.1", "lv": 3, "q": "The figure shows a market with a negative externality. A tax equal to the marginal external cost is imposed on producers. What are the new price and quantity?", "o": ["Price rises from £5 to £6 and quantity falls from 5 to 4 units", "Price rises from £5 to £7 and quantity falls from 5 to 4 units", "Price stays at £5 and quantity falls from 5 to 4 units", "Price rises from £5 to £6 and quantity stays at 5 units"], "a": 0, "x": "The external cost is £2 (the gap between MSC and MPC). The tax shifts supply up to MSC, which meets D at 4 units and £6.", "w": ["", "£7 is the height of MSC at 5 units; the new equilibrium price is where MSC meets D, £6.", "The tax raises the price paid by consumers, so price cannot stay at £5.", "The higher price reduces quantity demanded, so quantity must fall below 5."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": true, "ynums": true, "ystep": 1, "xlabel": "Quantity (units)", "ylabel": "Price / cost (£)", "lines": [{"pts": [[0, 10], [10, 0]], "label": "D = MPB = MSB", "c": 0}, {"pts": [[0, 0], [10, 10]], "label": "MPC", "c": 1}, {"pts": [[0, 2], [8, 10]], "label": "MSC", "c": 2}], "areas": [], "arrows": [], "points": [{"at": [5, 5], "label": "X"}]}}
{"id": "econ-d034", "s": "micro", "t": "1.3.2", "lv": 1, "q": "The diagram shows a good with a negative production externality. At which point does the free market operate, and why?", "o": ["Point Y, where MPB = MPC", "Point X, where MPB = MPC", "Point X, where MSB = MSC", "Point Y, where MPB = MSC"], "a": 1, "x": "Firms and consumers ignore the external cost, so the market settles where private benefit equals private cost. That is where MPB crosses MPC, at point X.", "w": ["Y is on MSC, so it is the social optimum, not where MPB meets MPC.", "", "MSB = MSC is the social optimum, which is at Y, not the market outcome.", "Y is the social optimum; the market ignores MSC and uses MPC."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price / cost", "lines": [{"pts": [[0, 10], [10, 0]], "label": "MPB", "c": 0}, {"pts": [[0, 2], [8, 10]], "label": "MPC", "c": 1}, {"pts": [[0, 4], [6, 10]], "label": "MSC", "c": 2}], "areas": [], "arrows": [], "points": [{"at": [4, 6], "label": "X"}, {"at": [3, 7], "label": "Y"}]}}
{"id": "econ-d035", "s": "micro", "t": "1.3.2", "lv": 2, "q": "The diagram shows a positive consumption externality. Which statement correctly identifies the welfare gain from moving from Q1 to the social optimum Q2?", "o": ["Area B, the external benefit at Q1", "Areas A and B together", "The area under MPC from Q1 to Q2", "Area A, between MSB and MPC"], "a": 3, "x": "Between Q1 and Q2 each extra unit gives more social benefit (MSB) than it costs (MPC). The gain is the triangle A between those curves.", "w": ["B is the total external benefit up to Q1, not the gain from extra output.", "Area B lies to the left of Q1 and is already enjoyed at the market output.", "The area under MPC is a cost, not a net gain.", ""], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price / cost", "lines": [{"pts": [[0, 8], [8, 0]], "label": "MPB", "c": 0}, {"pts": [[0, 2], [8, 10]], "label": "MPC = MSC", "c": 1}, {"pts": [[0, 10], [10, 0]], "label": "MSB", "c": 3}], "areas": [{"pts": [[3, 5], [3, 7], [4, 6]], "label": "A", "c": 2, "at": [3.3, 6]}, {"pts": [[0, 8], [0, 10], [3, 7], [3, 5]], "label": "B", "c": 2, "at": [1, 7.5]}], "arrows": [], "points": [{"at": [3, 5], "label": "", "guides": ["Q1", "P1"]}, {"at": [4, 6], "label": "", "guides": ["Q2", "P2"]}]}}
{"id": "econ-d036", "s": "micro", "t": "1.3.2", "lv": 3, "q": "A tax equal to the external cost per unit is placed on this good. Reading the diagram, what is the new market output and the welfare loss eliminated?", "o": ["3 units and £1", "4 units and £1", "3 units and £2", "4 units and £2"], "a": 0, "x": "The external cost is £2 per unit (MSC minus MPC), so the tax moves output to Y at 3 units. The loss removed is ½ × £2 × 1 unit = £1.", "w": ["", "The tax cuts output from 4 units to 3, so 4 units is the old output.", "This forgets the half in the triangle area; ½ × 2 × 1 = £1.", "Output falls to 3 units and the triangle area is £1, not £2."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": true, "ynums": true, "ystep": 2, "xlabel": "Quantity (units)", "ylabel": "Price / cost (£)", "lines": [{"pts": [[0, 10], [10, 0]], "label": "MPB", "c": 0}, {"pts": [[0, 2], [8, 10]], "label": "MPC", "c": 1}, {"pts": [[0, 4], [6, 10]], "label": "MSC", "c": 2}], "areas": [], "arrows": [], "points": [{"at": [4, 6], "label": "X"}, {"at": [3, 7], "label": "Y"}]}}
{"id": "econ-d037", "s": "micro", "t": "1.3.4", "lv": 1, "q": "Consumers wrongly believe the good is more beneficial than it is. D1 shows their perceived benefit and D2 the true benefit. Which point shows the output the market produces?", "o": ["Point Y", "Point X", "Point Z", "Point Y or Z, depending on price"], "a": 1, "x": "The market follows what consumers believe, so it settles where S meets D1. That is point X, which is to the right of the efficient output at Y.", "w": ["Y is where S meets D2, the socially efficient output, not what the market produces.", "", "Z lies on D2 but not on S, so it is not a market equilibrium.", "The market equilibrium is fixed where S meets D1, so there is no choice between points."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price and benefit", "lines": [{"pts": [[0, 0], [10, 10]], "label": "S", "c": 0}, {"pts": [[0, 10], [10, 0]], "label": "D1", "c": 1}, {"pts": [[0, 8], [8, 0]], "label": "D2", "c": 2, "dash": true}], "areas": [], "arrows": [], "points": [{"at": [4, 4], "label": "Y"}, {"at": [5, 5], "label": "X"}, {"at": [5, 3], "label": "Z"}]}}
{"id": "econ-d038", "s": "micro", "t": "1.3.4", "lv": 2, "q": "In the diagram, D1 is perceived benefit and D2 is true benefit. Which area shows the welfare loss from the information gap?", "o": ["Area B only", "Areas A and B together", "Neither, because consumers chose freely", "Area A only"], "a": 3, "x": "The loss is on units between Y and X, where the true benefit on D2 is below the cost on S. That is triangle A. Area B lies to the left of Y, where units are worth producing, so it is not a loss.", "w": ["B covers units below the efficient output, where benefit exceeds cost, so it is not a loss.", "B is not a loss, so adding it to A is wrong.", "Wrong beliefs push output past Y, so a loss arises even though choices were free.", ""], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price and benefit", "lines": [{"pts": [[0, 0], [10, 10]], "label": "S", "c": 0}, {"pts": [[0, 10], [10, 0]], "label": "D1", "c": 1}, {"pts": [[0, 8], [8, 0]], "label": "D2", "c": 2, "dash": true}], "areas": [{"pts": [[4, 4], [5, 5], [5, 3]], "label": "A", "c": 3, "at": [4.8, 4]}, {"pts": [[0, 4], [0, 8], [4, 4]], "label": "B", "c": 2, "at": [1.2, 5.3]}], "arrows": [], "points": [{"at": [5, 5], "label": "X"}, {"at": [4, 4], "label": "Y"}]}}
{"id": "econ-d039", "s": "micro", "t": "1.3.4", "lv": 3, "q": "An information campaign leads consumers to see the true benefit. Which change in the diagram follows?", "o": ["D1 shifts left to D2, so price and quantity fall to Y", "S shifts left, so price rises and quantity falls to Y", "D2 shifts right to D1, so price and quantity rise to X", "D1 shifts left to D2, so price falls but quantity stays at X"], "a": 0, "x": "Once consumers see the true benefit, their demand moves from D1 to D2. It cuts the market's price and quantity to Y, where S meets D2, removing the welfare loss.", "w": ["", "", "", ""], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price and benefit", "lines": [{"pts": [[0, 0], [10, 10]], "label": "S", "c": 0}, {"pts": [[0, 10], [10, 0]], "label": "D1", "c": 1}, {"pts": [[0, 8], [8, 0]], "label": "D2", "c": 2, "dash": true}], "areas": [], "arrows": [], "points": [{"at": [5, 5], "label": "X"}, {"at": [4, 4], "label": "Y"}]}}
{"id": "econ-d040", "s": "micro", "t": "1.4.1", "lv": 1, "q": "The diagram shows supply shifting from S1 to S2 by the same amount at every quantity. Which is the most likely cause?", "o": ["A subsidy paid to producers per unit", "A rise in consumers' incomes", "A specific tax placed on the good", "An increase in demand for the good"], "a": 2, "x": "A parallel leftward (upward) shift of supply by a fixed amount is the effect of a specific tax. Price rises and quantity falls from X to Y.", "w": ["A subsidy would shift supply right, not left.", "Income changes shift demand, and D1 does not move.", "", "A demand increase would move D1, not supply."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price", "lines": [{"pts": [[0, 10], [10, 0]], "label": "D1", "c": 0}, {"pts": [[0, 0], [10, 10]], "label": "S1", "c": 1, "dash": true}, {"pts": [[0, 2], [8, 10]], "label": "S2", "c": 2}], "areas": [], "arrows": [], "points": [{"at": [5, 5], "label": "X"}, {"at": [4, 6], "label": "Y"}]}}
{"id": "econ-d041", "s": "micro", "t": "1.4.1", "lv": 2, "q": "A specific tax shifts supply from S1 to S2. Which area shows the part of the tax revenue borne by producers?", "o": ["Area B", "Area A", "Area C", "A and B together"], "a": 0, "x": "Producers receive the price on S1 at the new quantity, which is below the old price. The drop from the old price to that level is area B.", "w": ["", "Area A is the rise in price paid by consumers, so it is their share.", "Area C is the deadweight loss, not revenue borne by either side.", "Together A and B are the whole tax revenue, not producers' share alone."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price", "lines": [{"pts": [[0, 10], [10, 0]], "label": "D1", "c": 0}, {"pts": [[0, 0], [10, 10]], "label": "S1", "c": 1}, {"pts": [[0, 2], [8, 10]], "label": "S2", "c": 2}], "areas": [{"pts": [[0, 5], [4, 5], [4, 6], [0, 6]], "label": "A", "c": 0, "at": [2, 5.5]}, {"pts": [[0, 4], [4, 4], [4, 5], [0, 5]], "label": "B", "c": 3, "at": [2, 4.5]}, {"pts": [[4, 4], [4, 6], [5, 5]], "label": "C", "c": 2, "at": [4.3, 5]}], "arrows": [], "points": [{"at": [5, 5], "label": "X"}, {"at": [4, 6], "label": "Y"}]}}
{"id": "econ-d042", "s": "micro", "t": "1.4.1", "lv": 3, "q": "A specific tax shifts supply from S1 to S2. What does the diagram show about who bears the tax?", "o": ["Producers bear most, because supply is more elastic than demand", "The tax is shared equally, as areas A and B are the same size", "Producers bear most, because area B shows the full tax revenue", "Consumers bear most, as A exceeds B and demand is less elastic than supply"], "a": 3, "x": "Area A, the price rise to consumers, is much larger than area B, the fall in price received by producers. Demand is steeper (less elastic) than supply, so consumers bear more.", "w": ["Elastic supply means producers can cut output easily, so they bear less, not more.", "Area A is clearly larger than B, so the burden is not equal.", "Area B is only the producers' share; total revenue is A plus B.", ""], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price", "lines": [{"pts": [[0, 10], [5, 0]], "label": "D1", "c": 0}, {"pts": [[0, 5], [10, 10]], "label": "S1", "c": 1}, {"pts": [[0, 7.5], [5, 10]], "label": "S2", "c": 2}], "areas": [{"pts": [[0, 6], [1, 6], [1, 8], [0, 8]], "label": "A", "c": 0, "at": [0.5, 7]}, {"pts": [[0, 5.5], [1, 5.5], [1, 6], [0, 6]], "label": "B", "c": 3, "at": [0.5, 5.75]}], "arrows": [], "points": [{"at": [2, 6], "label": "X"}, {"at": [1, 8], "label": "Y"}]}}
{"id": "econ-d043", "s": "micro", "t": "1.4.2", "lv": 1, "q": "The diagram shows a tax on a good with a negative externality. Which area is the welfare loss created by the tax?", "o": ["Area B, the parallelogram between S1 and S2", "The whole area between D and S1", "Area A, the triangle between MSB and MSC", "Area A and area B added together"], "a": 2, "x": "The welfare loss is the triangle between MSB and MSC on the units no longer produced. Area A is that triangle. Area B is tax revenue, not a loss.", "w": ["Area B is the tax revenue the government collects, not the welfare loss.", "The area between D and S1 is not the loss; it extends beyond the lost units.", "", "Area B is a transfer to government, so adding it overstates the welfare loss."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price and costs", "lines": [{"pts": [[0, 10], [10, 0]], "label": "MSB = D", "c": 0}, {"pts": [[0, 1], [9, 10]], "label": "MPC = S1", "c": 1}, {"pts": [[0, 3], [7, 10]], "label": "MSC", "c": 2}, {"pts": [[0, 5], [5, 10]], "label": "S2 (with tax)", "c": 3}], "areas": [{"pts": [[2.5, 7.5], [2.5, 5.5], [3.5, 6.5]], "label": "A", "c": 3, "at": [2.85, 6.5]}, {"pts": [[0, 1], [0, 5], [2.5, 7.5], [2.5, 3.5]], "label": "B", "c": 1, "at": [1.2, 4.3]}], "arrows": [], "points": []}}
{"id": "econ-d044", "s": "micro", "t": "1.4.2", "lv": 2, "q": "The diagram shows a price cap. Which statement correctly describes the market at the cap?", "o": ["Q1 is traded and there is excess demand of Q3 minus Q1", "Q3 is traded and there is excess supply of Q3 minus Q1", "Q2 is traded and the market still clears at the cap", "Q1 is traded and there is excess supply of Q3 minus Q1"], "a": 0, "x": "At the cap suppliers offer only Q1, while consumers want Q3. Quantity traded is the lower Q1, leaving excess demand from Q1 to Q3.", "w": ["", "Q3 is demanded, but suppliers provide only Q1, so Q3 cannot be traded.", "Q2 is the free market quantity; the cap prevents the market reaching it.", "Demand exceeds supply at the cap, so there is a shortage, not a surplus."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity of energy", "ylabel": "Price", "lines": [{"pts": [[0, 10], [10, 0]], "label": "D", "c": 0}, {"pts": [[0, 1], [9, 10]], "label": "S", "c": 1}, {"pts": [[0, 3.5], [10, 3.5]], "label": "Price cap", "c": 2}], "areas": [], "arrows": [], "points": [{"at": [2.5, 3.5], "label": "X", "guides": ["Q1"]}, {"at": [4.5, 5.5], "label": "E", "guides": ["Q2"]}, {"at": [6.5, 3.5], "label": "Y", "guides": ["Q3"]}]}}
{"id": "econ-d045", "s": "micro", "t": "1.4.2", "lv": 3, "q": "The government cuts the tax so that S2 falls to coincide with MSC. What happens, using the diagram?", "o": ["Output rises from Q1 to Q2, price rises to P2 and area A grows", "Output stays at Q1 because the tax is only partly removed", "Output falls to Q2 and price rises, so area A is removed", "Output rises from Q1 to Q2, price falls to P2 and area A disappears"], "a": 3, "x": "S2 moving down to MSC gives equilibrium at O. Output rises from Q1 to Q2, price falls from P1 to P2, and the welfare loss triangle A is eliminated.", "w": ["Price falls from P1 to P2, and area A shrinks to nothing rather than growing.", "S2 falls fully onto MSC, so equilibrium moves to O, not staying at Q1.", "Q2 is greater than Q1, so output rises and the price falls to P2.", ""], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price and costs", "lines": [{"pts": [[0, 10], [10, 0]], "label": "MSB = D", "c": 0}, {"pts": [[0, 1], [9, 10]], "label": "MPC = S1", "c": 1}, {"pts": [[0, 3], [7, 10]], "label": "MSC", "c": 2}, {"pts": [[0, 5], [5, 10]], "label": "S2 (with tax)", "c": 3}], "areas": [{"pts": [[2.5, 7.5], [2.5, 5.5], [3.5, 6.5]], "label": "A", "c": 3, "at": [2.85, 6.5]}], "arrows": [], "points": [{"at": [2.5, 7.5], "label": "T", "guides": ["Q1", "P1"]}, {"at": [3.5, 6.5], "label": "O", "guides": ["Q2", "P2"]}]}}
{"id": "econ-d106", "s": "micro", "t": "3.2.1", "lv": 1, "q": "On the diagram, which point's output would a revenue-maximising firm choose?", "o": ["The output at X, where MC cuts MR from below", "The output at Z, where AR meets AC", "The output at Y, where MR is equal to zero", "The output at W, where MC cuts AC at its minimum"], "a": 2, "x": "Revenue is greatest where MR = 0, which is the output at Y. X is profit maximisation, Z is sales maximisation and W is the lowest average cost.", "w": ["X is the profit-maximising output, not the point where extra revenue falls to zero.", "Z is the sales-maximising output with only normal profit, not the revenue peak.", "", "W is the productively efficient output, which is not a revenue objective."], "fig": {"type": "line", "x": [0, 12], "y": [0, 12], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price, costs and revenue", "lines": [{"pts": [[0, 12], [12, 0]], "label": "AR", "c": 0}, {"pts": [[0, 12], [6, 0]], "label": "MR", "c": 1}, {"pts": [[0, 0], [11, 11]], "label": "MC", "c": 2}, {"pts": [[1, 11], [1.5, 7.75], [2, 6.25], [3, 5], [4, 4.625], [4.58, 4.58], [5, 4.6], [6, 4.75], [7, 5], [8, 5.31], [9, 5.67]], "label": "AC", "c": 3}], "areas": [], "arrows": [], "points": [{"at": [4, 4], "label": "X", "guides": ["Qx"]}, {"at": [4.58, 4.58], "label": "W"}, {"at": [6, 0], "label": "Y", "guides": ["Qy"]}, {"at": [7, 5], "label": "Z", "guides": ["Qz"]}]}}
{"id": "econ-d107", "s": "micro", "t": "3.2.1", "lv": 2, "q": "The firm maximises profit. Which area shows its supernormal profit?", "o": ["Area A", "Area B", "Areas A and B together", "Area C"], "a": 0, "x": "At the profit-maximising output Q1, supernormal profit is (AR − AC) × output. That is the rectangle between AR and AC, which is area A.", "w": ["", "Area B is total cost, AC × output, not profit.", "A and B together make total revenue, not profit.", "Area C lies beyond Q1 and is not (AR − AC) × output at the profit maximum."], "fig": {"type": "line", "x": [0, 12], "y": [0, 12], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price, costs and revenue", "lines": [{"pts": [[0, 12], [12, 0]], "label": "AR", "c": 0}, {"pts": [[0, 12], [6, 0]], "label": "MR", "c": 1}, {"pts": [[0, 0], [11, 11]], "label": "MC", "c": 2}, {"pts": [[1, 11], [1.5, 7.75], [2, 6.25], [3, 5], [4, 4.625], [4.58, 4.58], [5, 4.6], [6, 4.75], [7, 5], [8, 5.31], [9, 5.67]], "label": "AC", "c": 3}], "areas": [{"pts": [[0, 4.625], [4, 4.625], [4, 8], [0, 8]], "label": "A", "c": 0, "at": [2, 6.3]}, {"pts": [[0, 0], [4, 0], [4, 4.625], [0, 4.625]], "label": "B", "c": 2, "at": [2, 2.3]}, {"pts": [[4, 0], [7, 0], [7, 5], [4, 5]], "label": "C", "c": 3, "at": [5.5, 2.5]}], "arrows": [], "points": [{"at": [4, 4], "guides": ["Q1"]}]}}
{"id": "econ-d108", "s": "micro", "t": "3.2.1", "lv": 3, "q": "Unit costs rise, shifting MC from MC1 to MC2. What happens to the profit-maximising and revenue-maximising outputs?", "o": ["Both outputs fall, because MC is higher at every output", "Profit-maximising output rises to Y; revenue-maximising output stays at Z", "Profit-maximising output stays at X; revenue-maximising output falls below Z", "Profit-maximising output falls from X to Y; revenue-maximising stays at Z"], "a": 3, "x": "MC = MR now occurs at Y, a lower output than X. Revenue maximisation depends only on MR = 0 at Z, which does not involve MC, so it is unchanged.", "w": ["Revenue-maximising output depends on MR, not MC, so it does not fall.", "The higher MC2 cuts MR further left, so profit-maximising output falls rather than rises.", "MC2 cuts MR at a lower output than X, so profit-maximising output cannot stay at X.", ""], "fig": {"type": "line", "x": [0, 12], "y": [0, 12], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price, costs and revenue", "lines": [{"pts": [[0, 12], [12, 0]], "label": "AR", "c": 0}, {"pts": [[0, 12], [6, 0]], "label": "MR", "c": 1}, {"pts": [[0, 0], [11, 11]], "label": "MC1", "c": 2, "dash": true}, {"pts": [[0, 3], [9, 12]], "label": "MC2", "c": 3}], "areas": [], "arrows": [{"from": [4, 4], "to": [3, 6], "c": 3}], "points": [{"at": [4, 4], "label": "X", "guides": ["Qx"]}, {"at": [3, 6], "label": "Y", "guides": ["Qy"]}, {"at": [6, 0], "label": "Z", "guides": ["Qz"]}]}}
{"id": "econ-d109", "s": "micro", "t": "3.3.1", "lv": 1, "q": "The diagram shows a firm's AR and MR curves, labelled L1 and L2. Which statement is correct?", "o": ["L1 is MR, because it is the flatter of the two curves", "L2 is AR, because it is steeper and so shows demand", "L2 is MR, because it lies below L1 and falls twice as steeply", "L1 and L2 are the same curve, as for a price taker"], "a": 2, "x": "AR is the demand curve. A firm with market power must cut price on all units, so MR lies below AR and falls twice as steeply, cutting the axis halfway.", "w": ["MR is steeper than AR, not flatter.", "AR is the flatter curve; the steeper one is MR.", "", "AR and MR only coincide for a price taker, whose curve is horizontal."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price / revenue (£)", "lines": [{"pts": [[0, 10], [10, 0]], "label": "L1", "c": 0}, {"pts": [[0, 10], [5, 0]], "label": "L2", "c": 1}]}}
{"id": "econ-d110", "s": "micro", "t": "3.3.1", "lv": 2, "q": "Q1 is the output directly below point X on the AR curve. What is true of the firm's total revenue at Q1?", "o": ["TR is at its maximum and PED is −1 at X", "TR is still rising because price at X is positive", "TR is falling because demand is inelastic at X", "TR is zero because MR is zero at Q1"], "a": 0, "x": "MR cuts the quantity axis at Q1, so extra sales add nothing to TR and TR is at its peak. This is the point of unit elasticity on a straight-line demand curve.", "w": ["", "MR is zero, so extra units no longer add to TR; it has stopped rising.", "TR only falls beyond Q1, where MR is negative and demand is inelastic.", "MR = 0 does not make TR zero; TR is price times quantity and is at its maximum."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price / revenue (£)", "lines": [{"pts": [[0, 10], [10, 0]], "label": "AR", "c": 0}, {"pts": [[0, 10], [5, 0]], "label": "MR", "c": 1}], "points": [{"at": [5, 5], "label": "X", "guides": ["Q1"]}]}}
{"id": "econ-d111", "s": "micro", "t": "3.3.1", "lv": 3, "q": "The firm cuts its price, moving along AR from point A to point B. What happens to total revenue overall?", "o": ["TR rises, because the lower price raises quantity sold", "TR is the same at A and B, having peaked at Q = 5 between them", "TR falls, because MR is negative at B so demand is inelastic", "TR falls, because price is lower at B than at A"], "a": 1, "x": "TR at A is 8 × 2 = £16 and at B is 2 × 8 = £16. TR rose while MR was positive, peaked at Q = 5, then fell back.", "w": ["TR rose only until Q = 5, then fell back; the overall change is not a rise.", "", "MR is negative at B, but TR at B equals TR at A, so it has not fallen overall.", "Lower price alone does not decide TR; quantity rises too, and the two effects cancel here."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": true, "xnums": true, "ynums": true, "ystep": 2, "xlabel": "Quantity", "ylabel": "Price / revenue (£)", "lines": [{"pts": [[0, 10], [10, 0]], "label": "AR", "c": 0}, {"pts": [[0, 10], [5, 0]], "label": "MR", "c": 1}], "points": [{"at": [2, 8], "label": "A"}, {"at": [8, 2], "label": "B"}]}}
{"id": "econ-d112", "s": "micro", "t": "3.3.2", "lv": 1, "q": "The diagram shows short-run cost curves. What does point X show?", "o": ["The lowest point of MC, where diminishing returns begin", "The lowest point of AVC, where MC equals AVC", "The lowest point of ATC, where MC equals ATC", "The point where fixed costs fall to zero"], "a": 2, "x": "At X the MC curve cuts the ATC curve from below at its lowest point. Below X, MC is under ATC and pulls it down; above X, MC is over ATC and pushes it up.", "w": ["MC reaches its lowest point at a lower output, well to the left of X.", "AVC is lowest at a lower output, where MC cuts AVC, not at X.", "", "AFC only keeps falling as output rises; it never reaches zero."], "fig": {"type": "line", "x": [0, 10], "y": [0, 12], "grid": false, "xnums": false, "ynums": false, "xlabel": "Output", "ylabel": "Costs (£)", "lines": [{"pts": [[0.5, 2.094], [1, 1.375], [2, 0.5], [3, 0.375], [4, 1], [5, 2.375], [6, 4.5], [7, 7.375], [8, 11]], "label": "MC", "c": 0}, {"pts": [[0.5, 2.531], [1, 2.125], [2, 1.5], [3, 1.125], [4, 1], [5, 1.125], [6, 1.5], [7, 2.125], [8, 3]], "label": "AVC", "c": 2}, {"pts": [[2, 10.5], [3, 7.125], [4, 5.5], [5, 4.725], [6, 4.5], [7, 4.696], [8, 5.25]], "label": "ATC", "c": 1}], "areas": [], "arrows": [], "points": [{"at": [6, 4.5], "label": "X", "guides": ["Q1", "£"]}]}}
{"id": "econ-d113", "s": "micro", "t": "3.3.2", "lv": 2, "q": "Y is the lowest point of AVC and X is the lowest point of ATC. Between the outputs at Y and X, which statement is correct?", "o": ["MC is above AVC but below ATC, so AVC rises while ATC still falls", "MC is below AVC and ATC, so both averages fall", "MC is above both AVC and ATC, so both averages rise", "MC is below AVC but above ATC, so AVC falls while ATC rises"], "a": 0, "x": "Between Y and X the MC curve lies above AVC, so AVC rises, but below ATC, so ATC still falls. The falling AFC outweighs the rising AVC until X.", "w": ["", "MC is above AVC in this range, so AVC cannot be falling.", "MC is below ATC until X, so ATC is falling, not rising.", "MC is above AVC and below ATC here, the reverse of this."], "fig": {"type": "line", "x": [0, 10], "y": [0, 12], "grid": false, "xnums": false, "ynums": false, "xlabel": "Output", "ylabel": "Costs (£)", "lines": [{"pts": [[0.5, 2.094], [1, 1.375], [2, 0.5], [3, 0.375], [4, 1], [5, 2.375], [6, 4.5], [7, 7.375], [8, 11]], "label": "MC", "c": 0}, {"pts": [[0.5, 2.531], [1, 2.125], [2, 1.5], [3, 1.125], [4, 1], [5, 1.125], [6, 1.5], [7, 2.125], [8, 3]], "label": "AVC", "c": 2}, {"pts": [[2, 10.5], [3, 7.125], [4, 5.5], [5, 4.725], [6, 4.5], [7, 4.696], [8, 5.25]], "label": "ATC", "c": 1}], "areas": [], "arrows": [], "points": [{"at": [4, 1], "label": "Y", "guides": ["Q1", "£"]}, {"at": [6, 4.5], "label": "X", "guides": ["Q2", "£"]}]}}
{"id": "econ-d114", "s": "micro", "t": "3.3.2", "lv": 3, "q": "The firm's ATC curve moves from ATC1 to ATC2, while MC and AVC stay where they are. What is the most likely cause?", "o": ["A rise in the wage rate paid to workers on the production line", "A fall in the price of raw materials used in production", "The firm moving to its minimum efficient scale in the long run", "A rise in fixed costs, such as the rent on the factory"], "a": 3, "x": "ATC2 is above ATC1 but AVC and MC are unchanged, so only fixed costs have risen. Higher fixed costs raise AFC and so ATC, but do not change the extra cost of a unit.", "w": ["Higher wages are a variable cost and would shift MC and AVC upwards too.", "Cheaper materials would lower variable costs, shifting MC and AVC down, and ATC would fall.", "That is a long-run movement along LRAC, and would not shift short-run ATC with MC and AVC fixed.", ""], "fig": {"type": "line", "x": [0, 10], "y": [0, 12], "grid": false, "xnums": false, "ynums": false, "xlabel": "Output", "ylabel": "Costs (£)", "lines": [{"pts": [[0.5, 2.094], [1, 1.375], [2, 0.5], [3, 0.375], [4, 1], [5, 2.375], [6, 4.5], [7, 7.375], [8, 11]], "label": "MC", "c": 0}, {"pts": [[0.5, 2.531], [1, 2.125], [2, 1.5], [3, 1.125], [4, 1], [5, 1.125], [6, 1.5], [7, 2.125], [8, 3]], "label": "AVC", "c": 2}, {"pts": [[2, 10.5], [3, 7.125], [4, 5.5], [5, 4.725], [6, 4.5], [7, 4.696], [8, 5.25]], "label": "ATC1", "c": 1, "dash": true}, {"pts": [[3, 10.125], [4, 7.75], [5, 6.525], [6, 6], [7, 5.982], [8, 6.375]], "label": "ATC2", "c": 3}], "areas": [], "arrows": [], "points": []}}
{"id": "econ-d115", "s": "micro", "t": "3.3.3", "lv": 1, "q": "The diagram shows a firm's LRAC curve. Which point shows the minimum efficient scale?", "o": ["Point A, where LRAC is falling as output rises", "Point B, where LRAC is at its lowest", "Point C, where output is highest on the curve", "Point A and point C, as their LRAC is equal"], "a": 1, "x": "MES is the lowest output at which LRAC is minimised. Point B is the bottom of the LRAC curve, so it shows the minimum efficient scale.", "w": ["A is on the falling part of the curve, above the minimum, so economies of scale are still being gained and LRAC is not minimised.", "", "Highest output is not the same as lowest LRAC; costs are rising at C because of diseconomies of scale.", "Equal LRAC at A and C does not make either the minimum; both are above B."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Output", "ylabel": "Long-run average cost (£)", "lines": [{"pts": [[0.5, 7.06], [1, 6], [2, 4.25], [3, 3], [4, 2.25], [5, 2], [6, 2.25], [7, 3], [8, 4.25], [9, 6], [9.5, 7.06]], "label": "LRAC", "c": 0}], "areas": [], "arrows": [], "points": [{"at": [2, 4.25], "label": "A"}, {"at": [5, 2], "label": "B"}, {"at": [8, 4.25], "label": "C"}]}}
{"id": "econ-d116", "s": "micro", "t": "3.3.3", "lv": 2, "q": "A firm expands from output Q1 at point Y to output Q2 at point Z. Which is the most likely cause of the change in LRAC?", "o": ["Bulk-buying discounts become larger as the firm grows", "The firm borrows more cheaply because banks see it as lower risk", "Other firms in the industry cluster nearby and share suppliers", "Communication problems and poor coordination in a larger firm"], "a": 3, "x": "Y and Z are both beyond the minimum of LRAC, so moving from Y to Z is a rise in LRAC along the curve as the firm grows. This shows internal diseconomies of scale, such as poor communication and coordination.", "w": ["Bulk-buying discounts are a purchasing economy and would lower LRAC, not raise it.", "Cheaper borrowing is a financial economy, which would lower LRAC rather than raise it.", "Clustering gives external economies and shifts the curve; the move shown is along the curve.", ""], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Output", "ylabel": "Long-run average cost (£)", "lines": [{"pts": [[0.5, 7.06], [1, 6], [2, 4.25], [3, 3], [4, 2.25], [5, 2], [6, 2.25], [7, 3], [8, 4.25], [9, 6], [9.5, 7.06]], "label": "LRAC", "c": 0}], "areas": [], "arrows": [], "points": [{"at": [6, 2.25], "label": "Y", "guides": ["Q1"]}, {"at": [8, 4.25], "label": "Z", "guides": ["Q2"]}]}}
{"id": "econ-d117", "s": "micro", "t": "3.3.3", "lv": 3, "q": "After a cluster of firms forms nearby, the firm's LRAC moves from LRAC1 to LRAC2. Which statement fits the diagram?", "o": ["External economies of scale lower costs at every output, with MES still at Q*", "Internal economies of scale move the firm down LRAC1 from P to R", "Diseconomies of scale raise MES output above Q*", "A rise in MES output explains why LRAC is lower at R"], "a": 0, "x": "The whole curve shifts down because the industry cluster lowers costs for all firms: external economies. The minimum stays at output Q*, so MES output is unchanged.", "w": ["", "Internal economies are movements along one curve; P to R is a shift to a new curve.", "LRAC2 is lower, not higher, and the minimum remains at Q*, so this is not a diseconomy.", "MES output does not change; both minima are at Q*, so it cannot explain the lower cost."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Output", "ylabel": "Long-run average cost (£)", "lines": [{"pts": [[0.5, 7.06], [1, 6], [2, 4.25], [3, 3], [4, 2.25], [5, 2], [6, 2.25], [7, 3], [8, 4.25], [9, 6], [9.5, 7.06]], "label": "LRAC1", "c": 0, "dash": true}, {"pts": [[0.5, 6.06], [1, 5], [2, 3.25], [3, 2], [4, 1.25], [5, 1], [6, 1.25], [7, 2], [8, 3.25], [9, 5], [9.5, 6.06]], "label": "LRAC2", "c": 1}], "areas": [], "arrows": [], "points": [{"at": [5, 2], "label": "P", "guides": ["Q*"]}, {"at": [5, 1], "label": "R"}]}}
{"id": "econ-d118", "s": "micro", "t": "3.3.4", "lv": 1, "q": "The firm produces Q1, where MC = MR. Which area shows its supernormal profit?", "o": ["Area B only", "Area A only", "Areas A and B together", "Neither; only normal profit is earned"], "a": 1, "x": "Supernormal profit is (AR − AC) × Q. At Q1, AR is above AC, so the area between them up to Q1, area A, is supernormal profit. Area B is total cost.", "w": ["Area B is total cost, AC × Q, not profit.", "", "Area B is cost, so adding it to A overstates profit.", "AR is well above AC at Q1, so profit is above normal."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "xlabel": "Quantity", "ylabel": "Price, costs, revenue", "lines": [{"pts": [[0, 10], [10, 0]], "label": "AR", "c": 0}, {"pts": [[0, 10], [5, 0]], "label": "MR", "c": 1}, {"pts": [[1, 2.75], [1.5, 1.6875], [2, 1], [2.5, 0.6875], [3, 0.75], [3.5, 1.1875], [4, 2], [4.5, 3.1875], [5, 4.75], [5.5, 6.6875], [6, 9]], "label": "MC", "c": 2}, {"pts": [[1, 4.25], [1.5, 3.5625], [2, 3], [2.5, 2.5625], [3, 2.25], [3.5, 2.0625], [4, 2], [4.5, 2.0625], [5, 2.25], [5.5, 2.5625], [6, 3]], "label": "AC", "c": 3}], "areas": [{"pts": [[0, 2], [4, 2], [4, 6], [0, 6]], "label": "A", "c": 0, "at": [2, 4]}, {"pts": [[0, 0], [4, 0], [4, 2], [0, 2]], "label": "B", "c": 2, "at": [2, 1]}], "arrows": [], "points": [{"at": [4, 2], "label": "E", "guides": ["Q1"]}]}}
{"id": "econ-d119", "s": "micro", "t": "3.3.4", "lv": 2, "q": "Using the values on the axes, what is the firm's supernormal profit at Q1, where MC = MR?", "o": ["£24", "£12", "£8", "£16"], "a": 3, "x": "Profit is maximised at Q1 = 4. Price is £6 on AR and average cost is £2. Supernormal profit is (6 − 2) × 4 = £16.", "w": ["£24 is price × quantity, which is total revenue, not profit.", "£12 uses the wrong gap between price and cost.", "£8 is total cost, AC × Q, not profit.", ""], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "xnums": true, "ynums": true, "ystep": 1, "xlabel": "Quantity (units)", "ylabel": "Price, costs (£)", "lines": [{"pts": [[0, 10], [10, 0]], "label": "AR", "c": 0}, {"pts": [[0, 10], [5, 0]], "label": "MR", "c": 1}, {"pts": [[1, 2.75], [1.5, 1.6875], [2, 1], [2.5, 0.6875], [3, 0.75], [3.5, 1.1875], [4, 2], [4.5, 3.1875], [5, 4.75], [5.5, 6.6875], [6, 9]], "label": "MC", "c": 2}, {"pts": [[1, 4.25], [1.5, 3.5625], [2, 3], [2.5, 2.5625], [3, 2.25], [3.5, 2.0625], [4, 2], [4.5, 2.0625], [5, 2.25], [5.5, 2.5625], [6, 3]], "label": "AC", "c": 3}], "areas": [], "arrows": [], "points": [{"at": [4, 2], "label": "E", "guides": ["Q1", "C1"]}, {"at": [4, 6], "label": "R", "guides": ["Q1", "P1"]}]}}
{"id": "econ-d120", "s": "micro", "t": "3.3.4", "lv": 3, "q": "The firm produces Q1, where MC = MR. Which statement about areas K and L is correct?", "o": ["AR exceeds AVC by area K, so it keeps producing despite area L", "Area L is a supernormal profit, so the firm should expand output", "AR is below AVC, so the firm should shut down in the short run", "Area K is the loss, so closing down is better in the short run"], "a": 0, "x": "At Q1, AR is above AVC, so revenue covers variable costs with area K left over for fixed costs. AR is below AC, so area L is a loss. Producing beats shutting down.", "w": ["", "Area L lies between AC and AR, so it is a loss, not a profit.", "At Q1, AR is above AVC, so the short-run shutdown condition is not met.", "Area K is AR above AVC, a contribution to fixed costs; the loss is area L."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "xlabel": "Quantity", "ylabel": "Price, costs, revenue", "lines": [{"pts": [[0, 6], [10, 1]], "label": "AR", "c": 0}, {"pts": [[0, 6], [6, 0]], "label": "MR", "c": 1}, {"pts": [[1, 2.75], [1.5, 1.6875], [2, 1], [2.5, 0.6875], [3, 0.75], [3.5, 1.1875], [4, 2], [4.5, 3.1875], [5, 4.75], [5.5, 6.6875], [6, 9]], "label": "MC", "c": 2}, {"pts": [[2, 9.25], [2.5, 7.5625], [3, 6.4167], [3.5, 5.6339], [4, 5.125], [4.5, 4.8403], [5, 4.75], [5.5, 4.8352], [6, 5.0833], [6.5, 5.4856]], "label": "AC", "c": 3}, {"pts": [[1, 4.25], [1.5, 3.5625], [2, 3], [2.5, 2.5625], [3, 2.25], [3.5, 2.0625], [4, 2], [4.5, 2.0625], [5, 2.25], [5.5, 2.5625], [6, 3], [6.5, 3.5625]], "label": "AVC", "c": 3, "dash": true}], "areas": [{"pts": [[0, 2], [4, 2], [4, 4], [0, 4]], "label": "K", "c": 0, "at": [2, 3]}, {"pts": [[0, 4], [4, 4], [4, 5.125], [0, 5.125]], "label": "L", "c": 1, "at": [2, 4.6]}], "arrows": [], "points": [{"at": [4, 2], "label": "E", "guides": ["Q1"]}]}}
{"id": "econ-d121", "s": "micro", "t": "3.4.1", "lv": 1, "q": "Which point on the diagram shows productive efficiency?", "o": ["Point X, where AC is falling", "Point Y, where MC cuts AC", "Point Z, where AC is rising", "Point W, where MC is lowest"], "a": 1, "x": "Productive efficiency is at the lowest point of AC, where MC cuts AC. That is point Y. At X and Z average cost is higher.", "w": ["At X average cost is still falling, so raising output would cut unit costs.", "", "At Z average cost is rising, so unit cost is above the minimum.", "W is the lowest point of MC, not of AC. At that output average cost is still falling."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Costs (£)", "lines": [{"pts": [[0, 3.5], [1, 2.6], [2, 1.9], [3, 1.4], [4, 1.1], [5, 1], [6, 1.1], [7, 1.4], [8, 1.9]], "label": "AC", "c": 3}, {"pts": [[0, 3.5], [1, 1.8], [2, 0.7], [3, 0.2], [4, 0.3], [5, 1], [6, 2.3], [7, 4.2], [8, 6.7]], "label": "MC", "c": 2}], "areas": [], "arrows": [], "points": [{"at": [3, 1.4], "label": "X"}, {"at": [5, 1], "label": "Y"}, {"at": [7, 1.4], "label": "Z"}, {"at": [3, 0.2], "label": "W"}]}}
{"id": "econ-d122", "s": "micro", "t": "3.4.1", "lv": 2, "q": "The diagram shows a profit-maximising monopoly. Which area represents the welfare loss from allocative inefficiency?", "o": ["Area B, the rectangle of supernormal profit", "Area B plus the area under MC", "The area under MR up to Q1", "Area A, between AR and MC from Q1 to Q2"], "a": 3, "x": "Between Q1 and Q2 consumers value each unit (AR) above its cost (MC) but it is not produced. Area A is that lost surplus.", "w": ["Area B is supernormal profit, a transfer to the firm and not the welfare loss.", "The area under MC is the cost of producing, not lost surplus.", "The area under MR is revenue; it does not show unproduced units valued above their cost.", ""], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price, costs and revenue (£)", "lines": [{"pts": [[0, 8.3], [8.3, 0]], "label": "AR", "c": 0}, {"pts": [[0, 8.3], [4.15, 0]], "label": "MR", "c": 1}, {"pts": [[0, 3.5], [1, 1.8], [2, 0.7], [3, 0.2], [4, 0.3], [5, 1], [6, 2.3], [7, 4.2], [8, 6.7]], "label": "MC", "c": 2}, {"pts": [[0, 3.5], [1, 2.6], [2, 1.9], [3, 1.4], [4, 1.1], [5, 1], [6, 1.1], [7, 1.4], [8, 1.9]], "label": "AC", "c": 3}], "areas": [{"pts": [[4, 0.3], [4, 4.3], [6, 2.3]], "label": "A", "c": 1, "at": [4.5, 2.3]}, {"pts": [[0, 1.1], [4, 1.1], [4, 4.3], [0, 4.3]], "label": "B", "c": 0, "at": [2, 2.7]}], "arrows": [], "points": [{"at": [4, 4.3], "label": "P1", "guides": ["Q1", "P1"]}, {"at": [6, 2.3], "guides": ["Q2"]}]}}
{"id": "econ-d123", "s": "micro", "t": "3.4.1", "lv": 3, "q": "For the monopoly shown, producing at Q1, which outputs would a regulator need for allocative and productive efficiency?", "o": ["Q2 for allocative efficiency, Q3 for productive efficiency", "Q3 for allocative efficiency, Q2 for productive efficiency", "Q1 for both, because MR equals MC there", "Q2 for both, because price equals MC there"], "a": 0, "x": "Allocative efficiency needs P = MC, where AR meets MC at Q2. Productive efficiency needs MC = AC at minimum AC, at Q3. Q1 achieves neither.", "w": ["", "Q3 is where MC cuts AC, not where AR meets MC, so the two are swapped.", "MR = MC at Q1 is only profit maximisation; there P > MC and AC is above its minimum.", "Q2 gives P = MC only; AC is not at its lowest point there, so it is not productively efficient."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price, costs and revenue (£)", "lines": [{"pts": [[0, 8.3], [8.3, 0]], "label": "AR", "c": 0}, {"pts": [[0, 8.3], [4.15, 0]], "label": "MR", "c": 1}, {"pts": [[0, 3.5], [1, 1.8], [2, 0.7], [3, 0.2], [4, 0.3], [5, 1], [6, 2.3], [7, 4.2], [8, 6.7]], "label": "MC", "c": 2}, {"pts": [[0, 3.5], [1, 2.6], [2, 1.9], [3, 1.4], [4, 1.1], [5, 1], [6, 1.1], [7, 1.4], [8, 1.9]], "label": "AC", "c": 3}], "areas": [], "arrows": [], "points": [{"at": [4, 4.3], "label": "P1", "guides": ["Q1", "P1"]}, {"at": [6, 2.3], "label": "P2", "guides": ["Q2", "P2"]}, {"at": [5, 1], "guides": ["Q3"]}]}}
{"id": "econ-d124", "s": "micro", "t": "3.4.2", "lv": 1, "q": "The diagram shows a perfectly competitive firm at its profit-maximising output. Which area shows supernormal profit?", "o": ["Area B", "Areas A and B together", "Area A", "The gap between MC and AC"], "a": 2, "x": "Supernormal profit is (AR − AC) × quantity. At Q1 that is the rectangle between P1 and AC, which is area A.", "w": ["Area B is total cost, AC × Q1, not profit.", "A and B together are total revenue, P1 × Q1, not profit.", "", "The gap between MC and AC is not an area showing profit at Q1."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price / costs", "lines": [{"pts": [[0, 9.25], [0.5, 6.94], [1, 5], [1.5, 3.44], [2, 2.25], [2.5, 1.44], [3, 1], [3.5, 0.94], [4, 1.25], [4.5, 1.94], [5, 3], [5.5, 4.44], [6, 6.25], [6.5, 8.44], [6.8, 9.93]], "label": "MC", "c": 0}, {"pts": [[0.5, 8.06], [1, 7], [2, 5.25], [3, 4], [4, 3.25], [5, 3], [6, 3.25], [7, 4], [8, 5.25], [9, 7]], "label": "AC", "c": 1}, {"pts": [[0, 6.25], [10, 6.25]], "label": "D=AR=MR", "c": 2}], "areas": [{"pts": [[0, 3.25], [6, 3.25], [6, 6.25], [0, 6.25]], "label": "A", "c": 3, "at": [3, 4.75]}, {"pts": [[0, 0], [6, 0], [6, 3.25], [0, 3.25]], "label": "B", "c": 2, "at": [3, 1.6]}], "arrows": [], "points": [{"at": [6, 6.25], "label": "", "guides": ["Q1", "P1"]}]}}
{"id": "econ-d125", "s": "micro", "t": "3.4.2", "lv": 2, "q": "The firm faces price P3 and produces where MC = MR. What does area L show, and what happens in the long run?", "o": ["A loss; firms exit, supply shifts left and price rises", "Supernormal profit; firms enter, supply shifts right and price falls", "A loss; firms enter until the price falls even further", "Normal profit; no firms enter or leave the market"], "a": 0, "x": "At Q3, AC is above P3, so AR < AC and area L is a loss. Exit reduces market supply, so price rises back to minimum AC.", "w": ["", "AR is below AC, so this is a loss, not supernormal profit.", "Entry follows profit, not losses. Losses cause exit.", "Normal profit needs AR = AC, but AC is above P3 here."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price / costs", "lines": [{"pts": [[0, 9.25], [0.5, 6.94], [1, 5], [1.5, 3.44], [2, 2.25], [2.5, 1.44], [3, 1], [3.5, 0.94], [4, 1.25], [4.5, 1.94], [5, 3], [5.5, 4.44], [6, 6.25], [6.5, 8.44], [6.8, 9.93]], "label": "MC", "c": 0}, {"pts": [[0.5, 8.06], [1, 7], [2, 5.25], [3, 4], [4, 3.25], [5, 3], [6, 3.25], [7, 4], [8, 5.25], [9, 7]], "label": "AC", "c": 1}, {"pts": [[0, 1.25], [10, 1.25]], "label": "D=AR=MR", "c": 2}], "areas": [{"pts": [[0, 1.25], [4, 1.25], [4, 3.25], [0, 3.25]], "label": "L", "c": 3, "at": [1, 2.25]}], "arrows": [], "points": [{"at": [4, 1.25], "label": "", "guides": ["Q3", "P3"]}]}}
{"id": "econ-d126", "s": "micro", "t": "3.4.2", "lv": 3, "q": "The market price falls from P1 to P2 after entry. Which statement about the firm is correct?", "o": ["Output rises from Q1 to Q2 and profit stays supernormal", "Output falls from Q1 to Q2 and profit falls to normal at X", "Output stays at Q1 and price falls to the level of AC at Q1", "Output falls to Q2 but the firm makes a loss as P2 is below AC"], "a": 1, "x": "With price P2, MC = MR at X, which is output Q2, lower than Q1. There P2 equals AC at its minimum, so profit is normal.", "w": ["Q2 is to the left of Q1, so output falls, and profit is not supernormal at X.", "", "The firm moves along MC to Q2, so output does not stay at Q1.", "At X, AC equals P2 at its minimum, so there is no loss."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price / costs", "lines": [{"pts": [[0, 9.25], [0.5, 6.94], [1, 5], [1.5, 3.44], [2, 2.25], [2.5, 1.44], [3, 1], [3.5, 0.94], [4, 1.25], [4.5, 1.94], [5, 3], [5.5, 4.44], [6, 6.25], [6.5, 8.44], [6.8, 9.93]], "label": "MC", "c": 0}, {"pts": [[0.5, 8.06], [1, 7], [2, 5.25], [3, 4], [4, 3.25], [5, 3], [6, 3.25], [7, 4], [8, 5.25], [9, 7]], "label": "AC", "c": 1}, {"pts": [[0, 6.25], [10, 6.25]], "label": "AR1=MR1", "c": 2, "dash": true}, {"pts": [[0, 3], [10, 3]], "label": "AR2=MR2", "c": 3, "step": 3}], "areas": [], "arrows": [{"from": [9, 6.25], "to": [9, 3], "c": 2, "step": 2}], "points": [{"at": [6, 6.25], "label": "Y", "guides": ["Q1", "P1"]}, {"at": [5, 3], "label": "X", "guides": ["Q2", "P2"], "step": 3}], "anim": "steps", "steps": ["Start at Y: price P1, output Q1", "Entry lowers price from P1 to P2", "New equilibrium at X"]}}
{"id": "econ-d127", "s": "micro", "t": "3.4.3", "lv": 1, "q": "The firm is in short-run equilibrium. Which area shows its supernormal profit?", "o": ["Area B", "Area A", "Areas A and B together", "There is no supernormal profit"], "a": 1, "x": "Supernormal profit is (AR - AC) multiplied by output. At Q1 the gap between AR at Y and AC is the height of area A, so area A is the profit.", "w": ["Area B is total cost, AC multiplied by output, not profit.", "", "Areas A and B together are total revenue, price multiplied by quantity.", "AR at Y is above AC at Q1, so supernormal profit exists."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price, costs and revenue", "lines": [{"pts": [[1, 7.4], [2, 6.1], [3, 5], [4, 4.1], [5, 3.4], [6, 2.9], [7, 2.6], [8, 2.5], [9, 2.6], [10, 2.9]], "label": "AC", "c": 1}, {"pts": [[2, 0.1], [10, 3.3]], "label": "MC", "c": 2}, {"pts": [[0, 8.8], [10, 0.8]], "label": "AR", "c": 0}, {"pts": [[0, 8.8], [5.5, 0]], "label": "MR", "c": 3, "dash": true}], "areas": [{"pts": [[0, 5], [4.75, 5], [4.75, 3.55625], [0, 3.55625]], "label": "A", "c": 0, "at": [2.3, 4.3]}, {"pts": [[0, 3.55625], [4.75, 3.55625], [4.75, 0], [0, 0]], "label": "B", "c": 1, "at": [2.3, 1.8]}], "arrows": [], "points": [{"at": [4.75, 5], "label": "Y", "guides": ["Q1", "P1"]}]}}
{"id": "econ-d128", "s": "micro", "t": "3.4.3", "lv": 2, "q": "The firm is in long-run equilibrium at E. Which statement about output Q1 is correct?", "o": ["Allocatively efficient, because AR equals AC at Q1", "Productively efficient, because AR touches AC at E", "Supernormal profit, because AR is above MC at Q1", "Excess capacity: Q1 is below the minimum-AC output Q2"], "a": 3, "x": "AC is lowest at G, output Q2. The firm produces Q1, which is less, so it has excess capacity. Price at E exceeds MC at F, so it is not allocatively efficient.", "w": ["Allocative efficiency needs price equal to MC; at Q1 price at E is well above MC at F.", "Productive efficiency needs output at the lowest AC, point G, not at E.", "AR is above MC, but AR equals AC at E, so profit is only normal.", ""], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price, costs and revenue", "lines": [{"pts": [[1, 7.4], [2, 6.1], [3, 5], [4, 4.1], [5, 3.4], [6, 2.9], [7, 2.6], [8, 2.5], [9, 2.6], [10, 2.9]], "label": "AC", "c": 1}, {"pts": [[2, 0.1], [10, 3.3]], "label": "MC", "c": 2}, {"pts": [[0, 7.3], [9, 0.1]], "label": "AR", "c": 0}, {"pts": [[0, 7.3], [4.5, 0.1]], "label": "MR", "c": 3, "dash": true}], "areas": [], "arrows": [], "points": [{"at": [4, 4.1], "label": "E", "guides": ["Q1", "P1"]}, {"at": [4, 0.9], "label": "F"}, {"at": [8, 2.5], "label": "G", "guides": ["Q2"]}]}}
{"id": "econ-d129", "s": "micro", "t": "3.4.3", "lv": 3, "q": "The firm makes the loss shown by area L at Q1. Which statement about the long run is correct?", "o": ["Area L is the loss; entry shifts AR left until AR equals AC at P1", "Area L is the loss; exit shifts AC down until it touches AR at P1", "Area L is the loss; exit shifts AR right until AR=AC, at a price above P1", "Area L is supernormal profit, so entry will push the price below P1"], "a": 2, "x": "At Q1, AR at Z is below AC, so L is a loss. Firms exit, remaining firms' AR shifts right and becomes less elastic until it is tangent to AC, so price rises above P1.", "w": ["Entry shifts AR left, which would deepen the loss; the loss causes exit instead.", "Exit does not move AC. The adjustment comes from the AR curve shifting right.", "", "AR is below AC at Z, so L is a loss, not supernormal profit."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price, costs and revenue", "lines": [{"pts": [[1, 7.4], [2, 6.1], [3, 5], [4, 4.1], [5, 3.4], [6, 2.9], [7, 2.6], [8, 2.5], [9, 2.6], [10, 2.9]], "label": "AC", "c": 1}, {"pts": [[2, 0.1], [10, 3.3]], "label": "MC", "c": 2}, {"pts": [[0, 6.3], [7.5, 0.3]], "label": "AR1", "c": 0}, {"pts": [[0, 6.3], [3.9, 0.06]], "label": "MR1", "c": 3, "dash": true}], "areas": [{"pts": [[0, 4.525], [3.5, 4.525], [3.5, 3.5], [0, 3.5]], "label": "L", "c": 2, "at": [1.7, 4]}], "arrows": [], "points": [{"at": [3.5, 3.5], "label": "Z", "guides": ["Q1", "P1"]}]}}
{"id": "econ-d130", "s": "micro", "t": "3.4.4", "lv": 1, "q": "The diagram shows an oligopolist's demand curve. Which point is the kink, where rivals ignore a price rise but match a price cut?", "o": ["Point Y", "Point Z", "Point X", "None, as the curve is smooth"], "a": 2, "x": "The kink is where the elastic and inelastic parts of demand meet, at point X. Above it rivals do not follow a price rise; below it they match cuts.", "w": ["Point Y lies on the elastic section, away from the kink.", "Point Z lies on the inelastic section, away from the kink.", "", "The curve changes slope at X, so it has a kink."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price", "lines": [{"pts": [[0, 10], [5, 6]], "label": "D elastic part", "c": 0}, {"pts": [[5, 6], [8, 0]], "label": "D inelastic part", "c": 0}], "areas": [], "arrows": [], "points": [{"at": [2, 8.4], "label": "Y"}, {"at": [7, 2], "label": "Z"}, {"at": [5, 6], "label": "X"}]}}
{"id": "econ-d131", "s": "micro", "t": "3.4.4", "lv": 2, "q": "Marginal cost rises from MC1 to MC2, as shown. According to the kinked demand model, what happens to price and output?", "o": ["Price rises above P1 and output falls below Q1", "Price falls below P1 and output rises above Q1", "Price stays at P1 but output falls below Q1", "Price and output stay at P1 and Q1"], "a": 3, "x": "Both MC1 and MC2 cut the vertical gap in MR at Q1. Profit is still maximised at Q1, and the price read from D at Q1 is P1, so nothing changes.", "w": ["MC2 still cuts MR in the gap at Q1, so output does not fall.", "The cost rise does not lower price or raise output; MC2 meets the gap at Q1.", "Output stays at Q1, because MC2 still passes through the gap in MR.", ""], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price and costs", "lines": [{"pts": [[0, 10], [5, 6]], "label": "D elastic part", "c": 0}, {"pts": [[5, 6], [8, 0]], "label": "D inelastic part", "c": 0}, {"pts": [[0, 10], [5, 2]], "label": "MR", "c": 1}, {"pts": [[0, 0], [10, 2]], "label": "MC1", "c": 2}, {"pts": [[0, 0.8], [10, 2.8]], "label": "MC2", "c": 3, "dash": true}], "areas": [], "arrows": [{"from": [5, 2], "to": [5, 0], "c": 1}], "points": [{"at": [5, 6], "label": "K", "guides": ["Q1", "P1"]}]}}
{"id": "econ-d132", "s": "micro", "t": "3.4.4", "lv": 3, "q": "Costs rise so MC1 shifts up to MC3, which now cuts the upper part of MR at Q2. What is the new profit-maximising outcome?", "o": ["Price rises to P2 and output falls to Q2", "Price stays at P1 and output stays at Q1", "Price falls to P2 and output rises to Q2", "Price rises to P2 and output stays at Q1"], "a": 0, "x": "MC3 now cuts MR above the gap, at Q2 left of Q1. Reading up to D at Q2 gives point M, so price rises to P2 and output falls.", "w": ["", "MC3 no longer passes through the gap in MR, so Q1 is no longer profit-maximising.", "Q2 is to the left of Q1, so output falls, and P2 is above P1.", "Output moves to Q2, which is below Q1, so it cannot stay at Q1."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price and costs", "lines": [{"pts": [[0, 10], [5, 6]], "label": "D elastic part", "c": 0}, {"pts": [[5, 6], [8, 0]], "label": "D inelastic part", "c": 0}, {"pts": [[0, 10], [5, 2]], "label": "MR", "c": 1}, {"pts": [[0, 0], [10, 2]], "label": "MC1", "c": 2, "dash": true}, {"pts": [[0, 2.5], [10, 4.5]], "label": "MC3", "c": 3}], "areas": [], "arrows": [{"from": [5, 2], "to": [5, 0], "c": 1}], "points": [{"at": [5, 6], "label": "K", "guides": ["Q1", "P1"]}, {"at": [4.1667, 6.6667], "label": "M", "guides": ["Q2", "P2"]}]}}
{"id": "econ-d133", "s": "micro", "t": "3.4.5", "lv": 1, "q": "The diagram shows a monopolist's AR, MR and MC. Which point shows its profit-maximising output?", "o": ["Point Y, where AR meets MC", "Point Z, where MR is zero", "Point X, where MR meets MC", "Point W, the price on AR"], "a": 2, "x": "Profit is maximised where MR = MC, which is point X. The price is then read from AR above it, at W.", "w": ["Y is where P = MC, the competitive output, not the monopolist's choice.", "Z is where MR = 0, which maximises revenue, not profit.", "", "W is the price charged, not the output, and MR does not equal MC there."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price, cost, revenue", "lines": [{"pts": [[0, 10], [10, 0]], "label": "AR", "c": 0}, {"pts": [[0, 10], [5, 0]], "label": "MR", "c": 1}, {"pts": [[0, 2], [10, 2]], "label": "MC", "c": 2}], "points": [{"at": [8, 2], "label": "Y"}, {"at": [5, 0], "label": "Z"}, {"at": [4, 2], "label": "X"}, {"at": [4, 6], "label": "W"}]}}
{"id": "econ-d134", "s": "micro", "t": "3.4.5", "lv": 2, "q": "The diagram shows a profit-maximising monopolist with MC = AC. Which area is the deadweight (welfare) loss?", "o": ["Area A", "Area C", "Areas A and B together", "Area B"], "a": 3, "x": "The welfare loss is the triangle between AR and MC for the output lost between the monopoly and the P = MC level. That is area B.", "w": ["Area A is supernormal profit, a transfer to the firm, not a loss of welfare.", "Area C is the consumer surplus that remains at the monopoly price.", "Area A is profit, which is not lost, so adding it to B overstates the loss.", ""], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price, cost, revenue", "lines": [{"pts": [[0, 10], [10, 0]], "label": "AR", "c": 0}, {"pts": [[0, 10], [5, 0]], "label": "MR", "c": 1}, {"pts": [[0, 2], [10, 2]], "label": "MC = AC", "c": 2}], "areas": [{"pts": [[0, 10], [0, 6], [4, 6]], "label": "C", "c": 1, "at": [1, 7.3]}, {"pts": [[0, 6], [4, 6], [4, 2], [0, 2]], "label": "A", "c": 3, "at": [2, 4]}, {"pts": [[4, 6], [4, 2], [8, 2]], "label": "B", "c": 2, "at": [5, 3.3]}]}}
{"id": "econ-d135", "s": "micro", "t": "3.4.5", "lv": 3, "q": "Demand rises from AR1 to AR2, with MR1 to MR2. MC is constant. Which point shows the monopolist's new profit-maximising price and output?", "o": ["Point X, the original price and output", "Point Y, on AR2 above where MR2 meets MC", "Point Z, where MR2 meets MC", "Point W, on AR2 at the original price"], "a": 1, "x": "MR2 meets MC at output 6 (point Z). The price is read up to AR2, which is point Y. Both the price and output rise.", "w": ["X was the equilibrium on AR1 before demand rose.", "", "Z gives the new output but lies on MC. The price must come from AR2.", "W keeps the old price of 6, but the new profit-maximising price is higher."], "fig": {"type": "line", "x": [0, 14], "y": [0, 14], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price, cost, revenue", "lines": [{"pts": [[0, 10], [10, 0]], "label": "AR1", "c": 0, "dash": true}, {"pts": [[0, 10], [5, 0]], "label": "MR1", "c": 1, "dash": true}, {"pts": [[0, 14], [14, 0]], "label": "AR2", "c": 0}, {"pts": [[0, 14], [7, 0]], "label": "MR2", "c": 1}, {"pts": [[0, 2], [14, 2]], "label": "MC", "c": 2}], "points": [{"at": [4, 6], "label": "X"}, {"at": [6, 8], "label": "Y"}, {"at": [6, 2], "label": "Z"}, {"at": [8, 6], "label": "W"}]}}
{"id": "econ-d136", "s": "micro", "t": "3.4.6", "lv": 1, "q": "In the monopsony labour market diagram, which curve shows the firm's marginal cost of labour?", "o": ["Curve X, as it shows the wage each worker is paid", "Curve Y, as it lies above supply and is steeper", "Curve Z, as it shows the extra revenue from a worker", "Curve X, as hiring one more costs just that wage"], "a": 1, "x": "To hire one more worker the monopsonist must raise the wage for all its workers. So the marginal cost of labour lies above the supply curve (X) and is steeper. That is curve Y; Z is MRP.", "w": ["Curve X is supply, the average cost of labour: the wage paid per worker, not the extra cost of one more.", "", "Curve Z slopes down: it is MRP, the extra revenue from a worker (labour demand), not a cost.", "Hiring one more worker means raising pay for all, so the extra cost is above the wage shown on X."], "fig": {"type": "line", "x": [0, 10], "y": [0, 16], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity of labour", "ylabel": "Wage (£)", "lines": [{"pts": [[0, 2], [10, 12]], "label": "X", "c": 0}, {"pts": [[0, 2], [6.5, 15]], "label": "Y", "c": 1}, {"pts": [[0, 14], [10, 4]], "label": "Z", "c": 2}], "areas": [], "arrows": [], "points": []}}
{"id": "econ-d137", "s": "micro", "t": "3.4.6", "lv": 2, "q": "The diagram shows a monopsony employer. Which describes the profit-maximising outcome?", "o": ["L1 workers are hired and paid W1, read from S at B", "L1 workers are hired and paid the wage shown at point A", "L2 workers are hired and paid W2, where MRP meets S", "L2 workers are hired and paid W1, the wage at point B"], "a": 0, "x": "The firm hires where MRP = MCL (A), giving L1 workers. It pays the wage on supply at that quantity, W1 at B.", "w": ["", "Point A is where MRP meets MCL; the wage is read down to supply, not at A.", "That is the competitive outcome at C, not the monopsony's.", "The monopsony does not hire L2, and W1 goes with L1."], "fig": {"type": "line", "x": [0, 10], "y": [0, 16], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity of labour", "ylabel": "Wage (£)", "lines": [{"pts": [[0, 2], [10, 12]], "label": "S", "c": 0}, {"pts": [[0, 2], [6.5, 15]], "label": "MCL", "c": 1}, {"pts": [[0, 14], [10, 4]], "label": "MRP", "c": 2}], "areas": [], "arrows": [], "points": [{"at": [4, 10], "label": "A", "guides": ["L1"]}, {"at": [4, 6], "label": "B", "guides": ["L1", "W1"]}, {"at": [6, 8], "label": "C", "guides": ["L2", "W2"]}]}}
{"id": "econ-d138", "s": "micro", "t": "3.4.6", "lv": 3, "q": "A minimum wage is set at W2, shown by line Wmin. What happens to employment in this monopsony?", "o": ["It falls below L1, because the wage has risen above W1", "It stays at L1, because MCL still cuts MRP at point A", "It rises to L2, but only if the firm cuts the wage below W1", "It rises from L1 to L2, as MCL is flat at W2 up to L2"], "a": 3, "x": "With Wmin at W2, the cost of each extra worker is W2 up to L2. MRP stays above W2 until C, so the firm hires L2 workers.", "w": ["Wage floors below the competitive wage raise monopsony employment; they do not cut it.", "Wmin makes MCL flat at W2, so the firm no longer hires where MCL cuts MRP at A.", "Wmin forces the wage up to W2; the firm cannot pay below it.", ""], "fig": {"type": "line", "x": [0, 10], "y": [0, 16], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity of labour", "ylabel": "Wage (£)", "lines": [{"pts": [[0, 2], [10, 12]], "label": "S", "c": 0}, {"pts": [[0, 2], [6.5, 15]], "label": "MCL", "c": 1}, {"pts": [[0, 14], [10, 4]], "label": "MRP", "c": 2}, {"pts": [[0, 8], [10, 8]], "label": "Wmin", "c": 3, "dash": true}], "areas": [], "arrows": [], "points": [{"at": [4, 10], "label": "A"}, {"at": [4, 6], "label": "B", "guides": ["L1", "W1"]}, {"at": [6, 8], "label": "C", "guides": ["L2", "W2"]}]}}
{"id": "econ-d139", "s": "micro", "t": "3.4.7", "lv": 1, "q": "In the diagram, which area is the supernormal profit at the profit-maximising output that could attract new entrants?", "o": ["Area B", "Area A", "Areas A and B together", "The area under MR"], "a": 1, "x": "Supernormal profit is (P1 − AC) × Q1. This is the rectangle between price and average cost up to Q1. That is area A, and it is the profit that entrants hope to take.", "w": ["Area B lies beyond Q1. It is not part of profit at X; it is the welfare lost by restricting output.", "", "Area B is not profit, so adding it to A overstates the profit.", "The area under MR up to Q1 is total revenue, which includes costs, so it is not profit."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price, cost, revenue", "lines": [{"pts": [[0, 10], [10, 0]], "label": "AR", "c": 0}, {"pts": [[0, 10], [5, 0]], "label": "MR", "c": 1}, {"pts": [[0, 2], [10, 2]], "label": "MC = AC", "c": 2}], "areas": [{"pts": [[0, 2], [4, 2], [4, 6], [0, 6]], "label": "A", "c": 3, "at": [2, 4]}, {"pts": [[4, 2], [8, 2], [4, 6]], "label": "B", "c": 1, "at": [5, 3.3]}], "arrows": [], "points": [{"at": [4, 6], "label": "X", "guides": ["Q1", "P1"]}]}}
{"id": "econ-d140", "s": "micro", "t": "3.4.7", "lv": 2, "q": "The firm moves from point X to point Y. What is the best explanation for this move in a contestable market?", "o": ["Output falls to Q1 as the firm restricts supply to raise price", "Output rises to Q2 because costs have fallen from AC to P2", "Price falls to P2 because demand has shifted from AR to MR", "Output rises to Q2 as limit pricing deters potential entrants"], "a": 3, "x": "Moving down AR from X to Y cuts price to P2 and raises output to Q2. That limit pricing reduces supernormal profit so entry looks unattractive.", "w": ["Moving from X to Y raises output and lowers price, the reverse of this.", "AC is constant; the firm moves along AR and costs do not change.", "AR and MR are separate curves; the firm moves along AR and demand does not shift.", ""], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price, cost, revenue", "lines": [{"pts": [[0, 10], [10, 0]], "label": "AR", "c": 0}, {"pts": [[0, 10], [5, 0]], "label": "MR", "c": 1}, {"pts": [[0, 2], [10, 2]], "label": "MC = AC", "c": 2}], "areas": [], "arrows": [{"from": [4, 6], "to": [7, 3], "c": 3}], "points": [{"at": [4, 6], "label": "X", "guides": ["Q1", "P1"]}, {"at": [7, 3], "label": "Y", "guides": ["Q2", "P2"]}]}}
{"id": "econ-d141", "s": "micro", "t": "3.4.7", "lv": 3, "q": "At point Y the firm has used limit pricing. Which statement about the outcome is correct?", "o": ["Supernormal profit is only area C, small enough to make entry unattractive", "The firm earns normal profit only, as P2 is above AC", "Allocative efficiency is achieved because P2 equals MC at Q2", "Profit is area A, since output has risen to Q2"], "a": 0, "x": "At Y, price P2 exceeds AC by a small margin, so supernormal profit is just area C. This small profit gives entrants little incentive, so the outcome is close to competition.", "w": ["", "Price above AC means supernormal profit, so profit is not only normal.", "P2 is above MC, so price does not equal marginal cost and allocative efficiency is not reached.", "Area A was the profit at X; at Y the profit is only area C."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price, cost, revenue", "lines": [{"pts": [[0, 10], [10, 0]], "label": "AR", "c": 0}, {"pts": [[0, 10], [5, 0]], "label": "MR", "c": 1}, {"pts": [[0, 2], [10, 2]], "label": "MC = AC", "c": 2}], "areas": [{"pts": [[0, 2], [4, 2], [4, 6], [0, 6]], "label": "A", "c": 1, "at": [2, 4]}, {"pts": [[0, 2], [7, 2], [7, 3], [0, 3]], "label": "C", "c": 3, "at": [3.5, 2.5]}], "arrows": [], "points": [{"at": [4, 6], "label": "X", "guides": ["Q1", "P1"]}, {"at": [7, 3], "label": "Y", "guides": ["Q2", "P2"]}]}}
{"id": "econ-d142", "s": "micro", "t": "3.5.1", "lv": 1, "q": "The wage rate falls from W1 to W2. What does the diagram show happening to the firm?", "o": ["A rightward shift of MRP, so more workers are hired", "A leftward shift of MRP, so fewer workers are hired", "A movement along MRP from A to B, so more workers are hired", "A movement along MRP from B to A, so fewer workers are hired"], "a": 2, "x": "A wage change moves the firm along its MRP curve. At the lower wage W2 it hires up to B, where MRP equals W2, so employment rises from L1 to L2.", "w": ["The MRP curve does not shift when only the wage changes.", "The MRP curve does not shift when only the wage changes.", "", "The wage falls, so the move is from A to B, not B to A."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity of labour", "ylabel": "Wage rate (£)", "lines": [{"pts": [[1, 9], [9, 1]], "label": "MRP", "c": 0}, {"pts": [[0, 6], [10, 6]], "label": "W1", "c": 1}, {"pts": [[0, 3], [10, 3]], "label": "W2", "c": 2}], "areas": [], "arrows": [], "points": [{"at": [4, 6], "label": "A", "guides": ["L1"]}, {"at": [7, 3], "label": "B", "guides": ["L2"]}]}}
{"id": "econ-d143", "s": "micro", "t": "3.5.1", "lv": 2, "q": "At the wage shown, the firm's labour demand moves from MRP1 to MRP2. Which could have caused this?", "o": ["A rise in the price of the product the workers make", "A fall in the wage rate paid to workers", "A fall in consumer demand for the firm's product", "A fall in the supply of workers in the labour market"], "a": 0, "x": "A higher product price raises MR, so MRP = MPP × MR rises at every quantity of labour. The curve shifts right, from MRP1 to MRP2.", "w": ["", "A wage fall would be a movement along the curve, not a shift.", "Falling product demand lowers MRP and shifts the curve left.", "Labour supply does not shift the firm's MRP demand curve."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity of labour", "ylabel": "Wage rate (£)", "lines": [{"pts": [[1, 9], [9, 1]], "label": "MRP1", "c": 0}, {"pts": [[2, 10], [10, 2]], "label": "MRP2", "c": 2}, {"pts": [[0, 5], [10, 5]], "label": "Wage W", "c": 1}], "areas": [], "arrows": [{"from": [4, 7], "to": [6, 7], "c": 2}], "points": [{"at": [5, 5], "label": "X", "guides": ["L1"]}, {"at": [7, 5], "label": "Y", "guides": ["L2"]}]}}
{"id": "econ-d144", "s": "micro", "t": "3.5.1", "lv": 3, "q": "The firm hires L1 workers at wage W1. Which area is the revenue from these workers over and above the wage bill?", "o": ["Area B only", "Areas A and B together", "Neither area", "Area A only"], "a": 3, "x": "Area under MRP up to L1 is A plus B, the total revenue added. Area B is the wage bill (W1 × L1), so what remains is area A.", "w": ["Area B is the wage bill, the cost of employing L1 workers.", "A and B together is the total MRP, before wages are deducted.", "Area A lies between MRP and the wage, so it is the extra revenue.", ""], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity of labour", "ylabel": "Wage rate (£)", "lines": [{"pts": [[0, 10], [10, 0]], "label": "MRP", "c": 0}, {"pts": [[0, 4], [10, 4]], "label": "W1", "c": 1}], "areas": [{"pts": [[0, 10], [0, 4], [6, 4]], "label": "A", "c": 2, "at": [1.5, 5.5]}, {"pts": [[0, 0], [0, 4], [6, 4], [6, 0]], "label": "B", "c": 3, "at": [3, 2]}], "arrows": [], "points": [{"at": [6, 4], "label": "X", "guides": ["L1"]}]}}
{"id": "econ-d145", "s": "micro", "t": "3.5.2", "lv": 1, "q": "In the diagram, the move from S1 to S2 shows:", "o": ["A rise in labour demand", "A rightward shift in labour supply", "A leftward shift in labour supply", "A movement along S1"], "a": 1, "x": "S2 lies to the right of S1, so more workers are supplied at each wage. This is an increase in supply, a rightward shift.", "w": ["The shift is in a supply curve; D1 has not moved.", "", "S2 is to the right of S1, not the left.", "A movement along would stay on S1, but the whole curve has moved."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity of labour", "ylabel": "Wage rate", "lines": [{"pts": [[1, 9], [9, 1]], "label": "D1", "c": 0}, {"pts": [[1, 1], [9, 9]], "label": "S1", "c": 1, "dash": true}, {"pts": [[2, 1], [10, 9]], "label": "S2", "c": 2}], "areas": [], "arrows": [{"from": [4, 4], "to": [5, 4], "c": 2}], "points": [], "anim": "none", "steps": []}}
{"id": "econ-d146", "s": "micro", "t": "3.5.2", "lv": 2, "q": "The original equilibrium is at X, where D1 meets S1. After supply shifts to S2, what happens?", "o": ["Wage falls and employment rises", "Wage rises and employment falls", "Wage and employment both rise", "Wage falls and employment falls"], "a": 0, "x": "At Z, where D1 meets S2, the wage is lower and employment is higher than at X. A supply increase pushes the wage down along D1.", "w": ["", "Falling supply would do this, but S2 shows supply rising.", "Both rising would need a demand increase, and D1 has not moved.", "The wage does fall, but employment rises along D1."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity of labour", "ylabel": "Wage rate", "lines": [{"pts": [[1, 9], [9, 1]], "label": "D1", "c": 0}, {"pts": [[1, 1], [9, 9]], "label": "S1", "c": 1, "dash": true}, {"pts": [[3, 1], [10, 8]], "label": "S2", "c": 2}], "areas": [], "arrows": [], "points": [{"at": [5, 5], "label": "X", "guides": ["Q1", "W1"]}, {"at": [6, 4], "label": "Z", "guides": ["Q2", "W2"]}], "anim": "none", "steps": []}}
{"id": "econ-d147", "s": "micro", "t": "3.5.2", "lv": 3, "q": "The diagram shows labour supply S1 and demand D1 with equilibrium at X. Which change would cause supply to move to S2?", "o": ["A rise in the wage for this job", "Employers needing more workers", "More generous non-wage benefits in the job", "A stricter limit on skilled migration"], "a": 3, "x": "S2 is to the left of S1, so fewer workers are supplied at each wage. Tighter migration limits cut the available workforce and cause this leftward shift.", "w": ["A wage rise is a movement along S1, not a shift.", "That would shift demand, not supply.", "Better benefits would attract workers and shift supply right.", ""], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity of labour", "ylabel": "Wage rate", "lines": [{"pts": [[1, 9], [9, 1]], "label": "D1", "c": 0}, {"pts": [[1, 1], [9, 9]], "label": "S1", "c": 1, "dash": true}, {"pts": [[0, 1], [8, 9]], "label": "S2", "c": 2}], "areas": [], "arrows": [{"from": [4, 4], "to": [3, 4], "c": 2}], "points": [{"at": [5, 5], "label": "X"}], "anim": "none", "steps": []}}
{"id": "econ-d148", "s": "micro", "t": "3.5.3", "lv": 1, "q": "In the diagram, a minimum wage W_min is imposed. What is the result in this labour market?", "o": ["Excess demand for labour, so firms face a shortage of workers", "The market clears at W_min, so there is no unemployment", "Excess supply of labour, as Qs exceeds Qd at W_min", "No effect, because W_min is below the equilibrium wage"], "a": 2, "x": "W_min is above the equilibrium wage at E. At W_min, workers supplying labour (Qs) exceed those firms demand (Qd), so there is excess supply of labour.", "w": ["Excess demand would occur at a wage below equilibrium, not above it.", "The market clears only at E; at W_min quantities supplied and demanded differ.", "", "W_min sits above E on the diagram, so it is binding."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity of labour", "ylabel": "Wage rate", "lines": [{"pts": [[0, 9], [10, 1]], "label": "D", "c": 0}, {"pts": [[0, 1], [10, 9]], "label": "S", "c": 1}, {"pts": [[0, 7], [10, 7]], "label": "W_min", "c": 2}], "areas": [], "arrows": [], "points": [{"at": [5, 5], "label": "E"}, {"at": [2.5, 7], "label": "Qd"}, {"at": [7.5, 7], "label": "Qs"}]}}
{"id": "econ-d149", "s": "micro", "t": "3.5.3", "lv": 2, "q": "The firm is a monopsony. Which point shows the wage it pays and the number of workers it employs?", "o": ["Y: employment is set where MCL = MRP, and the wage comes from S", "X: the wage equals MRP at the profit-maximising employment", "Z: the monopsony hires where S meets MRP, as in competition", "X: the wage is read from where MCL cuts MRP"], "a": 0, "x": "The monopsony hires where MCL = MRP (below X). It then pays only what workers will accept, the wage on the supply curve at that employment: point Y.", "w": [" ", "X is on MRP and MCL, but the firm does not pay MRP; it pays the lower wage on S.", "Z is the competitive outcome; a monopsony restricts employment below it.", "The MCL-MRP intersection fixes employment, but the wage is read from S, not X."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity of labour", "ylabel": "Wage rate", "lines": [{"pts": [[0, 10], [10, 0]], "label": "MRP", "c": 0}, {"pts": [[0, 1], [10, 6]], "label": "S", "c": 1}, {"pts": [[0, 1], [9, 10]], "label": "MCL", "c": 2}], "areas": [], "arrows": [], "points": [{"at": [4.5, 5.5], "label": "X"}, {"at": [4.5, 3.25], "label": "Y"}, {"at": [6, 4], "label": "Z"}]}}
{"id": "econ-d150", "s": "micro", "t": "3.5.3", "lv": 3, "q": "The firm is a monopsony paying W0 with employment Q1. A minimum wage W1 is now introduced, as shown. What happens?", "o": ["Employment falls from Q2 to Q1, as W1 is above W0", "Wage rises to W1 but employment stays at Q1, as MCL is unchanged", "Employment falls because labour demand contracts along MRP", "Wage rises from W0 to W1 and employment rises from Q1 to Q2"], "a": 3, "x": "W1 makes the wage flat at W1 up to Q2, so extra workers cost W1 each. MCL then equals W1 until it meets MRP at Z, so employment rises.", "w": ["Employment starts at Q1, not Q2; it moves up, not down.", "The floor makes MCL equal W1 up to Q2, so MCL does change.", "MRP at Z still exceeds W1 up to Q2, so firms want more workers, not fewer.", ""], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity of labour", "ylabel": "Wage rate", "lines": [{"pts": [[0, 10], [10, 0]], "label": "MRP", "c": 0}, {"pts": [[0, 1], [10, 6]], "label": "S", "c": 1}, {"pts": [[0, 1], [9, 10]], "label": "MCL", "c": 2}, {"pts": [[0, 4], [10, 4]], "label": "W1", "c": 3, "dash": true}], "areas": [], "arrows": [], "points": [{"at": [4.5, 3.25], "label": "Y", "guides": ["Q1", "W0"]}, {"at": [6, 4], "label": "Z", "guides": ["Q2", "W1"]}]}}
{"id": "econ-d151", "s": "micro", "t": "3.6.1", "lv": 1, "q": "In the diagram, the monopsony employs the quantity of labour where MC labour meets MRP. Which point shows the wage it pays?", "o": ["Point A, where MC labour meets MRP", "Point B, on the labour supply curve S", "Point C, where S meets MRP", "The point where MC labour meets the vertical axis"], "a": 1, "x": "The firm hires Q1 workers, where MC labour equals MRP at A. The wage needed to attract that many workers is read up to the supply curve S, which is point B.", "w": ["A shows the value of the marginal worker's output, not the wage paid.", "", "C is the competitive outcome, not the monopsony wage.", "The vertical-axis intercept is not a wage the firm pays at this employment level."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity of labour", "ylabel": "Wage", "lines": [{"pts": [[0, 10], [10, 0]], "label": "MRP", "c": 0}, {"pts": [[0, 1], [10, 6]], "label": "S (AC labour)", "c": 1}, {"pts": [[0, 1], [9, 10]], "label": "MC labour", "c": 2}], "areas": [], "arrows": [], "points": [{"at": [4.5, 5.5], "label": "A", "guides": ["Q1"]}, {"at": [4.5, 3.25], "label": "B"}, {"at": [6, 4], "label": "C"}]}}
{"id": "econ-d152", "s": "micro", "t": "3.6.1", "lv": 2, "q": "The regulator sets the price cap shown on this monopoly. Compared with the unregulated outcome at A, what happens at B?", "o": ["Price falls and output falls", "Price falls and output rises to C, where P = MC", "Price falls and output rises, but not to point C", "Price is unchanged and output rises"], "a": 2, "x": "The cap lowers price from A to B and makes extra output sell at the capped price, so output rises. B is still short of C, the allocatively efficient output where P = MC.", "w": ["Under the cap the firm sells more at the lower price, so output rises, not falls.", "The cap moves the firm to B, not to C, so P is still above MC.", "", "Price falls from A to the cap level, so it is not unchanged."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price and costs", "lines": [{"pts": [[0, 10], [10, 0]], "label": "AR (demand)", "c": 0}, {"pts": [[0, 10], [5, 0]], "label": "MR", "c": 1}, {"pts": [[0, 2], [10, 2]], "label": "MC", "c": 2}, {"pts": [[0, 4], [6, 4]], "label": "Price cap", "c": 3}], "areas": [], "arrows": [], "points": [{"at": [4, 6], "label": "A"}, {"at": [6, 4], "label": "B"}, {"at": [8, 2], "label": "C"}]}}
{"id": "econ-d153", "s": "micro", "t": "3.6.1", "lv": 3, "q": "A minimum wage is set at the level shown, above the competitive wage in this monopsony. Compared with A, what is the effect?", "o": ["Employment rises to B's level, but workers between B and C cannot find jobs", "Employment falls to B's level, as in a competitive market", "Employment rises to C's level because all workers who supply labour are hired", "Employment stays at A's level because MRP is unchanged"], "a": 0, "x": "At the minimum wage the firm hires up to where MRP equals that wage, which is B. This is more than at A, but C workers want jobs, so B to C is unemployment.", "w": ["", "Employment at B is above A's, so it rises. It does not fall.", "Firms hire only up to B, where MRP equals the wage. C is the quantity supplied, not hired.", "The wage floor changes the cost of hiring, so employment moves from A to B."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity of labour", "ylabel": "Wage", "lines": [{"pts": [[0, 10], [10, 0]], "label": "MRP", "c": 0}, {"pts": [[0, 1], [10, 6]], "label": "S (AC labour)", "c": 1}, {"pts": [[0, 1], [9, 10]], "label": "MC labour", "c": 2}, {"pts": [[0, 5], [8, 5]], "label": "Minimum wage", "c": 3}], "areas": [], "arrows": [], "points": [{"at": [4.5, 3.25], "label": "A"}, {"at": [5, 5], "label": "B"}, {"at": [8, 5], "label": "C"}]}}
{"id": "econ-d154", "s": "micro", "t": "3.6.2", "lv": 1, "q": "The diagram shows a market with a maximum price Pmax. What happens at Pmax?", "o": ["A surplus between Q1 and Q2", "Equilibrium at Q3, with no excess demand", "Excess demand between Q1 and Q2", "Excess supply between Q2 and Q3"], "a": 2, "x": "At Pmax, quantity demanded is Q2 but quantity supplied is only Q1. The gap between Q1 and Q2 is excess demand.", "w": ["A surplus needs supply above demand, but here demand is above supply.", "Q3 is the free-market equilibrium, which Pmax prevents.", "", "Excess supply would need Pmax above P*, but Pmax is below it."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price", "lines": [{"pts": [[0, 10], [10, 0]], "label": "D", "c": 0}, {"pts": [[0, 0], [10, 10]], "label": "S", "c": 1}, {"pts": [[0, 3], [10, 3]], "label": "Pmax", "c": 2}], "areas": [], "arrows": [], "points": [{"at": [5, 5], "label": "E", "guides": ["Q3", "P*"]}, {"at": [3, 3], "guides": ["Q1", "Pmax"]}, {"at": [7, 3], "guides": ["Q2", "Pmax"]}]}}
{"id": "econ-d155", "s": "micro", "t": "3.6.2", "lv": 2, "q": "The diagram shows a minimum price of £7. How large is the surplus?", "o": ["4 units", "3 units", "7 units", "2 units"], "a": 0, "x": "At £7, quantity demanded (point X) is 3 units and quantity supplied (point Y) is 7 units. The surplus is 7 - 3 = 4 units.", "w": ["", "3 units is only quantity demanded at £7, not the surplus.", "7 units is only quantity supplied at £7, not the gap.", "2 units is the gap between the equilibrium quantity of 5 and the quantity demanded of 3, not the surplus."], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": true, "ynums": true, "ystep": 1, "xlabel": "Quantity (units)", "ylabel": "Price (£)", "lines": [{"pts": [[0, 10], [10, 0]], "label": "D", "c": 0}, {"pts": [[0, 0], [10, 10]], "label": "S", "c": 1}, {"pts": [[0, 7], [10, 7]], "label": "Pmin £7", "c": 2}], "areas": [], "arrows": [], "points": [{"at": [3, 7], "label": "X"}, {"at": [7, 7], "label": "Y"}, {"at": [5, 5], "label": "E"}]}}
{"id": "econ-d156", "s": "micro", "t": "3.6.2", "lv": 3, "q": "A subsidy shifts supply from S1 to S2. Consumers pay P2 and producers receive P3. Who gains more?", "o": ["Consumers gain more, because area B is below the old price P1", "Producers gain more, because they receive P3 on every unit", "Neither gains, because the subsidy cost falls on taxpayers", "The gain is shared equally, because areas B and C are equal"], "a": 3, "x": "Consumers' share of the subsidy is area B (price falls from P1 to P2) and producers' share is area C (price received rises from P1 to P3). P3 is as far above P1 as P2 is below it, and both rectangles run to Q2, so B equals C.", "w": ["B is consumers' gain, but C is the same size, so consumers do not gain more.", "P3 is above P1 by the same amount that P2 is below it, so the gains are equal.", "Taxpayers fund B + C, but consumers and producers both gain from the lower and higher prices.", ""], "fig": {"type": "line", "x": [0, 10], "y": [0, 10], "grid": false, "xnums": false, "ynums": false, "xlabel": "Quantity", "ylabel": "Price", "lines": [{"pts": [[0, 10], [10, 0]], "label": "D", "c": 0}, {"pts": [[0, 0], [10, 10]], "label": "S1", "c": 1}, {"pts": [[2, 0], [10, 8]], "label": "S2", "c": 2}], "areas": [{"pts": [[0, 4], [6, 4], [6, 5], [0, 5]], "label": "B", "c": 3, "at": [3, 4.5]}, {"pts": [[0, 5], [6, 5], [6, 6], [0, 6]], "label": "C", "c": 1, "at": [3, 5.5]}], "arrows": [], "points": [{"at": [5, 5], "label": "E1", "guides": ["Q1", "P1"]}, {"at": [6, 4], "label": "E2", "guides": ["Q2", "P2"]}, {"at": [6, 6], "label": "F", "guides": ["Q2", "P3"]}]}}
